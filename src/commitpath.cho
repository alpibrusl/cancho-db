edition 9;
module cdb.commitpath;

import std.conns;
import std.crypto;
import std.bytes;
import cdb.commit;
import cdb.ir;
import cdb.build;
import cdb.token;
import cdb.shared;
import cdb.upstream;
import cdb.login;
import cdb.state;
import cdb.store;

// The commit path (docs/m1-commit-path.md, P2d-3): what a transaction has done, and what happens when it ends. Statements are added as
// the guard allows them; at the end of a transaction (the client's `COMMIT`, or the end of an autocommit statement) the commit is built,
// signed, and made durable in the order of P2-D4: for a write `PREPARE TRANSACTION`, the three files, `COMMIT PREPARED`; for a read the
// files, then `COMMIT`. The whole sequence runs inside the event loop with bounded waits (P2-D6).

// The proxy's own commands (BEGIN, COMMIT, PREPARE TRANSACTION and the rest) go to the server through the EXTENDED protocol, with names of their own
// (`cdb_x`, `cdb_p`), never the simple one: PostgreSQL's simple `Query` destroys the client's unnamed prepared statement and portal, and a client
// that parsed one in an earlier group (pg8000 does) would lose it to the proxy's `BEGIN` or `COMMIT`. The names are reserved (a client's statement
// or portal may not start with `cdb`: src/extended.cho).
fn put_header[&m](m: &!m [byte], at: int, ty: int, body: int) -> [] int {
    m[at] = byte_of(ty);
    m[at + 1] = byte_of((body + 4) / 16777216 % 256);
    m[at + 2] = byte_of((body + 4) / 65536 % 256);
    m[at + 3] = byte_of((body + 4) / 256 % 256);
    m[at + 4] = byte_of((body + 4) % 256);
    return at + 5;
}

fn put_name[&m, &s](m: &!m [byte], at: int, text: &s [byte]) -> [] int {
    var i = 0;
    while i < len(text) {
        m[at + i] = byte_of(int_of(text[i]));
        i = i + 1;
    }
    m[at + len(text)] = byte_of(0);
    return at + len(text) + 1;
}

// Run `sql` on upstream connection `b` and wait, bounded, for its `ReadyForQuery`. 0 if it ran, 1 if PostgreSQL answered with an error, -1 if the
// connection failed or was silent. The server must be quiet (nothing owed from it): lockstep (src/extended.cho) and the simple path both see to that.
pub fn upstream_exec[&t, &c, &q](tab: &!t conns.Table, core: &!c shared.Core, b: int, sql: &q [byte]) -> [conn_read, conn_write, poll] int {
    var sent = false;
    region r {
        let m = alloc_slice[r](len(sql) + 160, byte_of(0));
        var at = 0;
        // Close of a leftover statement and portal (no error if there are none), Parse, Bind, Execute, Close, Close, Sync
        at = put_header(m, at, 'C', 7);
        m[at] = byte_of('S');
        at = put_name(m, at + 1, "cdb_x");
        at = put_header(m, at, 'C', 7);
        m[at] = byte_of('P');
        at = put_name(m, at + 1, "cdb_p");
        at = put_header(m, at, 'P', 6 + len(sql) + 1 + 2);
        at = put_name(m, at, "cdb_x");
        at = put_name(m, at, sql);
        at = at + 2;
        at = put_header(m, at, 'B', 6 + 6 + 6);
        at = put_name(m, at, "cdb_p");
        at = put_name(m, at, "cdb_x");
        at = at + 6;
        at = put_header(m, at, 'E', 6 + 4);
        at = put_name(m, at, "cdb_p");
        at = at + 4;
        at = put_header(m, at, 'C', 7);
        m[at] = byte_of('S');
        at = put_name(m, at + 1, "cdb_x");
        at = put_header(m, at, 'C', 7);
        m[at] = byte_of('P');
        at = put_name(m, at + 1, "cdb_p");
        at = put_header(m, at, 'S', 0);
        sent = upstream.write_all(tab, b, m[0..at]);
    }
    if !sent {
        return 0 - 1;
    }
    let si = contents(core.snapin);
    let n = upstream.read_until_ready(tab, b, si, shared.login_ms());
    if n < 0 {
        return 0 - 1;
    }
    var pos = 0;
    var errored = 0;
    while pos + 5 <= n {
        if int_of(si[pos]) == 'E' {
            errored = 1;
        }
        pos = pos + 1 + commit.be(si, pos + 1, 4);
    }
    return errored;
}

// The code and the message of the first `ErrorResponse` in the answer `si` of `upstream_exec`, as `<code>: <message>` into `out`: its length, 0 if the answer holds none. For what the proxy says when it
// cannot start: PostgreSQL's own words are the only thing that tells a lock conflict from a missing privilege.
pub fn error_text[&s, &o](si: &s [byte], out: &!o [byte]) -> [] int {
    var pos = 0;
    while pos + 5 <= len(si) {
        let kind = int_of(si[pos]);
        let ml = commit.be(si, pos + 1, 4);
        if kind == 0 || ml < 4 || pos + 1 + ml > len(si) {
            return 0;
        }
        if kind == 'E' {
            var w = 0;
            var f = pos + 5;
            let end = pos + 1 + ml;
            while f < end && int_of(si[f]) != 0 {
                let tag = int_of(si[f]);
                var e = f + 1;
                while e < end && int_of(si[e]) != 0 {
                    e = e + 1;
                }
                if tag == 'C' || tag == 'M' {
                    var i = f + 1;
                    while i < e && w + 2 < len(out) {
                        out[w] = si[i];
                        w = w + 1;
                        i = i + 1;
                    }
                    if tag == 'C' && w + 2 < len(out) {
                        out[w] = byte_of(':');
                        out[w + 1] = byte_of(' ');
                        w = w + 2;
                    }
                }
                f = e + 1;
            }
            return w;
        }
        pos = pos + 1 + ml;
    }
    return 0;
}

// Forget what client `k`'s transaction did (its token stays recorded: that is per connection, not per transaction).
pub fn reset[&c](core: &!c shared.Core, k: int) -> [] int {
    let ai = contents(core.acci);
    ai[8 * k] = 0;
    ai[8 * k + 1] = 0;
    ai[8 * k + 2] = 0;
    ai[8 * k + 3] = 0;
    ai[8 * k + 5] = 0;
    ai[8 * k + 6] = 0;
    contents(core.state)[shared.stride() * k + 24] = 0;
    return 0;
}

// A new transaction for client `k`, which began with the schema `snapshot` (its hash is what the commit records).
pub fn begin[&c, &s](core: &!c shared.Core, k: int, snapshot: &s [byte]) -> [] int {
    reset(core, k);
    let acc = contents(core.acc);
    crypto.sha256(snapshot, acc[k * shared.acc_stride() + shared.acc_snap_at()..k * shared.acc_stride() + shared.acc_snap_at() + 32]);
    contents(core.acci)[8 * k + 5] = 1;
    return 0;
}

// Make sure the salt buffer holds `need` unused bytes (docs/spec/ir.md section 8, docs/m2g-erasure.md 6c): if it does not, a fresh `rnd_size()` bytes are fetched from the database over upstream
// connection `b`. 0 if it does hold them, 1 if PostgreSQL refused the query, -1 if the connection failed or answered something else.
pub fn ensure_rnd[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, b: int, need: int) -> [conn_read, conn_write, poll] int {
    if contents(core.rndi)[0] >= need {
        return 0;
    }
    let r = upstream_exec(tab, core, b, "select encode(string_agg(cdb.rnd(), ''::bytea), 'hex') from generate_series(1, 64)");
    if r != 0 {
        return r;
    }
    let si = contents(core.snapin);
    let at = first_text_at(si);
    if at < 4 || commit.be(si, at - 4, 4) != 2 * shared.rnd_size() || at + 2 * shared.rnd_size() > len(si) {
        return 0 - 1;
    }
    if state.hexdec(si, at, at + 2 * shared.rnd_size(), contents(core.rnd), 0) != shared.rnd_size() {
        return 0 - 1;
    }
    contents(core.rndi)[0] = shared.rnd_size();
    return 0;
}

// Add what the guard allowed (`n` statements: their ids, IR records and effects) to client `k`'s transaction, the statements as records of version 3 of the statement store
// (docs/spec/ir.md section 8: each constant lifted out, a salt from the buffer `ensure_rnd` fills, the id over the shape and the hash of the constants). `ids` is not used: the ids are made here.
// 0 if it fits, 1 if the transaction would hold more than a commit can name, 2 if there are no salts left (the caller did not `ensure_rnd` for `n` statements), 3 if a record is not a statement. A `nondet`
// effect (`now()`, the only one the lowering lets through) is noted: the commit records the transaction's `now()` (P2-D9). `erased` writes the records already erased (the erase call of docs/m2g-erasure.md 6d:
// its key is never stored).
pub fn add[&h, &c, &i, &x, &f](heap: &!h Heap, core: &!c shared.Core, k: int, n: int, ids: &i [byte], irs: &x [byte], effs: &f [byte], erased: bool) -> [heap] int {
    let ai = contents(core.acci);
    let acc = contents(core.acc);
    let base = k * shared.acc_stride();
    // effects: kind 4 is nondeterminism; 1, 2 and 3 are what make a commit two-phase
    var wrote = 0;
    var nondet = 0;
    var at = 0;
    while at + 3 <= len(effs) {
        let kind = int_of(effs[at]);
        if kind == 4 {
            nondet = 1;
        }
        if kind >= 1 && kind <= 3 {
            wrote = 1;
        }
        at = at + 3 + commit.be(effs, at + 1, 2);
    }
    if ai[8 * k] + n > shared.acc_stmts() || ai[8 * k + 2] + len(effs) > shared.acc_effs() {
        return 1;
    }
    // each record: lift its constants, take a salt if there are any, write the version 3 record and its id
    var pos = 0;
    var irat = ai[8 * k + 1];
    var status = 0;
    var i = 0;
    while i < n && status == 0 {
        if pos + 4 > len(irs) {
            status = 3;
        } else {
            let rl = commit.be(irs, pos, 4);
            if pos + 4 + rl > len(irs) {
                status = 3;
            } else {
                region r {
                    let body = irs[pos + 4..pos + 4 + rl];
                    let shape = alloc_slice[r](rl + 8, byte_of(0));
                    let vals = alloc_slice[r](rl + 8, byte_of(0));
                    let info = alloc_slice[r](4, 0);
                    let salt = alloc_slice[r](16, byte_of(0));
                    let id = alloc_slice[r](32, byte_of(0));
                    let lifted = ir.lift(heap, body, shape, vals, info);
                    if lifted < 0 {
                        status = 5 - lifted;
                    } else {
                        if info[2] > 0 {
                            let rn = contents(core.rndi);
                            let rb = contents(core.rnd);
                            if rn[0] < 16 {
                                status = 2;
                            } else {
                                var j = 0;
                                while j < 16 {
                                    salt[j] = rb[rn[0] - 16 + j];
                                    rb[rn[0] - 16 + j] = byte_of(0);
                                    j = j + 1;
                                }
                                rn[0] = rn[0] - 16;
                            }
                        }
                        if status == 0 {
                            let np = build.stmt3(acc[base + shared.acc_irs_at()..base + shared.acc_effs_at()], irat, shape[0..info[0]], vals[0..info[1]], info[2], salt, id, erased);
                            if np < 0 {
                                status = 1;
                            } else {
                                irat = np;
                                build.put_bytes(acc[base..base + 2048], 32 * (ai[8 * k] + i), id);
                            }
                        }
                    }
                }
                pos = pos + 4 + rl;
            }
        }
        i = i + 1;
    }
    if status != 0 {
        return status;
    }
    build.put_bytes(acc[base + shared.acc_effs_at()..base + shared.acc_snap_at()], ai[8 * k + 2], effs);
    ai[8 * k] = ai[8 * k] + n;
    ai[8 * k + 1] = irat;
    ai[8 * k + 2] = ai[8 * k + 2] + len(effs);
    if wrote == 1 {
        ai[8 * k + 3] = 1;
    }
    if nondet == 1 {
        ai[8 * k + 6] = 1;
    }
    return 0;
}

// The first column of the first row of the last answer in `si`, read as a decimal number: -1 if there is none or it is not one.
pub fn first_number[&s](si: &s [byte]) -> [] int {
    var pos = 0;
    while pos + 5 <= len(si) {
        let ln = commit.be(si, pos + 1, 4);
        if ln < 4 {
            return 0 - 1;
        }
        if int_of(si[pos]) == 'D' && pos + 11 <= len(si) {
            let cl = commit.be(si, pos + 7, 4);
            var v = 0;
            var i = 0;
            if cl == 0 {
                return 0 - 1;
            }
            while i < cl && pos + 11 + i < len(si) {
                let c = int_of(si[pos + 11 + i]);
                if c < '0' || c > '9' {
                    return 0 - 1;
                }
                v = v * 10 + c - '0';
                i = i + 1;
            }
            return v;
        }
        if int_of(si[pos]) == 'Z' {
            return 0 - 1;
        }
        pos = pos + 1 + ln;
    }
    return 0 - 1;
}

// Where the first column of the first row of the last answer in `si` starts (its length is the four bytes before it), or -1 if there is no row or the value is null.
pub fn first_text_at[&s](si: &s [byte]) -> [] int {
    var pos = 0;
    while pos + 5 <= len(si) {
        let ln = commit.be(si, pos + 1, 4);
        if ln < 4 || int_of(si[pos]) == 'Z' {
            return 0 - 1;
        }
        if int_of(si[pos]) == 'D' && pos + 11 <= len(si) {
            let cl = commit.be(si, pos + 7, 4);
            if cl <= 0 || pos + 11 + cl > len(si) {
                return 0 - 1;
            }
            return pos + 11;
        }
        pos = pos + 1 + ln;
    }
    return 0 - 1;
}

// `prefix`, the commit's gid `cdb:` and 64 hex digits, and a closing quote, into `out`: its length.
fn gid_sql[&o, &p, &i](out: &!o [byte], prefix: &p [byte], ident: &i [byte]) -> [] int {
    var at = build.put_bytes(out, 0, prefix);
    at = build.put_bytes(out, at, "cdb:");
    return hex_sql(out, at, ident);
}

// The 32 bytes of `ident` as 64 hex digits and a closing quote, into `out` at `at`: the new position.
fn hex_sql[&o, &i](out: &!o [byte], start: int, ident: &i [byte]) -> [] int {
    var at = start;
    var j = 0;
    while j < 32 {
        let v = int_of(ident[j]);
        out[at] = byte_of(hex_digit(v / 16));
        out[at + 1] = byte_of(hex_digit(v % 16));
        at = at + 2;
        j = j + 1;
    }
    out[at] = byte_of('\'');
    return at + 1;
}

// The decimal digits of `n` (not negative) into `out` at `at`: the new position.
fn dec_sql[&o](out: &!o [byte], at: int, n: int) -> [] int {
    var digits = 1;
    var t = n;
    while t >= 10 {
        t = t / 10;
        digits = digits + 1;
    }
    var i = digits;
    var v = n;
    while i > 0 {
        out[at + i - 1] = byte_of('0' + v % 10);
        v = v / 10;
        i = i - 1;
    }
    return at + digits;
}

fn hex_digit(v: int) -> [] int {
    if v < 10 {
        return '0' + v;
    }
    return 'a' + v - 10;
}

// End client `k`'s transaction on its upstream connection: build the commit, make it durable, make it permanent. 0 if it is done (or there
// was nothing to record); 1 if PostgreSQL refused (nothing is in the log); 2 if the log could not be written (PostgreSQL is rolled back and
// nothing is in the log); -1 if the upstream was lost, or an upstream step after the log append failed (the log has the commit; the next
// start's recovery settles PostgreSQL, P2-D11) -- the caller closes the client's connection; 3 if the transaction changed more than one commit can record (the facts
// are too many for the answer to fit, docs/m2-branches.md D17: PostgreSQL is rolled back and nothing is in the log).
pub fn conclude[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int) -> [conn_read, conn_write, poll, file_write] int {
    let st = contents(core.state);
    let ai = contents(core.acci);
    let p = shared.stride() * k;
    let b = st[p + 1];
    let n = ai[8 * k];
    if n == 0 {
        let r = upstream_exec(tab, core, b, "COMMIT");
        reset(core, k);
        if r < 0 {
            return 0 - 1;
        }
        return r;
    }
    let wrote = ai[8 * k + 3] == 1;
    if contents(core.store.chain)[2] >= shared.ids_max() {
        // the recovery table is full: no further commit can be made safely (a restart refuses this log too)
        upstream_exec(tab, core, b, "ROLLBACK");
        reset(core, k);
        return 2;
    }
    // `now()` (P2-D9): the transaction's own, read inside it before anything is made durable, and recorded as one int value in `nondet`
    var nowv = 0 - 1;
    if ai[8 * k + 6] == 1 {
        let nr = upstream_exec(tab, core, b, "select (extract(epoch from now()) * 1000000)::bigint");
        if nr == 0 {
            nowv = first_number(contents(core.snapin));
        }
        if nowv < 0 {
            if nr >= 0 {
                upstream_exec(tab, core, b, "ROLLBACK");
            }
            reset(core, k);
            if nr < 0 {
                return 0 - 1;
            }
            return 1;
        }
    }
    var result = 0;
    region z {
        let nd = alloc_slice[z](9, byte_of(0));
        var nds = 0;
        if nowv >= 0 {
            nd[0] = byte_of(1);
            build.put_be(nd, 1, nowv, 8);
            nds = 1;
        }
        let enc = alloc_slice[z](8192, byte_of(0));
        let f = alloc_slice[z](128, byte_of(0));
        let ident = alloc_slice[z](32, byte_of(0));
        let sig = alloc_slice[z](64, byte_of(0));
        let tr = alloc_slice[z](shared.token_max() + 8, byte_of(0));
        let lr = alloc_slice[z](8300, byte_of(0));
        let q = alloc_slice[z](512, byte_of(0));
        let chg = alloc_slice[z](32, byte_of(0));
        let stt = alloc_slice[z](32, byte_of(0));
        let tk = contents(core.tokb)[k * shared.token_max()..k * shared.token_max() + st[p + 12]];
        let acc = contents(core.acc);
        let base = k * shared.acc_stride();
        // f: [0..32] the schema the transaction began with, [32..64] the token's id, [64..96] its principal, [96..128] zeros
        build.put_bytes(f, 0, acc[base + shared.acc_snap_at()..base + shared.acc_snap_at() + 32]);
        token.prefix_id(tk, token.blocks(tk), f[32..64]);
        token.principal_of(tk, f[64..96]);
        // the connection's branch (state slot 23, set at login): its name, where its chain ends, and its tip
        let bx = st[p + 23];
        let chain = contents(core.store.chain);
        let names = contents(core.store.names);
        var branch = names[bx * store.branch_name_max()..bx * store.branch_name_max() + chain[4 + 3 * bx]];
        var seqno = chain[4 + 3 * bx + 1];
        let tip = contents(core.store.tip)[64 * bx..64 * bx + 64];
        // a fork (docs/m2-branches.md D24): the commit is the first of the NEW branch, whose parent is the source's tip; `fk` is what `forkpath.start` noted
        let forking = st[p + 24] == 1;
        let fk = contents(core.fkn)[k * shared.fork_rec()..k * shared.fork_rec() + shared.fork_rec()];
        if forking {
            branch = fk[34..34 + int_of(fk[33])];
            seqno = 0;
        }
        var parents = f[96..96];
        var np = 0;
        if chain[4 + 3 * bx + 2] == 1 {
            parents = tip[0..32];
            np = 1;
        }
        // a merge (docs/m2-branches.md D37): two parents, the target's tip and the source's, and the state over both of their states; `mp` holds the two ids and `ms` the two states
        let merging = st[p + 24] == 2;
        let mp = alloc_slice[z](64, byte_of(0));
        let ms = alloc_slice[z](64, byte_of(0));
        let src = int_of(fk[113]);
        if merging {
            var q4 = 0;
            while q4 < 32 {
                mp[q4] = contents(core.store.tip)[64 * bx + q4];
                mp[32 + q4] = contents(core.store.tip)[64 * src + q4];
                ms[q4] = contents(core.store.tip)[64 * bx + 32 + q4];
                ms[32 + q4] = contents(core.store.tip)[64 * src + 32 + q4];
                q4 = q4 + 1;
            }
            parents = mp[0..64];
            np = 2;
        }
        // `changes` (docs/m2-branches.md D16): a read has the empty one; a transaction that wrote asks the database, inside the transaction, for its NET facts and the
        // Merkle root of them is `changes`. 0 if all went well; 1 PostgreSQL refused or the text is not facts; 3 too many facts; -1 the upstream was lost.
        var fcode = 0;
        if forking {
            // the copy was made after the source's tip that was noted: if another commit has been made on the source since, the copy and the parent no longer agree
            var moved = chain[4 + 3 * bx + 2] != int_of(fk[32]);
            var q2 = 0;
            while q2 < 32 && chain[4 + 3 * bx + 2] == 1 {
                if tip[q2] != fk[q2] {
                    moved = true;
                }
                q2 = q2 + 1;
            }
            if moved {
                fcode = 4;
            } else if shared.branch_taken(core, branch) != 0 {
                fcode = 5;
            }
            if fcode != 0 {
                upstream_exec(tab, core, b, "ROLLBACK");
            }
        }
        if merging {
            // the merge was decided on the two tips that were noted: a commit on either branch since makes it a merge of something else
            var moved = chain[4 + 3 * bx + 2] != int_of(fk[32]) || chain[4 + 3 * src + 2] != int_of(fk[112]);
            var q5 = 0;
            while q5 < 32 {
                if mp[q5] != fk[q5] || mp[32 + q5] != fk[80 + q5] {
                    moved = true;
                }
                q5 = q5 + 1;
            }
            if moved {
                fcode = 6;
                upstream_exec(tab, core, b, "ROLLBACK");
            }
        }
        state.changes(0, f[96..128], chg);
        if wrote && fcode == 0 {
            let fr = upstream_exec(tab, core, b, "select case when length(f) > 200000 then '!' else f end from (select cdb.facts(txid_current()) as f) s");
            if fr < 0 {
                fcode = 0 - 1;
            } else if fr != 0 {
                fcode = 1;
            } else {
                let si = contents(core.snapin);
                let at = first_text_at(si);
                if at >= 0 {
                    let tl = commit.be(si, at - 4, 4);
                    if tl == 1 && int_of(si[at]) == '!' {
                        fcode = 3;
                    } else {
                        let rc = state.changes_of(si, at, at + tl, contents(core.fw), contents(core.fm), contents(core.fe), contents(core.fl), chg);
                        if rc != 0 {
                            fcode = 1;
                        }
                    }
                }
            }
        }
        // `state`: the parent's, if there is one, and these changes
        if merging {
            state.state(2, ms[0..64], chg, stt);
        } else {
            state.state(np, tip[32..32 + 32 * np], chg, stt);
        }
        var elen = 0 - 1;
        if fcode == 0 {
            elen = build.encode(enc, parents, branch, seqno, f[0..32], acc[base..base + 32 * n], acc[base + shared.acc_effs_at()..base + shared.acc_effs_at() + ai[8 * k + 2]], f[32..64], f[64..96], f[96..96], nds, nd[0..9 * nds], chg, stt, 0, f[96..96], contents(core.aux)[1]);
        }
        if fcode != 0 {
            if fcode > 0 && fcode < 4 {
                upstream_exec(tab, core, b, "ROLLBACK");
            }
            result = fcode;
        } else if elen < 0 {
            result = 2;
        } else {
            build.id(enc[0..elen], ident);
            build.sign_with_public(contents(core.store.seed)[0..32], contents(core.store.seed)[32..64], ident, sig);
            var tl = 0;
            if ai[8 * k + 4] == 0 {
                tl = build.store_record(tr, 0, tk);
            }
            let ll = build.log_record(lr, 0, enc[0..elen], sig);
            var step = 0;
            if wrote {
                // the delta rows of this transaction (even those whose net effect is nothing, so that none is left without a commit) take the commit's id, inside the transaction
                // that is about to be prepared: they live or die with the data
                // and the commit's place in the log is noted, for `AS OF` (docs/m2-branches.md D30): its id, the schema of its branch and its index in the log, one statement
                var at = build.put_bytes(q, 0, "with m as (insert into cdb.mark(commit_id, sch, ord) values ('\\x");
                at = hex_sql(q, at, ident);
                at = build.put_bytes(q, at - 1, "'::bytea, '");
                if forking || bx > 0 {
                    at = build.put_bytes(q, at, "cdb_b_");
                    at = build.put_bytes(q, at, branch);
                } else {
                    at = build.put_bytes(q, at, "public");
                }
                at = build.put_bytes(q, at, "', ");
                at = dec_sql(q, at, chain[2]);
                at = build.put_bytes(q, at, ")) update cdb.delta set commit_id = '\\x");
                at = hex_sql(q, at, ident);
                at = build.put_bytes(q, at - 1, "'::bytea, ord = ");
                at = dec_sql(q, at, chain[2]);
                let dn = build.put_bytes(q, at, " where xid = txid_current()");
                step = upstream_exec(tab, core, b, q[0..dn]);
            }
            if step == 0 && wrote {
                step = upstream_exec(tab, core, b, q[0..gid_sql(q, "PREPARE TRANSACTION '", ident)]);
            }
            if step < 0 {
                result = 0 - 1;
            } else if step == 1 {
                result = 1;
            } else {
                let ar = shared.store_append(core.store, tr[0..tl], acc[base + shared.acc_irs_at()..base + shared.acc_irs_at() + ai[8 * k + 1]], lr[0..ll]);
                if ar != 0 {
                    if wrote {
                        upstream_exec(tab, core, b, q[0..gid_sql(q, "ROLLBACK PREPARED '", ident)]);
                    } else {
                        upstream_exec(tab, core, b, "ROLLBACK");
                    }
                    result = 2;
                } else {
                    // the commit is in the log: the chain moves on whatever PostgreSQL now says
                    var j = 0;
                    var nb = bx;
                    if forking {
                        // the new branch enters the table now that its first commit is in the log
                        nb = chain[0];
                        var q3 = 0;
                        while q3 < len(branch) {
                            names[nb * store.branch_name_max() + q3] = branch[q3];
                            q3 = q3 + 1;
                        }
                        chain[4 + 3 * nb] = len(branch);
                        chain[0] = chain[0] + 1;
                    }
                    let ntip = contents(core.store.tip)[64 * nb..64 * nb + 64];
                    while j < 32 {
                        ntip[j] = ident[j];
                        ntip[32 + j] = stt[j];
                        j = j + 1;
                    }
                    build.put_bytes(contents(core.store.ids), 32 * chain[2], ident);
                    // the commit graph: its branch, its parents' indices (a fork's is the source's tip, a merge's two tips), and the branch's last commit is this one
                    let gi = chain[2];
                    let txs = contents(core.store.tx);
                    contents(core.store.cbr)[gi] = byte_of(nb);
                    var gp0 = 0 - 1;
                    if forking || chain[4 + 3 * bx + 2] == 1 {
                        gp0 = txs[bx];
                    }
                    contents(core.store.cg)[2 * gi] = gp0;
                    var gp1 = 0 - 1;
                    if merging {
                        gp1 = txs[src];
                    }
                    contents(core.store.cg)[2 * gi + 1] = gp1;
                    txs[nb] = gi;
                    chain[2] = chain[2] + 1;
                    chain[4 + 3 * nb + 1] = chain[4 + 3 * nb + 1] + 1;
                    chain[4 + 3 * nb + 2] = 1;
                    ai[8 * k + 4] = 1;
                    var fin = 0;
                    if wrote {
                        fin = upstream_exec(tab, core, b, q[0..gid_sql(q, "COMMIT PREPARED '", ident)]);
                    } else {
                        fin = upstream_exec(tab, core, b, "COMMIT");
                    }
                    if fin != 0 {
                        result = 0 - 1;
                    }
                }
            }
        }
    }
    reset(core, k);
    return result;
}
