edition 9;
module cdb.asof;

// `AS OF` on its way to PostgreSQL (docs/m2-branches.md D31). The guard's rendering keeps the clause as the statement had it: `"orders" as of '<64 hex digits>' [as "x"]`. PostgreSQL does not know it; this turns each
// into the table as it was, `cdb.asof(null::"orders", cdb.ord('<64 hex digits>')) as "x"` (the alias is the table's name if the statement gave none). Text inside a string literal or a quoted name is left alone,
// so that what a client wrote in a constant is never changed.

// Whether `text` is in `s` at `at`.
fn is_at[&s, &t](s: &s [byte], at: int, text: &t [byte]) -> [] bool {
    if at + len(text) > len(s) {
        return false;
    }
    var i = 0;
    while i < len(text) {
        if s[at + i] != text[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn put[&o, &t](out: &!o [byte], at: int, text: &t [byte]) -> [] int {
    if at < 0 || at + len(text) > len(out) {
        return 0 - 1;
    }
    var i = 0;
    while i < len(text) {
        out[at + i] = text[i];
        i = i + 1;
    }
    return at + len(text);
}

fn put_slice[&o, &s](out: &!o [byte], at: int, from: &s [byte]) -> [] int {
    return put(out, at, from);
}

// Rewrite the `n` bytes of rendering at the start of `out`: the new length, or -1 if the result does not fit.
pub fn rewrite[&h, &o](heap: &!h Heap, out: &!o [byte], n: int) -> [heap] int {
    var tmp = box_slice(heap, len(out), byte_of(0));
    var result = n;
    borrow mut tmp as &!tw in {
        let t = contents(tw);
        var at = 0;
        var i = 0;
        var mode = 0;
        // where the last quoted name began in `t`, and where it ended in `out`
        var id_start = 0 - 1;
        var id_end = 0 - 1;
        var changed = false;
        while i < n && at >= 0 {
            let c = int_of(out[i]);
            if mode == 1 {
                // inside a string literal: a quote ends it, unless it is doubled
                at = put_slice(t, at, out[i..i + 1]);
                if c == '\'' {
                    if i + 1 < n && int_of(out[i + 1]) == '\'' {
                        at = put_slice(t, at, out[i + 1..i + 2]);
                        i = i + 1;
                    } else {
                        mode = 0;
                    }
                }
                i = i + 1;
            } else if mode == 2 {
                at = put_slice(t, at, out[i..i + 1]);
                if c == '"' {
                    if i + 1 < n && int_of(out[i + 1]) == '"' {
                        at = put_slice(t, at, out[i + 1..i + 2]);
                        i = i + 1;
                    } else {
                        mode = 0;
                        id_end = i + 1;
                    }
                }
                i = i + 1;
            } else if c == '\'' {
                mode = 1;
                at = put_slice(t, at, out[i..i + 1]);
                i = i + 1;
            } else if c == '"' {
                mode = 2;
                id_start = at;
                at = put_slice(t, at, out[i..i + 1]);
                i = i + 1;
            } else if id_end == i && is_at(out[0..n], i, " as of '") && i + 8 + 65 <= n && int_of(out[i + 8 + 64]) == '\'' {
                // the quoted name just before is the table: it becomes the argument of the function
                let name = t[id_start..at];
                var nm = box_slice(heap, len(name) + 1, byte_of(0));
                borrow mut nm as &!nw in {
                    var q = 0;
                    while q < len(name) {
                        contents(nw)[q] = name[q];
                        q = q + 1;
                    }
                    at = put(t, id_start, "cdb.asof(null::");
                    at = put_slice(t, at, contents(nw)[0..len(name)]);
                    at = put(t, at, ", cdb.ord('");
                    at = put_slice(t, at, out[i + 8..i + 8 + 64]);
                    at = put(t, at, "'))");
                    i = i + 8 + 65;
                    if !is_at(out[0..n], i, " as \"") {
                        at = put(t, at, " as ");
                        at = put_slice(t, at, contents(nw)[0..len(name)]);
                    }
                }
                unbox_slice(heap, nm);
                changed = true;
                id_end = 0 - 1;
            } else {
                at = put_slice(t, at, out[i..i + 1]);
                i = i + 1;
            }
        }
        if at < 0 {
            result = 0 - 1;
        } else if changed {
            var j = 0;
            while j < at {
                out[j] = t[j];
                j = j + 1;
            }
            result = at;
        }
    }
    unbox_slice(heap, tmp);
    return result;
}
