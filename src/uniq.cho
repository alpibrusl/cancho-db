edition 9;
module cdb.uniq;

// SPDX-License-Identifier: EUPL-1.2
// Copyright (c) 2026 Alpibru S.L.
// Unique indexes (docs/m3-engine.md 6bo, slice 3): a row may not be written while another row has the same values in the columns of one. What an INSERT and
// an UPDATE ask before they write a row; the looking up is `index.holder`.
import cdb.commit;
import cdb.btree;
import cdb.tables;
import cdb.pager;
import cdb.index;
import cdb.exec;

// Whether the table last bound has a unique index.
pub fn any[&q](w: &q exec.Work) -> [] bool {
    var i = 0;
    while i < w.nix {
        if index.unique(contents(w.ix), i * index.rec()) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Before a new row `r` is stored at the key `k[0..kn]`: 1 if a row of the tree `tree` has its values in a unique index, 0 if none has, or a refusal.
pub fn taken[&q, &z, &r, &k](p: &!z pager.Pager, w: &!q exec.Work, tree: int, r: &r [byte], k: &k [byte], kn: int) -> [file_read] int {
    let dl = w.dlen;
    var i = 0;
    while i < w.nix {
        let at = i * index.rec();
        if index.unique(contents(w.ix), at) {
            let h = index.holder(p, contents(w.sc), tree, w.tid, contents(w.ix), at, contents(w.ctx)[64..64 + dl], r, k[4..kn], contents(w.ixa), contents(w.ixb), contents(w.ua), contents(w.ub), contents(w.uv));
            if h < 0 {
                return exec.tree_err(h);
            }
            if h > 0 {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// Before an UPDATE writes the row at the key `k[0..kn]`, which was `old` and becomes `new`. `root` is the tree before the statement, `nroot` the tree it has
// made so far, `seen` a tree of the rows remembered as holding a value another row takes (0: none yet). PostgreSQL checks each row as it writes it, in an
// order the engine does not know, so only what no order changes is answered:
//   - the new value is held now by another row: that row is remembered. If it is read later and gives the value up, the outcome depends on the order
//     (`w.orderdep`); if it is still remembered when the statement ends it kept the value, or took it in this statement, and the caller notes the error;
//   - the new value was held before the statement by a row that has since given it up: order-dependent.
// The tree of the remembered, or a refusal.
pub fn changed[&q, &z, &o, &n, &k](p: &!z pager.Pager, w: &!q exec.Work, root: int, nroot: int, seen: int, old: &o [byte], new: &n [byte], k: &k [byte], kn: int) -> [file_read, file_write] int {
    let dl = w.dlen;
    var out = seen;
    var moved = false;
    var i = 0;
    while i < w.nix {
        let at = i * index.rec();
        if index.unique(contents(w.ix), at) {
            let eo = index.entry(contents(w.ix), at, contents(w.ctx)[64..64 + dl], old, k[4..kn], contents(w.ixa));
            let en = index.entry(contents(w.ix), at, contents(w.ctx)[64..64 + dl], new, k[4..kn], contents(w.ixb));
            if eo < 0 || en < 0 {
                return exec.too_big();
            }
            if !index.stays(contents(w.ix), at, contents(w.ctx)[64..64 + dl], old, new, eo, en) {
                moved = true;
                let h = index.holder(p, contents(w.sc), nroot, w.tid, contents(w.ix), at, contents(w.ctx)[64..64 + dl], new, k[4..kn], contents(w.ixa), contents(w.ixb), contents(w.ua), contents(w.ub), contents(w.uv));
                if h < 0 {
                    return exec.tree_err(h);
                }
                if h > 0 {
                    contents(w.ua)[0] = byte_of('u');
                    exec.copy(contents(w.ub), 4, h, contents(w.ua), 1);
                    let s = btree.put(p, contents(w.sc), out, contents(w.ua)[0..1 + h], contents(w.ua)[0..1]);
                    if s < 0 {
                        return exec.tree_err(s);
                    }
                    out = s;
                } else {
                    let h0 = index.holder(p, contents(w.sc), root, w.tid, contents(w.ix), at, contents(w.ctx)[64..64 + dl], new, k[4..kn], contents(w.ixa), contents(w.ixb), contents(w.ua), contents(w.ub), contents(w.uv));
                    if h0 < 0 {
                        return exec.tree_err(h0);
                    }
                    if h0 > 0 {
                        w.orderdep = true;
                    }
                }
            }
        }
        i = i + 1;
    }
    if moved && out != 0 {
        // this row gives up a value: was it remembered as the holder of one another row takes?
        contents(w.ua)[0] = byte_of('u');
        exec.copy(k, 4, kn - 4, contents(w.ua), 1);
        let g = btree.get(p, contents(w.sc), out, contents(w.ua)[0..1 + kn - 4], contents(w.uv));
        if g >= 0 {
            w.orderdep = true;
        } else if g != btree.not_found() {
            return exec.tree_err(g);
        }
    }
    return out;
}

// After CREATE TABLE has made the table `name`, whose entry (`nc` columns) is in `ent` and whose columns written UNIQUE are listed in `ua` (how many, then their
// numbers): a unique index `<table>_<column>_key` on each, marked as a constraint's, in the tree `root`. The new root; or a refusal, when a name is taken (PostgreSQL
// tries another) or longer than a name may be (PostgreSQL cuts it).
pub fn constraints[&q, &z, &n](p: &!z pager.Pager, w: &!q exec.Work, root: int, name: &n [byte], nc: int) -> [file_read, file_write] int {
    var out = root;
    let nu = int_of(contents(w.ua)[0]);
    var u = 0;
    while u < nu && out >= 0 {
        let col = int_of(contents(w.ua)[1 + u]);
        // the column's name in the entry (its columns from 8: a type, a place in the key, a length, the name)
        var oa = 8;
        var c = 0;
        while c < col && c < nc {
            oa = oa + 4 + commit.be(contents(w.ent), oa + 2, 2);
            c = c + 1;
        }
        let cl = commit.be(contents(w.ent), oa + 2, 2);
        var nl = exec.copy(name, 0, len(name), contents(w.nrow), 0);
        contents(w.nrow)[nl] = byte_of('_');
        nl = exec.copy(contents(w.ent), oa + 4, cl, contents(w.nrow), nl + 1);
        contents(w.nrow)[nl] = byte_of('_');
        contents(w.nrow)[nl + 1] = byte_of('k');
        contents(w.nrow)[nl + 2] = byte_of('e');
        contents(w.nrow)[nl + 3] = byte_of('y');
        nl = nl + 4;
        if nl > 63 {
            return exec.unsupported();
        }
        // the name is free: no index has it, no table, no sequence
        let kl = tables.index_key(contents(w.nrow)[0..nl], contents(w.key2));
        let g = btree.get(p, contents(w.sc), out, contents(w.key2)[0..kl], contents(w.uv));
        let gt = tables.find(p, contents(w.sc), out, contents(w.nrow)[0..nl], contents(w.key), contents(w.uv));
        let ql = tables.sequence_key(contents(w.nrow)[0..nl], contents(w.key));
        let gq = btree.get(p, contents(w.sc), out, contents(w.key)[0..ql], contents(w.uv));
        if g >= 0 || gt >= 0 || gq >= 0 {
            return exec.unsupported();
        }
        if g != btree.not_found() || gt != btree.not_found() || gq != btree.not_found() {
            return exec.damaged();
        }
        var vl = 0;
        region r {
            let idn = alloc_slice[r](1, 0);
            out = index.number(p, contents(w.sc), out, contents(w.key), idn);
            if out >= 0 {
                contents(w.ub)[0] = byte_of(col);
                // (flags: 2 a unique index, 4 a constraint's)
                vl = index.value(name, idn[0], 6, 0, contents(w.ub), 1, contents(w.uv));
            }
        }
        if out < 0 {
            return exec.tree_err(out);
        }
        out = exec.put_key(p, w, out, contents(w.key2), kl, contents(w.uv)[0..vl]);
        u = u + 1;
    }
    return out;
}
