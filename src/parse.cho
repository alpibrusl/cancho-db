// The ways a parse is refused: `expr` answers `0 - code`, and `st[3]` is the token index it stopped at.
pub fn e_syntax() -> [] int {
    return 1;
}

pub fn e_unknown_construct() -> [] int {
    return 2;
}

pub fn e_unsupported_operator() -> [] int {
    return 3;
