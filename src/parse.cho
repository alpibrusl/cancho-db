    return 14;
}

pub fn error_name(code: int) -> [] &static [byte] {
    if code == 1 {
        return "syntax";
    }
    if code == 2 {
        return "unknown-construct";
    }
    if code == 3 {
        return "unsupported-operator";
    }
    if code == 4 {
        return "reserved-word";
    }
    if code == 5 {
        return "unknown-type";
    }
    if code == 6 {
        return "nested-too-deep";
    }
    if code == 7 {
        return "too-big";
    }
    if code == 9 {
        return "set-operation";
    }
    if code == 10 {
        return "unsupported-join";
    }
    if code == 11 {
        return "unsupported-statement";
    }
    if code == 12 {
        return "insert-select";
    }
    if code == 13 {
        return "returning";
    }
    if code == 14 {
        return "on-conflict";
    }
    return "subquery";
}

// Indices into the state slice `st` (at least 10 ints, the first four zeroed by `reset`): the next free node, the kids used,
// the root of the last parse, the token a refusal stopped at, then the two stack heights and scratch for a parsed type.
fn s_nodes() -> [] int {
    return 0;
}

fn s_kids() -> [] int {
    return 1;
}

pub fn s_root() -> [] int {
    return 2;
}

pub fn s_errpos() -> [] int {
    return 3;
}

fn s_vtop() -> [] int {
    return 4;
}

fn s_otop() -> [] int {
    return 5;
}

fn s_type() -> [] int {
    return 6;
}

fn s_mod1() -> [] int {
    return 7;
}

fn s_mod2() -> [] int {
    return 8;
}

// Starts a fresh tree: node 0 is reserved, so a node id of 0 means none.
pub fn reset[&x](st: &!x [int]) -> [] int {
    st[0] = 1;
    st[1] = 0;
    st[2] = 0;
    st[3] = 0;
    st[4] = 0;
    st[5] = 0;
    st[6] = 0;
    st[7] = 0;
    st[8] = 0;
    st[9] = 0;
    return 0;
}

