edition 9;
module cdb.facts;

import cdb.commit;
import cdb.build;
import cdb.tables;
import cdb.btree;
import cdb.pager;
import cdb.state;
import cdb.exec;
import cdb.ir;
import cdb.row;
import std.map;

// The facts of a transaction (docs/m3-engine.md 6af). Fold the changes the statement just made (`chg`) into the tree `froot` (0: none yet): a key is the table, a zero byte and the
// plain key; a value is 66 bytes, for each of "when the transaction first touched the row" and "now" a byte (1: there is an image) and the hash of the image. The new root, or an error
// (`exec.too_big()` for a key the tree does not hold).
pub fn take[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, froot: int) -> [file_read, file_write] int {
    var root = froot;
    var at = 0;
    var c = 0;
    while c < w.nchg {
        let nl = commit.be(contents(w.chg), at, 2);
        let kl = commit.be(contents(w.chg), at + 2 + nl, 2);
        // the key of the fact is the table, a zero byte and the commitment to the row's key; the hashes are over each image and its salt (6ag). A record of `chg`: the table, the
        // plain key, the two images (a length of all ones: none), the key's salt, and each row salt after a byte that says whether it is there
        let ka = at + 4 + nl;
        var ia = ka + kl;
        // where each image is, and how long (below 0: none)
        var im0 = 0;
        var im1 = 0;
        var il0 = 0 - 1;
        var il1 = 0 - 1;
        var side = 0;
        while side < 2 {
            let il = commit.be(contents(w.chg), ia, 4);
            ia = ia + 4;
            if side == 0 {
                im0 = ia;
            } else {
                im1 = ia;
            }
            if il != 4294967295 {
                if side == 0 {
                    il0 = il;
                } else {
                    il1 = il;
                }
                ia = ia + il;
            }
            side = side + 1;
        }
        var fk = exec.copy(contents(w.chg), at + 2, nl, contents(w.key), 0);
        contents(w.key)[fk] = byte_of(0);
        state.key_commit(contents(w.chg)[ia..ia + 16], contents(w.chg)[ka..ka + kl], contents(w.key)[fk + 1..fk + 33]);
        fk = fk + 33;
        side = 0;
        while side < 2 {
            let o = 33 * side;
            let sa = ia + 16 + 17 * side;
            var il = il0;
            var im = im0;
            if side == 1 {
                il = il1;
                im = im1;
            }
            if il < 0 || int_of(contents(w.chg)[sa]) != 1 {
                contents(w.uval)[o] = byte_of(0);
                var z = 0;
                while z < 32 {
                    contents(w.uval)[o + 1 + z] = byte_of(0);
                    z = z + 1;
                }
            } else {
                contents(w.uval)[o] = byte_of(1);
                state.row_hash2(contents(w.chg)[sa + 1..sa + 17], contents(w.chg)[im..im + il], contents(w.uval)[o + 1..o + 33]);
            }
            side = side + 1;
        }
        at = ia + 50;
        let g = btree.get(p, contents(w.sc), root, contents(w.key)[0..fk], contents(w.cur));
        if g == 66 {
            // touched before in this transaction: what it was then stays
            exec.copy(contents(w.cur), 0, 33, contents(w.uval), 0);
        } else if g != btree.not_found() {
            return exec.damaged();
        }
        var nw = 0;
        if int_of(contents(w.uval)[0]) == 0 && int_of(contents(w.uval)[33]) == 0 {
            // made and removed in the transaction: no fact
            nw = root;
            if g == 66 {
                nw = btree.del(p, contents(w.sc), root, contents(w.key)[0..fk]);
            }
        } else {
            nw = btree.put(p, contents(w.sc), root, contents(w.key)[0..fk], contents(w.uval)[0..66]);
        }
        if nw < 0 {
            return exec.tree_err(nw);
        }
        root = nw;
        c = c + 1;
    }
    return root;
}

// `changes` (docs/spec/state.md section 3) of the facts in the tree `froot`, into the 32 bytes of `out`: how many facts, or an error.
pub fn changes[&q, &z, &o](p: &!z pager.Pager, w: &!q exec.Work, froot: int, out: &!o [byte]) -> [file_read] int {
    var n = 0;
    var kl = 0;
    var more = froot != 0;
    while more {
        let r = btree.next_after(p, contents(w.sc), froot, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return exec.tree_err(r);
        } else {
            let nk = r / 1024;
            kl = exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
            var z = 0;
            while z < nk && int_of(contents(w.key2)[z]) != 0 {
                z = z + 1;
            }
            if int_of(contents(w.key2)[0]) <= 3 {
                // what the transaction's statements were (`say`): no fact
            } else {
                if r % 1024 != 66 || n >= 4096 {
                    return exec.too_big();
                }
                let was = int_of(contents(w.cur)[0]) == 1;
                let is = int_of(contents(w.cur)[33]) == 1;
                // (a row that ends as it began would be no fact; with a new salt for every change, 6ag, none does: its two hashes differ)
                var kind = 1;
                var ol = 32;
                var nl = 32;
                if !was {
                    kind = 0;
                    ol = 0;
                } else if !is {
                    kind = 2;
                    nl = 0;
                }
                let el = state.put_fact(contents(w.nrow), 0, kind, contents(w.key2)[0..z], contents(w.key2)[z + 1..nk], contents(w.cur)[1..1 + ol], contents(w.cur)[34..34 + nl]);
                if el < 0 {
                    return exec.unsupported();
                }
                state.leaf(contents(w.nrow)[0..el], contents(w.tmp)[32 * n..32 * n + 32]);
                n = n + 1;
            }
        }
    }
    state.merkle(contents(w.tmp)[0..32 * n], n, contents(w.uval)[0..32]);
    state.changes(n, contents(w.uval)[0..32], out);
    return n;
}

// The longest record `seal` writes: a commit of `build.max_effects()` is not made here, one of 32 tables is.
pub fn max_record() -> [] int {
    return 25000;
}

// How many statements one commit names here: a transaction of more is refused when it commits (6au).
pub fn max_statements() -> [] int {
    return 500;
}

// The commit a transaction is (docs/m3-engine.md 6ah). `root` is the branch's tree with the transaction in it and `froot` its facts (`take`). The record of the commit as the log
// holds it (`build.log_record`: its length is 4, the encoding's length that its first four bytes say, and 64) is written to `out`, and the tree's head of the log is moved to it: the
// new root, or an error. The commit's parent is the head the tree had (none: the first commit of the log, number 0), its `changes` are the facts', its `state` follows from the
// parent's, its effects are one write for each table that has a fact, and it is signed with the key `seed` is the seed of.
pub fn seal[&q, &z, &s, &y, &m, &o](p: &!z pager.Pager, w: &!q exec.Work, root: int, froot: int, seed: &s [byte], who: &y [byte], schema: &m [byte], out: &!o [byte]) -> [file_read, file_write] int {
    var nw = 0 - 1;
    region g {
        let chg = alloc_slice[g](32, byte_of(0));
        let head = alloc_slice[g](72, byte_of(0));
        let zero = alloc_slice[g](32, byte_of(0));
        // the hash of the schema the transaction began with (6bc), if the caller has it; zeros if not
        let sch = alloc_slice[g](32, byte_of(0));
        if len(schema) == 32 {
            exec.copy(schema, 0, 32, sch, 0);
        }
        let effs = alloc_slice[g](8192, byte_of(0));
        let ids = alloc_slice[g](32 * max_statements(), byte_of(0));
        let enc = alloc_slice[g](24000, byte_of(0));
        let sig = alloc_slice[g](64, byte_of(0));
        let st = alloc_slice[g](32, byte_of(0));
        let n = changes(p, w, froot, chg);
        if n < 0 {
            return n;
        }
        // the head the tree has
        var seq = 0;
        var np = 0;
        let hk = tables.head_key(contents(w.key));
        let hr = btree.get(p, contents(w.sc), root, contents(w.key)[0..hk], contents(w.cur));
        if hr == 72 {
            seq = commit.be(contents(w.cur), 0, 8) + 1;
            np = 1;
            exec.copy(contents(w.cur), 0, 72, head, 0);
        } else if hr != btree.not_found() {
            if hr < 0 {
                return exec.tree_err(hr);
            }
            return exec.damaged();
        }
        // its effects are those of its statements, as `say` inferred them (6au): the keys under 0x02, a kind and a target each
        var el = 0;
        var kl = 1;
        contents(w.key)[0] = byte_of(2);
        var more = froot != 0;
        while more {
            let r = btree.next_after(p, contents(w.sc), froot, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
            if r == btree.not_found() || r >= 0 && int_of(contents(w.key2)[0]) != 2 {
                more = false;
            } else if r < 0 {
                return exec.tree_err(r);
            } else {
                let nk = r / 1024;
                if nk < 2 || el + 1 + nk > len(effs) {
                    return exec.too_big();
                }
                effs[el] = contents(w.key2)[1];
                build.put_be(effs, el + 1, nk - 2, 2);
                el = exec.copy(contents(w.key2), 2, nk - 2, effs, el + 3);
                kl = exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
            }
        }
        // and its statements, in the order they ran: the keys under 0x01, a number and a part; part 0 is the statement's id
        var il = 0;
        kl = 1;
        contents(w.key)[0] = byte_of(1);
        more = froot != 0;
        while more {
            let r = btree.next_after(p, contents(w.sc), froot, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
            if r == btree.not_found() || r >= 0 && int_of(contents(w.key2)[0]) != 1 {
                more = false;
            } else if r < 0 {
                return exec.tree_err(r);
            } else {
                let nk = r / 1024;
                if nk != 6 {
                    return exec.damaged();
                }
                if int_of(contents(w.key2)[5]) == 0 {
                    if r % 1024 != 32 || il + 32 > len(ids) {
                        // more statements in one transaction than a commit names here
                        return exec.too_big();
                    }
                    il = exec.copy(contents(w.cur), 0, 32, ids, il);
                }
                kl = exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
            }
        }
        state.state(np, head[40..40 + 32 * np], chg, st);
        // who and when (6at): the id of the token the commit was made under, its principal and the time, if the caller has them; zeros and 0 if not
        var en = 0;
        if len(who) >= who_fixed() {
            en = build.encode(enc, head[8..8 + 32 * np], "main", seq, sch, ids[0..il], effs[0..el], who[0..32], who[32..64], zero[0..0], 0, zero[0..0], chg, st, 0, zero[0..0], commit.be(who, 64, 8));
        } else {
            en = build.encode(enc, head[8..8 + 32 * np], "main", seq, sch, ids[0..il], effs[0..el], zero, zero, zero[0..0], 0, zero[0..0], chg, st, 0, zero[0..0], 0);
        }
        if en < 0 || 4 + en + 64 > len(out) {
            return exec.too_big();
        }
        build.put_be(head, 0, seq, 8);
        build.id(enc[0..en], head[8..40]);
        build.sign(seed, head[8..40], sig);
        build.log_record(out, 0, enc[0..en], sig);
        exec.copy(st, 0, 32, head, 40);
        let hk2 = tables.head_key(contents(w.key));
        nw = btree.put(p, contents(w.sc), root, contents(w.key)[0..hk2], head);
        if nw < 0 {
            return exec.tree_err(nw);
        }
        // which of the tree's transactions this commit is, under its id: what `AS OF` the commit reads the tree as of (6be)
        let txn = exec.last_txn(p, w, nw);
        if txn < 0 {
            return txn;
        }
        build.put_be(sig, 0, txn, 8);
        let ak = tables.asof_key(head[8..40], contents(w.key));
        nw = btree.put(p, contents(w.sc), nw, contents(w.key)[0..ak], sig[0..8]);
        if nw < 0 {
            return exec.tree_err(nw);
        }
        // the log is in the tree (6as). One key signs it: the first commit's, kept, and a commit signed with another is not made
        build.public_key(seed, sig[0..32]);
        let lk = tables.log_key(contents(w.key));
        let lr = btree.get(p, contents(w.sc), nw, contents(w.key)[0..lk], contents(w.cur));
        if lr == btree.not_found() {
            nw = btree.put(p, contents(w.sc), nw, contents(w.key)[0..lk], sig[0..32]);
            if nw < 0 {
                return exec.tree_err(nw);
            }
        } else if lr != 32 || !exec.same(contents(w.cur), 0, 32, sig, 0, 32) {
            return exec.unsupported();
        }
        // the token, under its id, the first time a commit is made under it: a verifier is given the tokens with the log (6at)
        // (writing it again would write the same bytes: that it is written once is a saving, and no test can tell)
        if len(who) > who_fixed() {
            let tk0 = tables.kept_key(7, who[0..32], 0, contents(w.key));
            let tr = btree.get(p, contents(w.sc), nw, contents(w.key)[0..tk0], contents(w.cur));
            if tr == btree.not_found() {
                var ta = who_fixed();
                var tpart = 0;
                while ta < len(who) {
                    var tl = len(who) - ta;
                    if tl > 700 {
                        tl = 700;
                    }
                    if tpart >= 255 {
                        return exec.too_big();
                    }
                    let tk1 = tables.kept_key(7, who[0..32], tpart, contents(w.key));
                    nw = btree.put(p, contents(w.sc), nw, contents(w.key)[0..tk1], who[ta..ta + tl]);
                    if nw < 0 {
                        return exec.tree_err(nw);
                    }
                    ta = ta + tl;
                    tpart = tpart + 1;
                }
            } else if tr < 0 {
                return exec.tree_err(tr);
            }
        }
        // the record, in parts a value of the tree holds
        let rn = 4 + en + 64;
        var ra = 0;
        var part = 0;
        while ra < rn {
            var pl = rn - ra;
            if pl > 700 {
                pl = 700;
            }
            let rk = tables.record_key(seq, part, contents(w.key));
            nw = btree.put(p, contents(w.sc), nw, contents(w.key)[0..rk], out[ra..ra + pl]);
            if nw < 0 {
                return exec.tree_err(nw);
            }
            ra = ra + pl;
            part = part + 1;
        }
        // its statements' records, under their ids (6au)
        kl = 1;
        contents(w.key)[0] = byte_of(1);
        more = froot != 0;
        while more {
            let r = btree.next_after(p, contents(w.sc), froot, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
            if r == btree.not_found() || r >= 0 && int_of(contents(w.key2)[0]) != 1 {
                more = false;
            } else if r < 0 {
                return exec.tree_err(r);
            } else {
                kl = exec.copy(contents(w.key2), 0, r / 1024, contents(w.key), 0);
                let part = int_of(contents(w.key2)[5]);
                if part == 0 {
                    // whose parts follow
                    exec.copy(contents(w.cur), 0, 32, st, 0);
                } else {
                    let sk = tables.kept_key(8, st, part - 1, contents(w.lit));
                    nw = btree.put(p, contents(w.sc), nw, contents(w.lit)[0..sk], contents(w.cur)[0..r % 1024]);
                    if nw < 0 {
                        return exec.tree_err(nw);
                    }
                }
            }
        }
        // its facts, as they are in the transaction's tree (what its statements were is no fact)
        var fl = 0;
        var going = froot != 0;
        while going {
            let r = btree.next_after(p, contents(w.sc), froot, contents(w.key)[0..fl], false, contents(w.key2), contents(w.cur));
            if r == btree.not_found() {
                going = false;
            } else if r < 0 {
                return exec.tree_err(r);
            } else {
                let nk = r / 1024;
                fl = exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
                if int_of(contents(w.key2)[0]) > 3 {
                    let dk = tables.fact_key(seq, contents(w.lit));
                    let dl = exec.copy(contents(w.key2), 0, nk, contents(w.lit), dk);
                    nw = btree.put(p, contents(w.sc), nw, contents(w.lit)[0..dl], contents(w.cur)[0..66]);
                    if nw < 0 {
                        return exec.tree_err(nw);
                    }
                }
            }
        }
    }
    return nw;
}

// What `seal` is told of who commits and when (`who`): the token's id (32 bytes), the principal (32), the time in milliseconds (8), then the token itself.
pub fn who_fixed() -> [] int {
    return 72;
}

// What is kept with the log under an id (`kind` 7: a token, 6at; 8: a statement's record, 6au): the one after the id `after[0..an]` (nothing: the first) as it is in the
// tree `root`, its id into `after` (32 bytes) and its bytes into `out`; its length, 0 after the last, or an error.
pub fn next_kept[&q, &z, &a, &o](p: &!z pager.Pager, w: &!q exec.Work, root: int, kind: int, after: &!a [byte], an: int, out: &!o [byte]) -> [file_read] int {
    // (after every part of the one `after` names: its id and a part number above any)
    var kl = tables.kept_key(kind, after[0..32], 255, contents(w.key));
    if an == 0 {
        kl = kl - 33;
    }
    let r = btree.next_after(p, contents(w.sc), root, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
    if r == btree.not_found() {
        return 0;
    }
    if r < 0 {
        return exec.tree_err(r);
    }
    if r / 1024 != 38 || commit.be(contents(w.key2), 0, 4) != tables.log_space() || int_of(contents(w.key2)[4]) != kind {
        return 0;
    }
    exec.copy(contents(w.key2), 5, 32, after, 0);
    var at = 0;
    var part = 0;
    var more = true;
    while more {
        let tk = tables.kept_key(kind, after[0..32], part, contents(w.key));
        let g = btree.get(p, contents(w.sc), root, contents(w.key)[0..tk], contents(w.cur));
        if g == btree.not_found() {
            more = false;
        } else if g < 0 {
            return exec.tree_err(g);
        } else if at + g > len(out) {
            return exec.too_big();
        } else {
            at = exec.copy(contents(w.cur), 0, g, out, at);
            part = part + 1;
        }
    }
    return at;
}

// A statement that ran is told to the transaction (6au): for each IR in what the statement left (`exec.stmts_of`), its record as the log's third version has it with the
// constants gone (docs/spec/ir.md section 8: the shape, the salted hash of its constants, and no payload) under the next number of the transaction's tree `froot`, and
// its effects as the verifier infers them (`ir.infer`), each a key of that tree. The constants are never written anywhere: there is nothing of them for an erasure to
// find. The new root, or an error.
pub fn say[&h, &q, &z](heap: &!h Heap, p: &!z pager.Pager, w: &!q exec.Work, froot: int) -> [heap, file_read, file_write] int {
    var root = froot;
    var at = 0;
    var i = 0;
    while i < exec.stmts_count(w) && root >= 0 {
        let n = commit.be(exec.stmts_of(w), at, 4);
        var shape = box_slice(heap, n + 8, byte_of(0));
        var vals = box_slice(heap, n + 8, byte_of(0));
        var rec = box_slice(heap, n + 64, byte_of(0));
        var set = map.empty(heap, 16, 0, 3);
        region r {
            let info = alloc_slice[r](4, 0);
            let salt = alloc_slice[r](16, byte_of(0));
            let id = alloc_slice[r](32, byte_of(0));
            let num = alloc_slice[r](4, byte_of(0));
            var lifted = 0 - 1;
            var rn = 0;
            borrow mut shape as &!sw in {
                borrow mut vals as &!vw in {
                    borrow mut rec as &!rw in {
                        lifted = ir.lift(heap, exec.stmts_of(w)[at + 4..at + 4 + n], contents(sw), contents(vw), info);
                        if lifted >= 0 && exec.fresh(w, salt) {
                            rn = build.stmt3(contents(rw), 0, contents(sw)[0..info[0]], contents(vw)[0..info[1]], info[2], salt, id, true);
                        }
                        let (grown, good) = ir.infer(heap, set, exec.stmts_of(w)[at + 4..at + 4 + n], 2, info);
                        set = grown;
                        if lifted < 0 || rn <= 4 || !good {
                            root = exec.unsupported();
                        }
                        // the statement's number in the transaction
                        var count = 0;
                        contents(w.key)[0] = byte_of(3);
                        if root > 0 {
                            let g = btree.get(p, contents(w.sc), root, contents(w.key)[0..1], contents(w.cur));
                            if g == 4 {
                                count = commit.be(contents(w.cur), 0, 4);
                            }
                        }
                        if root >= 0 {
                            build.put_be(num, 0, count + 1, 4);
                            root = put(p, w, root, 1, num);
                        }
                        // its id, then its record in parts
                        contents(w.key)[0] = byte_of(1);
                        build.put_be(contents(w.key), 1, count, 4);
                        contents(w.key)[5] = byte_of(0);
                        if root >= 0 {
                            root = put(p, w, root, 6, id);
                        }
                        var ra = 4;
                        var part = 1;
                        while ra < rn && root >= 0 {
                            var pl = rn - ra;
                            if pl > 700 {
                                pl = 700;
                            }
                            if part > 255 {
                                root = exec.too_big();
                            } else {
                                contents(w.key)[5] = byte_of(part);
                                root = put(p, w, root, 6, contents(rw)[ra..ra + pl]);
                            }
                            ra = ra + pl;
                            part = part + 1;
                        }
                    }
                }
            }
        }
        // its effects
        borrow set as &sr in {
            var e = 0;
            while e < map.entries(sr) && root >= 0 {
                if map.is_live(sr, e) {
                    let key = map.key_at(sr, e);
                    if len(key) + 1 > btree.max_key() {
                        root = exec.too_big();
                    } else {
                        contents(w.key)[0] = byte_of(2);
                        let kl = exec.copy(key, 0, len(key), contents(w.key), 1);
                        root = put(p, w, root, kl, "e");
                    }
                }
                e = e + 1;
            }
        }
        map.drop(heap, set);
        unbox_slice(heap, shape);
        unbox_slice(heap, vals);
        unbox_slice(heap, rec);
        at = at + 4 + n;
        i = i + 1;
    }
    return root;
}

// Put `value` under the first `kl` bytes of `w.key` in the tree `root`.
fn put[&q, &z, &v](p: &!z pager.Pager, w: &!q exec.Work, root: int, kl: int, value: &v [byte]) -> [file_read, file_write] int {
    let nw = btree.put(p, contents(w.sc), root, contents(w.key)[0..kl], value);
    if nw < 0 {
        return exec.tree_err(nw);
    }
    return nw;
}

// The log's header as it is in the tree `root` (6as): `build.log_header` into `out`, its length; 0 if no commit was ever recorded there; or an error.
pub fn header[&q, &z, &o](p: &!z pager.Pager, w: &!q exec.Work, root: int, out: &!o [byte]) -> [file_read] int {
    let lk = tables.log_key(contents(w.key));
    let lr = btree.get(p, contents(w.sc), root, contents(w.key)[0..lk], contents(w.cur));
    if lr == btree.not_found() {
        return 0;
    }
    if lr != 32 {
        return exec.damaged();
    }
    return build.log_header(out, 0, contents(w.cur)[0..32]);
}

// The record of commit `seq` as it is in the tree `root`, into `out`: its length, 0 if there is no such commit, or an error.
pub fn record[&q, &z, &o](p: &!z pager.Pager, w: &!q exec.Work, root: int, seq: int, out: &!o [byte]) -> [file_read] int {
    var at = 0;
    var part = 0;
    var more = true;
    while more {
        let rk = tables.record_key(seq, part, contents(w.key));
        let r = btree.get(p, contents(w.sc), root, contents(w.key)[0..rk], contents(w.cur));
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return exec.tree_err(r);
        } else if at + r > len(out) || part >= 255 {
            return exec.too_big();
        } else {
            at = exec.copy(contents(w.cur), 0, r, out, at);
            part = part + 1;
        }
    }
    if at > 0 && (at < 68 || at != 4 + commit.be(out, 0, 4) + 64) {
        // not a whole record
        return exec.damaged();
    }
    return at;
}

// The fact of the log after the one whose key is `after[0..an]` (nothing: the first), as it is in the tree `root`: its key into `after` (the commit's number, 8 bytes, the
// table, a zero byte, the commitment) and its two hashes into `out` (66 bytes); the key's length, 0 after the last, or an error.
pub fn next_fact[&q, &z, &a, &o](p: &!z pager.Pager, w: &!q exec.Work, root: int, after: &!a [byte], an: int, out: &!o [byte]) -> [file_read] int {
    let fk = tables.fact_key(0, contents(w.key));
    var kl = exec.copy(after, 0, an, contents(w.key), fk - 8);
    if an == 0 {
        kl = fk - 8;
    }
    let r = btree.next_after(p, contents(w.sc), root, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
    if r == btree.not_found() {
        return 0;
    }
    if r < 0 {
        return exec.tree_err(r);
    }
    let nk = r / 1024;
    if nk < 5 || commit.be(contents(w.key2), 0, 4) != tables.log_space() || int_of(contents(w.key2)[4]) != 6 {
        return 0;
    }
    if nk < 5 + 8 + 2 + 32 || r % 1024 != 66 || nk - 5 > len(after) {
        return exec.damaged();
    }
    exec.copy(contents(w.cur), 0, 66, out, 0);
    return exec.copy(contents(w.key2), 5, nk - 5, after, 0);
}

// The answer to `select cancho_last_commit()` (docs/m3-engine.md 6ax), made in `w` as a SELECT's is: one row, the number of commits the log in the tree `root` has (an
// integer) and the id of the last in hex (text; null when there is none). 0, or an error.
pub fn last[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int) -> [file_read] int {
    var n = 0;
    var fill = 0;
    region g {
        let ident = alloc_slice[g](32, byte_of(0));
        let hk = tables.head_key(contents(w.key));
        let hr = btree.get(p, contents(w.sc), root, contents(w.key)[0..hk], contents(w.cur));
        if hr == 72 {
            n = commit.be(contents(w.cur), 0, 8) + 1;
            exec.copy(contents(w.cur), 8, 32, ident, 0);
        } else if hr != btree.not_found() {
            if hr < 0 {
                return exec.tree_err(hr);
            }
            return exec.damaged();
        }
        let rows = contents(w.rows);
        rows[0] = byte_of(1);
        exec.put_i64(rows, 1, n);
        if n == 0 {
            rows[9] = byte_of(0);
            fill = 10;
        } else {
            rows[9] = byte_of(3);
            build.put_be(rows, 10, 64, 2);
            var k = 0;
            while k < 32 {
                let b = int_of(ident[k]);
                var hi = '0' + b / 16;
                if b / 16 > 9 {
                    hi = 'a' + b / 16 - 10;
                }
                var lo = '0' + b % 16;
                if b % 16 > 9 {
                    lo = 'a' + b % 16 - 10;
                }
                rows[12 + 2 * k] = byte_of(hi);
                rows[13 + 2 * k] = byte_of(lo);
                k = k + 1;
            }
            fill = 76;
        }
    }
    contents(w.pos)[exec.p_itype()] = row.t_int();
    contents(w.pos)[exec.p_itype() + 1] = row.t_text();
    contents(w.idx)[0] = 0;
    w.first = 0;
    w.count = 1;
    w.nitems = 2;
    w.rfill = fill;
    w.nchg = 0;
    w.cfill = 0;
    w.root = root;
    return 0;
}

// The number of the first commit whose record the tree `root` still holds (0: all of them), or an error.
pub fn floor[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int) -> [file_read] int {
    let fk = tables.floor_key(contents(w.key));
    let r = btree.get(p, contents(w.sc), root, contents(w.key)[0..fk], contents(w.cur));
    if r == btree.not_found() {
        return 0;
    }
    if r < 0 {
        return exec.tree_err(r);
    }
    if r != 8 {
        return exec.damaged();
    }
    return commit.be(contents(w.cur), 0, 8);
}

// How many commits a call of `archive` takes out at most: what a statement may do while the others wait.
pub fn archive_step() -> [] int {
    return 128;
}

// One commit's part of the log taken out of the tree `root`: its record, its facts, and the records of its statements. The new root, or an error.
fn forget[&q, &z, &r, &f](p: &!z pager.Pager, w: &!q exec.Work, root: int, seq: int, rec: &!r [byte], info: &!f [int]) -> [file_read, file_write] int {
    var nw = root;
    let rn = record(p, w, nw, seq, rec);
    if rn <= 0 {
        return exec.damaged();
    }
    if commit.decode(rec[4..rn - 64], info) != commit.ok() {
        return exec.damaged();
    }
    // the statements it names (each under its id, in parts)
    var i = 0;
    while i < info[commit.f_stmts_n()] {
        let at = 4 + info[commit.f_stmts_at()] + 32 * i;
        var part = 0;
        var more = true;
        while more {
            let kk = tables.kept_key(8, rec[at..at + 32], part, contents(w.key));
            let d = btree.del(p, contents(w.sc), nw, contents(w.key)[0..kk]);
            if d == btree.not_found() {
                more = false;
            } else if d < 0 {
                return exec.tree_err(d);
            } else {
                nw = d;
                part = part + 1;
            }
        }
        i = i + 1;
    }
    // its facts: every key that begins with its number
    var more = true;
    while more {
        let fk = tables.fact_key(seq, contents(w.key));
        let r = btree.next_after(p, contents(w.sc), nw, contents(w.key)[0..fk], false, contents(w.key2), contents(w.cur));
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return exec.tree_err(r);
        } else {
            let nk = r / 1024;
            if nk < 13 || commit.be(contents(w.key2), 0, 4) != tables.log_space() || int_of(contents(w.key2)[4]) != 6 || commit.be(contents(w.key2), 5, 8) != seq {
                more = false;
            } else {
                let d = btree.del(p, contents(w.sc), nw, contents(w.key2)[0..nk]);
                if d < 0 {
                    return exec.tree_err(d);
                }
                nw = d;
            }
        }
    }
    // which transaction it was, kept under its id (6be): the tree is not read as of a commit it no longer has the record of
    region g {
        let ident = alloc_slice[g](32, byte_of(0));
        build.id(rec[4..rn - 64], ident);
        let ak = tables.asof_key(ident, contents(w.key));
        let d = btree.del(p, contents(w.sc), nw, contents(w.key)[0..ak]);
        if d >= 0 {
            nw = d;
        } else if d != btree.not_found() {
            return exec.tree_err(d);
        }
    }
    // its record, in parts
    var part = 0;
    more = true;
    while more {
        let rk = tables.record_key(seq, part, contents(w.key));
        let d = btree.del(p, contents(w.sc), nw, contents(w.key)[0..rk]);
        if d == btree.not_found() {
            more = false;
        } else if d < 0 {
            return exec.tree_err(d);
        } else {
            nw = d;
            part = part + 1;
        }
    }
    return nw;
}

// `select cancho_log_archive(upto)` (docs/m3-engine.md 6ba): the records, facts and statements of the commits before `upto` are taken out of the tree `root`, at most
// `archive_step()` commits of them in a call, and the tree says which is the first it still has. Whoever asks has them elsewhere: the engine cannot know that, and
// does as it is told. The head of the log stays, so the next commit is made as before. The answer is made in `w` as a SELECT's: one row, the first commit still held
// and the number of commits. 0, or an error (`archive_ahead()`: the log has fewer than `upto` commits).
pub fn archive[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int, upto: int) -> [file_read, file_write] int {
    var n = 0;
    let hk = tables.head_key(contents(w.key));
    let hr = btree.get(p, contents(w.sc), root, contents(w.key)[0..hk], contents(w.cur));
    if hr == 72 {
        n = commit.be(contents(w.cur), 0, 8) + 1;
    } else if hr != btree.not_found() {
        if hr < 0 {
            return exec.tree_err(hr);
        }
        return exec.damaged();
    }
    if upto > n {
        return exec.archive_ahead();
    }
    var at = floor(p, w, root);
    if at < 0 {
        return at;
    }
    var stop = upto;
    if stop > at + archive_step() {
        stop = at + archive_step();
    }
    var nw = root;
    if stop > at {
        region g {
            let rec = alloc_slice[g](max_record(), byte_of(0));
            let info = alloc_slice[g](commit.out_len(), 0);
            let num = alloc_slice[g](8, byte_of(0));
            while at < stop {
                nw = forget(p, w, nw, at, rec, info);
                if nw < 0 {
                    return nw;
                }
                at = at + 1;
            }
            build.put_be(num, 0, at, 8);
            let fk = tables.floor_key(contents(w.key));
            nw = btree.put(p, contents(w.sc), nw, contents(w.key)[0..fk], num);
            if nw < 0 {
                return exec.tree_err(nw);
            }
        }
    }
    return two(w, nw, at, n);
}

// The answer of a call that changes no row, made in `w` as a SELECT's: one row of two whole numbers; and the tree the call left. 0.
fn two[&q](w: &!q exec.Work, root: int, a: int, b: int) -> [] int {
    let rows = contents(w.rows);
    rows[0] = byte_of(1);
    exec.put_i64(rows, 1, a);
    rows[9] = byte_of(1);
    exec.put_i64(rows, 10, b);
    contents(w.pos)[exec.p_itype()] = row.t_int();
    contents(w.pos)[exec.p_itype() + 1] = row.t_int();
    contents(w.idx)[0] = 0;
    w.first = 0;
    w.count = 1;
    w.nitems = 2;
    w.rfill = 18;
    // it changed no row: what the statement before reported is not this one's (a commit of the log is made of a statement's changes)
    w.nchg = 0;
    w.cfill = 0;
    w.root = root;
    return 0;
}

// How many entries of the history a call of `trim` takes out at most.
pub fn trim_step() -> [] int {
    return 256;
}

// `select cancho_history_trim()` (docs/m3-engine.md 6bb): what the rows were before the transactions that have ended (the undo entries of 6n, up to the tree's last
// transaction) is taken out of the tree `root`, at most `trim_step()` entries a call, and the tree says up to which transaction. The entries of a transaction that
// is open are of a later number and stay: its commit needs them. The answer, made in `w` as a SELECT's: how many entries this call took out (0: there are no more)
// and the number of that transaction. 0, or an error.
pub fn trim[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int) -> [file_read, file_write] int {
    let last = exec.last_txn(p, w, root);
    if last < 0 {
        return last;
    }
    var nw = root;
    var gone = 0;
    region g {
        let from = alloc_slice[g](12, byte_of(0));
        build.put_be(from, 0, 4294967295, 4);
        build.put_be(from, 4, 9223372036854775807 - last, 8);
        var more = root != 0;
        while more && gone < trim_step() {
            let r = btree.next_after(p, contents(w.sc), nw, from, true, contents(w.key2), contents(w.cur));
            if r == btree.not_found() {
                more = false;
            } else if r < 0 {
                return exec.tree_err(r);
            } else if r / 1024 < 12 || commit.be(contents(w.key2), 0, 4) != 4294967295 {
                more = false;
            } else {
                let d = btree.del(p, contents(w.sc), nw, contents(w.key2)[0..r / 1024]);
                if d < 0 {
                    return exec.tree_err(d);
                }
                nw = d;
                gone = gone + 1;
            }
        }
        if gone > 0 {
            let num = alloc_slice[g](8, byte_of(0));
            build.put_be(num, 0, last, 8);
            let tk = tables.trim_key(contents(w.key));
            nw = btree.put(p, contents(w.sc), nw, contents(w.key)[0..tk], num);
            if nw < 0 {
                return exec.tree_err(nw);
            }
        }
    }
    return two(w, nw, gone, last);
}

// The number of the tree's transaction that the commit `id` was (`tables.asof_key`), or `exec.as_of_unknown()`: no commit of the log the tree `root` still has
// the record of; or an error.
pub fn txn_of[&q, &z, &i](p: &!z pager.Pager, w: &!q exec.Work, root: int, id: &i [byte]) -> [file_read] int {
    let ak = tables.asof_key(id, contents(w.key));
    let r = btree.get(p, contents(w.sc), root, contents(w.key)[0..ak], contents(w.cur));
    if r == btree.not_found() {
        return exec.as_of_unknown();
    }
    if r < 0 {
        return exec.tree_err(r);
    }
    if r != 8 {
        return exec.damaged();
    }
    return commit.be(contents(w.cur), 0, 8);
}
