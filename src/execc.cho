edition 9;
module cdb.execc;

import cdb.commit;
import cdb.build;
import cdb.row;
import cdb.eval;
import cdb.btree;
import cdb.pager;
import cdb.tables;
import cdb.index;
import cdb.parse;
import cdb.lower;
import cdb.exec;
import cdb.via;
import cdb.uniq;
import cdb.checks;

// The statements of the engine that define (docs/m3-engine.md 6g, 6x): CREATE TABLE, CREATE SEQUENCE, DROP TABLE, ALTER TABLE ... ADD COLUMN. Split from src/execw.cho
// (the statements that write rows), which had come to 1,866 lines; the two answer the same way.

fn col_type[&q](w: &!q exec.Work, c: int) -> [] int {
    let dl = w.dlen;
    return row.col_type(contents(w.ctx)[64..64 + dl], c);
}

fn columns[&q](w: &!q exec.Work) -> [] int {
    let dl = w.dlen;
    return row.columns(contents(w.ctx)[64..64 + dl]);
}

// ---- CREATE TABLE and DROP TABLE

pub fn name_ok[&d](data: &d [byte], at: int, n: int) -> [] bool {
    if n < 1 || n > tables.max_name() {
        return false;
    }
    var i = 0;
    while i < n {
        let c = int_of(data[at + i]);
        let letter = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_';
        if !letter && (i == 0 || c < '0' || c > '9') {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Whether the expression at `cn` is a range of the column whose name is `ent[na..na + nl]`: `c between lo and hi`, c that column, lo and hi integer literals
// (docs/m3-engine.md 6x). If it is, the two bounds are written to `tmp` from `xa`.
fn range_of[&q, &s, &t, &n, &k](w: &!q exec.Work, sql: &s [byte], toks: &t [int], nodes: &n [int], kids: &k [int], cn: int, na: int, nl: int, xa: int) -> [] bool {
    if nodes[6 * cn] != parse.n_between() || nodes[6 * cn + 1] != 0 || nodes[6 * cn + 3] != 3 {
        return false;
    }
    let subj = kids[nodes[6 * cn + 2]];
    if nodes[6 * subj] != parse.n_col() || nodes[6 * subj + 4] >= 0 {
        return false;
    }
    let sl = lower.name_text(sql, toks, nodes[6 * subj + 1], contents(w.nrow)[0..256], 0);
    if sl < 0 || !exec.same(contents(w.nrow), 0, sl, contents(w.ent), na, nl) {
        return false;
    }
    var which = 1;
    while which <= 2 {
        var bn = kids[nodes[6 * cn + 2] + which];
        var sign = 1;
        if nodes[6 * bn] == parse.n_neg() {
            sign = 0 - 1;
            bn = kids[nodes[6 * bn + 2]];
        }
        let tok = nodes[6 * bn + 1];
        if nodes[6 * bn] != parse.n_num() || parse.tlen(toks, tok) > 18 {
            return false;
        }
        var v = 0;
        var q = parse.tstart(toks, tok);
        while q < parse.tstart(toks, tok) + parse.tlen(toks, tok) {
            let d = int_of(sql[q]);
            if d < '0' || d > '9' {
                return false;
            }
            v = v * 10 + d - '0';
            q = q + 1;
        }
        exec.put_i64(contents(w.tmp), xa + 8 * (which - 1), sign * v);
        which = which + 1;
    }
    return true;
}

// Read column definitions (the children of the node `list`: the first of them is column `c0` of the table, the last column `nc - 1`) into the entry being built: the definition in `ent` (the columns
// before `c0` are there already, from 8; these go from `da0`), the marks and defaults in `tmp` from `xa0`. `keys0` of the columns before are the key. Errors are noted. The end of the definition, with
// the end of the marks and the number of key columns left in `pos` (`exec.p_ddl`); or a refusal.
fn column_defs[&q, &s, &t, &n, &k](w: &!q exec.Work, sql: &s [byte], toks: &t [int], nodes: &n [int], kids: &k [int], list: int, c0: int, nc: int, da0: int, xa0: int, keys0: int, skip: int) -> [] int {
    let b = eval.max_nodes();
    var da = da0;
    var xa = xa0;
    var keys = keys0;
    var c = c0;
    contents(w.pos)[exec.p_ddl() + 2] = 0;
    contents(w.ua)[0] = byte_of(0);
    contents(w.ua)[200] = byte_of(1);
    while c < nc {
        // `skip` is the child of the list that is no column (a table's PRIMARY KEY (...)), or -1
        var ci = c - c0;
        if skip >= 0 && ci >= skip {
            ci = ci + 1;
        }
        let cd = kids[nodes[6 * list + 2] + ci];
        if nodes[6 * cd] != parse.n_coldef() || nodes[6 * cd + 3] < 1 {
            return exec.malformed();
        }
        let flags = nodes[6 * cd + 4];
        if flags / 32 % 2 == 1 && (c0 != 0 || flags / 8 % 2 == 1 || nodes[6 * cd + 3] - 1 - flags / 16 % 2 > 0) {
            // an identity column added to a table that has rows, or one with a default: not built
            return exec.unsupported();
        }
        // the children after the type: the default and the check, in the order the flags say (src/stmt.cho)
        let has_check = flags / 16 % 2;
        let has_default = nodes[6 * cd + 3] - 1 - has_check;
        var def_kid = 1;
        var chk_kid = 1 + has_default;
        if flags / 64 % 2 == 1 {
            def_kid = 2;
            chk_kid = 1;
        }
        if has_default < 0 || has_default > 1 {
            return exec.malformed();
        }
        let tyn = kids[nodes[6 * cd + 2]];
        let code = nodes[6 * tyn + 1];
        var ty = 0;
        if code == 1 {
            ty = row.t_int2();
        } else if code == 2 {
            ty = row.t_int4();
        } else if code == 3 {
            ty = row.t_int();
        } else if code == 4 {
            ty = row.t_text();
        } else if code == 5 {
            ty = row.t_bool();
        } else if code == 9 {
            ty = row.t_ts();
        } else if code == 10 {
            ty = row.t_tstz();
        } else {
            return exec.unsupported();
        }
        if flags / 4 % 2 == 1 {
            // UNIQUE: a constraint's index, made with the table (`uniq.constraints`; 6bo). Not on a column added later, and at most eight a table.
            let nu = int_of(contents(w.ua)[0]);
            let uf = int_of(contents(w.ua)[200]);
            if c0 != 0 || nu >= 8 {
                return exec.unsupported();
            }
            // (each constraint: how many columns, then their numbers; `ua[200]` is where the next goes)
            contents(w.ua)[uf] = byte_of(1);
            contents(w.ua)[uf + 1] = byte_of(c);
            contents(w.ua)[200] = byte_of(uf + 2);
            contents(w.ua)[0] = byte_of(nu + 1);
        }
        var place = 0;
        if flags / 2 % 2 == 1 {
            keys = keys + 1;
            place = 1;
            if keys > 1 {
                exec.note(w, exec.e_two_keys());
                place = 0;
            }
        }
        if da + 4 + tables.max_name() > 900 {
            return exec.too_big();
        }
        let cl = lower.name_text(sql, toks, nodes[6 * cd + 1], contents(w.ent)[0..900], da + 4);
        if cl < 0 || !name_ok(contents(w.ent), da + 4, cl) {
            return exec.unsupported();
        }
        // a name that an earlier column has
        var oa = 8;
        var k = 0;
        while k < c {
            let ol = commit.be(contents(w.ent), oa + 2, 2);
            if exec.same(contents(w.ent), oa + 4, ol, contents(w.ent), da + 4, cl) {
                exec.note(w, exec.e_column_twice());
            }
            oa = oa + 4 + ol;
            k = k + 1;
        }
        contents(w.ent)[da] = byte_of(ty);
        contents(w.ent)[da + 1] = byte_of(place);
        build.put_be(contents(w.ent), da + 2, cl, 2);
        da = da + 4 + cl;
        var marks = flags % 2;
        let ma = xa;
        xa = xa + 1;
        var literal = has_default == 1;
        if literal && nodes[6 * kids[nodes[6 * cd + 2] + def_kid]] == parse.n_call() {
            // DEFAULT now() (6bp): the time of each insert, so a mark and no value; for a column of times, of a table that is being made
            if !row.is_time(ty) || c0 != 0 {
                return exec.unsupported();
            }
            marks = marks + 16;
            literal = false;
        }
        if literal {
            let dn = kids[nodes[6 * cd + 2] + def_kid];
            let ln = lower.literal(sql, toks, nodes, kids, dn, contents(w.lrs), contents(w.lit), contents(w.lsc));
            if ln < 0 {
                return exec.unsupported();
            }
            contents(w.info)[0] = exec.arena_start(w);
            let r = eval.eval(contents(w.lit)[0..ln], 0, contents(w.lsc), contents(w.ctx), contents(w.cx), 0, contents(w.ws), contents(w.ar), contents(w.info));
            if r > 0 {
                // a parameter: PostgreSQL takes none in a definition
                return exec.unsupported();
            }
            if r < 0 {
                let s = exec.stat(w, r);
                if s < 0 {
                    return s;
                }
            } else {
                let vt = contents(w.ws)[b];
                if contents(w.ws)[b + 1] == 0 && (vt == 1 || vt == 5 || vt == 6) && !row.int_fits(ty, contents(w.ws)[b + 2]) {
                    // PostgreSQL takes the table and raises at each insert that uses the default: not reproduced
                    return exec.unsupported();
                }
                let r2 = eval.assign(contents(w.ws), b, ty, contents(w.ar), contents(w.info));
                if r2 < 0 {
                    let s = exec.stat(w, r2);
                    if s < 0 {
                        return s;
                    }
                } else if contents(w.ws)[b + 1] == 2 {
                    exec.note(w, contents(w.ws)[b + 2] - 1);
                } else {
                    marks = marks + 2;
                    let f = exec.enc(contents(w.tmp), xa, contents(w.ws), b, contents(w.ar));
                    if f == 0 - 1 {
                        return exec.too_big();
                    }
                    if f < 0 {
                        return exec.unsupported();
                    }
                    xa = f;
                }
            }
        }
        if has_check == 1 {
            // a range (docs/m3-engine.md 6x) is two integers beside the column; any other check is an expression of the table's (6bz, src/checks.cho), which
            // a column added to a table that has rows cannot have
            let cn = kids[nodes[6 * cd + 2] + chk_kid];
            let integer = ty == row.t_int() || ty == row.t_int4() || ty == row.t_int2();
            if integer && range_of(w, sql, toks, nodes, kids, cn, da - cl, cl, xa) {
                xa = xa + 16;
                marks = marks + 4;
            } else if c0 != 0 {
                return exec.unsupported();
            }
        }
        if flags / 32 % 2 == 1 {
            // an identity column: an integer, one a table (PostgreSQL takes several; hooks has one)
            if ty != row.t_int() && ty != row.t_int4() && ty != row.t_int2() || contents(w.pos)[exec.p_ddl() + 2] != 0 {
                return exec.unsupported();
            }
            contents(w.pos)[exec.p_ddl() + 2] = 1;
            marks = marks + 8;
        }
        contents(w.tmp)[ma] = byte_of(marks);
        if da + xa > exec.max_stored_row() {
            return exec.too_big();
        }
        c = c + 1;
    }
    contents(w.pos)[exec.p_ddl()] = xa;
    contents(w.pos)[exec.p_ddl() + 1] = keys;
    return da;
}

// CREATE TABLE: the IR `e` names the table (ir.md section 2, `Ddl` kind 0); its columns are read from the parser's tree (`stmt` is the statement's node), which is all that has them (6e).
pub fn create_table[&q, &z, &x, &s, &t, &n, &k](p: &!z pager.Pager, w: &!q exec.Work, root: int, e: &x [byte], sql: &s [byte], toks: &t [int], nodes: &n [int], kids: &k [int], stmt: int) -> [file_read, file_write] int {
    exec.start(w, root);
    if len(e) < 5 || int_of(e[0]) != 4 || int_of(e[1]) != 0 || nodes[6 * stmt] != parse.n_create_table() {
        return exec.malformed();
    }
    let nl = commit.be(e, 2, 2);
    if 4 + nl != len(e) {
        return exec.malformed();
    }
    if !name_ok(e, 4, nl) {
        return exec.unsupported();
    }
    // IF NOT EXISTS, and a table or an index has the name: PostgreSQL says so in a notice and does not read the definition
    if nodes[6 * stmt + 4] == 1 {
        let g0 = tables.find(p, contents(w.sc), root, e[4..4 + nl], contents(w.key), contents(w.cur));
        let ikl0 = tables.index_key(e[4..4 + nl], contents(w.key));
        var g1 = btree.not_found();
        if g0 == btree.not_found() {
            g1 = btree.get(p, contents(w.sc), root, contents(w.key)[0..ikl0], contents(w.cur));
        }
        if g0 >= 0 || g1 >= 0 {
            return 0;
        }
        if g0 != btree.not_found() {
            return exec.tree_err(g0);
        }
        if g1 != btree.not_found() {
            return exec.tree_err(g1);
        }
    }
    // a PRIMARY KEY (column, ...) among the children is no column
    // (nor is a UNIQUE (column, ...), told by its data: those are read after the columns, and have to be written after them)
    var tk = 0 - 1;
    var nc = 0;
    var lists = false;
    var i = 0;
    while i < nodes[6 * stmt + 3] {
        let kid = kids[nodes[6 * stmt + 2] + i];
        if nodes[6 * kid] != parse.n_cols() {
            if lists {
                return exec.unsupported();
            }
            nc = nc + 1;
        } else if nodes[6 * kid + 1] == 0 - 2 {
            lists = true;
        } else {
            tk = i;
        }
        i = i + 1;
    }
    if nc < 1 || nc > row.max_columns() {
        return exec.too_big();
    }
    // the definition is built in `ent` from 6, the marks and defaults in `tmp`
    let da = column_defs(w, sql, toks, nodes, kids, stmt, 0, nc, 8, 0, 0, tk);
    if da < 0 {
        return da;
    }
    let xa = contents(w.pos)[exec.p_ddl()];
    var keys = contents(w.pos)[exec.p_ddl() + 1];
    if tk >= 0 {
        // the table's key: each name is a column (42703), once (42701), and no column says it is the key too (42P16); its place in the key is its place in the list
        let kn = kids[nodes[6 * stmt + 2] + tk];
        if keys > 0 {
            exec.note(w, exec.e_two_keys());
        }
        var j = 0;
        while j < nodes[6 * kn + 3] {
            let tok = nodes[6 * kids[nodes[6 * kn + 2] + j] + 1];
            let cl = lower.name_text(sql, toks, tok, contents(w.nrow)[0..256], 0);
            if cl < 0 {
                return exec.unsupported();
            }
            var oa = 8;
            var found = false;
            var c = 0;
            while c < nc {
                let ol = commit.be(contents(w.ent), oa + 2, 2);
                if exec.same(contents(w.ent), oa + 4, ol, contents(w.nrow), 0, cl) {
                    found = true;
                    if keys > 0 {
                        // a note was made
                    } else if int_of(contents(w.ent)[oa + 1]) != 0 {
                        exec.note(w, exec.e_column_twice());
                    } else {
                        contents(w.ent)[oa + 1] = byte_of(j + 1);
                    }
                }
                oa = oa + 4 + ol;
                c = c + 1;
            }
            if !found {
                exec.note(w, exec.e_no_column());
            }
            j = j + 1;
        }
        if keys == 0 {
            keys = nodes[6 * kn + 3];
        }
    }
    if keys == 0 {
        // a table with no primary key has no key to store its rows by
        return exec.unsupported();
    }
    // the UNIQUE (column, ...) of the table: each column is one of the table's, once
    i = 0;
    while i < nodes[6 * stmt + 3] {
        let un = kids[nodes[6 * stmt + 2] + i];
        if nodes[6 * un] == parse.n_cols() && nodes[6 * un + 1] == 0 - 2 {
            let m = nodes[6 * un + 3];
            let nu = int_of(contents(w.ua)[0]);
            let uf = int_of(contents(w.ua)[200]);
            if m < 1 || m > index.max_cols() || nu >= 8 {
                return exec.unsupported();
            }
            var j = 0;
            while j < m {
                let cl = lower.name_text(sql, toks, nodes[6 * kids[nodes[6 * un + 2] + j] + 1], contents(w.nrow)[0..256], 0);
                if cl < 0 {
                    return exec.unsupported();
                }
                var oa = 8;
                var at = 0 - 1;
                var c = 0;
                while c < nc {
                    let ol = commit.be(contents(w.ent), oa + 2, 2);
                    if exec.same(contents(w.ent), oa + 4, ol, contents(w.nrow), 0, cl) {
                        at = c;
                    }
                    oa = oa + 4 + ol;
                    c = c + 1;
                }
                if at < 0 {
                    exec.note(w, exec.e_no_column());
                    at = 0;
                }
                var q = 0;
                while q < j {
                    if int_of(contents(w.ua)[uf + 1 + q]) == at && w.code == 0 {
                        return exec.unsupported();
                    }
                    q = q + 1;
                }
                contents(w.ua)[uf + 1 + j] = byte_of(at);
                j = j + 1;
            }
            contents(w.ua)[uf] = byte_of(m);
            contents(w.ua)[200] = byte_of(uf + 1 + m);
            contents(w.ua)[0] = byte_of(nu + 1);
        }
        i = i + 1;
    }
    build.put_be(contents(w.ent), 4, da - 6, 2);
    build.put_be(contents(w.ent), 6, nc, 2);
    let total = exec.copy(contents(w.tmp), 0, xa, contents(w.ent), da);
    // its checks that are expressions (6bz): read, typed and named now, kept once the table has its number
    let pc = checks.prepare(w, sql, toks, nodes, kids, stmt, e[4..4 + nl], nc, total);
    if pc < 0 {
        return pc;
    }
    let g = tables.find(p, contents(w.sc), root, e[4..4 + nl], contents(w.key), contents(w.cur));
    if g >= 0 {
        exec.note(w, exec.e_table_exists());
    } else if g != btree.not_found() {
        return exec.tree_err(g);
    }
    // an index has a name among the tables' (PostgreSQL: one namespace for both)
    let ikl = tables.index_key(e[4..4 + nl], contents(w.key));
    let gi = btree.get(p, contents(w.sc), root, contents(w.key)[0..ikl], contents(w.cur));
    if gi >= 0 {
        exec.note(w, exec.e_table_exists());
    } else if gi != btree.not_found() {
        return exec.tree_err(gi);
    }
    // and so has a sequence
    let qkl = tables.sequence_key(e[4..4 + nl], contents(w.key));
    let gq = btree.get(p, contents(w.sc), root, contents(w.key)[0..qkl], contents(w.cur));
    if gq >= 0 {
        exec.note(w, exec.e_table_exists());
    } else if gq != btree.not_found() {
        return exec.tree_err(gq);
    }
    if w.code != 0 {
        return exec.verdict(w);
    }
    // the counter of table numbers and the table's entry are keys of the tree like any other: their history is kept
    let ekl = tables.entry_key(e[4..4 + nl], contents(w.key));
    let r1 = exec.remember(p, w, root, contents(w.key), 4);
    if r1 < 0 {
        return r1;
    }
    let r2 = exec.remember(p, w, r1, contents(w.key), ekl);
    if r2 < 0 {
        return r2;
    }
    var nw = tables.create(p, contents(w.sc), r2, e[4..4 + nl], contents(w.key), contents(w.ent)[0..total]);
    if nw < 0 {
        return exec.tree_err(nw);
    }
    nw = checks.store(p, w, nw, tables.id_of(contents(w.ent)));
    if nw < 0 {
        return nw;
    }
    // the unique columns: an index each, the constraint's (6bo)
    nw = uniq.constraints(p, w, nw, e[4..4 + nl], nc);
    if nw < 0 {
        return nw;
    }
    w.root = nw;
    if contents(w.pos)[exec.p_ddl() + 2] != 0 {
        // the counter of its identity column: there from the start, so that a draw in a transaction that is rolled back has somewhere to stay
        let sr = exec.seq_put(p, w, nw, tables.id_of(contents(w.ent)), 1);
        if sr < 0 {
            return sr;
        }
        w.root = sr;
    }
    return 0;
}

// Lower the condition of an `insert ... select ... where` (the SELECT of it at `node`, src/stmt.cho) for `insert` to read: 0, or a refusal.
pub fn guard_lower[&q, &s, &t, &n, &k, &m](w: &!q exec.Work, sql: &s [byte], toks: &t [int], nodes: &n [int], kids: &k [int], node: int, schema: &m [byte]) -> [] int {
    let ln = lower.lower(sql, toks, nodes, kids, node, schema, contents(w.lrs), contents(w.lit), contents(w.lsc));
    if ln < 0 {
        exec.set_guard(w, 0);
        return exec.unsupported();
    }
    exec.set_guard(w, ln);
    return 0;
}

// The number the token `tok` is (digits, at most 18), or -1.
fn tok_number[&s, &t](sql: &s [byte], toks: &t [int], tok: int) -> [] int {
    if parse.tlen(toks, tok) > 18 {
        return 0 - 1;
    }
    var v = 0;
    var q = parse.tstart(toks, tok);
    while q < parse.tstart(toks, tok) + parse.tlen(toks, tok) {
        let d = int_of(sql[q]);
        if d < '0' || d > '9' {
            return 0 - 1;
        }
        v = v * 10 + d - '0';
        q = q + 1;
    }
    return v;
}

// CREATE SEQUENCE (docs/m3-engine.md 6ad): a name among the tables' and the indexes', a number of its own, a least value (1 if none is said) and a counter that starts one below its
// first value (the least, if none is said).
pub fn create_sequence[&q, &z, &s, &t, &n](p: &!z pager.Pager, w: &!q exec.Work, root: int, sql: &s [byte], toks: &t [int], nodes: &n [int], stmt: int) -> [file_read, file_write] int {
    exec.start(w, root);
    if nodes[6 * stmt] != parse.n_create_seq() {
        return exec.malformed();
    }
    let nl = lower.name_text(sql, toks, nodes[6 * stmt + 1], contents(w.nrow)[0..256], 0);
    if nl < 0 || !name_ok(contents(w.nrow), 0, nl) {
        return exec.unsupported();
    }
    var low = 1;
    if nodes[6 * stmt + 4] >= 0 {
        low = tok_number(sql, toks, nodes[6 * stmt + 4]);
    }
    var first = low;
    if nodes[6 * stmt + 5] >= 0 {
        first = tok_number(sql, toks, nodes[6 * stmt + 5]);
    }
    if low < 0 || first < low {
        // a number that is no integer; a start below the least value (PostgreSQL: 22023)
        return exec.unsupported();
    }
    // the name is free: no sequence, no table and no index has it
    let skl = tables.sequence_key(contents(w.nrow)[0..nl], contents(w.key2));
    var there = false;
    let g0 = btree.get(p, contents(w.sc), root, contents(w.key2)[0..skl], contents(w.cur));
    if g0 >= 0 {
        there = true;
    } else if g0 != btree.not_found() {
        return exec.tree_err(g0);
    }
    let g1 = tables.find(p, contents(w.sc), root, contents(w.nrow)[0..nl], contents(w.key), contents(w.cur));
    if g1 >= 0 {
        there = true;
    } else if g1 != btree.not_found() {
        return exec.tree_err(g1);
    }
    let ikl = tables.index_key(contents(w.nrow)[0..nl], contents(w.key));
    let g2 = btree.get(p, contents(w.sc), root, contents(w.key)[0..ikl], contents(w.cur));
    if g2 >= 0 {
        there = true;
    } else if g2 != btree.not_found() {
        return exec.tree_err(g2);
    }
    if there {
        if nodes[6 * stmt + 3] == 1 {
            // IF NOT EXISTS: a notice
            return 0;
        }
        return exec.e_table_exists();
    }
    // a number from the tables' numbers
    build.put_be(contents(w.key), 0, 0, 4);
    var id = 1;
    let gc = btree.get(p, contents(w.sc), root, contents(w.key)[0..4], contents(w.cur));
    if gc == 4 {
        id = commit.be(contents(w.cur), 0, 4);
    } else if gc != btree.not_found() {
        return exec.damaged();
    }
    build.put_be(contents(w.cur), 0, id + 1, 4);
    var nroot = btree.put(p, contents(w.sc), root, contents(w.key)[0..4], contents(w.cur)[0..4]);
    if nroot < 0 {
        return exec.tree_err(nroot);
    }
    build.put_be(contents(w.cur), 0, id, 4);
    exec.put_i64(contents(w.cur), 4, low);
    let skl2 = tables.sequence_key(contents(w.nrow)[0..nl], contents(w.key2));
    nroot = btree.put(p, contents(w.sc), nroot, contents(w.key2)[0..skl2], contents(w.cur)[0..12]);
    if nroot < 0 {
        return exec.tree_err(nroot);
    }
    let sr = exec.seq_put(p, w, nroot, id, first);
    if sr < 0 {
        return sr;
    }
    w.root = sr;
    return 0;
}

// DROP TABLE (`Ddl` kind 2): the table's rows are removed one by one (D-M3-8), then its entry.
pub fn drop_table[&q, &z, &x](p: &!z pager.Pager, w: &!q exec.Work, root: int, e: &x [byte]) -> [file_read, file_write] int {
    exec.start(w, root);
    if len(e) < 5 || int_of(e[0]) != 4 || int_of(e[1]) != 2 {
        return exec.malformed();
    }
    let r0 = exec.bind_table(p, w, root, e, 2);
    if r0 != 0 {
        return r0;
    }
    var nroot = root;
    exec.scan_start(w);
    var more = true;
    while more {
        let rl = exec.scan_next(p, w, root);
        if rl == 0 - 1 {
            more = false;
        } else if rl < 0 {
            return rl;
        } else {
            let kl = w.klen;
            let nw = exec.row_del(p, w, nroot, contents(w.key), kl, contents(w.cur)[0..rl]);
            if nw < 0 {
                return nw;
            }
            nroot = nw;
            // each row that goes with the table is a row deleted, and a fact of the commit (6ai)
            let cr = exec.change(w, contents(w.cur)[0..rl], true, contents(w.cur)[0..0], false);
            if cr < 0 {
                return cr;
            }
        }
    }
    let nl = w.nlen;
    // the table's indexes go with it
    build.put_be(contents(w.key), 0, 0, 4);
    contents(w.key)[4] = byte_of(1);
    var ikl = 5;
    more = true;
    while more {
        let r = btree.next_after(p, contents(w.sc), root, contents(w.key)[0..ikl], false, contents(w.key2), contents(w.cur));
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return exec.tree_err(r);
        } else {
            let nk = r / 1024;
            let nv = r % 1024;
            if nk < 6 || commit.be(contents(w.key2), 0, 4) != 0 || int_of(contents(w.key2)[4]) != 1 {
                more = false;
            } else {
                var tl = index.name_end(contents(w.cur)[0..nv]);
                if tl < 0 {
                    tl = nv;
                }
                if exec.same(contents(w.cur), 0, tl, e, 4, nl) {
                    let nw = exec.del_key(p, w, nroot, contents(w.key2), nk);
                    if nw < 0 {
                        return nw;
                    }
                    nroot = nw;
                }
                exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
                ikl = nk;
            }
        }
    }
    // its counter, if it has one
    let tid = w.tid;
    let ckl = tables.counter_key(tid, contents(w.key));
    let cg = btree.get(p, contents(w.sc), nroot, contents(w.key)[0..ckl], contents(w.uval));
    if cg >= 0 {
        let cd = btree.del(p, contents(w.sc), nroot, contents(w.key)[0..ckl]);
        if cd < 0 {
            return exec.tree_err(cd);
        }
        nroot = cd;
    } else if cg != btree.not_found() {
        return exec.tree_err(cg);
    }
    // its checks go with it (6bz)
    let fr = checks.forget(p, w, nroot, w.tid);
    if fr < 0 {
        return fr;
    }
    nroot = fr;
    // the table's entry in the catalog is a key of the tree like any other: its history is kept, so the table is there AS OF before
    let ekl = tables.entry_key(e[4..4 + nl], contents(w.key));
    let rm = exec.remember(p, w, nroot, contents(w.key), ekl);
    if rm < 0 {
        return rm;
    }
    let nw = tables.remove(p, contents(w.sc), rm, e[4..4 + nl], contents(w.key));
    if nw < 0 {
        return exec.tree_err(nw);
    }
    w.root = nw;
    return 0;
}

// ALTER TABLE ... ADD COLUMN (`Ddl` kind 1; docs/m3-engine.md 6q): the definition gains the column, and every row is written again with the column's default, or null.
pub fn alter_add[&q, &z, &x, &s, &t, &n, &k](p: &!z pager.Pager, w: &!q exec.Work, root: int, e: &x [byte], sql: &s [byte], toks: &t [int], nodes: &n [int], kids: &k [int], stmt: int) -> [file_read, file_write] int {
    exec.start(w, root);
    if len(e) < 5 || int_of(e[0]) != 4 || int_of(e[1]) != 1 || nodes[6 * stmt] != parse.n_alter_add() || nodes[6 * stmt + 3] != 1 {
        return exec.malformed();
    }
    // a check with a name, or a second one: a check of the table's, which a column that is added cannot bring (6bz)
    var ch = nodes[6 * stmt + 5];
    while ch >= 0 {
        if nodes[6 * ch + 1] != 0 - 2 {
            return exec.unsupported();
        }
        ch = nodes[6 * ch + 4];
    }
    let r0 = exec.bind_table(p, w, root, e, 2);
    if r0 != 0 {
        return r0;
    }
    let nl = w.nlen;
    let dl = w.dlen;
    let el = w.elen;
    let n0 = columns(w);
    let how = nodes[6 * stmt + 4];
    if how == 1 || how == 2 {
        // ADD COLUMN IF NOT EXISTS, or ALTER COLUMN ... TYPE: is the column there, and of which type
        let cd = kids[nodes[6 * stmt + 2]];
        let cl = lower.name_text(sql, toks, nodes[6 * cd + 1], contents(w.nrow)[0..256], 0);
        if cl < 0 || nodes[6 * cd + 3] < 1 {
            return exec.unsupported();
        }
        var at = 0 - 1;
        var c = 0;
        while c < n0 {
            let nm = row.col_name(contents(w.ctx)[64..64 + dl], c);
            if exec.same(nm, 0, len(nm), contents(w.nrow), 0, cl) {
                at = c;
            }
            c = c + 1;
        }
        if how == 1 && at >= 0 {
            // PostgreSQL says so in a notice and does not read the definition
            return 0;
        }
        if how == 2 {
            if at < 0 {
                exec.note(w, exec.e_no_column());
                return exec.verdict(w);
            }
            // to the type it has: nothing changes. Any other type is a rewrite of the table, which is not built
            let code = nodes[6 * kids[nodes[6 * cd + 2]] + 1];
            let ty = row.col_type(contents(w.ctx)[64..64 + dl], at);
            if code == 1 && ty == row.t_int2() || code == 2 && ty == row.t_int4() || code == 3 && ty == row.t_int() || code == 4 && ty == row.t_text() || code == 5 && ty == row.t_bool() {
                return 0;
            }
            return exec.unsupported();
        }
    }
    if n0 + 1 > row.max_columns() {
        return exec.too_big();
    }
    // the marks and defaults of the columns there are go to `tmp`, where the new column's follow them; its definition follows theirs in `ent`
    let xl = el - 6 - dl;
    exec.copy(contents(w.ent), 6 + dl, xl, contents(w.tmp), 0);
    let da = column_defs(w, sql, toks, nodes, kids, stmt, n0, n0 + 1, 6 + dl, xl, 1, 0 - 1);
    if da < 0 {
        return da;
    }
    let xa = contents(w.pos)[exec.p_ddl()];
    build.put_be(contents(w.ent), 4, da - 6, 2);
    build.put_be(contents(w.ent), 6, n0 + 1, 2);
    let total = exec.copy(contents(w.tmp), 0, xa, contents(w.ent), da);
    // what a row there gets: the default, or null; which a column that takes no null refuses
    let marks = int_of(contents(w.tmp)[xl]);
    let has_default = marks / 2 % 2 == 1;
    var nulls = !has_default;
    var dlen2 = 0;
    if has_default {
        dlen2 = tables.stored_len(contents(w.tmp), xl + 1);
        if int_of(contents(w.tmp)[xl + 1]) == 0 {
            nulls = true;
        }
    }
    // the default is outside the column's range: an error if a row gets it
    var outside = false;
    if marks / 4 == 1 && has_default && int_of(contents(w.tmp)[xl + 1]) == 1 {
        let dv = row.int_at(contents(w.tmp), xl + 2);
        outside = dv < row.int_at(contents(w.tmp), xl + 1 + dlen2) || dv > row.int_at(contents(w.tmp), xl + 9 + dlen2);
    }
    var nroot = root;
    exec.scan_start(w);
    var more = true;
    while more {
        let rl = exec.scan_next(p, w, root);
        if rl == 0 - 1 {
            more = false;
        } else if rl < 0 {
            return rl;
        } else if nulls && marks % 2 == 1 {
            exec.note(w, exec.e_not_null());
            more = false;
        } else if outside {
            exec.note(w, exec.e_check());
            more = false;
        } else if w.code == 0 {
            var ra = exec.copy(contents(w.cur), 0, rl, contents(w.nrow), 0);
            if has_default {
                if ra + dlen2 > exec.max_stored_row() {
                    return exec.too_big();
                }
                ra = exec.copy(contents(w.tmp), xl + 1, dlen2, contents(w.nrow), ra);
            } else {
                if ra + 1 > exec.max_stored_row() {
                    return exec.too_big();
                }
                contents(w.nrow)[ra] = byte_of(0);
                ra = ra + 1;
            }
            let kl = w.klen;
            // the row is another row now, of another definition: a change like an update's, with a new salt, and a fact of the commit (6ai)
            let nw = exec.row_put(p, w, nroot, contents(w.key), kl, contents(w.nrow)[0..ra], contents(w.cur)[0..rl], 1);
            if nw < 0 {
                return nw;
            }
            nroot = nw;
            let cr = exec.change_def(w, contents(w.cur)[0..rl], true, contents(w.nrow)[0..ra], true, da - 6);
            if cr < 0 {
                return cr;
            }
        }
    }
    if w.code != 0 {
        return exec.verdict(w);
    }
    let ekl = tables.entry_key(e[4..4 + nl], contents(w.key));
    let nw = exec.put_key(p, w, nroot, contents(w.key), ekl, contents(w.ent)[0..total]);
    if nw < 0 {
        return nw;
    }
    w.root = nw;
    return 0;
}
