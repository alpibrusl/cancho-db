edition 9;
module cdb.execd;

import cdb.commit;
import cdb.build;
import cdb.btree;
import cdb.pager;
import cdb.row;
import cdb.tables;
import cdb.index;
import cdb.parse;
import cdb.lower;
import cdb.exec;
import cdb.execw;

// Statements that change what a table is, or empties it, and tell the log each row they touch (docs/m3-engine.md 6ao, 6ar). The engine's own forms: no IR.

// TRUNCATE (docs/m3-engine.md 6ao): every row of the table is removed, and is a row deleted (a fact of the commit, as for a table dropped, 6ai). The table stays, and its
// counter goes on from where it was (PostgreSQL's default, CONTINUE IDENTITY).
pub fn truncate_table[&q, &z, &s, &t, &n](p: &!z pager.Pager, w: &!q exec.Work, root: int, sql: &s [byte], toks: &t [int], nodes: &n [int], stmt: int) -> [file_read, file_write] int {
    exec.start(w, root);
    if nodes[6 * stmt] != parse.n_truncate() {
        return exec.malformed();
    }
    let nl = lower.name_text(sql, toks, nodes[6 * stmt + 1], contents(w.nrow)[2..258], 0);
    if nl < 0 {
        return exec.unsupported();
    }
    build.put_be(contents(w.nrow), 0, nl, 2);
    exec.copy(contents(w.nrow), 0, 2 + nl, contents(w.lit), 0);
    let r0 = exec.bind_table(p, w, root, contents(w.lit)[0..2 + nl], 0);
    if r0 != 0 {
        return r0;
    }
    var nroot = root;
    exec.scan_start(w);
    var more = true;
    while more {
        let rl = exec.scan_next(p, w, root);
        if rl == 0 - 1 {
            more = false;
        } else if rl < 0 {
            return rl;
        } else {
            let kl = w.klen;
            let nw = exec.row_del(p, w, nroot, contents(w.key), kl, contents(w.cur)[0..rl]);
            if nw < 0 {
                return nw;
            }
            nroot = nw;
            // each row is a row deleted, and a fact of the commit (6ao)
            let cr = exec.change(w, contents(w.cur)[0..rl], true, contents(w.cur)[0..0], false);
            if cr < 0 {
                return cr;
            }
        }
    }
    // the table stays: what is left is its tree with no row of it
    w.root = nroot;
    return 0;
}

// ALTER TABLE ... RENAME TO (docs/m3-engine.md 6ar). The table keeps its number, so its rows stay where they are in the tree, and its entry in the catalog moves to the new
// name with its indexes. For the log a row is a row of the table named: each one leaves the table of the old name and enters the table of the new one, as another row
// (new salts), which is two facts of the commit.
pub fn rename_table[&q, &z, &s, &t, &n](p: &!z pager.Pager, w: &!q exec.Work, root: int, sql: &s [byte], toks: &t [int], nodes: &n [int], stmt: int) -> [file_read, file_write] int {
    exec.start(w, root);
    if nodes[6 * stmt] != parse.n_rename() {
        return exec.malformed();
    }
    // the old name from 0 of `lit`, the new one from 300, each after its length
    let ol = lower.name_text(sql, toks, nodes[6 * stmt + 1], contents(w.lit)[2..258], 0);
    let nl = lower.name_text(sql, toks, nodes[6 * stmt + 4], contents(w.lit)[302..558], 0);
    if ol < 0 || nl < 0 || !execw.name_ok(contents(w.lit), 302, nl) {
        return exec.unsupported();
    }
    build.put_be(contents(w.lit), 0, ol, 2);
    build.put_be(contents(w.lit), 300, nl, 2);
    let r0 = exec.bind_table(p, w, root, contents(w.lit)[0..2 + ol], 0);
    if r0 != 0 {
        return r0;
    }
    // the new name is free: no table, no index and no sequence has it
    var there = false;
    let g1 = tables.find(p, contents(w.sc), root, contents(w.lit)[302..302 + nl], contents(w.key), contents(w.cur));
    let ikl = tables.index_key(contents(w.lit)[302..302 + nl], contents(w.key));
    let g2 = btree.get(p, contents(w.sc), root, contents(w.key)[0..ikl], contents(w.cur));
    let skl = tables.sequence_key(contents(w.lit)[302..302 + nl], contents(w.key));
    let g3 = btree.get(p, contents(w.sc), root, contents(w.key)[0..skl], contents(w.cur));
    if g1 >= 0 || g2 >= 0 || g3 >= 0 {
        return exec.e_table_exists();
    }
    if g1 != btree.not_found() || g2 != btree.not_found() || g3 != btree.not_found() {
        return exec.damaged();
    }
    // every row leaves the table of the old name
    exec.scan_start(w);
    var more = true;
    while more {
        let rl = exec.scan_next(p, w, root);
        if rl == 0 - 1 {
            more = false;
        } else if rl < 0 {
            return rl;
        } else {
            let cr = exec.change(w, contents(w.cur)[0..rl], true, contents(w.cur)[0..0], false);
            if cr < 0 {
                return cr;
            }
        }
    }
    // the entry moves: under the new name, with the number it had; the old name is free (and stays in the history, as a dropped table's does)
    let el = w.elen;
    var kl = tables.entry_key(contents(w.lit)[302..302 + nl], contents(w.key));
    var nroot = exec.put_key(p, w, root, contents(w.key), kl, contents(w.ent)[0..el]);
    if nroot < 0 {
        return nroot;
    }
    kl = tables.entry_key(contents(w.lit)[2..2 + ol], contents(w.key));
    nroot = exec.del_key(p, w, nroot, contents(w.key), kl);
    if nroot < 0 {
        return nroot;
    }
    // its indexes are indexes of the table under its new name
    build.put_be(contents(w.key), 0, 0, 4);
    contents(w.key)[4] = byte_of(1);
    var xl = 5;
    more = true;
    while more {
        let r = btree.next_after(p, contents(w.sc), root, contents(w.key)[0..xl], false, contents(w.key2), contents(w.cur));
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return exec.tree_err(r);
        } else {
            let nk = r / 1024;
            if nk < 6 || commit.be(contents(w.key2), 0, 4) != 0 || int_of(contents(w.key2)[4]) != 1 {
                more = false;
            } else {
                // (a built index's value is the table's name, a zero byte and what the index is: the name changes and the rest stays, src/index.cho)
                let nv = r % 1024;
                var tl = index.name_end(contents(w.cur)[0..nv]);
                if tl < 0 {
                    tl = nv;
                }
                if exec.same(contents(w.cur), 0, tl, contents(w.lit), 2, ol) {
                    var vl = exec.copy(contents(w.lit), 302, nl, contents(w.ent), 0);
                    vl = exec.copy(contents(w.cur), tl, nv - tl, contents(w.ent), vl);
                    nroot = exec.put_key(p, w, nroot, contents(w.key2), nk, contents(w.ent)[0..vl]);
                    if nroot < 0 {
                        return nroot;
                    }
                }
                xl = exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
            }
        }
    }
    // every row enters the table of the new name, with salts of its own
    let mid = nroot;
    let r1 = exec.bind_table(p, w, mid, contents(w.lit)[300..302 + nl], 0);
    if r1 != 0 {
        return exec.damaged();
    }
    exec.scan_start(w);
    more = true;
    while more {
        let rl = exec.scan_next(p, w, mid);
        if rl == 0 - 1 {
            more = false;
        } else if rl < 0 {
            return rl;
        } else {
            let kn = w.klen;
            exec.copy(contents(w.cur), 0, rl, contents(w.nrow), 0);
            let nw = exec.row_put(p, w, nroot, contents(w.key), kn, contents(w.nrow)[0..rl], contents(w.cur)[0..rl], 3);
            if nw < 0 {
                return nw;
            }
            nroot = nw;
            let cr = exec.change(w, contents(w.cur)[0..0], false, contents(w.nrow)[0..rl], true);
            if cr < 0 {
                return cr;
            }
        }
    }
    w.root = nroot;
    return 0;
}

// CREATE INDEX (`Ddl` kind 3; 6q, 6bo): the index is given a number, recorded with its columns, and an entry is made for each row. A UNIQUE one is refused with 23505 if two rows have the
// same values in its columns.
pub fn create_index[&q, &z, &x, &s, &t, &n, &k](p: &!z pager.Pager, w: &!q exec.Work, root: int, e: &x [byte], sql: &s [byte], toks: &t [int], nodes: &n [int], kids: &k [int], stmt: int) -> [file_read, file_write] int {
    exec.start(w, root);
    if len(e) < 5 || int_of(e[0]) != 4 || int_of(e[1]) != 3 || nodes[6 * stmt] != parse.n_create_index() {
        return exec.malformed();
    }
    let iflags = nodes[6 * stmt + 4];
    let r0 = exec.bind_table(p, w, root, e, 2);
    if r0 != 0 {
        return r0;
    }
    let dl = w.dlen;
    let nl = w.nlen;
    var ncols = nodes[6 * stmt + 3];
    var cond = 0;
    if iflags / 4 % 2 == 1 {
        // the condition of a partial index: a boolean column of the table and nothing else (docs/m3-engine.md 6x)
        ncols = ncols - 1;
        let cn = kids[nodes[6 * stmt + 2] + ncols];
        if nodes[6 * cn] != parse.n_col() || nodes[6 * cn + 4] >= 0 {
            return exec.unsupported();
        }
        let cl = lower.name_text(sql, toks, nodes[6 * cn + 1], contents(w.nrow)[0..256], 0);
        if cl < 0 {
            return exec.unsupported();
        }
        var isbool = false;
        var c = 0;
        while c < row.columns(contents(w.ctx)[64..64 + dl]) {
            let nm = row.col_name(contents(w.ctx)[64..64 + dl], c);
            if exec.same(nm, 0, len(nm), contents(w.nrow), 0, cl) && row.col_type(contents(w.ctx)[64..64 + dl], c) == row.t_bool() {
                isbool = true;
                cond = c;
            }
            c = c + 1;
        }
        if !isbool {
            return exec.unsupported();
        }
    }
    // each column is one of the table's
    var i = 0;
    while i < ncols {
        let tok = nodes[6 * kids[nodes[6 * stmt + 2] + i] + 1];
        let cl = lower.name_text(sql, toks, tok, contents(w.nrow)[0..256], 0);
        if cl < 0 {
            return exec.unsupported();
        }
        var found = false;
        var c = 0;
        while c < row.columns(contents(w.ctx)[64..64 + dl]) {
            let nm = row.col_name(contents(w.ctx)[64..64 + dl], c);
            if exec.same(nm, 0, len(nm), contents(w.nrow), 0, cl) {
                found = true;
                if i < index.max_cols() {
                    contents(w.ixb)[i] = byte_of(c);
                }
            }
            c = c + 1;
        }
        if !found {
            exec.note(w, exec.e_no_column());
        }
        i = i + 1;
    }
    // (an index is built on at most so many columns, and a table has at most so many: docs/m3-engine.md 6bo)
    if ncols > index.max_cols() || w.nix >= index.max_per_table() {
        return exec.unsupported();
    }
    let il = lower.name_text(sql, toks, nodes[6 * stmt + 1], contents(w.nrow)[0..256], 0);
    if il < 0 || !execw.name_ok(contents(w.nrow), 0, il) {
        return exec.unsupported();
    }
    // the name is free: no index has it, and no table
    let kl = tables.index_key(contents(w.nrow)[0..il], contents(w.key2));
    // IF NOT EXISTS: a name that is taken is a notice, once the condition and the columns have been read (PostgreSQL's order: src/backend/commands/indexcmds.c)
    let ine = iflags / 2 % 2 == 1;
    var there = false;
    let g = btree.get(p, contents(w.sc), root, contents(w.key2)[0..kl], contents(w.cur));
    if g >= 0 {
        there = true;
    } else if g != btree.not_found() {
        return exec.tree_err(g);
    }
    let gt = tables.find(p, contents(w.sc), root, contents(w.nrow)[0..il], contents(w.key), contents(w.cur));
    if gt >= 0 {
        there = true;
    } else if gt != btree.not_found() {
        return exec.tree_err(gt);
    }
    let qkl = tables.sequence_key(contents(w.nrow)[0..il], contents(w.key));
    let gq = btree.get(p, contents(w.sc), root, contents(w.key)[0..qkl], contents(w.cur));
    if gq >= 0 {
        there = true;
    } else if gq != btree.not_found() {
        return exec.tree_err(gq);
    }
    if there && !ine {
        exec.note(w, exec.e_table_exists());
    }
    if w.code != 0 {
        return exec.verdict(w);
    }
    if there {
        return 0;
    }
    // the index is built (6bo): a number of its own, its entry in the catalog with its columns, and an entry for each row the table has
    var nroot = root;
    var vl = 0;
    region g {
        let idn = alloc_slice[g](1, 0);
        nroot = index.number(p, contents(w.sc), root, contents(w.key), idn);
        if nroot >= 0 {
            vl = index.value(contents(w.ctx)[0..nl], idn[0], iflags / 4 % 2 + 2 * (iflags % 2), cond, contents(w.ixb), ncols, contents(w.ent));
        }
    }
    if nroot < 0 {
        return exec.tree_err(nroot);
    }
    nroot = exec.put_key(p, w, nroot, contents(w.key2), kl, contents(w.ent)[0..vl]);
    if nroot < 0 {
        return nroot;
    }
    // (the record of this one index, as `index.load` would give it, at the head of `ix`)
    exec.copy(contents(w.ent), nl + 1, vl - nl - 1, contents(w.ix), 0);
    exec.scan_start(w);
    var more = true;
    while more {
        let rl = exec.scan_next(p, w, root);
        if rl == 0 - 1 {
            more = false;
        } else if rl < 0 {
            return rl;
        } else {
            let xl = index.entry(contents(w.ix), 0, contents(w.ctx)[64..64 + dl], contents(w.cur)[0..rl], contents(w.key)[4..w.klen], contents(w.ixa));
            if xl < 0 {
                return exec.too_big();
            }
            if xl > 0 && iflags % 2 == 1 {
                // a unique index: no row already entered has these values, or there is no index (23505)
                let h = index.holder(p, contents(w.sc), nroot, w.tid, contents(w.ix), 0, contents(w.ctx)[64..64 + dl], contents(w.cur)[0..rl], contents(w.key)[4..w.klen], contents(w.ixa), contents(w.ixb), contents(w.ua), contents(w.ub), contents(w.uv));
                if h < 0 {
                    return exec.tree_err(h);
                }
                if h > 0 {
                    return exec.e_unique();
                }
            }
            if xl > 0 {
                contents(w.ixb)[0] = byte_of(xl - (w.klen - 4));
                let u = btree.put(p, contents(w.sc), nroot, contents(w.ixa)[0..xl], contents(w.ixb)[0..1]);
                if u < 0 {
                    return exec.tree_err(u);
                }
                nroot = u;
            }
        }
    }
    w.root = nroot;
    return 0;
}

// DROP INDEX (`Ddl` kind 4; 6q): the name goes. The lowering has found the index in the snapshot, or refused.
pub fn drop_index[&q, &z, &x, &s, &t, &n](p: &!z pager.Pager, w: &!q exec.Work, root: int, e: &x [byte], sql: &s [byte], toks: &t [int], nodes: &n [int], stmt: int) -> [file_read, file_write] int {
    exec.start(w, root);
    if len(e) < 5 || int_of(e[0]) != 4 || int_of(e[1]) != 4 || nodes[6 * stmt] != parse.n_drop_index() {
        return exec.malformed();
    }
    let il = lower.name_text(sql, toks, nodes[6 * stmt + 1], contents(w.nrow)[0..256], 0);
    if il < 0 {
        return exec.unsupported();
    }
    let kl = tables.index_key(contents(w.nrow)[0..il], contents(w.key2));
    if kl < 0 {
        return exec.unsupported();
    }
    let g = btree.get(p, contents(w.sc), root, contents(w.key2)[0..kl], contents(w.cur));
    if g == btree.not_found() {
        return exec.unsupported();
    }
    if g < 0 {
        return exec.tree_err(g);
    }
    var nw = exec.del_key(p, w, root, contents(w.key2), kl);
    if nw < 0 {
        return nw;
    }
    // a built index's entries go with it (6bo)
    let z = index.name_end(contents(w.cur)[0..g]);
    if z >= 0 && z + 5 <= g {
        let id = commit.be(contents(w.cur), z + 1, 4);
        region s {
            let v = alloc_slice[s](1024, byte_of(0));
            nw = index.clear(p, contents(w.sc), nw, id, contents(w.ixa), contents(w.ixb), v);
        }
        if nw < 0 {
            return exec.tree_err(nw);
        }
    }
    w.root = nw;
    return 0;
}
