edition 9;
module cdb.drive;

import cdb.lex;
import cdb.parse;
import cdb.stmt;
import cdb.lower;
import cdb.pager;
import cdb.exec;
import cdb.execs;
import cdb.execw;
import cdb.execd;
import cdb.session;
import cdb.facts;
import cdb.build;
import cdb.token;
import cdb.ir;
import std.map;
import cdb.answer;
import cdb.tables;
import cdb.row;

// What the engine does with a statement's text before it parses it (docs/m3-engine.md 6ac, 6ad, 6ae): a subquery that stands where a value does is run first and a parameter takes
// its place; so does the value a `nextval` will draw. This was written in the program that tests the engine and is here so that it is tested as the engine is (its mutants are in
// tests/mutants.py, group `engine`).

// What a subquery is run with (docs/m3-engine.md 6ac): the buffers a SELECT needs from text to rows, beside the statement's own.
pub struct Sub {
    tb: Box[[int]],
    t2: Box[[int]],
    nb: Box[[int]],
    kb: Box[[int]],
    vb: Box[[int]],
    ob: Box[[int]],
    rb: Box[[int]],
    st: Box[[int]],
    gb: Box[[int]],
    cb: Box[[int]],
    sc: Box[[int]],
    schema: Box[[byte]],
    ir: Box[[byte]],
    text: Box[[byte]],
    vtx: Box[[byte]],
}

pub fn new[&h](heap: &!h Heap) -> [heap] Sub {
    return Sub { tb: box_slice(heap, 16384, 0), t2: box_slice(heap, 32768, 0), nb: box_slice(heap, 6 * 4160, 0), kb: box_slice(heap, 4160, 0), vb: box_slice(heap, 64, 0), ob: box_slice(heap, 256, 0), rb: box_slice(heap, 512, 0), st: box_slice(heap, 16, 0), gb: box_slice(heap, 4096, 0), cb: box_slice(heap, 16, 0), sc: box_slice(heap, 1024, 0), schema: box_slice(heap, 65536, byte_of(0)), ir: box_slice(heap, 32768, byte_of(0)), text: box_slice(heap, 16384, byte_of(0)), vtx: box_slice(heap, 4096, byte_of(0)) };
}

pub fn free[&h](heap: &!h Heap, b: Sub) -> [heap] int {
    let Sub { tb, t2, nb, kb, vb, ob, rb, st, gb, cb, sc, schema, ir, text, vtx } = b;
    unbox_slice(heap, tb);
    unbox_slice(heap, t2);
    unbox_slice(heap, nb);
    unbox_slice(heap, kb);
    unbox_slice(heap, vb);
    unbox_slice(heap, ob);
    unbox_slice(heap, rb);
    unbox_slice(heap, st);
    unbox_slice(heap, gb);
    unbox_slice(heap, cb);
    unbox_slice(heap, sc);
    unbox_slice(heap, schema);
    unbox_slice(heap, ir);
    unbox_slice(heap, text);
    unbox_slice(heap, vtx);
    return 0;
}

// Run the SELECT `sql` (a subquery's text) on the tree `root`: 0 with its rows left in `w`, or anything else (a refusal, an error).
fn scalar[&z, &q, &b, &s](pg: &!z pager.Pager, w: &!q exec.Work, b: &!b Sub, sql: &s [byte], root: int) -> [file_read] int {
    if len(sql) + 4 > 4096 {
        return exec.too_big();
    }
    let sl = exec.schema(pg, w, root, contents(b.schema));
    if sl < 0 {
        return sl;
    }
    let n = lex.tokenize(sql, contents(b.tb));
    if n < 0 || !exec.params_fit(w, sql, contents(b.tb), n, true) {
        return exec.unsupported();
    }
    parse.reset(contents(b.st));
    contents(b.st)[12] = 0;
    let q = stmt.select(sql, contents(b.tb), 0, n, contents(b.nb), contents(b.kb), contents(b.vb), contents(b.ob), contents(b.gb), contents(b.cb), contents(b.st));
    if q != n {
        return exec.unsupported();
    }
    let top = contents(b.st)[2];
    let ln = lower.lower(sql, contents(b.tb), contents(b.nb), contents(b.kb), top, contents(b.schema)[0..sl], contents(b.rb), contents(b.ir), contents(b.sc));
    if ln < 0 {
        return exec.unsupported();
    }
    return execs.select(pg, w, root, contents(b.ir)[0..ln], contents(b.sc));
}

fn tok_is[&s, &t](sql: &s [byte], toks: &t [int], i: int, n: int, c: int) -> [] bool {
    return i >= 0 && i < n && toks[4 * i] == lex.t_punct() && int_of(sql[toks[4 * i + 1]]) == c;
}

fn put_text[&o](out: &!o [byte], at: int, text: &static [byte]) -> [] int {
    var i = 0;
    while i < len(text) {
        out[at + i] = text[i];
        i = i + 1;
    }
    return at + len(text);
}

// The subqueries of the statement `sql` (docs/m3-engine.md 6ac): each `(select ...)` that stands where a value does is run, and the statement is written again into `b.text` with a
// parameter and a cast in its place, bound to the value. The length of the new text; -1 if the statement has no subquery (it runs as it is); -2 if it has one that is not answered (the
// statement, run as it is, is then refused by the parser as it always was).
pub fn prepare[&z, &q, &b, &s](pg: &!z pager.Pager, w: &!q exec.Work, b: &!b Sub, sql: &s [byte], root: int) -> [file_read] int {
    if 4 * (len(sql) + 4) > 32768 || len(sql) + 256 > 16384 {
        return 0 - 1;
    }
    let n = lex.tokenize(sql, contents(b.t2));
    if n < 0 {
        return 0 - 1;
    }
    var any = false;
    var i = 0;
    while i + 1 < n {
        if tok_is(sql, contents(b.t2), i, n, '(') && parse.kw(sql, contents(b.t2), i + 1, n, "select") {
            any = true;
        }
        if parse.kw(sql, contents(b.t2), i, n, "nextval") && tok_is(sql, contents(b.t2), i + 1, n, '(') {
            any = true;
        }
        i = i + 1;
    }
    if !any {
        return 0 - 1;
    }
    if !exec.params_fit(w, sql, contents(b.t2), n, false) {
        return 0 - 2;
    }
    var o = 0;
    var from = 0;
    // whether the place is in a list of output columns (the items of a SELECT that is the statement, a RETURNING): a subquery there, under whatever, may give its column its name, which the
    // parameter in its place would not
    var named = false;
    var depth0 = 0;
    i = 0;
    while i < n {
        if tok_is(sql, contents(b.t2), i, n, '(') {
            depth0 = depth0 + 1;
        } else if tok_is(sql, contents(b.t2), i, n, ')') {
            depth0 = depth0 - 1;
        } else if depth0 == 0 && (parse.kw(sql, contents(b.t2), i, n, "select") && !parse.kw(sql, contents(b.t2), 0, n, "insert") || parse.kw(sql, contents(b.t2), i, n, "returning")) {
            named = true;
        } else if depth0 == 0 && (parse.kw(sql, contents(b.t2), i, n, "from") || parse.kw(sql, contents(b.t2), i, n, "where") || parse.kw(sql, contents(b.t2), i, n, "set")) {
            named = false;
        }
        if named && tok_is(sql, contents(b.t2), i, n, '(') && parse.kw(sql, contents(b.t2), i + 1, n, "select") {
            return 0 - 2;
        }
        if parse.kw(sql, contents(b.t2), i, n, "nextval") && tok_is(sql, contents(b.t2), i + 1, n, '(') {
            // nextval('name') (docs/m3-engine.md 6ad): in an INSERT, once, in its first row, with nothing before it that may leave it uncomputed (a CASE, a COALESCE, an AND, an OR, an IN);
            // the value it will draw takes its place, and the INSERT makes the draw when its row is reached
            var ok = parse.kw(sql, contents(b.t2), 0, n, "insert") && exec.draw_id(w) == 0 && i >= 2 && i + 3 < n && contents(b.t2)[4 * (i + 2)] == lex.t_string() && tok_is(sql, contents(b.t2), i + 3, n, ')');
            var k = 0;
            while k < n {
                if parse.kw(sql, contents(b.t2), k, n, "case") {
                    ok = false;
                }
                // nothing before it that may leave what follows uncomputed
                if k < i && (parse.kw(sql, contents(b.t2), k, n, "coalesce") || parse.kw(sql, contents(b.t2), k, n, "and") || parse.kw(sql, contents(b.t2), k, n, "or") || parse.kw(sql, contents(b.t2), k, n, "in")) {
                    ok = false;
                }
                // in the first row: no `), (` before it (PostgreSQL does not reach a later row if an earlier one fails)
                if k + 2 < i && tok_is(sql, contents(b.t2), k, n, ')') && tok_is(sql, contents(b.t2), k + 1, n, ',') && tok_is(sql, contents(b.t2), k + 2, n, '(') {
                    ok = false;
                }
                k = k + 1;
            }
            if !ok {
                return 0 - 2;
            }
            // (a string's token is what is between its quotes)
            let na = contents(b.t2)[4 * (i + 2) + 1];
            let nz = na + contents(b.t2)[4 * (i + 2) + 2];
            k = na;
            while k < nz {
                let c = int_of(sql[k]);
                if !(c >= 'a' && c <= 'z' || c == '_' || c >= '0' && c <= '9' && k > na) {
                    return 0 - 2;
                }
                k = k + 1;
            }
            let id = exec.seq_find(pg, w, root, sql[na..nz]);
            if id < 0 {
                return 0 - 2;
            }
            let last = exec.seq_last(pg, w, root, id);
            if last < 0 {
                return 0 - 2;
            }
            let v = last;
            exec.draw_set(w, id, v + 1);
            // the digits of `v` (it is at least a sequence's least value, which is not negative)
            var digits = 1;
            var div = 1;
            while v / div >= 10 {
                div = div * 10;
                digits = digits + 1;
            }
            k = 0;
            while k < digits {
                contents(b.vtx)[k] = byte_of('0' + v / div % 10);
                div = div / 10;
                k = k + 1;
            }
            let num = exec.params_inner(w);
            if v < 0 || num > 99 || !exec.param_add(w, contents(b.vtx)[0..digits], false) {
                return 0 - 2;
            }
            let start = contents(b.t2)[4 * i + 1];
            if o + (start - from) + 32 > 16384 {
                return 0 - 2;
            }
            k = from;
            while k < start {
                contents(b.text)[o] = sql[k];
                o = o + 1;
                k = k + 1;
            }
            o = put_text(contents(b.text), o, "($");
            if num >= 10 {
                contents(b.text)[o] = byte_of('0' + num / 10);
                o = o + 1;
            }
            contents(b.text)[o] = byte_of('0' + num % 10);
            o = o + 1;
            o = put_text(contents(b.text), o, "::bigint)");
            from = contents(b.t2)[4 * (i + 3) + 1] + 1;
            i = i + 4;
        } else if tok_is(sql, contents(b.t2), i, n, '(') && parse.kw(sql, contents(b.t2), i + 1, n, "select") {
            depth0 = depth0 - 1;
            // where a value stands: after an operator, a parenthesis or a comma, or one of the words an expression follows; not after IN, EXISTS, a function's name, FROM
            var ok = i > 0;
            if ok && (contents(b.t2)[4 * (i - 1)] == lex.t_ident() || contents(b.t2)[4 * (i - 1)] == lex.t_quoted()) {
                let p = i - 1;
                ok = parse.kw(sql, contents(b.t2), p, n, "and") || parse.kw(sql, contents(b.t2), p, n, "or") || parse.kw(sql, contents(b.t2), p, n, "not") || parse.kw(sql, contents(b.t2), p, n, "when") || parse.kw(sql, contents(b.t2), p, n, "then") || parse.kw(sql, contents(b.t2), p, n, "else") || parse.kw(sql, contents(b.t2), p, n, "where") || parse.kw(sql, contents(b.t2), p, n, "having") || parse.kw(sql, contents(b.t2), p, n, "between") || parse.kw(sql, contents(b.t2), p, n, "on");
            }
            var depth = 1;
            var j = i + 1;
            while j < n && depth > 0 {
                if tok_is(sql, contents(b.t2), j, n, '(') {
                    depth = depth + 1;
                } else if tok_is(sql, contents(b.t2), j, n, ')') {
                    depth = depth - 1;
                }
                j = j + 1;
            }
            let close = j - 1;
            if !ok || depth != 0 {
                return 0 - 2;
            }
            let a = contents(b.t2)[4 * (i + 1) + 1];
            let z = contents(b.t2)[4 * close + 1];
            let rc = scalar(pg, w, b, sql[a..z], root);
            if rc != 0 || exec.count_of(w) > 1 || exec.columns_of(w) != 1 {
                return 0 - 2;
            }
            var vn = 0 - 1;
            if exec.count_of(w) == 1 {
                vn = answer.text(exec.type_of(w, 0), exec.rows_of(w), exec.row_at(w, 0), contents(b.vtx), 0);
                if vn < 0 - 1 {
                    return 0 - 2;
                }
            }
            let ty = exec.type_of(w, 0);
            let num = exec.params_inner(w);
            var added = false;
            if vn < 0 {
                added = exec.param_add(w, contents(b.vtx)[0..0], true);
            } else {
                added = exec.param_add(w, contents(b.vtx)[0..vn], false);
            }
            if !added || num > 99 || ty != 1 && ty != 5 && ty != 6 && ty != 2 && ty != 3 {
                return 0 - 2;
            }
            let start = contents(b.t2)[4 * i + 1];
            if o + (start - from) + 32 > 16384 {
                return 0 - 2;
            }
            var k = from;
            while k < start {
                contents(b.text)[o] = sql[k];
                o = o + 1;
                k = k + 1;
            }
            o = put_text(contents(b.text), o, "($");
            if num >= 10 {
                contents(b.text)[o] = byte_of('0' + num / 10);
                o = o + 1;
            }
            contents(b.text)[o] = byte_of('0' + num % 10);
            o = o + 1;
            if ty == 1 {
                o = put_text(contents(b.text), o, "::bigint)");
            } else if ty == 5 {
                o = put_text(contents(b.text), o, "::integer)");
            } else if ty == 6 {
                o = put_text(contents(b.text), o, "::smallint)");
            } else if ty == 2 {
                o = put_text(contents(b.text), o, "::boolean)");
            } else {
                o = put_text(contents(b.text), o, "::text)");
            }
            from = z + 1;
            i = close + 1;
        } else {
            i = i + 1;
        }
    }
    if o + (len(sql) - from) > 16384 {
        return 0 - 2;
    }
    var k = from;
    while k < len(sql) {
        contents(b.text)[o] = sql[k];
        o = o + 1;
        k = k + 1;
    }
    return o;
}

// What an erase is refused for before anything runs (docs/m3-engine.md 6bf): the statement is the call and its arguments are not a table and a key the engine
// erases by.
// Whether the statement `sql` only reads (docs/m3-engine.md 6bs), from its tokens (a `;` that ends the text is not one of them): one `select`, with none of the words by which a select writes (a sequence drawn from
// or set, a table made, the engine's own functions). It errs on the side of no: what it refuses waits, and loses nothing.
pub fn reads_only[&b, &s](b: &!b Sub, sql: &s [byte]) -> [] bool {
    if 4 * (len(sql) + 4) > 32768 {
        return false;
    }
    let toks = contents(b.t2);
    let n = lex.tokenize(sql, toks);
    if n < 1 || !parse.kw(sql, toks, 0, n, "select") {
        return false;
    }
    var i = 1;
    while i < n {
        if parse.tkind(toks, i) == lex.t_semicolon() {
            return false;
        }
        if parse.kw(sql, toks, i, n, "nextval") || parse.kw(sql, toks, i, n, "setval") || parse.kw(sql, toks, i, n, "into") {
            return false;
        }
        if parse.tkind(toks, i) == lex.t_ident() && parse.tlen(toks, i) >= 7 && parse.word_is(sql, parse.tstart(toks, i), 7, "cancho_") {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn erase_malformed() -> [] int {
    return 0 - 3;
}

fn put_part[&o, &t](out: &!o [byte], at: int, text: &t [byte]) -> [] int {
    if at < 0 || at + len(text) > len(out) {
        return 0 - 1;
    }
    var i = 0;
    while i < len(text) {
        out[at + i] = text[i];
        i = i + 1;
    }
    return at + len(text);
}

// `select cancho_erase('<table>', '<key>')` (docs/m3-engine.md 6bf; the statement is the proxy's, docs/m2g-erasure.md 6d): if `sql` is that and nothing else, the
// DELETE that names the row is written into `b.text` (`delete from <table> where <its key's column> = <the key>`) and the statement `Call`, as the log is told
// it, into `b.ir`. The key is a JSON array of one value, a whole number or a string, as the table's key is one column of that kind. The length of the DELETE;
// -1 if the statement is not that call (it runs as whatever it is); `erase_malformed()` if it is the call and not of that shape, or names no such table.
pub fn erase_text[&z, &q, &b, &s](pg: &!z pager.Pager, w: &!q exec.Work, b: &!b Sub, sql: &s [byte], root: int) -> [file_read] int {
    if 4 * (len(sql) + 4) > 32768 || len(sql) > 4096 {
        return 0 - 1;
    }
    var n = lex.tokenize(sql, contents(b.t2));
    if n > 0 && parse.tkind(contents(b.t2), n - 1) == lex.t_semicolon() {
        n = n - 1;
    }
    if n < 3 || !parse.kw(sql, contents(b.t2), 0, n, "select") || !parse.kw(sql, contents(b.t2), 1, n, "cancho_erase") || !tok_is(sql, contents(b.t2), 2, n, '(') {
        return 0 - 1;
    }
    if n != 7 || parse.tkind(contents(b.t2), 3) != lex.t_string() || !tok_is(sql, contents(b.t2), 4, n, ',') || parse.tkind(contents(b.t2), 5) != lex.t_string() || !tok_is(sql, contents(b.t2), 6, n, ')') {
        return erase_malformed();
    }
    let ta = parse.tstart(contents(b.t2), 3);
    let tl = parse.tlen(contents(b.t2), 3);
    if !execw.name_ok(sql, ta, tl) {
        return erase_malformed();
    }
    var at = 0 - 1;
    region r {
        let key = alloc_slice[r](300, byte_of(0));
        let ent = alloc_slice[r](1024, byte_of(0));
        let kv = alloc_slice[r](len(sql) + 1, byte_of(0));
        // the key as the statement's string holds it: a quote written twice is one
        var vn = 0;
        var i = parse.tstart(contents(b.t2), 5);
        let ve = i + parse.tlen(contents(b.t2), 5);
        while i < ve {
            kv[vn] = sql[i];
            vn = vn + 1;
            if int_of(sql[i]) == 39 && i + 1 < ve && int_of(sql[i + 1]) == 39 {
                i = i + 1;
            }
            i = i + 1;
        }
        // `[`, one value, `]`, with spaces around them
        var a = 0;
        var z = vn;
        while a < z && int_of(kv[a]) == ' ' {
            a = a + 1;
        }
        while z > a && int_of(kv[z - 1]) == ' ' {
            z = z - 1;
        }
        var good = z - a >= 3 && int_of(kv[a]) == '[' && int_of(kv[z - 1]) == ']';
        a = a + 1;
        z = z - 1;
        while good && a < z && int_of(kv[a]) == ' ' {
            a = a + 1;
        }
        while good && z > a && int_of(kv[z - 1]) == ' ' {
            z = z - 1;
        }
        let text = good && z - a >= 2 && int_of(kv[a]) == '"' && int_of(kv[z - 1]) == '"';
        var el = 0 - 1;
        if good {
            el = tables.find(pg, exec.scratch(w), root, sql[ta..ta + tl], key, ent);
        }
        var col = 0 - 1;
        if el >= 6 {
            let dl = tables.def_len(ent);
            let def = ent[6..6 + dl];
            if row.key_columns(def) == 1 {
                var c = 0;
                while c < row.columns(def) {
                    if row.col_pk(def, c) > 0 {
                        col = c;
                    }
                    c = c + 1;
                }
            }
            if col >= 0 {
                let ty = row.col_type(def, col);
                let whole = ty == row.t_int() || ty == row.t_int4() || ty == row.t_int2();
                if !(text && ty == row.t_text()) && !(!text && whole) {
                    col = 0 - 1;
                }
            }
            if col >= 0 {
                let out = contents(b.text);
                at = put_part(out, 0, "delete from ");
                at = put_part(out, at, sql[ta..ta + tl]);
                at = put_part(out, at, " where ");
                at = put_part(out, at, row.col_name(def, col));
                at = put_part(out, at, " = ");
                if text {
                    // a JSON string of plain characters, `\"` and `\\`; written as a string of the statement, a quote twice
                    at = put_part(out, at, "'");
                    var k = a + 1;
                    while k < z - 1 && at >= 0 {
                        var ch = int_of(kv[k]);
                        if ch == 92 {
                            k = k + 1;
                            ch = int_of(kv[k]);
                            if k >= z - 1 || ch != 92 && ch != '"' {
                                at = 0 - 1;
                            }
                        } else if ch == '"' || ch < 32 {
                            at = 0 - 1;
                        }
                        if at >= 0 && at + 2 <= len(out) {
                            out[at] = byte_of(ch);
                            at = at + 1;
                            if ch == 39 {
                                out[at] = byte_of(39);
                                at = at + 1;
                            }
                        } else {
                            at = 0 - 1;
                        }
                        k = k + 1;
                    }
                    at = put_part(out, at, "'");
                } else {
                    // a whole number: a sign and digits, at most 18 of them
                    var k = a;
                    if k < z && int_of(kv[k]) == '-' {
                        k = k + 1;
                    }
                    var digits = z - k >= 1 && z - k <= 18;
                    while k < z && digits {
                        digits = int_of(kv[k]) >= '0' && int_of(kv[k]) <= '9';
                        k = k + 1;
                    }
                    if digits {
                        at = put_part(out, at, kv[a..z]);
                    } else {
                        at = 0 - 1;
                    }
                }
            }
        }
        if at > 0 {
            // the statement as the log is told it: `Call cancho_erase` of the two strings (docs/spec/ir.md section 2), whose constants the store leaves out
            let ir = contents(b.ir);
            var p = 0;
            ir[0] = byte_of(5);
            p = build.put_be(ir, 1, 12, 2);
            p = put_part(ir, p, "cancho_erase");
            p = build.put_be(ir, p, 2, 4);
            ir[p] = byte_of(1);
            ir[p + 1] = byte_of(2);
            p = build.put_be(ir, p + 2, tl, 4);
            p = put_part(ir, p, sql[ta..ta + tl]);
            ir[p] = byte_of(1);
            ir[p + 1] = byte_of(2);
            p = build.put_be(ir, p + 2, vn, 4);
            p = put_part(ir, p, kv[0..vn]);
            contents(b.st)[15] = p;
        }
    }
    if at <= 0 {
        return erase_malformed();
    }
    return at;
}

// Whether the token lets its holder erase: the call `cancho_erase` (what it erases, the DELETE that runs is held to as any is).
pub fn may_erase[&k](tk: &k [byte]) -> [] bool {
    return len(tk) == 0 || allows(tk, 3, "cancho_erase");
}

// The erase that just ran is told to the transaction as the call it was (`erase_text` left it): false if it does not fit.
pub fn keep_erase[&q, &b](w: &!q exec.Work, b: &b Sub) -> [] bool {
    return exec.stmt_add(w, contents(b.ir)[0..contents(b.st)[15]]);
}

// The statement as `prepare` wrote it again.
pub fn text[&b](b: &b Sub) -> [] &b [byte] {
    return contents(b.text);
}

// What one statement needs to be read and lowered (docs/m3-engine.md 6ak): made for a statement of `cap` bytes, and holding afterwards how it went (`outcome` and what follows).
pub struct Run {
    tb: Box[[int]],
    nb: Box[[int]],
    kb: Box[[int]],
    vb: Box[[int]],
    ob: Box[[int]],
    rb: Box[[int]],
    st: Box[[int]],
    gb: Box[[int]],
    cb: Box[[int]],
    sc: Box[[int]],
    how: Box[[int]],
    schema: Box[[byte]],
    ir: Box[[byte]],
}

pub fn run_new[&h](heap: &!h Heap, n: int) -> [heap] Run {
    let cap = n + 4;
    return Run { tb: box_slice(heap, 4 * cap, 0), nb: box_slice(heap, 6 * (cap + 64), 0), kb: box_slice(heap, cap + 64, 0), vb: box_slice(heap, 64, 0), ob: box_slice(heap, 256, 0), rb: box_slice(heap, 512, 0), st: box_slice(heap, 16, 0), gb: box_slice(heap, cap, 0), cb: box_slice(heap, 16, 0), sc: box_slice(heap, 1024, 0), how: box_slice(heap, 8, 0), schema: box_slice(heap, 65536, byte_of(0)), ir: box_slice(heap, 65536, byte_of(0)) };
}

pub fn run_free[&h](heap: &!h Heap, m: Run) -> [heap] int {
    let Run { tb, nb, kb, vb, ob, rb, st, gb, cb, sc, how, schema, ir } = m;
    unbox_slice(heap, tb);
    unbox_slice(heap, nb);
    unbox_slice(heap, kb);
    unbox_slice(heap, vb);
    unbox_slice(heap, ob);
    unbox_slice(heap, rb);
    unbox_slice(heap, st);
    unbox_slice(heap, gb);
    unbox_slice(heap, cb);
    unbox_slice(heap, sc);
    unbox_slice(heap, how);
    unbox_slice(heap, schema);
    unbox_slice(heap, ir);
    return 0;
}

// How a statement went: answered; refused where it was read (`o_lex`, `o_parse`, `o_lower`: `code` is that stage's), as a write to a tree read AS OF (`o_as_of`), or by the
// engine (`o_refused`: `code` is below 0); an error a client is sent (`o_error`: `code` is above 0); or BEGIN, COMMIT or ROLLBACK, which the session answers (`o_control`).
pub fn o_ok() -> [] int {
    return 0;
}

pub fn o_lex() -> [] int {
    return 1;
}

pub fn o_parse() -> [] int {
    return 2;
}

pub fn o_lower() -> [] int {
    return 3;
}

pub fn o_as_of() -> [] int {
    return 4;
}

pub fn o_refused() -> [] int {
    return 5;
}

pub fn o_error() -> [] int {
    return 6;
}

pub fn o_control() -> [] int {
    return 7;
}

// Not run: the token of whoever asked does not allow one of its effects (6at).
pub fn o_denied() -> [] int {
    return 8;
}

pub fn outcome[&m](m: &m Run) -> [] int {
    return contents(m.how)[0];
}

pub fn code[&m](m: &m Run) -> [] int {
    return contents(m.how)[1];
}

// The kind of the statement that was answered (src/answer.cho; 9: an erase).
pub fn kind[&m](m: &m Run) -> [] int {
    return contents(m.how)[2];
}

// Whether the answer has rows: a SELECT, or a statement with RETURNING.
pub fn has_rows[&m](m: &m Run) -> [] bool {
    return contents(m.how)[3] == 1;
}

// The names of the answer's columns, each a `u16` length and the bytes.
pub fn names[&m](m: &m Run) -> [] &m [byte] {
    return contents(m.ir)[0..contents(m.how)[4]];
}

// The tag of a refusal (`outcome` one of the refusals).
pub fn refusal[&m](m: &m Run) -> [] &static [byte] {
    let o = contents(m.how)[0];
    let c = contents(m.how)[1];
    if o == o_lex() {
        return lex.error_name(c);
    }
    if o == o_parse() {
        return parse.error_name(c);
    }
    if o == o_lower() {
        return lower.error_name(c);
    }
    if o == o_as_of() {
        return "engine-as-of-write";
    }
    if o == o_denied() {
        return "effect-denied";
    }
    return exec.refusal_name(c);
}

fn done[&r](hw: &!r [int], o: int, c: int) -> [] int {
    hw[0] = o;
    hw[1] = c;
    return 0;
}

// Run the statement `sql` over the tree `root`: the tree after it (`root` itself unless the statement is answered), or `session.is_begin()`, `is_commit()`, `is_rollback()`.
// `mode` 0: as it is; 1: over a tree read AS OF (only a SELECT); 2: an erase (the statement is the DELETE that names the row); 3: in a transaction that has failed (nothing runs
// but what ends it). `part`: its parameters were added by `prepare`, after those the client bound. `tk`: the token of whoever asks (nothing: nobody is asked who they are);
// a statement with an effect it does not allow is not run (`o_denied`).
// Whether the token `tk` allows one effect: of `kind` (0 read, 1 write, 2 a definition) on `target`.
fn allows[&k, &t](tk: &k [byte], kind: int, target: &t [byte]) -> [] bool {
    var yes = true;
    region r {
        let enc = alloc_slice[r](3 + len(target), byte_of(0));
        enc[0] = byte_of(kind);
        build.put_be(enc, 1, len(target), 2);
        build.put_bytes(enc, 3, target);
        yes = !token.effect_denied(tk, enc, 0, 1);
    }
    return yes;
}

// Whether the token `tk` allows every effect of the lowered statement `e` (docs/m3-engine.md 6at): the effects are the ones the verifier infers from the IR (`ir.infer`),
// each held against every block of the token, as the proxy's guard does. No token: nothing is held against anything.
fn permitted[&h, &k, &e](heap: &!h Heap, tk: &k [byte], e: &e [byte]) -> [heap] bool {
    if len(tk) == 0 {
        return true;
    }
    var yes = true;
    var set = map.empty(heap, 16, 0, 3);
    region r {
        let info = alloc_slice[r](2, 0);
        let (grown, good) = ir.infer(heap, set, e, 2, info);
        set = grown;
        yes = good;
    }
    borrow set as &sr in {
        var i = 0;
        while i < map.entries(sr) && yes {
            if map.is_live(sr, i) {
                let key = map.key_at(sr, i);
                yes = allows(tk, int_of(key[0]), key[1..len(key)]);
            }
            i = i + 1;
        }
    }
    map.drop(heap, set);
    return yes;
}

// A statement of the IR for one of the engine's forms that has none, kept for the log: `tag` 3 a DELETE of the table named at the token `tok` with no condition, `tag` 4
// a definition of `kind` (docs/spec/ir.md section 2) of that name.
// Whether the IR is the statement `Call` of the function `name` with `argc` arguments (docs/spec/ir.md section 2: the tag, the name, the count, the arguments).
fn is_call[&e](e: &e [byte], name: &static [byte], argc: int) -> [] bool {
    if len(e) < 7 + len(name) || int_of(e[0]) != 5 || int_of(e[1]) != 0 || int_of(e[2]) != len(name) {
        return false;
    }
    var i = 0;
    while i < len(name) {
        if int_of(e[3 + i]) != int_of(name[i]) {
            return false;
        }
        i = i + 1;
    }
    let c = 3 + len(name);
    return int_of(e[c]) == 0 && int_of(e[c + 1]) == 0 && int_of(e[c + 2]) == 0 && int_of(e[c + 3]) == argc;
}

fn is_last_commit[&e](e: &e [byte]) -> [] bool {
    return is_call(e, "cancho_last_commit", 0) && len(e) == 7 + 18;
}

// The one argument of `cancho_log_archive(n)`, a whole number written as a constant: its value, or -1 if the IR is anything else.
fn archive_upto[&e](e: &e [byte]) -> [] int {
    let c = 7 + 18;
    if !is_call(e, "cancho_log_archive", 1) || len(e) != c + 10 || int_of(e[c]) != 1 || int_of(e[c + 1]) != 1 || int_of(e[c + 2]) >= 128 {
        return 0 - 1;
    }
    var v = 0;
    var i = 0;
    while i < 8 {
        v = v * 256 + int_of(e[c + 2 + i]);
        i = i + 1;
    }
    return v;
}

fn hex_digit(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return 0 - 1;
}

// The tree a SELECT whose tables are read `AS OF` a commit is run on (docs/m3-engine.md 6be; the syntax and the IR are the proxy's, docs/m2-branches.md D8): 0 if
// the statement just parsed reads no table that way; else the tree `root` as it was at that commit. The engine reads the whole statement over one tree, so every
// table of the statement must be read as of the same commit (one table as it was and another as it is, or two commits: `engine-unsupported`). The commit is
// looked up in the log the tree has (`asof-unknown-commit`) and the tree put back to the transaction it was (`exec.as_of`; `history-trimmed` if that past is
// gone). The tree answered is one to read and forget: nothing of it is the branch's.
fn as_of_view[&z, &q, &b, &s](pg: &!z pager.Pager, w: &!q exec.Work, m: &!b Run, sql: &s [byte], root: int) -> [file_read, file_write] int {
    var first = 0 - 1;
    var tables = 0;
    var with = 0;
    var same = true;
    var id = 0;
    while id < contents(m.st)[0] {
        if contents(m.nb)[6 * id] == parse.n_table() {
            tables = tables + 1;
            let tok = contents(m.nb)[6 * id + 5];
            if tok >= 0 {
                with = with + 1;
                if first < 0 {
                    first = tok;
                }
                same = same && parse.tlen(contents(m.tb), tok) == 64;
                var i = 0;
                while i < 64 && same {
                    same = int_of(sql[parse.tstart(contents(m.tb), tok) + i]) == int_of(sql[parse.tstart(contents(m.tb), first) + i]);
                    i = i + 1;
                }
            }
        }
        id = id + 1;
    }
    if with == 0 {
        return 0;
    }
    if !same || with != tables {
        return exec.unsupported();
    }
    var view = 0;
    region r {
        let ident = alloc_slice[r](32, byte_of(0));
        var i = 0;
        var hex = true;
        while i < 32 && hex {
            let hi = hex_digit(int_of(sql[parse.tstart(contents(m.tb), first) + 2 * i]));
            let lo = hex_digit(int_of(sql[parse.tstart(contents(m.tb), first) + 2 * i + 1]));
            hex = hi >= 0 && lo >= 0;
            ident[i] = byte_of((hi * 16 + lo) % 256);
            i = i + 1;
        }
        if !hex {
            view = exec.unsupported();
        } else {
            view = facts.txn_of(pg, w, root, ident);
            if view >= 0 {
                view = facts.as_of(pg, w, root, view);
            }
        }
    }
    return view;
}

// The SELECT, lowered again over the tables' own names (the IR that is kept says `AS OF`; the one that is run does not), on the tree `view` as it was.
fn select_as_of[&z, &q, &b, &s](pg: &!z pager.Pager, w: &!q exec.Work, m: &!b Run, sql: &s [byte], top: int, sl: int, view: int, root: int) -> [file_read] int {
    var rc = 0;
    region r {
        let ir2 = alloc_slice[r](32768, byte_of(0));
        let sc2 = alloc_slice[r](1024, 0);
        let l2 = lower.lower_plain(sql, contents(m.tb), contents(m.nb), contents(m.kb), top, contents(m.schema)[0..sl], contents(m.rb), ir2, sc2);
        if l2 < 0 {
            rc = exec.unsupported();
        } else {
            w.past = true;
            rc = execs.select(pg, w, view, ir2[0..l2], sc2);
            w.past = false;
        }
        // the tree read is not the branch's: the statement leaves the branch as it found it
        w.root = root;
    }
    // and the pages that tree was built of are given back: reading the past does not make the file grow
    pager.recycle(pg);
    return rc;
}

fn keep_named[&q, &s, &t](w: &!q exec.Work, sql: &s [byte], toks: &t [int], tok: int, tag: int, kind: int) -> [] bool {
    var ok = false;
    region r {
        let b = alloc_slice[r](300, byte_of(0));
        b[0] = byte_of(tag);
        var at = 1;
        if tag == 4 {
            b[1] = byte_of(kind);
            at = 2;
        }
        let nl = lower.name_text(sql, toks, tok, b[at + 2..at + 258], 0);
        if nl >= 0 {
            build.put_be(b, at, nl, 2);
            at = at + 2 + nl;
            if tag == 3 {
                // no WHERE
                b[at] = byte_of(0);
                at = at + 1;
            }
            ok = exec.stmt_add(w, b[0..at]);
        }
    }
    return ok;
}

// The same for one of the engine's forms that has no IR: a definition of, or a write to, the name at the token `tok` of the statement.
fn permitted_name[&k, &s, &t](tk: &k [byte], sql: &s [byte], toks: &t [int], tok: int, kind: int) -> [] bool {
    if len(tk) == 0 {
        return true;
    }
    var yes = false;
    region r {
        let name = alloc_slice[r](256, byte_of(0));
        let nl = lower.name_text(sql, toks, tok, name, 0);
        if nl >= 0 {
            yes = allows(tk, kind, name[0..nl]);
        }
    }
    return yes;
}

pub fn run[&h, &z, &q, &m, &s, &k](heap: &!h Heap, pg: &!z pager.Pager, w: &!q exec.Work, m: &!m Run, sql: &s [byte], root: int, mode: int, part: bool, tk: &k [byte]) -> [heap, file_read, file_write] int {
    let hw = contents(m.how);
    exec.stmts_clear(w);
    done(hw, o_ok(), 0);
    hw[2] = 0 - 1;
    hw[3] = 0;
    hw[4] = 0;
    exec.set_guard(w, 0);
    var sl = exec.schema(pg, w, root, contents(m.schema));
    if sl < 0 {
        done(hw, o_refused(), sl);
        return root;
    }
    let n = lex.tokenize(sql, contents(m.tb));
    if n < 0 {
        done(hw, o_lex(), 0 - n);
        return root;
    }
    if !exec.params_fit(w, sql, contents(m.tb), n, part) {
        done(hw, o_refused(), exec.unsupported());
        return root;
    }
    parse.reset(contents(m.st));
    let q0 = stmt.statement(sql, contents(m.tb), 0, n, contents(m.nb), contents(m.kb), contents(m.vb), contents(m.ob), contents(m.gb), contents(m.cb), contents(m.st));
    if q0 < 0 {
        done(hw, o_parse(), 0 - q0);
        return root;
    }
    let top = contents(m.st)[2];
    let head = contents(m.nb)[6 * top];
    if head == parse.n_begin() || head == parse.n_commit() || head == parse.n_rollback() {
        // the transaction's own statements are the session's to answer
        done(hw, o_control(), 0);
        if head == parse.n_commit() {
            return session.is_commit();
        }
        if head == parse.n_rollback() {
            return session.is_rollback();
        }
        return session.is_begin();
    }
    var rc = 0;
    var kind = 0 - 1;
    var returned = 0 - 1;
    var called = false;
    var archived = false;
    var trimmed = false;
    var erased = false;
    if mode == 3 {
        // the transaction has failed: nothing runs until it is ended
        rc = exec.e_aborted();
    } else if head == parse.n_create_seq() {
        // CREATE SEQUENCE has no IR: it is the engine's alone
        if mode != 0 || exec.params_bound(w) > 0 {
            rc = exec.unsupported();
        } else if !permitted_name(tk, sql, contents(m.tb), contents(m.nb)[6 * top + 1], 2) {
            done(hw, o_denied(), 2);
            return root;
        } else {
            rc = execw.create_sequence(pg, w, root, sql, contents(m.tb), contents(m.nb), top);
        }
        kind = answer.k_create_sequence();
    } else if head == parse.n_truncate() {
        // TRUNCATE has no IR either
        if mode != 0 || exec.params_bound(w) > 0 {
            rc = exec.unsupported();
        } else if !permitted_name(tk, sql, contents(m.tb), contents(m.nb)[6 * top + 1], 1) {
            done(hw, o_denied(), 1);
            return root;
        } else {
            rc = execd.truncate_table(pg, w, root, sql, contents(m.tb), contents(m.nb), top);
        }
        kind = answer.k_truncate();
    } else if head == parse.n_rename() {
        // nor has a table's renaming
        if mode != 0 || exec.params_bound(w) > 0 {
            rc = exec.unsupported();
        } else if !permitted_name(tk, sql, contents(m.tb), contents(m.nb)[6 * top + 1], 2) || !permitted_name(tk, sql, contents(m.tb), contents(m.nb)[6 * top + 4], 2) {
            // a renaming defines both names
            done(hw, o_denied(), 2);
            return root;
        } else {
            rc = execd.rename_table(pg, w, root, sql, contents(m.tb), contents(m.nb), top);
        }
        kind = answer.k_alter_table();
    } else {
        // a SELECT of tables as they were at a commit (6be) is read, and its names found, in the tree as it was then: a table since dropped is there, a column
        // since added is not
        var view = 0;
        if head == parse.n_select() && mode == 0 {
            view = as_of_view(pg, w, m, sql, root);
            if view < 0 {
                done(hw, o_refused(), view);
                return root;
            }
            if view > 0 {
                sl = exec.schema(pg, w, view, contents(m.schema));
                if sl < 0 {
                    done(hw, o_refused(), sl);
                    return root;
                }
            }
        }
        let ln = lower.lower(sql, contents(m.tb), contents(m.nb), contents(m.kb), top, contents(m.schema)[0..sl], contents(m.rb), contents(m.ir), contents(m.sc));
        if ln < 0 {
            done(hw, o_lower(), 0 - ln);
            return root;
        }
        let e = contents(m.ir)[0..ln];
        hw[5] = ln;
        kind = int_of(e[0]);
        if !permitted(heap, tk, e) {
            done(hw, o_denied(), kind);
            return root;
        }
        if mode == 1 && kind != 6 {
            // the tree read AS OF a transaction is not one to write to
            done(hw, o_as_of(), 0);
            return root;
        } else if mode == 2 {
            rc = execw.erase(pg, w, root, e, contents(m.sc));
            kind = 9;
        } else if mode == 4 && kind == 3 {
            // the server's erase (6bf): the row is deleted as a DELETE deletes it, with its fact for the log, and then it and its past are erased. The answer is
            // a row: whether the row was there, and how many entries of its past went
            rc = execw.delete(pg, w, root, e, contents(m.sc));
            if rc == 0 {
                let was = exec.count_of(w);
                // (what the delete counted and changed is kept across the erase, as a statement's is across the reading of what it returns)
                exec.ret_set(w, 2);
                rc = execw.erase(pg, w, exec.root_of(w), e, contents(m.sc));
                exec.ret_set(w, 0);
                if rc == 0 {
                    facts.erased(w, was, exec.count_of(w) - was);
                    called = true;
                    erased = true;
                    kind = 6;
                }
            }
        } else if kind == 6 && view > 0 {
            // tables read as of a commit (6be)
            rc = select_as_of(pg, w, m, sql, top, sl, view, root);
        } else if kind == 6 {
            rc = execs.select(pg, w, root, e, contents(m.sc));
        } else if kind == 1 && contents(m.nb)[6 * top + 1] > 0 && execw.guard_lower(w, sql, contents(m.tb), contents(m.nb), contents(m.kb), contents(m.nb)[6 * top + 1] - 1, contents(m.schema)[0..sl]) < 0 {
            // the condition of an `insert ... select ... where` does not lower
            rc = exec.unsupported();
        } else if (kind == 1 || kind == 2 || kind == 3) && contents(m.nb)[6 * top + 5] >= 0 {
            // RETURNING (6aa): the items are a SELECT over the table, read before the statement over no rows (what is wrong with them is known before anything is written) and
            // after it over the rows it wrote
            let rn = contents(m.nb)[6 * top + 5];
            region rr {
                let ir2 = alloc_slice[rr](32768, byte_of(0));
                let sc2 = alloc_slice[rr](1024, 0);
                let l2 = lower.lower(sql, contents(m.tb), contents(m.nb), contents(m.kb), rn, contents(m.schema)[0..sl], contents(m.rb), ir2, sc2);
                if l2 < 0 {
                    done(hw, o_lower(), 0 - l2);
                    return root;
                }
                if !permitted(heap, tk, ir2[0..l2]) {
                    // what a statement returns it reads
                    done(hw, o_denied(), 6);
                    return root;
                }
                exec.ret_set(w, 3);
                rc = execs.select(pg, w, root, ir2[0..l2], sc2);
                if rc == 0 {
                    exec.ret_set(w, 1);
                    if kind == 1 {
                        rc = execw.insert(pg, w, root, e, contents(m.sc), contents(m.nb)[6 * top + 4] == 1);
                    } else if kind == 2 {
                        rc = execw.update(pg, w, root, e, contents(m.sc));
                    } else {
                        rc = execw.delete(pg, w, root, e, contents(m.sc));
                    }
                    if rc == 0 {
                        let r1 = exec.root_of(w);
                        exec.ret_set(w, 2);
                        rc = execs.select(pg, w, r1, ir2[0..l2], sc2);
                        returned = rn;
                        // what it returns it read: that select is a statement of the commit too (6au)
                        if rc == 0 && !exec.stmt_add(w, ir2[0..l2]) {
                            rc = exec.too_big();
                        }
                    }
                }
                exec.ret_set(w, 0);
            }
        } else if kind == 1 {
            rc = execw.insert(pg, w, root, e, contents(m.sc), contents(m.nb)[6 * top + 4] == 1);
        } else if kind == 2 {
            rc = execw.update(pg, w, root, e, contents(m.sc));
        } else if kind == 3 {
            rc = execw.delete(pg, w, root, e, contents(m.sc));
        } else if kind == 4 && ln > 1 && int_of(e[1]) == 0 {
            rc = execw.create_table(pg, w, root, e, sql, contents(m.tb), contents(m.nb), contents(m.kb), top);
            kind = answer.k_create_table();
        } else if kind == 4 && ln > 1 && int_of(e[1]) == 2 {
            rc = execw.drop_table(pg, w, root, e);
            kind = answer.k_drop_table();
        } else if kind == 4 && ln > 1 && int_of(e[1]) == 1 {
            rc = execw.alter_add(pg, w, root, e, sql, contents(m.tb), contents(m.nb), contents(m.kb), top);
            kind = answer.k_alter_table();
        } else if kind == 4 && ln > 1 && int_of(e[1]) == 3 {
            rc = execd.create_index(pg, w, root, e, sql, contents(m.tb), contents(m.nb), contents(m.kb), top);
            kind = answer.k_create_index();
        } else if kind == 4 && ln > 1 && int_of(e[1]) == 4 {
            rc = execd.drop_index(pg, w, root, e, sql, contents(m.tb), contents(m.nb), top);
            kind = answer.k_drop_index();
        } else if kind == 5 && is_call(e, "cancho_history_trim", 0) && len(e) == 7 + 19 {
            // what the rows were before, taken out of the page file (6bb)
            rc = facts.trim(pg, w, root);
            called = true;
            trimmed = true;
            kind = 6;
        } else if kind == 5 && archive_upto(e) >= 0 {
            // the log's oldest part taken out of the page file by whoever has it elsewhere (6ba)
            rc = facts.archive(pg, w, root, archive_upto(e));
            called = true;
            archived = true;
            kind = 6;
        } else if kind == 5 && is_last_commit(e) {
            // the head of the log, for a client to hold a later log to (6ax)
            rc = facts.last(pg, w, root);
            called = true;
            kind = 6;
        } else {
            rc = exec.unsupported();
        }
    }
    if rc < 0 {
        done(hw, o_refused(), rc);
        return root;
    }
    if rc > 0 {
        done(hw, o_error(), rc);
        return root;
    }
    // what ran, as the log is told it (6au): the statement's IR; for the engine's forms that have none, the IR that says what they did
    var kept = true;
    if head == parse.n_truncate() {
        // every row deleted: a DELETE with no condition
        kept = keep_named(w, sql, contents(m.tb), contents(m.nb)[6 * top + 1], 3, 0 - 1);
    } else if head == parse.n_rename() {
        // a definition of both names
        kept = keep_named(w, sql, contents(m.tb), contents(m.nb)[6 * top + 1], 4, 1) && keep_named(w, sql, contents(m.tb), contents(m.nb)[6 * top + 4], 4, 1);
    } else if head == parse.n_create_seq() {
        kept = keep_named(w, sql, contents(m.tb), contents(m.nb)[6 * top + 1], 4, 0);
    } else if mode != 2 && mode != 4 {
        kept = exec.stmt_add(w, contents(m.ir)[0..hw[5]]);
    }
    if !kept {
        done(hw, o_refused(), exec.too_big());
        return root;
    }
    hw[2] = kind;
    if called {
        // the two columns of `cancho_last_commit()`
        hw[3] = 1;
        hw[4] = build.put_bytes(contents(m.ir), build.put_be(contents(m.ir), build.put_bytes(contents(m.ir), build.put_be(contents(m.ir), 0, 7, 2), "commits"), 2, 2), "id");
        if erased {
            hw[4] = build.put_bytes(contents(m.ir), build.put_be(contents(m.ir), build.put_bytes(contents(m.ir), build.put_be(contents(m.ir), 0, 3, 2), "row"), 4, 2), "past");
        }
        if trimmed {
            hw[4] = build.put_bytes(contents(m.ir), build.put_be(contents(m.ir), build.put_bytes(contents(m.ir), build.put_be(contents(m.ir), 0, 7, 2), "removed"), 11, 2), "transaction");
        }
        if archived {
            hw[4] = build.put_bytes(contents(m.ir), build.put_be(contents(m.ir), build.put_bytes(contents(m.ir), build.put_be(contents(m.ir), 0, 5, 2), "floor"), 7, 2), "commits");
        }
    } else if kind == 6 || returned >= 0 {
        // the names of the columns, as a client is sent them: what the lowering knows and the IR does not carry
        var top2 = top;
        if returned >= 0 {
            top2 = returned;
        }
        hw[3] = 1;
        hw[4] = lower.output_names(sql, contents(m.tb), contents(m.nb), contents(m.kb), top2, contents(m.schema)[0..sl], contents(m.sc), contents(m.ir));
    }
    return exec.root_of(w);
}
