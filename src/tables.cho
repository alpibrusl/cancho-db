edition 9;
module cdb.tables;

import cdb.commit;
import cdb.build;
import cdb.row;
import cdb.btree;
import cdb.pager;

// The tables of a branch, inside the branch's one tree (docs/m3-engine.md D-M3-8). A key of the tree is a table's number (`u32`) and then a row's stored key (src/row.cho); the number 0 is the catalog:
//
//     0x00000000                 -> the next table number to give out (`u32`); absent while no table was ever made (the first number is 1)
//     0x00000000 then a name     -> that table's entry
//     0x00000000 0x01 then a name -> the index of that name: the name of the table it is on (`index_key`)
//     0x00000000 0x02 then a table's number -> the value its identity column is given next (8 bytes; `counter_key`). Written when the table is made; never part of the history
//     0x00000000 0x03 then a name -> the sequence of that name (`sequence_key`): its number (`u32`, from the tables' numbers; its counter is `counter_key` of it) and its least value (8 bytes)
//     0x00000000 0x04            -> the head of the log (`head_key`, docs/m3-engine.md 6ah): the number of the branch's last commit (8 bytes), its id and its `state` (32 bytes each)
//
// and under the number 0xFFFFFFFE, which is no table's, the log (docs/m3-engine.md 6as):
//
//     0xFFFFFFFE 0x05            -> the public key the log is signed with (`log_key`); then a commit's number (8 bytes) and a part's (1): that part of its record (`record_key`)
//     0xFFFFFFFE 0x06 then a commit's number (8 bytes), a table, a zero byte and a key's commitment -> that fact of the commit: for each of was and is a byte and a hash (`fact_key`)
//     0xFFFFFFFE 0x07 then a token's id (32 bytes) and a part's number -> that part of the token, kept by the first commit made under it (`kept_key`, 6at)
//     0xFFFFFFFE 0x08 then a statement's id (32 bytes) and a part's number -> that part of the statement's record, its constants gone (`kept_key`, 6au)
//
// An entry: the table's number (`u32`), the length of its definition (`u16`), the definition (src/row.cho), then for each column one byte of marks (1: `not null`, 2: it has a default, 4: it has a
// range, 8: it is an identity column, whose values the table's counter gives) and, if it has a default, the default as a stored value (a tag and the value, as in a stored row), and if it has a range (`check (c between lo and hi)`, docs/m3-engine.md 6x) the two
// bounds, 8 bytes each (two's complement, big-endian). An entry is at most 800 bytes (a value of the tree).

pub fn max_name() -> [] int {
    return 63;
}

// The key of the entry of the table `name`, into `out`: its length, or -1 if the name is empty or too long.
pub fn entry_key[&n, &o](name: &n [byte], out: &!o [byte]) -> [] int {
    if len(name) < 1 || len(name) > max_name() || len(out) < 4 + len(name) {
        return 0 - 1;
    }
    build.put_be(out, 0, 0, 4);
    var i = 0;
    while i < len(name) {
        out[4 + i] = name[i];
        i = i + 1;
    }
    return 4 + len(name);
}

// The length of the stored value at `at` of `data` (its tag included), or -1 if there is none there.
pub fn stored_len[&d](data: &d [byte], at: int) -> [] int {
    if at < 0 || at >= len(data) {
        return 0 - 1;
    }
    let tag = int_of(data[at]);
    var n = 0 - 1;
    if tag == 0 {
        n = 1;
    } else if tag == 1 {
        n = 9;
    } else if tag == 2 {
        n = 2;
    } else if (tag == 3 || tag == 4) && at + 3 <= len(data) {
        n = 3 + commit.be(data, at + 1, 2);
    }
    if n < 0 || at + n > len(data) {
        return 0 - 1;
    }
    return n;
}

pub fn id_of[&e](ent: &e [byte]) -> [] int {
    return commit.be(ent, 0, 4);
}

pub fn def_len[&e](ent: &e [byte]) -> [] int {
    return commit.be(ent, 4, 2);
}

// Where the marks of column `i` are in the entry `ent` (an entry that `entry_ok`).
fn marks_at[&e](ent: &e [byte], i: int) -> [] int {
    var at = 6 + def_len(ent);
    var k = 0;
    while k < i {
        let m = int_of(ent[at]);
        at = at + 1;
        if m / 2 % 2 == 1 {
            at = at + stored_len(ent, at);
        }
        if m / 4 % 2 == 1 {
            at = at + 16;
        }
        k = k + 1;
    }
    return at;
}

// The identity column of the entry (an entry that `entry_ok`), or -1.
pub fn identity_col[&e](ent: &e [byte]) -> [] int {
    let n = row.columns(ent[6..6 + def_len(ent)]);
    var i = 0;
    while i < n {
        if int_of(ent[marks_at(ent, i)]) / 8 == 1 {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// The key of the sequence `name` in the catalog, into `out`: its length, or -1.
pub fn sequence_key[&n, &o](name: &n [byte], out: &!o [byte]) -> [] int {
    let n = index_key(name, out);
    if n > 0 {
        out[4] = byte_of(3);
    }
    return n;
}

// The key of the counter of the table numbered `id`, into `out` (at least 9 bytes): its length.
pub fn head_key[&o](out: &!o [byte]) -> [] int {
    build.put_be(out, 0, 0, 4);
    out[4] = byte_of(4);
    return 5;
}

// The log in the tree (docs/m3-engine.md 6as): the public key that signs it, a part of a commit's record, and where a commit's facts begin.
// (They are not in the catalog, which every statement reads from end to end: they are under a number no table has, `log_space()`, just below the history's.)
pub fn log_space() -> [] int {
    return 4294967294;
}

pub fn log_key[&o](out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(5);
    return 5;
}

pub fn record_key[&o](seq: int, part: int, out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(5);
    build.put_be(out, 5, seq, 8);
    out[13] = byte_of(part);
    return 14;
}

// A part of what is kept with the log under an id: under `kind` (7 a token, 6at; 8 a statement's record, 6au), the id, the part's number.
pub fn kept_key[&i, &o](kind: int, id: &i [byte], part: int, out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(kind);
    var k = 0;
    while k < 32 {
        out[5 + k] = id[k];
        k = k + 1;
    }
    out[37] = byte_of(part);
    return 38;
}

// How many times the pages nothing names were about to be taken back (docs/m3-engine.md 6az): a number in the tree, under the log's space, that a commit raises
// before the sweep that follows it. A reader of the file that finds it changed knows pages it read may have been written again.
pub fn sweeps_key[&o](out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(9);
    return 5;
}

// That number in the tree `root` (0 if it was never raised), or an error. `key` and `out` are scratch (5 and 8 bytes at least).
pub fn sweeps[&q, &s, &k, &o](p: &!q pager.Pager, sc: &!s [byte], root: int, key: &!k [byte], out: &!o [byte]) -> [file_read] int {
    let kl = sweeps_key(key);
    let n = btree.get(p, sc, root, key[0..kl], out);
    if n == btree.not_found() {
        return 0;
    }
    if n < 0 {
        return n;
    }
    if n != 8 {
        return btree.err_bad();
    }
    return commit.be(out, 0, 8);
}

// The tree `root` with that number one more: the new root, or an error.
pub fn sweeps_raise[&q, &s, &k, &o](p: &!q pager.Pager, sc: &!s [byte], root: int, key: &!k [byte], out: &!o [byte]) -> [file_read, file_write] int {
    let n = sweeps(p, sc, root, key, out);
    if n < 0 {
        return n;
    }
    build.put_be(out, 0, n + 1, 8);
    let kl = sweeps_key(key);
    return btree.put(p, sc, root, key[0..kl], out[0..8]);
}

// The number of the first commit whose record the tree still holds (docs/m3-engine.md 6ba): those before it were archived, 8 bytes under the log's space.
pub fn floor_key[&o](out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(10);
    return 5;
}

// The number of the last transaction whose history was trimmed away (docs/m3-engine.md 6bb): the tree as it was before it cannot be read any more. 8 bytes.
pub fn trim_key[&o](out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(11);
    return 5;
}

// A history entry by its key (docs/m3-engine.md 6bi): the tree key `k[0..kn]` and then the transaction's number as the history has it (newest first), so that the
// entries of one key are found without reading everyone's. Into `out`: its length. `past_prefix` is what the entries of a key begin with.
pub fn past_prefix[&k, &o](k: &k [byte], kn: int, out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(13);
    var i = 0;
    while i < kn {
        out[5 + i] = k[i];
        i = i + 1;
    }
    return 5 + kn;
}

pub fn past_key[&k, &o](k: &k [byte], kn: int, txn: int, out: &!o [byte]) -> [] int {
    let at = past_prefix(k, kn, out);
    build.put_be(out, at, 9223372036854775807 - txn, 8);
    return at + 8;
}

// Whether every history entry the tree has is findable by its key (6bi): there from a new tree's first transaction, or from a trim that found no history left.
pub fn indexed_key[&o](out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(14);
    return 5;
}

// The number of the tree's transaction that a commit of the log was (docs/m3-engine.md 6be), under the commit's id: what `AS OF` a commit reads the tree as of.
pub fn asof_key[&i, &o](id: &i [byte], out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(12);
    var k = 0;
    while k < 32 {
        out[5 + k] = id[k];
        k = k + 1;
    }
    return 37;
}

pub fn fact_key[&o](seq: int, out: &!o [byte]) -> [] int {
    build.put_be(out, 0, log_space(), 4);
    out[4] = byte_of(6);
    build.put_be(out, 5, seq, 8);
    return 13;
}

pub fn counter_key[&o](id: int, out: &!o [byte]) -> [] int {
    build.put_be(out, 0, 0, 4);
    out[4] = byte_of(2);
    build.put_be(out, 5, id, 4);
    return 9;
}

// Where the range of column `i` is in the entry (its low bound, 8 bytes, then its high bound), or -1 if it has none.
pub fn range_at[&e](ent: &e [byte], i: int) -> [] int {
    let at = marks_at(ent, i);
    let m = int_of(ent[at]);
    if m / 4 % 2 != 1 {
        return 0 - 1;
    }
    if m / 2 % 2 == 1 {
        return at + 1 + stored_len(ent, at + 1);
    }
    return at + 1;
}

pub fn not_null[&e](ent: &e [byte], i: int) -> [] bool {
    return int_of(ent[marks_at(ent, i)]) % 2 == 1;
}

// Where the default of column `i` is in the entry (a stored value), or -1 if it has none.
pub fn default_at[&e](ent: &e [byte], i: int) -> [] int {
    let at = marks_at(ent, i);
    if int_of(ent[at]) / 2 % 2 == 1 {
        return at + 1;
    }
    return 0 - 1;
}

// Whether `ent` is an entry: a number above 0, a definition that is one, marks of 0 to 15 for each column with a default and a range where they say so, and no bytes over.
pub fn entry_ok[&e](ent: &e [byte]) -> [] bool {
    if len(ent) < 8 || id_of(ent) < 1 {
        return false;
    }
    let dl = def_len(ent);
    if 6 + dl > len(ent) {
        return false;
    }
    let n = row.columns(ent[6..6 + dl]);
    if n < 1 {
        return false;
    }
    var at = 6 + dl;
    var k = 0;
    while k < n {
        if at >= len(ent) {
            return false;
        }
        let m = int_of(ent[at]);
        if m > 15 {
            return false;
        }
        at = at + 1;
        if m / 2 % 2 == 1 {
            let l = stored_len(ent, at);
            if l < 0 {
                return false;
            }
            at = at + l;
        }
        if m / 4 % 2 == 1 {
            if at + 16 > len(ent) {
                return false;
            }
            at = at + 16;
        }
        k = k + 1;
    }
    return at == len(ent);
}

// The entry of the table `name` in the tree `root`, copied into `out`: its length, `btree.not_found()`, or an error (`btree.err_bad()` if what is there is not an entry). `key` is scratch (at least 68 bytes).
pub fn find[&q, &s, &n, &k, &o](p: &!q pager.Pager, sc: &!s [byte], root: int, name: &n [byte], key: &!k [byte], out: &!o [byte]) -> [file_read] int {
    let kl = entry_key(name, key);
    if kl < 0 {
        return btree.not_found();
    }
    let n = btree.get(p, sc, root, key[0..kl], out);
    if n < 0 {
        return n;
    }
    if !entry_ok(out[0..n]) {
        return btree.err_bad();
    }
    return n;
}

// Add the table `name` with the entry `ent` (whose number is written here): the new root, or an error. The caller has checked that there is no such table.
pub fn create[&q, &s, &n, &k, &e](p: &!q pager.Pager, sc: &!s [byte], root: int, name: &n [byte], key: &!k [byte], ent: &!e [byte]) -> [file_read, file_write] int {
    if entry_key(name, key) < 0 {
        return btree.err_big();
    }
    var id = 1;
    var err = 0;
    region r {
        let b = alloc_slice[r](8, byte_of(0));
        let g = btree.get(p, sc, root, key[0..4], b);
        if g == 4 {
            id = commit.be(b, 0, 4);
        } else if g >= 0 {
            err = btree.err_bad();
        } else if g != btree.not_found() {
            err = g;
        }
        if err == 0 {
            build.put_be(b, 0, id + 1, 4);
            err = btree.put(p, sc, root, key[0..4], b[0..4]);
        }
    }
    if err < 0 {
        return err;
    }
    build.put_be(ent, 0, id, 4);
    return btree.put(p, sc, err, key[0..4 + len(name)], ent);
}

// Remove the entry of the table `name`: the new root, or an error. The table's rows are the caller's to remove.
pub fn remove[&q, &s, &n, &k](p: &!q pager.Pager, sc: &!s [byte], root: int, name: &n [byte], key: &!k [byte]) -> [file_read, file_write] int {
    let kl = entry_key(name, key);
    if kl < 0 {
        return btree.not_found();
    }
    return btree.del(p, sc, root, key[0..kl]);
}

fn lit[&o](out: &!o [byte], at: int, text: &static [byte]) -> [] int {
    var i = 0;
    while i < len(text) {
        out[at + i] = text[i];
        i = i + 1;
    }
    return at + len(text);
}

// The key of the index `name` in the catalog, into `out`: its length, or -1. An index is a name and the table it is on (the key's value): 0x00000000, 0x01, the name. A table's name does not begin
// with the byte 1, so the two kinds of key are apart.
pub fn index_key[&n, &o](name: &n [byte], out: &!o [byte]) -> [] int {
    if len(name) < 1 || len(name) > max_name() || len(out) < 5 + len(name) {
        return 0 - 1;
    }
    build.put_be(out, 0, 0, 4);
    out[4] = byte_of(1);
    var i = 0;
    while i < len(name) {
        out[5 + i] = name[i];
        i = i + 1;
    }
    return 5 + len(name);
}

// The snapshot the lowering reads (src/lower.cho): a line `name: column column ...` for each table of the tree `root` and a line `index name on table` for each index, into `out`: its length, or an error (`btree.err_big()` if `out` is too small).
// `key`, `key2` (at least 256 bytes each) and `ent` (at least 1024) are scratch.
pub fn schema_text[&q, &s, &k, &j, &e, &o](p: &!q pager.Pager, sc: &!s [byte], root: int, key: &!k [byte], key2: &!j [byte], ent: &!e [byte], out: &!o [byte]) -> [file_read] int {
    build.put_be(key, 0, 0, 4);
    var kl = 4;
    var at = 0;
    var more = root != 0;
    while more {
        let r = btree.next_after(p, sc, root, key[0..kl], false, key2, ent);
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return r;
        } else {
            let nk = r / 1024;
            let nv = r % 1024;
            if nk < 5 || commit.be(key2, 0, 4) != 0 {
                more = false;
            } else if int_of(key2[4]) == 2 || int_of(key2[4]) == 3 || int_of(key2[4]) == 4 {
                // a table's counter (`counter_key`), a sequence (`sequence_key`), the head of the log (`head_key`): no line
                var i = 0;
                while i < nk {
                    key[i] = key2[i];
                    i = i + 1;
                }
                kl = nk;
            } else if int_of(key2[4]) == 1 {
                // an index (`index_key`): a line `index NAME on TABLE`
                if at + 6 + (nk - 5) + 4 + nv + 1 > len(out) {
                    return btree.err_big();
                }
                at = lit(out, at, "index ");
                var i = 5;
                while i < nk {
                    out[at] = key2[i];
                    at = at + 1;
                    i = i + 1;
                }
                at = lit(out, at, " on ");
                i = 0;
                while i < nv {
                    out[at] = ent[i];
                    at = at + 1;
                    i = i + 1;
                }
                out[at] = byte_of('\n');
                at = at + 1;
                i = 0;
                while i < nk {
                    key[i] = key2[i];
                    i = i + 1;
                }
                kl = nk;
            } else {
                if !entry_ok(ent[0..nv]) {
                    return btree.err_bad();
                }
                let def = ent[6..6 + def_len(ent)];
                let n = row.columns(def);
                var need = nk - 4 + 2;
                var c = 0;
                while c < n {
                    need = need + 1 + len(row.col_name(def, c));
                    c = c + 1;
                }
                if at + need > len(out) {
                    return btree.err_big();
                }
                var i = 4;
                while i < nk {
                    out[at] = key2[i];
                    at = at + 1;
                    i = i + 1;
                }
                out[at] = byte_of(':');
                at = at + 1;
                c = 0;
                while c < n {
                    out[at] = byte_of(' ');
                    at = at + 1;
                    let nm = row.col_name(def, c);
                    i = 0;
                    while i < len(nm) {
                        out[at] = nm[i];
                        at = at + 1;
                        i = i + 1;
                    }
                    c = c + 1;
                }
                out[at] = byte_of('\n');
                at = at + 1;
                i = 0;
                while i < nk {
                    key[i] = key2[i];
                    i = i + 1;
                }
                kl = nk;
            }
        }
    }
    return at;
}
