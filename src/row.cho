edition 9;
module cdb.row;

import cdb.commit;
import cdb.build;

// Rows of the engine (docs/m3-engine.md D-M3-5 and D-M3-6, slice M3c): how a table is described, how a row and its key are stored, and the two texts the facts are made of: the row's *image*, which is
// byte for byte what PostgreSQL's `to_jsonb(row)::text` gives, and the *plain key*, which is `jsonb_build_array(<key columns>)::text`. Pure functions on bytes.
//
// A table definition: `u16` column count, then for each column its type (`u8`), its place in the primary key (`u8`: 0 if it is not part of it, else 1 for the first key column, 2 for the second...) and its
// name (`u16` length and bytes).
// Types: 1 integer (`smallint`, `integer`, `bigint`: one 64-bit value), 2 `boolean`, 3 text (`text`, `varchar`), 4 `bytea`.
// A stored row: for each column in order a tag, 0 for null or the column's type, then the value: integer 8 bytes (two's complement, big-endian), boolean 1 byte, text and bytea a `u16` length and the bytes.
// A stored key: for each key column in key order, integer as 8 bytes big-endian with the sign bit flipped, boolean as 1 byte, text and bytea as the bytes with each 0x00 written 0x00 0xFF and then 0x00 0x00:
// so keys compare as their values do, column by column.

pub fn t_int() -> [] int {
    return 1;
}

pub fn t_bool() -> [] int {
    return 2;
}

pub fn t_text() -> [] int {
    return 3;
}

pub fn t_bytea() -> [] int {
    return 4;
}

pub fn max_columns() -> [] int {
    return 64;
}

// The number of columns of the definition `def`, or -1 if it is not a well formed definition (a count of 1 to 64, known types, key places that are 1..k each once, names of at least one byte, no bytes over).
pub fn columns[&d](def: &d [byte]) -> [] int {
    if len(def) < 2 {
        return 0 - 1;
    }
    let n = commit.be(def, 0, 2);
    if n < 1 || n > max_columns() {
        return 0 - 1;
    }
    var at = 2;
    var i = 0;
    var keys = 0;
    var seen = 0;
    while i < n {
        if at + 4 > len(def) {
            return 0 - 1;
        }
        let ty = int_of(def[at]);
        let pk = int_of(def[at + 1]);
        let nl = commit.be(def, at + 2, 2);
        if ty < 1 || ty > 4 || nl < 1 || at + 4 + nl > len(def) || pk > n {
            return 0 - 1;
        }
        if pk > 0 {
            keys = keys + 1;
            seen = seen + pk;
        }
        at = at + 4 + nl;
        i = i + 1;
    }
    if at != len(def) || seen != keys * (keys + 1) / 2 {
        return 0 - 1;
    }
    return n;
}

// Where column `i` of `def` starts (its type byte). `def` is well formed.
fn col_at[&d](def: &d [byte], i: int) -> [] int {
    var at = 2;
    var k = 0;
    while k < i {
        at = at + 4 + commit.be(def, at + 2, 2);
        k = k + 1;
    }
    return at;
}

pub fn col_type[&d](def: &d [byte], i: int) -> [] int {
    return int_of(def[col_at(def, i)]);
}

pub fn col_pk[&d](def: &d [byte], i: int) -> [] int {
    return int_of(def[col_at(def, i) + 1]);
}

pub fn col_name[&d](def: &d [byte], i: int) -> [] &d [byte] {
    let at = col_at(def, i);
    return def[at + 4..at + 4 + commit.be(def, at + 2, 2)];
}

// How many columns the primary key has.
pub fn key_columns[&d](def: &d [byte]) -> [] int {
    let n = commit.be(def, 0, 2);
    var k = 0;
    var i = 0;
    while i < n {
        if col_pk(def, i) > 0 {
            k = k + 1;
        }
        i = i + 1;
    }
    return k;
}

// The length of the stored value at `at` of a row (its tag included), or -1 if it is not well formed there.
fn value_len[&r](row: &r [byte], at: int) -> [] int {
    if at >= len(row) {
        return 0 - 1;
    }
    let tag = int_of(row[at]);
    var n = 0 - 1;
    if tag == 0 {
        n = 1;
    } else if tag == 1 {
        n = 9;
    } else if tag == 2 {
        n = 2;
    } else if tag == 3 || tag == 4 {
        if at + 3 <= len(row) {
            n = 3 + commit.be(row, at + 1, 2);
        }
    }
    if n < 0 || at + n > len(row) {
        return 0 - 1;
    }
    return n;
}

// Where the value of column `i` starts in `row`, or -1 if the row is not a row of `def` up to there.
pub fn value_at[&d, &r](def: &d [byte], row: &r [byte], i: int) -> [] int {
    var at = 0;
    var k = 0;
    while k < i {
        let n = value_len(row, at);
        if n < 0 {
            return 0 - 1;
        }
        at = at + n;
        k = k + 1;
    }
    if value_len(row, at) < 0 {
        return 0 - 1;
    }
    return at;
}

// Whether `row` is a row of `def`: one value for each column, of the column's type or null, a boolean of 0 or 1, a key column not null, and no bytes over.
pub fn row_ok[&d, &r](def: &d [byte], row: &r [byte]) -> [] bool {
    let n = columns(def);
    if n < 0 {
        return false;
    }
    var at = 0;
    var i = 0;
    while i < n {
        let l = value_len(row, at);
        if l < 0 {
            return false;
        }
        let tag = int_of(row[at]);
        if tag == 0 {
            if col_pk(def, i) > 0 {
                return false;
            }
        } else if tag != col_type(def, i) {
            return false;
        } else if tag == 2 && int_of(row[at + 1]) > 1 {
            return false;
        }
        at = at + l;
        i = i + 1;
    }
    return at == len(row);
}

fn put1[&o](out: &!o [byte], at: int, c: int) -> [] int {
    if at < 0 || at >= len(out) {
        return 0 - 1;
    }
    out[at] = byte_of(c);
    return at + 1;
}

fn puts[&o, &t](out: &!o [byte], at: int, text: &t [byte]) -> [] int {
    var w = at;
    var i = 0;
    while i < len(text) && w >= 0 {
        w = put1(out, w, int_of(text[i]));
        i = i + 1;
    }
    return w;
}

fn hexdigit(v: int) -> [] int {
    if v < 10 {
        return '0' + v;
    }
    return 'a' + v - 10;
}

// A JSON string as PostgreSQL's jsonb writes it: `"` and `\` escaped, \b \f \n \r \t by name, any other byte under 0x20 as \u00XX (lower-case hex), everything else as it is.
fn json_string[&o, &t](out: &!o [byte], at: int, text: &t [byte]) -> [] int {
    var w = put1(out, at, '"');
    var i = 0;
    while i < len(text) && w >= 0 {
        let c = int_of(text[i]);
        if c == '"' || c == '\\' {
            w = put1(out, w, '\\');
            w = put1(out, w, c);
        } else if c == 8 {
            w = puts(out, w, "\\b");
        } else if c == 12 {
            w = puts(out, w, "\\f");
        } else if c == 10 {
            w = puts(out, w, "\\n");
        } else if c == 13 {
            w = puts(out, w, "\\r");
        } else if c == 9 {
            w = puts(out, w, "\\t");
        } else if c < 32 {
            w = puts(out, w, "\\u00");
            w = put1(out, w, hexdigit(c / 16));
            w = put1(out, w, hexdigit(c % 16));
        } else {
            w = put1(out, w, c);
        }
        i = i + 1;
    }
    return put1(out, w, '"');
}

// The 64-bit integer stored in the 8 bytes at `at`, in decimal.
fn json_int[&o, &r](out: &!o [byte], at: int, row: &r [byte], vat: int) -> [] int {
    // read as sign and magnitude without leaving 64 bits: the most negative value has no positive twin, so the digits are taken from the negative side
    var neg = int_of(row[vat]) >= 128;
    var v = 0;
    var i = 0;
    while i < 8 {
        var b = int_of(row[vat + i]);
        if neg {
            b = b - 255;
        }
        v = v * 256 + b;
        i = i + 1;
    }
    if neg {
        v = v - 1;
    }
    var w = at;
    if neg {
        w = put1(out, w, '-');
    }
    var digits = 1;
    var t = v;
    while t >= 10 || t <= 0 - 10 {
        t = t / 10;
        digits = digits + 1;
    }
    if w < 0 || w + digits > len(out) {
        return 0 - 1;
    }
    var k = digits;
    t = v;
    while k > 0 {
        var d = t % 10;
        if d < 0 {
            d = 0 - d;
        }
        out[w + k - 1] = byte_of('0' + d);
        t = t / 10;
        k = k - 1;
    }
    return w + digits;
}

// The stored value at `vat` of `row` as jsonb text.
fn json_value[&o, &r](out: &!o [byte], at: int, row: &r [byte], vat: int) -> [] int {
    let tag = int_of(row[vat]);
    if tag == 0 {
        return puts(out, at, "null");
    }
    if tag == 1 {
        return json_int(out, at, row, vat + 1);
    }
    if tag == 2 {
        if int_of(row[vat + 1]) == 1 {
            return puts(out, at, "true");
        }
        return puts(out, at, "false");
    }
    let n = commit.be(row, vat + 1, 2);
    if tag == 3 {
        return json_string(out, at, row[vat + 3..vat + 3 + n]);
    }
    // bytea: PostgreSQL's hex output, `\x` and two digits a byte, as a JSON string (so the backslash is doubled)
    var w = puts(out, at, "\"\\\\x");
    var i = 0;
    while i < n && w >= 0 {
        w = put1(out, w, hexdigit(int_of(row[vat + 3 + i]) / 16));
        w = put1(out, w, hexdigit(int_of(row[vat + 3 + i]) % 16));
        i = i + 1;
    }
    return put1(out, w, '"');
}

// Whether column name `a` comes before `b` in a jsonb object: the shorter first, then by bytes.
fn name_before[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    if len(x) != len(y) {
        return len(x) < len(y);
    }
    var i = 0;
    while i < len(x) {
        if int_of(x[i]) != int_of(y[i]) {
            return int_of(x[i]) < int_of(y[i]);
        }
        i = i + 1;
    }
    return false;
}

// The image of `row` (a row of `def`: `row_ok`), written into `out`: its length, or -1 if `out` is too small. It is `to_jsonb(row)::text`: an object of the columns in jsonb's key order (shorter names first,
// then by bytes), `{"a": 1, "bb": "x"}`.
pub fn image[&d, &r, &o](def: &d [byte], row: &r [byte], out: &!o [byte]) -> [] int {
    let n = commit.be(def, 0, 2);
    var w = put1(out, 0, '{');
    var done = 0;
    var last = 0 - 1;
    while done < n && w >= 0 {
        // the next column in jsonb order: the least name that comes after the last one written
        var best = 0 - 1;
        var i = 0;
        while i < n {
            var after = last < 0;
            if !after {
                after = name_before(col_name(def, last), col_name(def, i));
            }
            if after {
                if best < 0 {
                    best = i;
                } else if name_before(col_name(def, i), col_name(def, best)) {
                    best = i;
                }
            }
            i = i + 1;
        }
        if best < 0 {
            return 0 - 1;
        }
        if done > 0 {
            w = puts(out, w, ", ");
        }
        w = json_string(out, w, col_name(def, best));
        w = puts(out, w, ": ");
        if w >= 0 {
            w = json_value(out, w, row, value_at(def, row, best));
        }
        last = best;
        done = done + 1;
    }
    return put1(out, w, '}');
}

// The column that is place `k` (1 for the first) of the primary key, or -1.
fn key_col[&d](def: &d [byte], k: int) -> [] int {
    let n = commit.be(def, 0, 2);
    var i = 0;
    while i < n {
        if col_pk(def, i) == k {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// The plain key of `row`, written into `out`: its length, or -1. It is `jsonb_build_array(<the key columns in key order>)::text`: `[1]`, `["a@b", 2]`.
pub fn plain_key[&d, &r, &o](def: &d [byte], row: &r [byte], out: &!o [byte]) -> [] int {
    let kc = key_columns(def);
    var w = put1(out, 0, '[');
    var k = 1;
    while k <= kc && w >= 0 {
        if k > 1 {
            w = puts(out, w, ", ");
        }
        if w >= 0 {
            w = json_value(out, w, row, value_at(def, row, key_col(def, k)));
        }
        k = k + 1;
    }
    return put1(out, w, ']');
}

// The stored key of `row`, written into `out`: its length, or -1 if `out` is too small.
pub fn stored_key[&d, &r, &o](def: &d [byte], row: &r [byte], out: &!o [byte]) -> [] int {
    let kc = key_columns(def);
    var w = 0;
    var k = 1;
    while k <= kc && w >= 0 {
        let vat = value_at(def, row, key_col(def, k));
        let tag = int_of(row[vat]);
        if tag == 1 {
            var i = 0;
            while i < 8 && w >= 0 {
                var b = int_of(row[vat + 1 + i]);
                if i == 0 {
                    b = (b + 128) % 256;
                }
                w = put1(out, w, b);
                i = i + 1;
            }
        } else if tag == 2 {
            w = put1(out, w, int_of(row[vat + 1]));
        } else {
            let n = commit.be(row, vat + 1, 2);
            var i = 0;
            while i < n && w >= 0 {
                let b = int_of(row[vat + 3 + i]);
                w = put1(out, w, b);
                if b == 0 {
                    w = put1(out, w, 255);
                }
                i = i + 1;
            }
            w = put1(out, w, 0);
            w = put1(out, w, 0);
        }
        k = k + 1;
    }
    return w;
}
