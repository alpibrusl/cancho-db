edition 9;
module cdb.pager;

import std.crc;
import cdb.commit;
import cdb.build;

// The page file of the engine (docs/m3-engine.md, slice M3a): fixed pages of 4 KiB, read and written by number, each with a CRC-32 of its own bytes, over one file opened read-write (not append: a page is
// overwritten in place only when the caller says so, and the tree of src/btree.cho never overwrites a page a root still names).
//
// A page's first seven bytes are its header: byte 0 the type, bytes 1 and 2 an entry count, bytes 3 to 6 the CRC-32 of bytes 7 to 4095. A page that was never written (zeros), or was cut short, or had a bit
// flipped, does not match its CRC and is refused (`-2`): the engine never trusts a page it has not checked.
//
// Test hook (docs/m3-engine.md D-M3-7): every write and every sync is a numbered *step*. With `crash` set to n the n-th step does not happen (a write may happen in part, `torn` bytes of it) and every step
// after it is refused (`-3`), which leaves on disk exactly what a process killed there would leave. `crash` is 0 in the engine.

pub fn page_size() -> [] int {
    return 4096;
}

pub fn header_size() -> [] int {
    return 7;
}

pub res struct Pager {
    file: File,
    // the next page number to hand out: the file's length in pages when it was opened, then one more for each `alloc`. Page 0 is never a page of a tree (a root of 0 is an empty tree), and pages 1 and 2 are the
    // two superblocks (src/pstore.cho): the first page handed out is 3.
    next: int,
    crash: int,
    torn: int,
    steps: int,
    dead: bool,
    // pages no root names, zeroed, to be handed out again before the file grows (`cdb.pstore.sweep` fills it)
    free: Box[[int]],
    nfree: int,
    // the pages handed out since `begin` (a mark for each page of the first `fresh_max()`, and the list of those marked, to clear them): pages no root names yet, which the tree may write again in place
    fresh: Box[[byte]],
    flist: Box[[int]],
    nfl: int,
    window: bool,
    // pages that were read and found whole, or written whole, kept in memory (`cache_slots()` of them, page `id` in slot `id % cache_slots()`; `ctag` says which page a slot holds, 0 for none): a
    // page is checked once, not at every walk down the tree
    cache: Box[[byte]],
    ctag: Box[[int]],
    // a page of the open window that is in the cache and not yet in the file (`cdirty`, by slot; `dlist` the slots to write, `ndl` of them): it is written once, when the window closes, however often
    // the statement wrote it
    cdirty: Box[[byte]],
    dlist: Box[[int]],
    ndl: int,
    // the pages handed out since the base (docs/m3-engine.md 6bh): a mark for each page of the first `fresh_max()` (1: handed out; 2: handed out, given back by `recycle` and free, not
    // zeroed) and the list of those marked (`born_max()`; `over` if it did not hold them all, or a page was beyond the marks). `based`: there is a base, the tree `base`, and when
    // it was made the file held nothing else but zeroed pages and the two catalog pages `bcat0` and `bcat1`.
    born: Box[[byte]],
    blist: Box[[int]],
    nb: int,
    over: bool,
    based: bool,
    base: int,
    bcat0: int,
    bcat1: int,
}

pub fn free_max() -> [] int {
    return 65536;
}

pub fn fresh_max() -> [] int {
    return 4194304;
}

pub fn born_max() -> [] int {
    return 262144;
}

pub fn cache_slots() -> [] int {
    return 8192;
}

pub fn new_pager[&h](heap: &!h Heap, file: File, length: int) -> [heap] Pager {
    var next = length / 4096;
    if next < 3 {
        next = 3;
    }
    return Pager { file: file, next: next, crash: 0, torn: 0, steps: 0, dead: false, free: box_slice(heap, free_max(), 0), nfree: 0, fresh: box_slice(heap, fresh_max(), byte_of(0)), flist: box_slice(heap, free_max(), 0), nfl: 0, window: false, cache: box_slice(heap, 4096 * cache_slots(), byte_of(0)), ctag: box_slice(heap, cache_slots(), 0), cdirty: box_slice(heap, cache_slots(), byte_of(0)), dlist: box_slice(heap, 2 * cache_slots(), 0), ndl: 0, born: box_slice(heap, fresh_max(), byte_of(0)), blist: box_slice(heap, born_max(), 0), nb: 0, over: false, based: false, base: 0, bcat0: 0, bcat1: 0 };
}

pub fn drop_pager[&h](heap: &!h Heap, p: Pager) -> [heap] int {
    let Pager { file, next, crash, torn, steps, dead, free, nfree, fresh, flist, nfl, window, cache, ctag, cdirty, dlist, ndl, born, blist, nb, over, based, base, bcat0, bcat1 } = p;
    unbox_slice(heap, born);
    unbox_slice(heap, blist);
    unbox_slice(heap, free);
    unbox_slice(heap, fresh);
    unbox_slice(heap, flist);
    unbox_slice(heap, cache);
    unbox_slice(heap, ctag);
    unbox_slice(heap, cdirty);
    unbox_slice(heap, dlist);
    return file_close(file);
}

// The test hook: stop at step `crash` (0 for never), writing `torn` bytes of it if it is a write (0 for none).
pub fn set_crash[&q](p: &!q Pager, crash: int, torn: int) -> [] int {
    p.crash = crash;
    p.torn = torn;
    return 0;
}

pub fn steps[&q](p: &q Pager) -> [] int {
    return p.steps;
}

pub fn crashed[&q](p: &q Pager) -> [] bool {
    return p.dead;
}

// A new page number: a free page if there is one, else the file grows. Inside a window (`begin`) the page is marked as handed out in it.
pub fn alloc[&q](p: &!q Pager) -> [] int {
    var id = p.next;
    if p.nfree > 0 {
        p.nfree = p.nfree - 1;
        id = contents(p.free)[p.nfree];
    } else {
        p.next = p.next + 1;
    }
    if p.window && id < fresh_max() && p.nfl < free_max() {
        contents(p.fresh)[id] = byte_of(1);
        contents(p.flist)[p.nfl] = id;
        p.nfl = p.nfl + 1;
    }
    // born since the base (6bh)
    if id >= fresh_max() {
        p.over = true;
    } else if int_of(contents(p.born)[id]) == 2 {
        // given back by a read of the past and handed out again: it is in the list
        contents(p.born)[id] = byte_of(1);
    } else if int_of(contents(p.born)[id]) == 0 {
        if p.nb < born_max() {
            contents(p.born)[id] = byte_of(1);
            contents(p.blist)[p.nb] = id;
            p.nb = p.nb + 1;
        } else {
            p.over = true;
        }
    }
    return id;
}

// The base (6bh): the tree it is, or -1 if there is none to work from (no sweep left one, or more pages were handed out since than the list holds).
pub fn base[&q](p: &q Pager) -> [] int {
    if !p.based || p.over {
        return 0 - 1;
    }
    return p.base;
}

// One of the two catalog pages the superblocks named when the base was made (`i` 0 or 1).
pub fn base_catalog[&q](p: &q Pager, i: int) -> [] int {
    if i == 0 {
        return p.bcat0;
    }
    return p.bcat1;
}

pub fn born_count[&q](p: &q Pager) -> [] int {
    return p.nb;
}

pub fn born_at[&q](p: &q Pager, i: int) -> [] int {
    return contents(p.blist)[i];
}

// What is known of page `id` since the base: 0 it was not handed out, 1 it was, 2 it was and a read of the past gave it back (it is free and may not be zeros).
pub fn born[&q](p: &q Pager, id: int) -> [] int {
    if id < 0 || id >= fresh_max() {
        return 0;
    }
    return int_of(contents(p.born)[id]);
}

// From here on the base is the tree `root` (`ok`), or there is none (a sweep that could not leave one): nothing is born yet. `c0` and `c1` are the catalog pages the
// two superblocks name.
pub fn rebase[&q](p: &!q Pager, root: int, ok: bool, c0: int, c1: int) -> [] int {
    var i = 0;
    if p.over {
        // the list does not say which marks are set
        while i < fresh_max() {
            contents(p.born)[i] = byte_of(0);
            i = i + 1;
        }
    } else {
        while i < p.nb {
            contents(p.born)[contents(p.blist)[i]] = byte_of(0);
            i = i + 1;
        }
    }
    p.nb = 0;
    p.over = false;
    p.based = ok;
    p.base = root;
    p.bcat0 = c0;
    p.bcat1 = c1;
    return 0;
}

// A window begins (a statement, docs/m3-engine.md 6p): from here until the next `begin`, a page handed out by `alloc` is one that no root names yet, and `is_fresh` says so. The caller's side of the
// bargain: within a window it builds ONE tree from each tree it started with, and uses only the newest (an older one may share a page that has since been written again).
pub fn begin[&q](p: &!q Pager) -> [file_write] int {
    // what the window before left in memory goes to the file first: 0, or what `write_page` answers
    let fr = flush(p);
    var i = 0;
    while i < p.nfl {
        contents(p.fresh)[contents(p.flist)[i]] = byte_of(0);
        i = i + 1;
    }
    p.nfl = 0;
    p.window = true;
    return fr;
}

// The pages handed out in the window that is open are given back (docs/m3-engine.md 6be): for a statement that built a tree only to read it and forget it, so
// that reading does not make the file grow. The caller says by this that no root names them. They are free to be handed out again at once; what they hold is
// zeroed at the next sweep like any page nothing names, or by the next erase (6bh). How many.
pub fn recycle[&q](p: &!q Pager) -> [] int {
    var i = 0;
    var given = 0;
    while i < p.nfl {
        let id = contents(p.flist)[i];
        contents(p.fresh)[id] = byte_of(0);
        if push_free(p, id) {
            given = given + 1;
            // free, and it may hold what the tree read held: the next erase zeroes it (6bh)
            if id < fresh_max() && int_of(contents(p.born)[id]) == 1 {
                contents(p.born)[id] = byte_of(2);
            }
        }
        i = i + 1;
    }
    p.nfl = 0;
    return given;
}

// Whether page `id` was handed out in the window that is open.
pub fn is_fresh[&q](p: &!q Pager, id: int) -> [] bool {
    return p.window && id >= 3 && id < fresh_max() && int_of(contents(p.fresh)[id]) == 1;
}

pub fn next_page[&q](p: &q Pager) -> [] int {
    return p.next;
}

// Read page `id` into `out` (4096 bytes): 0 if it is there and its CRC matches, -1 if the file could not be read, -2 if the page is missing, short or damaged.
pub fn read_page[&q, &o](p: &!q Pager, id: int, out: &!o [byte]) -> [file_read] int {
    if id < 1 || len(out) < 4096 {
        return 0 - 2;
    }
    let slot = id % cache_slots();
    if contents(p.ctag)[slot] == id {
        let from = 4096 * slot;
        var i = 0;
        while i < 4096 {
            out[i] = contents(p.cache)[from + i];
            i = i + 1;
        }
        return 0;
    }
    var got = 0;
    while got < 4096 {
        match file_pread(p.file, id * 4096 + got, out[got..4096]) {
            Read::Got(n) => {
                if n <= 0 {
                    return 0 - 2;
                }
                got = got + n;
            }
            Read::End => {
                return 0 - 2;
            }
            Read::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    if crc.crc32_of(out[7..4096]) != commit.be(out, 3, 4) {
        return 0 - 2;
    }
    keep(p, id, out);
    return 0;
}

// Where page `id` is in the cache (`bytes`), if it is there: so that a reader that only looks need not copy it. -1 if it is not (read it with `read_page`, which puts it there).
pub fn pin[&q](p: &q Pager, id: int) -> [] int {
    if id < 1 {
        return 0 - 1;
    }
    let slot = id % cache_slots();
    if contents(p.ctag)[slot] == id {
        return 4096 * slot;
    }
    return 0 - 1;
}

// Page `id` is the open window's own (no root names it) and is in the cache: where it is there, and it is already marked as to be written when the window closes. The caller may then change it
// where it is (`bytes_mut`), which is what PostgreSQL does with a page it has pinned. -1 if the page is not such a page.
pub fn own[&q](p: &!q Pager, id: int) -> [] int {
    if !is_fresh(p, id) {
        return 0 - 1;
    }
    let slot = id % cache_slots();
    if contents(p.ctag)[slot] != id {
        return 0 - 1;
    }
    if int_of(contents(p.cdirty)[slot]) != 1 {
        // already written to the file in this window (the list of pages to write filled up): the caller takes the long way, which marks it again
        return 0 - 1;
    }
    return 4096 * slot;
}

pub fn bytes_mut[&q](p: &!q Pager) -> [] &!q [byte] {
    return contents(p.cache);
}

pub fn bytes[&q](p: &q Pager) -> [] &q [byte] {
    return contents(p.cache);
}

// Page `id` is `page` on the file, whole: remember it.
fn keep[&q, &o](p: &!q Pager, id: int, page: &o [byte]) -> [] int {
    let slot = id % cache_slots();
    if int_of(contents(p.cdirty)[slot]) == 1 && contents(p.ctag)[slot] != id {
        // the slot holds a page that is only there: it stays
        return 0;
    }
    let to = 4096 * slot;
    var i = 0;
    while i < 4096 {
        contents(p.cache)[to + i] = page[i];
        i = i + 1;
    }
    contents(p.ctag)[slot] = id;
    return 0;
}

// What is remembered of page `id` is no longer what the file holds (or may not be).
fn forget[&q](p: &!q Pager, id: int) -> [] int {
    let slot = id % cache_slots();
    if contents(p.ctag)[slot] == id {
        contents(p.ctag)[slot] = 0;
        contents(p.cdirty)[slot] = byte_of(0);
    }
    return 0;
}

// Write the page a slot holds, if it is not in the file yet: 0, or what `store` answers.
fn flush_slot[&q](p: &!q Pager, slot: int) -> [file_write] int {
    if int_of(contents(p.cdirty)[slot]) != 1 {
        return 0;
    }
    contents(p.cdirty)[slot] = byte_of(0);
    let id = contents(p.ctag)[slot];
    return store(p, id, contents(p.cache)[4096 * slot..4096 * slot + 4096]);
}

// Write every page that is only in memory: 0, or the first failure.
pub fn flush[&q](p: &!q Pager) -> [file_write] int {
    var rc = 0;
    var i = 0;
    while i < p.ndl && rc == 0 {
        rc = flush_slot(p, contents(p.dlist)[i]);
        i = i + 1;
    }
    p.ndl = 0;
    return rc;
}

// Write page `page` (4096 bytes) as page `id`. A page of the open window (`is_fresh`: no root names it yet) is kept in memory and written when the window closes (`begin`, `sync`), once however often it
// is written here; any other page is written now. 0, -1 if the write failed, -3 if the crash point was reached before (or at) this step.
pub fn write_page[&q, &o](p: &!q Pager, id: int, page: &!o [byte]) -> [file_write] int {
    if id < 1 || len(page) < 4096 {
        return 0 - 1;
    }
    if p.dead {
        return 0 - 3;
    }
    if is_fresh(p, id) {
        let slot = id % cache_slots();
        if contents(p.ctag)[slot] != id {
            let r = flush_slot(p, slot);
            if r < 0 {
                return r;
            }
        }
        if p.ndl >= 2 * cache_slots() {
            let r = flush(p);
            if r < 0 {
                return r;
            }
        }
        let to = 4096 * slot;
        var i = 0;
        while i < 4096 {
            contents(p.cache)[to + i] = page[i];
            i = i + 1;
        }
        contents(p.ctag)[slot] = id;
        if int_of(contents(p.cdirty)[slot]) != 1 {
            contents(p.cdirty)[slot] = byte_of(1);
            contents(p.dlist)[p.ndl] = slot;
            p.ndl = p.ndl + 1;
        }
        return 0;
    }
    forget(p, id);
    let r = store(p, id, page);
    if r < 0 {
        return r;
    }
    keep(p, id, page);
    return 0;
}

// Put `page` in the file as page `id`, its CRC stamped here: a step (the crash hook counts it). 0, -1, or -3.
fn store[&q, &o](p: &!q Pager, id: int, page: &!o [byte]) -> [file_write] int {
    build.put_be(page, 3, crc.crc32_of(page[7..4096]), 4);
    if p.dead {
        return 0 - 3;
    }
    p.steps = p.steps + 1;
    var upto = 4096;
    if p.crash > 0 && p.steps == p.crash {
        p.dead = true;
        upto = p.torn;
        if upto <= 0 {
            return 0 - 3;
        }
    }
    var at = 0;
    while at < upto {
        match file_pwrite(p.file, id * 4096 + at, page[at..upto]) {
            Done::Ok(n) => {
                if n <= 0 {
                    return 0 - 1;
                }
                at = at + n;
            }
            Done::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    if p.dead {
        return 0 - 3;
    }
    return 0;
}

// Make what was written durable: `fsync`. 0, -1 if it failed (the engine stops: a failed sync is the end of the process, docs/m3-engine.md section 2), -3 at the crash point.
pub fn sync[&q](p: &!q Pager) -> [file_write] int {
    if p.dead {
        return 0 - 3;
    }
    let fr = flush(p);
    if fr < 0 {
        return fr;
    }
    p.steps = p.steps + 1;
    if p.crash > 0 && p.steps == p.crash {
        p.dead = true;
        return 0 - 3;
    }
    match file_sync(p.file) {
        Done::Ok(n) => {
            return 0;
        }
        Done::Failed(e) => {
            return 0 - 1;
        }
    }
}

// Test hook: flip one bit of byte `off` of page `id`, in the file, without stamping the CRC again (what a bad sector or a stray write does), so that the page is refused when it is next read. Flipping the same
// byte again puts it back. 0, or -1 if the file could not be read or written.
pub fn flip[&q](p: &!q Pager, id: int, off: int) -> [file_read, file_write] int {
    var rc = 0;
    forget(p, id);
    region r {
        let b = alloc_slice[r](1, byte_of(0));
        match file_pread(p.file, id * 4096 + off, b) {
            Read::Got(n) => {
                let v = int_of(b[0]);
                b[0] = byte_of(v - v % 2 + 1 - v % 2);
                match file_pwrite(p.file, id * 4096 + off, b) {
                    Done::Ok(m) => {
                    }
                    Done::Failed(e) => {
                        rc = 0 - 1;
                    }
                }
            }
            Read::End => {
                rc = 0 - 1;
            }
            Read::Failed(e) => {
                rc = 0 - 1;
            }
        }
    }
    return rc;
}

// Whether page `id` is zeros in the file (1), is not (0), or the file could not be read (-1). What the cache holds and the file does not yet is written first.
pub fn blank[&q](p: &!q Pager, id: int) -> [file_read, file_write] int {
    if flush(p) < 0 {
        return 0 - 1;
    }
    var rc = 1;
    region r {
        let buf = alloc_slice[r](4096, byte_of(0));
        var got = 0;
        var going = true;
        while going && got < 4096 {
            match file_pread(p.file, id * 4096 + got, buf[got..4096]) {
                Read::Got(n) => {
                    if n <= 0 {
                        going = false;
                    }
                    got = got + n;
                }
                Read::End => {
                    going = false;
                }
                Read::Failed(e) => {
                    going = false;
                    rc = 0 - 1;
                }
            }
        }
        var i = 0;
        while i < got && rc == 1 {
            if int_of(buf[i]) != 0 {
                rc = 0;
            }
            i = i + 1;
        }
    }
    return rc;
}

// Forget the free pages (before a sweep fills the list again).
pub fn clear_free[&q](p: &!q Pager) -> [] int {
    p.nfree = 0;
    return 0;
}

// Page `id` is free (no root names it and it is zeroed): false if the list is full (the page is then simply not reused until the next sweep).
pub fn push_free[&q](p: &!q Pager, id: int) -> [] bool {
    if p.nfree >= free_max() {
        return false;
    }
    contents(p.free)[p.nfree] = id;
    p.nfree = p.nfree + 1;
    return true;
}

pub fn free_count[&q](p: &q Pager) -> [] int {
    return p.nfree;
}

// Overwrite page `id` with zeros (a page no root names may hold an erased row: docs/m3-engine.md D-M3-2). A page that is zeros already is not written again (and is no step). A zero page does not match its
// CRC, so it is refused if it is ever read as a page. 0, -1 if the file could not be read or written, -3 at the crash point.
pub fn zero_page[&q](p: &!q Pager, id: int) -> [file_read, file_write] int {
    if id < 3 {
        return 0 - 1;
    }
    forget(p, id);
    var rc = 0;
    region r {
        let buf = alloc_slice[r](4096, byte_of(0));
        var got = 0;
        var going = true;
        while going && got < 4096 {
            match file_pread(p.file, id * 4096 + got, buf[got..4096]) {
                Read::Got(n) => {
                    if n <= 0 {
                        going = false;
                    }
                    got = got + n;
                }
                Read::End => {
                    going = false;
                }
                Read::Failed(e) => {
                    going = false;
                    rc = 0 - 1;
                }
            }
        }
        var dirty = false;
        var i = 0;
        while i < got {
            if int_of(buf[i]) != 0 {
                dirty = true;
                buf[i] = byte_of(0);
            }
            i = i + 1;
        }
        if rc == 0 && dirty {
            if p.dead {
                rc = 0 - 3;
            } else {
                p.steps = p.steps + 1;
                var upto = 4096;
                if p.crash > 0 && p.steps == p.crash {
                    p.dead = true;
                    upto = p.torn;
                }
                var at = 0;
                while at < upto && rc == 0 {
                    match file_pwrite(p.file, id * 4096 + at, buf[at..upto]) {
                        Done::Ok(n) => {
                            if n <= 0 {
                                rc = 0 - 1;
                            }
                            at = at + n;
                        }
                        Done::Failed(e) => {
                            rc = 0 - 1;
                        }
                    }
                }
                if p.dead && rc == 0 {
                    rc = 0 - 3;
                }
            }
        }
    }
    return rc;
}
