edition 9;
module cdb.pager;

import std.crc;
import cdb.commit;
import cdb.build;

// The page file of the engine (docs/m3-engine.md, slice M3a): fixed pages of 4 KiB, read and written by number, each with a CRC-32 of its own bytes, over one file opened read-write (not append: a page is
// overwritten in place only when the caller says so, and the tree of src/btree.cho never overwrites a page a root still names).
//
// A page's first seven bytes are its header: byte 0 the type, bytes 1 and 2 an entry count, bytes 3 to 6 the CRC-32 of bytes 7 to 4095. A page that was never written (zeros), or was cut short, or had a bit
// flipped, does not match its CRC and is refused (`-2`): the engine never trusts a page it has not checked.
//
// Test hook (docs/m3-engine.md D-M3-7): every write and every sync is a numbered *step*. With `crash` set to n the n-th step does not happen (a write may happen in part, `torn` bytes of it) and every step
// after it is refused (`-3`), which leaves on disk exactly what a process killed there would leave. `crash` is 0 in the engine.

pub fn page_size() -> [] int {
    return 4096;
}

pub fn header_size() -> [] int {
    return 7;
}

pub res struct Pager {
    file: File,
    // the next page number to hand out: the file's length in pages when it was opened, then one more for each `alloc`. Page 0 is never a page of a tree (a root of 0 is an empty tree), and pages 1 and 2 are the
    // two superblocks (src/pstore.cho): the first page handed out is 3.
    next: int,
    crash: int,
    torn: int,
    steps: int,
    dead: bool,
    // pages no root names, zeroed, to be handed out again before the file grows (`cdb.pstore.sweep` fills it)
    free: Box[[int]],
    nfree: int,
    // the pages handed out since `begin` (a mark for each page of the first `fresh_max()`, and the list of those marked, to clear them): pages no root names yet, which the tree may write again in place
    fresh: Box[[byte]],
    flist: Box[[int]],
    nfl: int,
    window: bool,
}

pub fn free_max() -> [] int {
    return 65536;
}

pub fn fresh_max() -> [] int {
    return 4194304;
}

pub fn new_pager[&h](heap: &!h Heap, file: File, length: int) -> [heap] Pager {
    var next = length / 4096;
    if next < 3 {
        next = 3;
    }
    return Pager { file: file, next: next, crash: 0, torn: 0, steps: 0, dead: false, free: box_slice(heap, free_max(), 0), nfree: 0, fresh: box_slice(heap, fresh_max(), byte_of(0)), flist: box_slice(heap, free_max(), 0), nfl: 0, window: false };
}

pub fn drop_pager[&h](heap: &!h Heap, p: Pager) -> [heap] int {
    let Pager { file, next, crash, torn, steps, dead, free, nfree, fresh, flist, nfl, window } = p;
    unbox_slice(heap, free);
    unbox_slice(heap, fresh);
    unbox_slice(heap, flist);
    return file_close(file);
}

// The test hook: stop at step `crash` (0 for never), writing `torn` bytes of it if it is a write (0 for none).
pub fn set_crash[&q](p: &!q Pager, crash: int, torn: int) -> [] int {
    p.crash = crash;
    p.torn = torn;
    return 0;
}

pub fn steps[&q](p: &q Pager) -> [] int {
    return p.steps;
}

pub fn crashed[&q](p: &q Pager) -> [] bool {
    return p.dead;
}

// A new page number: a free page if there is one, else the file grows. Inside a window (`begin`) the page is marked as handed out in it.
pub fn alloc[&q](p: &!q Pager) -> [] int {
    var id = p.next;
    if p.nfree > 0 {
        p.nfree = p.nfree - 1;
        id = contents(p.free)[p.nfree];
    } else {
        p.next = p.next + 1;
    }
    if p.window && id < fresh_max() && p.nfl < free_max() {
        contents(p.fresh)[id] = byte_of(1);
        contents(p.flist)[p.nfl] = id;
        p.nfl = p.nfl + 1;
    }
    return id;
}

// A window begins (a statement, docs/m3-engine.md 6p): from here until the next `begin`, a page handed out by `alloc` is one that no root names yet, and `is_fresh` says so. The caller's side of the
// bargain: within a window it builds ONE tree from each tree it started with, and uses only the newest (an older one may share a page that has since been written again).
pub fn begin[&q](p: &!q Pager) -> [] int {
    var i = 0;
    while i < p.nfl {
        contents(p.fresh)[contents(p.flist)[i]] = byte_of(0);
        i = i + 1;
    }
    p.nfl = 0;
    p.window = true;
    return 0;
}

// Whether page `id` was handed out in the window that is open.
pub fn is_fresh[&q](p: &!q Pager, id: int) -> [] bool {
    return p.window && id >= 3 && id < fresh_max() && int_of(contents(p.fresh)[id]) == 1;
}

pub fn next_page[&q](p: &q Pager) -> [] int {
    return p.next;
}

// Read page `id` into `out` (4096 bytes): 0 if it is there and its CRC matches, -1 if the file could not be read, -2 if the page is missing, short or damaged.
pub fn read_page[&q, &o](p: &!q Pager, id: int, out: &!o [byte]) -> [file_read] int {
    if id < 1 || len(out) < 4096 {
        return 0 - 2;
    }
    var got = 0;
    while got < 4096 {
        match file_pread(p.file, id * 4096 + got, out[got..4096]) {
            Read::Got(n) => {
                if n <= 0 {
                    return 0 - 2;
                }
                got = got + n;
            }
            Read::End => {
                return 0 - 2;
            }
            Read::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    if crc.crc32_of(out[7..4096]) != commit.be(out, 3, 4) {
        return 0 - 2;
    }
    return 0;
}

// Write page `page` (4096 bytes, its CRC stamped here) as page `id`. 0, -1 if the write failed, -3 if the crash point was reached before (or at) this step.
pub fn write_page[&q, &o](p: &!q Pager, id: int, page: &!o [byte]) -> [file_write] int {
    if id < 1 || len(page) < 4096 {
        return 0 - 1;
    }
    build.put_be(page, 3, crc.crc32_of(page[7..4096]), 4);
    if p.dead {
        return 0 - 3;
    }
    p.steps = p.steps + 1;
    var upto = 4096;
    if p.crash > 0 && p.steps == p.crash {
        p.dead = true;
        upto = p.torn;
        if upto <= 0 {
            return 0 - 3;
        }
    }
    var at = 0;
    while at < upto {
        match file_pwrite(p.file, id * 4096 + at, page[at..upto]) {
            Done::Ok(n) => {
                if n <= 0 {
                    return 0 - 1;
                }
                at = at + n;
            }
            Done::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    if p.dead {
        return 0 - 3;
    }
    return 0;
}

// Make what was written durable: `fsync`. 0, -1 if it failed (the engine stops: a failed sync is the end of the process, docs/m3-engine.md section 2), -3 at the crash point.
pub fn sync[&q](p: &!q Pager) -> [file_write] int {
    if p.dead {
        return 0 - 3;
    }
    p.steps = p.steps + 1;
    if p.crash > 0 && p.steps == p.crash {
        p.dead = true;
        return 0 - 3;
    }
    match file_sync(p.file) {
        Done::Ok(n) => {
            return 0;
        }
        Done::Failed(e) => {
            return 0 - 1;
        }
    }
}

// Test hook: flip one bit of byte `off` of page `id`, in the file, without stamping the CRC again (what a bad sector or a stray write does), so that the page is refused when it is next read. Flipping the same
// byte again puts it back. 0, or -1 if the file could not be read or written.
pub fn flip[&q](p: &!q Pager, id: int, off: int) -> [file_read, file_write] int {
    var rc = 0;
    region r {
        let b = alloc_slice[r](1, byte_of(0));
        match file_pread(p.file, id * 4096 + off, b) {
            Read::Got(n) => {
                let v = int_of(b[0]);
                b[0] = byte_of(v - v % 2 + 1 - v % 2);
                match file_pwrite(p.file, id * 4096 + off, b) {
                    Done::Ok(m) => {
                    }
                    Done::Failed(e) => {
                        rc = 0 - 1;
                    }
                }
            }
            Read::End => {
                rc = 0 - 1;
            }
            Read::Failed(e) => {
                rc = 0 - 1;
            }
        }
    }
    return rc;
}

// Forget the free pages (before a sweep fills the list again).
pub fn clear_free[&q](p: &!q Pager) -> [] int {
    p.nfree = 0;
    return 0;
}

// Page `id` is free (no root names it and it is zeroed): false if the list is full (the page is then simply not reused until the next sweep).
pub fn push_free[&q](p: &!q Pager, id: int) -> [] bool {
    if p.nfree >= free_max() {
        return false;
    }
    contents(p.free)[p.nfree] = id;
    p.nfree = p.nfree + 1;
    return true;
}

pub fn free_count[&q](p: &q Pager) -> [] int {
    return p.nfree;
}

// Overwrite page `id` with zeros (a page no root names may hold an erased row: docs/m3-engine.md D-M3-2). A page that is zeros already is not written again (and is no step). A zero page does not match its
// CRC, so it is refused if it is ever read as a page. 0, -1 if the file could not be read or written, -3 at the crash point.
pub fn zero_page[&q](p: &!q Pager, id: int) -> [file_read, file_write] int {
    if id < 3 {
        return 0 - 1;
    }
    var rc = 0;
    region r {
        let buf = alloc_slice[r](4096, byte_of(0));
        var got = 0;
        var going = true;
        while going && got < 4096 {
            match file_pread(p.file, id * 4096 + got, buf[got..4096]) {
                Read::Got(n) => {
                    if n <= 0 {
                        going = false;
                    }
                    got = got + n;
                }
                Read::End => {
                    going = false;
                }
                Read::Failed(e) => {
                    going = false;
                    rc = 0 - 1;
                }
            }
        }
        var dirty = false;
        var i = 0;
        while i < got {
            if int_of(buf[i]) != 0 {
                dirty = true;
                buf[i] = byte_of(0);
            }
            i = i + 1;
        }
        if rc == 0 && dirty {
            if p.dead {
                rc = 0 - 3;
            } else {
                p.steps = p.steps + 1;
                var upto = 4096;
                if p.crash > 0 && p.steps == p.crash {
                    p.dead = true;
                    upto = p.torn;
                }
                var at = 0;
                while at < upto && rc == 0 {
                    match file_pwrite(p.file, id * 4096 + at, buf[at..upto]) {
                        Done::Ok(n) => {
                            if n <= 0 {
                                rc = 0 - 1;
                            }
                            at = at + n;
                        }
                        Done::Failed(e) => {
                            rc = 0 - 1;
                        }
                    }
                }
                if p.dead && rc == 0 {
                    rc = 0 - 3;
                }
            }
        }
    }
    return rc;
}
