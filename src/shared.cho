edition 9;
module cdb.shared;

import std.buffer;
import std.conns;
import std.io;
import std.addr;
import std.bytes;
import std.ed25519;
import cdb.commit;
import cdb.login;
import cdb.store;

// The proxy's shared state and the helpers every part of it uses (split out of `proxy.cho`, P2d-2, so the commit path can be a module
// of its own): the limits, the layout of a connection's slot in `Core.state`, `Core` itself, sending to a connection through its
// queue, and answering a client with an error or a command tag.

pub fn max_clients() -> [] int {
    return 64;
}

pub fn chunk() -> [] int {
    return 32768;
}

pub fn queue_size() -> [] int {
    return 65536;
}

// The most a client may send before it is paired: its startup packet and its password message together.
pub fn hello_size() -> [] int {
    return 16384;
}

// How long a client may take over its login.
pub fn hello_ms() -> [] int {
    return 10000;
}

// How long the proxy waits for PostgreSQL's login answer before it gives up on it.
pub fn login_ms() -> [] int {
    return 5000;
}

// The most of PostgreSQL's login answer (parameter statuses, key data, ready) the proxy will hold to relay.
pub fn relay_max() -> [] int {
    return 16384;
}

// The most of a client's token the proxy keeps (the token without its seed), and of one client message it will hold.
pub fn token_max() -> [] int {
    return 8192;
}

pub fn msg_max() -> [] int {
    return 65536;
}

// The schema snapshot's text, and the catalog answer it is built from.
pub fn snap_max() -> [] int {
    return 65536;
}

pub fn snapin_max() -> [] int {
    return 262144;
}

// Per connection `k`, `state[24k..24k+24]` is:
//
//     0  kind: 0 free, 1 client sending its startup, 2 client sending its password, 5 login accepted (waiting to be
//        paired), 3 paired (forwarding)
//     1  its peer's slot (paired), or -1
//     2  bytes waiting to be sent to it
//     3  what it is watched for (1 to read, 2 to write, 3 both, 0 neither)
//     4  1 if it closes once its queue has gone
//     5  bytes held in its login buffer
//     6  where the database name starts in the login buffer (kinds 2 and 5), and 7 how long it is
//     8  where application_name starts (-1 if absent), and 9 how long it is
//     10 where the password message starts in the login buffer (the startup packet is before it)
//     11 when it was accepted (monotonic ms)
//     12 for a paired client, the length of its token (more than 0); for the upstream side of a pair, -1
//     13 bytes of the client's messages held in its message buffer
//     14 1 if a whole simple query is at the start of that buffer, waiting for the guard
//     15 1 while the client's extended-protocol messages are discarded up to the next Sync
//     16 a paired client's transaction state: 0 idle, 1 in a transaction, 2 in a failed one (the proxy's own record, `I` `T` `E`)
//     17 1 while a statement of the client is in flight upstream (its ReadyForQuery has not come)
//     18 bytes of held CommandComplete messages (kept until the statement may be said to be done)
//     19 for the upstream side of a pair: bytes of a message being collected (a CommandComplete or a ReadyForQuery)
//     20 for the upstream side: bytes of the message being relayed that are still to come
//     21 for the upstream side: 1 while the statement in flight is an autocommit one the proxy wrapped in its own transaction
//     22 for the upstream side: 1 if that statement answered with an error
//     (kind 6 is the proxy's own catalog connection: not watched, used one question at a time)
pub fn stride() -> [] int {
    return 24;
}

// The most of one statement's CommandComplete messages the proxy holds back, and of one message it collects whole.
pub fn hold_max() -> [] int {
    return 2048;
}

pub fn sbuf_max() -> [] int {
    return 512;
}

// What the proxy keeps of the log directory while it runs (P2d-2): the three files, held open and locked, the signing seed, and where the
// branch's chain ends. `chain[0]` is the next `seq`, `chain[1]` is 1 if the branch has a tip (its id is `tip`), `chain[2]` the commits in the log.
pub res struct Store {
    log: File,
    tokens: File,
    stmts: File,
    // the signing seed (32 bytes) and, after it, its public key (32 bytes), derived once here: a signature that is given the key does not derive it again (`sign_with_public`, half the cost of a commit's signature)
    seed: Box[[byte]],
    tip: Box[[byte]],
    chain: Box[[int]],
    // the id of every commit the log holds, 32 bytes each in log order (`chain[2]` of them): recovery asks it which prepared
    // transactions have a commit (P2-D11)
    ids: Box[[byte]],
}

// The most commits the recovery table holds: a log with more is refused at startup, and a proxy whose log reaches it refuses further commits.
pub fn ids_max() -> [] int {
    return 1048576;
}

// What a transaction has done so far, per client slot `k` (P2d-3): `acc` at `k * acc_stride()`: the ids of its statements (32 bytes each, at most
// `acc_stmts()`), their IR as store records (at most `acc_irs()` bytes), their effects (at most `acc_effs()`) and the hash of the schema it began with;
// `acci` at `8 * k`: [0] statements, [1] bytes of IR records, [2] bytes of effects, [3] 1 once any effect is a write, a ddl or a call, [4] 1 once this
// client's token is in the token store, [5] 1 if the schema hash is set.
pub fn acc_stmts() -> [] int {
    return 64;
}

pub fn acc_irs() -> [] int {
    return 16384;
}

pub fn acc_effs() -> [] int {
    return 4096;
}

pub fn acc_stride() -> [] int {
    return 32 * 64 + 16384 + 4096 + 32;
}

// The extended protocol (docs/m1-extended.md P3-D3): per client slot `k`, `xstm` holds `x_stmts()` statement records (0 is the unnamed one) of `x_stmt_rec()` bytes:
// [0] 1 if used, [1] kind (0 an ordinary statement, 1 BEGIN, 2 COMMIT, 3 ROLLBACK), [2..4] bytes of IR records, [4..6] bytes of effects, [6] length of the name,
// [8..40] the statement's id, [40..104] its name, [104..2152] its IR as store records, [2152..2664] its effects. `xprt` holds `x_ports()` portal records
// (0 is the unnamed one) of `x_port_rec()` bytes: [0] 1 if used, [1] the statement it runs, [2] 1 once it has been executed, [3] the length of the name, [8..72] the name.
// `xi` at `8 * k`: [0] what completes the message in flight (0 none, 1 Parse, 2 Bind, 3 Describe, 4 Execute, 5 Close, 6 Sync), [1] the statement record the last Parse made, or -1.
pub fn x_stmts() -> [] int {
    return 33;
}

pub fn x_stmt_rec() -> [] int {
    return 2664;
}

pub fn x_ports() -> [] int {
    return 17;
}

pub fn x_port_rec() -> [] int {
    return 72;
}

pub fn x_name_max() -> [] int {
    return 63;
}

pub res struct Core {
    store: Store,
    xstm: Box[[byte]],
    xprt: Box[[byte]],
    xi: Box[[int]],
    acc: Box[[byte]],
    acci: Box[[int]],
    poller: Poller,
    events: Box[[int]],
    state: Box[[int]],
    rbuf: Box[[byte]],
    pends: Box[[byte]],
    hbuf: Box[[byte]],
    // The configuration: the root key (32 bytes), then the branch, the upstream user and the upstream database, each
    // NUL-ended, with where each starts in `cfgi`: [branch_at, branch_len, user_at, user_len, db_at, db_len].
    cfg: Box[[byte]],
    cfgi: Box[[int]],
    // each client's token, `token_max()` a slot; its message buffer, `msg_max()` a slot
    tokb: Box[[byte]],
    mbuf: Box[[byte]],
    // the schema snapshot, the catalog's raw answer, the guard's output and the query sent upstream
    snap: Box[[byte]],
    snapin: Box[[byte]],
    rend: Box[[byte]],
    qout: Box[[byte]],
    // [0] the slot of the catalog connection, or -1
    aux: Box[[int]],
    // held CommandComplete messages, `hold_max()` a slot; a message being collected, `sbuf_max()` a slot
    hold: Box[[byte]],
    sbuf: Box[[byte]],
}

// ------------------------------------------------------------------------------------------------ sending

// Hand `data` to the kernel without waiting for room, and keep what it did not take. Answers the new number of bytes
// queued, or -1 if the queue cannot hold the rest or the connection has failed (`cancho-pg`'s `emit`).
pub fn emit[&c, &d, &e](table: &!c conns.Table, slot: int, data: &d [byte], pend: &!e [byte], pending: int) -> [conn_write] int {
    var at = 0;
    if pending == 0 {
        match conns.write(table, slot, data) {
            Sent::Wrote(n) => {
                at = n;
            }
            Sent::Again => {
            }
            Sent::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    if at >= len(data) {
        return pending;
    }
    if pending + len(data) - at > len(pend) {
        return 0 - 1;
    }
    var i = at;
    while i < len(data) {
        pend[pending + i - at] = data[i];
        i = i + 1;
    }
    return pending + len(data) - at;
}

pub fn shut[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    conns.close(tab, k);
    st[stride() * k] = 0;
    return 0;
}

// Watch `k` for what it now waits on.
pub fn settle[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p] == 0 {
        return 0;
    }
    var want = 0;
    if st[p] == 1 || st[p] == 2 {
        // still logging in: read while it is not closing
        if st[p + 4] == 0 {
            want = 1;
        }
    } else if st[p] == 3 {
        if st[p + 4] == 0 && st[stride() * st[p + 1] + 2] + chunk() <= queue_size() && st[p + 14] == 0 {
            want = 1;
        }
    }
    if st[p + 2] > 0 {
        want = want + 2;
    }
    if want != st[p + 3] {
        conns.rewatch(tab, core.poller, k, k + 1, want);
        st[p + 3] = want;
    }
    return 0;
}

// `k` closes once what is queued for it has been sent.
pub fn close_after[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    let st = contents(core.state);
    if st[stride() * k + 2] == 0 {
        shut(tab, core, k);
    } else {
        st[stride() * k + 4] = 1;
        settle(tab, core, k);
    }
    return 0;
}

// `k` is finished (the peer closed, or it failed). Close it; a paired peer goes once what is queued for it has been sent.
pub fn finish[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    let st = contents(core.state);
    let peer = st[stride() * k + 1];
    let paired = st[stride() * k] == 3;
    shut(tab, core, k);
    if paired && peer >= 0 && st[stride() * peer] == 3 {
        close_after(tab, core, peer);
    }
    return 0;
}

// Connection `k` can be written to: send what is queued for it.
pub fn drain[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let pd = contents(core.pends);
    let p = stride() * k;
    let obase = k * queue_size();
    match conns.write(tab, k, pd[obase..obase + st[p + 2]]) {
        Sent::Wrote(sent) => {
            var at = 0;
            while at < st[p + 2] - sent {
                pd[obase + at] = pd[obase + sent + at];
                at = at + 1;
            }
            st[p + 2] = st[p + 2] - sent;
            if st[p + 2] == 0 && st[p + 4] == 1 {
                shut(tab, core, k);
            } else {
                settle(tab, core, k);
                if st[p] == 3 {
                    settle(tab, core, st[p + 1]);
                }
            }
        }
        Sent::Again => {
        }
        Sent::Failed(e) => {
            finish(tab, core, k);
        }
    }
    return 0;
}

// Queue `data` for `k`; false if it cannot be (the connection is then closed).
pub fn send[&t, &c, &d](tab: &!t conns.Table, core: &!c Core, k: int, data: &d [byte]) -> [conn_write, poll] bool {
    let st = contents(core.state);
    let pd = contents(core.pends);
    let q = stride() * k;
    let pending = emit(tab, k, data, pd[k * queue_size()..k * queue_size() + queue_size()], st[q + 2]);
    if pending < 0 {
        shut(tab, core, k);
        return false;
    }
    st[q + 2] = pending;
    settle(tab, core, k);
    return true;
}

// Tell client `k` it is refused (`ErrorResponse`, severity and SQLSTATE and the tag `login.cho` or this file gives) and
// close it once that has been sent. Nothing has reached PostgreSQL.
pub fn refuse[&t, &c, &a, &b, &d, &e](tab: &!t conns.Table, core: &!c Core, k: int, severity: &a [byte], sqlstate: &b [byte], tag: &d [byte], text: &e [byte]) -> [conn_write, poll] int {
    region r {
        let buf = alloc_slice[r](512, byte_of(0));
        let n = login.error_response(buf, severity, sqlstate, tag, text);
        if send(tab, core, k, buf[0..n]) {
            close_after(tab, core, k);
        }
    }
    return 0;
}

// Tell client `k` something went wrong with its query, and that PostgreSQL has not been asked (`ErrorResponse`, then
// `ReadyForQuery` with the transaction status `status`: `I`, `T` or `E`): the connection stays open.
pub fn answer_error[&t, &c, &a, &b, &d](tab: &!t conns.Table, core: &!c Core, k: int, status: int, sqlstate: &a [byte], tag: &b [byte], text: &d [byte]) -> [conn_write, poll] int {
    region r {
        let buf = alloc_slice[r](640, byte_of(0));
        var n = login.error_response(buf, "ERROR", sqlstate, tag, text);
        n = n + login.ready_for_query(buf[n..640], status);
        send(tab, core, k, buf[0..n]);
    }
    return 0;
}

// `CommandComplete` with the command tag `tag`, then `ReadyForQuery` with `status`, to client `k`: what PostgreSQL would say for
// a `BEGIN`, `COMMIT` or `ROLLBACK` that the proxy answered itself.
pub fn answer_tag[&t, &c, &a](tab: &!t conns.Table, core: &!c Core, k: int, status: int, tag: &a [byte]) -> [conn_write, poll] int {
    region r {
        let buf = alloc_slice[r](128, byte_of(0));
        let ln = len(tag) + 5;
        buf[0] = byte_of('C');
        buf[1] = byte_of(0);
        buf[2] = byte_of(0);
        buf[3] = byte_of(ln / 256 % 256);
        buf[4] = byte_of(ln % 256);
        var i = 0;
        while i < len(tag) {
            buf[5 + i] = tag[i];
            i = i + 1;
        }
        buf[5 + len(tag)] = byte_of(0);
        let n = 6 + len(tag) + login.ready_for_query(buf[6 + len(tag)..128], status);
        send(tab, core, k, buf[0..n]);
    }
    return 0;
}

// Drop the first `n` bytes of client `k`'s message buffer.
pub fn consume[&c](core: &!c Core, k: int, n: int) -> [] int {
    let st = contents(core.state);
    let mb = contents(core.mbuf);
    let p = stride() * k;
    let base = k * msg_max();
    var i = 0;
    while i < st[p + 13] - n {
        mb[base + i] = mb[base + n + i];
        i = i + 1;
    }
    st[p + 13] = st[p + 13] - n;
    return 0;
}

// A `Core` for `slots` connections, around the poller and the configuration (`cfg` and `cfgi`: see `Core`).
pub fn new_core[&h](heap: &!h Heap, poller: Poller, cfg: Box[[byte]], cfgi: Box[[int]], kept: Store, slots: int) -> [heap] Core {
    return Core { store: kept, xstm: box_slice(heap, slots * x_stmts() * x_stmt_rec() + x_stmts() * x_stmt_rec(), byte_of(0)), xprt: box_slice(heap, slots * x_ports() * x_port_rec() + x_ports() * x_port_rec(), byte_of(0)), xi: box_slice(heap, 8 * slots + 8, 0), acc: box_slice(heap, slots * acc_stride() + acc_stride(), byte_of(0)), acci: box_slice(heap, 8 * slots + 8, 0), poller: poller, events: box_slice(heap, 128, 0), state: box_slice(heap, stride() * slots + 2 * stride(), 0), rbuf: box_slice(heap, chunk(), byte_of(0)), pends: box_slice(heap, slots * queue_size() + queue_size(), byte_of(0)), hbuf: box_slice(heap, slots * hello_size() + hello_size(), byte_of(0)), cfg: cfg, cfgi: cfgi, tokb: box_slice(heap, slots * token_max() + token_max(), byte_of(0)), mbuf: box_slice(heap, slots * msg_max() + msg_max(), byte_of(0)), snap: box_slice(heap, snap_max(), byte_of(0)), snapin: box_slice(heap, snapin_max(), byte_of(0)), rend: box_slice(heap, msg_max(), byte_of(0)), qout: box_slice(heap, msg_max() + 16, byte_of(0)), aux: box_slice(heap, 8, 0 - 1), hold: box_slice(heap, slots * hold_max() + hold_max(), byte_of(0)), sbuf: box_slice(heap, slots * sbuf_max() + sbuf_max(), byte_of(0)) };
}

// Release everything a `Core` holds.
pub fn drop_core[&h](heap: &!h Heap, core: Core) -> [heap] int {
    let Core { store, xstm, xprt, xi, acc, acci, poller, events, state, rbuf, pends, hbuf, cfg, cfgi, tokb, mbuf, snap, snapin, rend, qout, aux, hold, sbuf } = core;
    drop_store(heap, store);
    unbox_slice(heap, xstm);
    unbox_slice(heap, xprt);
    unbox_slice(heap, xi);
    unbox_slice(heap, acc);
    unbox_slice(heap, acci);
    poller_close(poller);
    unbox_slice(heap, events);
    unbox_slice(heap, state);
    unbox_slice(heap, rbuf);
    unbox_slice(heap, pends);
    unbox_slice(heap, hbuf);
    unbox_slice(heap, cfg);
    unbox_slice(heap, cfgi);
    unbox_slice(heap, tokb);
    unbox_slice(heap, mbuf);
    unbox_slice(heap, snap);
    unbox_slice(heap, snapin);
    unbox_slice(heap, rend);
    unbox_slice(heap, qout);
    unbox_slice(heap, aux);
    unbox_slice(heap, hold);
    unbox_slice(heap, sbuf);
    return 0;
}

// A `Store` around three open files; `seed` (32 bytes) and `tip` (32 bytes, meaningful if `has` is 1) are copied.
pub fn new_store[&h, &s, &t, &i](heap: &!h Heap, log: File, tokens: File, stmts: File, seed: &s [byte], tip: &t [byte], next: int, has: int, ids: &i [byte], count: int) -> [heap] Store {
    var sb = box_slice(heap, 64, byte_of(0));
    var tb = box_slice(heap, 32, byte_of(0));
    var cb = box_slice(heap, 4, 0);
    var ib = box_slice(heap, 32 * ids_max(), byte_of(0));
    borrow mut sb as &!sw in {
        var i = 0;
        while i < 32 {
            contents(sw)[i] = seed[i];
            i = i + 1;
        }
        ed25519.public_key_from_seed(seed, contents(sw)[32..64]);
    }
    borrow mut tb as &!tw in {
        var i = 0;
        while i < 32 {
            contents(tw)[i] = tip[i];
            i = i + 1;
        }
    }
    borrow mut cb as &!cw in {
        contents(cw)[0] = next;
        contents(cw)[1] = has;
        contents(cw)[2] = count;
    }
    borrow mut ib as &!iw in {
        var i = 0;
        while i < 32 * count {
            contents(iw)[i] = ids[i];
            i = i + 1;
        }
    }
    return Store { log: log, tokens: tokens, stmts: stmts, seed: sb, tip: tb, chain: cb, ids: ib };
}

pub fn drop_store[&h](heap: &!h Heap, kept: Store) -> [heap] int {
    let Store { log, tokens, stmts, seed, tip, chain, ids } = kept;
    file_close(log);
    file_close(tokens);
    file_close(stmts);
    unbox_slice(heap, seed);
    unbox_slice(heap, tip);
    unbox_slice(heap, chain);
    unbox_slice(heap, ids);
    return 0;
}

// Append one commit through the open files (`store.append`'s order: token, statements, then the log, each synced).
pub fn store_append[&s, &x, &y, &z](kept: &!s Store, token_rec: &x [byte], stmt_recs: &y [byte], log_rec: &z [byte]) -> [file_write] int {
    return store.append(kept.log, kept.tokens, kept.stmts, token_rec, stmt_recs, log_rec);
}
