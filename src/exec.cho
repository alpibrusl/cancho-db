edition 9;
module cdb.exec;

import cdb.commit;
import cdb.build;
import cdb.row;
import cdb.eval;
import cdb.btree;
import cdb.pager;
import cdb.tables;

// The executor of the engine (docs/m3-engine.md 6g): what the statements share, and SELECT. The statements that write are in src/execw.cho.
//
// A statement answers 0 (done: `root`, `count` and the rows or the changes are in the `Work`), a number above 0 (an error of the statement, PostgreSQL's: `sqlstate` gives its code), or a number below 0 (a
// refusal, with a rule tag: `refusal_name`). The rule of 6g: the engine finds every error a statement could raise; one SQLSTATE among them is the answer, several are `engine-ambiguous-error`, and where
// whether there is an error at all depends on the order PostgreSQL works in, the statement is refused (`engine-order-dependent`).

pub fn unsupported() -> [] int {
    return 0 - 11;
}

pub fn order_dependent() -> [] int {
    return 0 - 12;
}

pub fn ambiguous() -> [] int {
    return 0 - 13;
}

pub fn too_big() -> [] int {
    return 0 - 14;
}

pub fn io_failed() -> [] int {
    return 0 - 15;
}

pub fn damaged() -> [] int {
    return 0 - 16;
}

pub fn malformed() -> [] int {
    return 0 - 19;
}

pub fn refusal_name(code: int) -> [] &static [byte] {
    if code == order_dependent() {
        return "engine-order-dependent";
    }
    if code == ambiguous() {
        return "engine-ambiguous-error";
    }
    if code == too_big() {
        return "engine-too-big";
    }
    if code == io_failed() {
        return "engine-io";
    }
    if code == damaged() {
        return "engine-damaged";
    }
    if code == malformed() {
        return "engine-malformed";
    }
    return "engine-unsupported";
}

// The errors of a statement. 1 to 4 are the evaluator's errors of a value less one, 5 to 7 its errors of types negated.
pub fn e_unique() -> [] int {
    return 8;
}

pub fn e_not_null() -> [] int {
    return 9;
}

pub fn e_table_exists() -> [] int {
    return 10;
}

pub fn e_no_table() -> [] int {
    return 11;
}

pub fn e_limit() -> [] int {
    return 12;
}

pub fn e_offset() -> [] int {
    return 13;
}

pub fn e_two_keys() -> [] int {
    return 14;
}

pub fn e_column_twice() -> [] int {
    return 15;
}

pub fn sqlstate(code: int) -> [] &static [byte] {
    if code == 1 {
        return "22012";
    }
    if code == 2 {
        return "22003";
    }
    if code == 3 {
        return "22P02";
    }
    if code == 4 {
        return "22025";
    }
    if code == 5 {
        return "42883";
    }
    if code == 6 {
        return "42804";
    }
    if code == 7 {
        return "42846";
    }
    if code == 8 {
        return "23505";
    }
    if code == 9 {
        return "23502";
    }
    if code == 10 {
        return "42P07";
    }
    if code == 11 {
        return "42P01";
    }
    if code == 12 {
        return "2201W";
    }
    if code == 13 {
        return "2201X";
    }
    if code == 14 {
        return "42P16";
    }
    if code == 15 {
        return "42701";
    }
    return "XX000";
}

// What a statement works in: made once, used by one statement at a time.
//
// `ctx` is what the evaluator is bound to: the table's name from 0, its definition from 64, the row from 1024 (`cx` says how long each is). `pos` holds positions and marks of the statement's parts (the
// `p_...` offsets below). `rows` holds the rows of a SELECT's answer (each the values of its items and then of its ORDER BY expressions, as stored values) or the rows an INSERT is about to store, and `idx`
// where each starts; `chg` the changes of a statement that writes (`changes_at`).
pub res struct Work {
    sc: Box[[byte]],
    ws: Box[[int]],
    ar: Box[[byte]],
    ctx: Box[[byte]],
    cx: Box[[int]],
    info: Box[[int]],
    ent: Box[[byte]],
    key: Box[[byte]],
    key2: Box[[byte]],
    cur: Box[[byte]],
    nrow: Box[[byte]],
    tmp: Box[[byte]],
    pos: Box[[int]],
    rows: Box[[byte]],
    idx: Box[[int]],
    idx2: Box[[int]],
    chg: Box[[byte]],
    lit: Box[[byte]],
    lsc: Box[[int]],
    lrs: Box[[int]],
    lo: Box[[byte]],
    hi: Box[[byte]],
    root: int,
    count: int,
    first: int,
    code: int,
    multi: bool,
    orderdep: bool,
    nitems: int,
    norder: int,
    nconj: int,
    rfill: int,
    nchg: int,
    cfill: int,
    tid: int,
    nlen: int,
    dlen: int,
    elen: int,
    klen: int,
    lon: int,
    hin: int,
    fresh: bool,
}

pub fn rows_size() -> [] int {
    return 16777216;
}

pub fn max_rows() -> [] int {
    return 262144;
}

pub fn new_work[&h](heap: &!h Heap) -> [heap] Work {
    return Work { sc: box_slice(heap, btree.scratch_size(), byte_of(0)), ws: box_slice(heap, eval.ws_size(), 0), ar: box_slice(heap, 262144, byte_of(0)), ctx: box_slice(heap, 2048, byte_of(0)), cx: box_slice(heap, 6, 0), info: box_slice(heap, 4, 0), ent: box_slice(heap, 1024, byte_of(0)), key: box_slice(heap, 256, byte_of(0)), key2: box_slice(heap, 256, byte_of(0)), cur: box_slice(heap, 1024, byte_of(0)), nrow: box_slice(heap, 2048, byte_of(0)), tmp: box_slice(heap, 131072, byte_of(0)), pos: box_slice(heap, 4096, 0), rows: box_slice(heap, rows_size(), byte_of(0)), idx: box_slice(heap, max_rows(), 0), idx2: box_slice(heap, max_rows(), 0), chg: box_slice(heap, rows_size(), byte_of(0)), lit: box_slice(heap, 4096, byte_of(0)), lsc: box_slice(heap, 1024, 0), lrs: box_slice(heap, 512, 0), lo: box_slice(heap, 256, byte_of(0)), hi: box_slice(heap, 256, byte_of(0)), root: 0, count: 0, first: 0, code: 0, multi: false, orderdep: false, nitems: 0, norder: 0, nconj: 0, rfill: 0, nchg: 0, cfill: 0, tid: 0, nlen: 0, dlen: 0, elen: 0, klen: 0, lon: 0 - 1, hin: 0 - 1, fresh: false };
}

pub fn drop_work[&h](heap: &!h Heap, w: Work) -> [heap] int {
    let Work { sc, ws, ar, ctx, cx, info, ent, key, key2, cur, nrow, tmp, pos, rows, idx, idx2, chg, lit, lsc, lrs, lo, hi, root, count, first, code, multi, orderdep, nitems, norder, nconj, rfill, nchg, cfill, tid, nlen, dlen, elen, klen, lon, hin, fresh } = w;
    unbox_slice(heap, sc);
    unbox_slice(heap, ws);
    unbox_slice(heap, ar);
    unbox_slice(heap, ctx);
    unbox_slice(heap, cx);
    unbox_slice(heap, info);
    unbox_slice(heap, ent);
    unbox_slice(heap, key);
    unbox_slice(heap, key2);
    unbox_slice(heap, cur);
    unbox_slice(heap, nrow);
    unbox_slice(heap, tmp);
    unbox_slice(heap, pos);
    unbox_slice(heap, rows);
    unbox_slice(heap, idx);
    unbox_slice(heap, idx2);
    unbox_slice(heap, chg);
    unbox_slice(heap, lit);
    unbox_slice(heap, lsc);
    unbox_slice(heap, lrs);
    unbox_slice(heap, lo);
    unbox_slice(heap, hi);
    return 0;
}

// Where things are in `pos`.
pub fn p_item() -> [] int {
    return 0;
}

pub fn p_iend() -> [] int {
    return 256;
}

pub fn p_itype() -> [] int {
    return 512;
}

pub fn p_ord() -> [] int {
    return 768;
}

pub fn p_odir() -> [] int {
    return 832;
}

pub fn p_oval() -> [] int {
    return 896;
}

pub fn p_conj() -> [] int {
    return 960;
}

pub fn p_scol() -> [] int {
    return 1024;
}

pub fn p_spos() -> [] int {
    return 1088;
}

pub fn p_soff() -> [] int {
    return 1152;
}

pub fn p_stack() -> [] int {
    return 1280;
}

pub fn max_items() -> [] int {
    return 255;
}

pub fn max_parts() -> [] int {
    return 64;
}

// ---- what the callers read

pub fn root_of[&q](w: &q Work) -> [] int {
    return w.root;
}

pub fn count_of[&q](w: &q Work) -> [] int {
    return w.count;
}

pub fn columns_of[&q](w: &q Work) -> [] int {
    return w.nitems;
}

pub fn type_of[&q](w: &!q Work, i: int) -> [] int {
    return contents(w.pos)[p_itype() + i];
}

// Where row `r` (0 for the first) of a SELECT's answer starts in `row_bytes`: its `columns_of` values follow one another as stored values.
pub fn row_at[&q](w: &!q Work, r: int) -> [] int {
    return contents(w.idx)[w.first + r];
}

pub fn row_byte[&q](w: &!q Work, at: int) -> [] int {
    return int_of(contents(w.rows)[at]);
}

pub fn changes_of[&q](w: &q Work) -> [] int {
    return w.nchg;
}

pub fn changes_len[&q](w: &q Work) -> [] int {
    return w.cfill;
}

// The changes of the last statement, one after the other: the table's name (`u16` length and bytes), the plain key (the same), the image before (`u32` length and bytes, or 0xFFFFFFFF and nothing if the row
// was not there) and the image after (the same).
pub fn change_byte[&q](w: &!q Work, at: int) -> [] int {
    return int_of(contents(w.chg)[at]);
}

// ---- shared by the statements

pub fn tree_err(r: int) -> [] int {
    if r == btree.err_big() {
        return too_big();
    }
    if r == btree.err_io() || r == btree.err_crash() {
        return io_failed();
    }
    return damaged();
}

pub fn start[&q](w: &!q Work, root: int) -> [] int {
    w.root = root;
    w.count = 0;
    w.first = 0;
    w.code = 0;
    w.multi = false;
    w.orderdep = false;
    w.nitems = 0;
    w.norder = 0;
    w.nconj = 0;
    w.rfill = 0;
    w.nchg = 0;
    w.cfill = 0;
    w.lon = 0 - 1;
    w.hin = 0 - 1;
    return 0;
}

// An error the statement could raise.
pub fn note[&q](w: &!q Work, code: int) -> [] int {
    if w.code == 0 {
        w.code = code;
    } else if w.code != code {
        w.multi = true;
    }
    return 0;
}

// The answer of a statement that could raise the errors noted: 0 if none, the one code, or `ambiguous()`.
pub fn verdict[&q](w: &q Work) -> [] int {
    if w.multi {
        return ambiguous();
    }
    return w.code;
}

// A negative answer of the evaluator: an error of the statement's types is noted (0); anything else is a refusal.
pub fn stat[&q](w: &!q Work, r: int) -> [] int {
    if r == eval.no_operator() || r == eval.mismatch() || r == eval.no_cast() {
        note(w, 0 - r);
        return 0;
    }
    if r == eval.malformed() {
        return malformed();
    }
    return unsupported();
}

// Evaluate the expression at `at` of `e` over the bound row (`ntab` 1) or over nothing (0): the evaluator's answer, the value in `ws` from `eval.max_nodes()`.
pub fn ev[&q, &x, &k](w: &!q Work, e: &x [byte], at: int, kinds: &k [int], ntab: int) -> [] int {
    contents(w.info)[0] = 0;
    return eval.eval(e, at, kinds, contents(w.ctx), contents(w.cx), ntab, contents(w.ws), contents(w.ar), contents(w.info));
}

pub fn copy[&s, &d](src: &s [byte], sa: int, n: int, dst: &!d [byte], da: int) -> [] int {
    var i = 0;
    while i < n {
        dst[da + i] = src[sa + i];
        i = i + 1;
    }
    return da + n;
}

pub fn same[&a, &b](x: &a [byte], xa: int, xn: int, y: &b [byte], ya: int, yn: int) -> [] bool {
    if xn != yn {
        return false;
    }
    var i = 0;
    while i < xn {
        if int_of(x[xa + i]) != int_of(y[ya + i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn put_i64[&o](out: &!o [byte], at: int, v: int) -> [] int {
    var rest = v;
    var i = 8;
    while i > 0 {
        i = i - 1;
        var b = rest % 256;
        if b < 0 {
            b = b + 256;
        }
        out[at + i] = byte_of(b);
        rest = (rest - b) / 256;
    }
    return 0;
}

// Whether the bytes are text PostgreSQL would store: UTF-8 (no overlong form, no surrogate, nothing above U+10FFFF) with no zero byte.
pub fn text_ok[&a](ar: &a [byte], at: int, n: int) -> [] bool {
    var i = 0;
    while i < n {
        let c = int_of(ar[at + i]);
        var more = 0;
        var least = 0;
        var v = c;
        if c == 0 {
            return false;
        }
        if c < 128 {
            more = 0;
        } else if c >= 194 && c < 224 {
            more = 1;
            v = c - 192;
            least = 128;
        } else if c >= 224 && c < 240 {
            more = 2;
            v = c - 224;
            least = 2048;
        } else if c >= 240 && c < 245 {
            more = 3;
            v = c - 240;
            least = 65536;
        } else {
            return false;
        }
        if i + more >= n {
            return false;
        }
        var k = 1;
        while k <= more {
            let d = int_of(ar[at + i + k]);
            if d < 128 || d >= 192 {
                return false;
            }
            v = v * 64 + d - 128;
            k = k + 1;
        }
        if v < least || v > 1114111 || v >= 55296 && v < 57344 {
            return false;
        }
        i = i + more + 1;
    }
    return true;
}

// The value at `v` of `ws` (not an error value) as a stored value into `out` at `at`: the position after it, -1 if it does not fit, -2 if it is text that `text_ok` refuses.
pub fn enc[&o, &w, &a](out: &!o [byte], at: int, ws: &w [int], v: int, ar: &a [byte]) -> [] int {
    let ty = ws[v];
    if ws[v + 1] != 0 {
        if at + 1 > len(out) {
            return 0 - 1;
        }
        out[at] = byte_of(0);
        return at + 1;
    }
    if ty == 1 || ty == 5 || ty == 6 {
        if at + 9 > len(out) {
            return 0 - 1;
        }
        out[at] = byte_of(1);
        put_i64(out, at + 1, ws[v + 2]);
        return at + 9;
    }
    if ty == 2 {
        if at + 2 > len(out) {
            return 0 - 1;
        }
        out[at] = byte_of(2);
        out[at + 1] = byte_of(ws[v + 2]);
        return at + 2;
    }
    let n = ws[v + 3];
    if n > 65535 || at + 3 + n > len(out) {
        return 0 - 1;
    }
    var tag = 3;
    if ty == 4 {
        tag = 4;
    } else if !text_ok(ar, ws[v + 2], n) {
        return 0 - 2;
    }
    out[at] = byte_of(tag);
    build.put_be(out, at + 1, n, 2);
    return copy(ar, ws[v + 2], n, out, at + 3);
}

// Bind the table whose `Name` is at `at` of `e`, in the tree `root`: 0, an error (`e_no_table`), or a refusal. After it the evaluator sees the table with no row (every column null).
pub fn bind_table[&q, &z, &x](p: &!z pager.Pager, w: &!q Work, root: int, e: &x [byte], at: int) -> [file_read] int {
    if at + 2 > len(e) {
        return malformed();
    }
    let nl = commit.be(e, at, 2);
    if nl < 1 || at + 2 + nl > len(e) {
        return malformed();
    }
    if nl > tables.max_name() {
        return unsupported();
    }
    var i = 0;
    while i < nl {
        // a table as it was at a commit (ir.md 6.1) is not served yet
        if int_of(e[at + 2 + i]) == '@' {
            return unsupported();
        }
        i = i + 1;
    }
    let n = tables.find(p, contents(w.sc), root, e[at + 2..at + 2 + nl], contents(w.key), contents(w.ent));
    if n == btree.not_found() {
        return e_no_table();
    }
    if n < 0 {
        return tree_err(n);
    }
    let dl = tables.def_len(contents(w.ent));
    if dl > 800 {
        return damaged();
    }
    copy(e, at + 2, nl, contents(w.ctx), 0);
    copy(contents(w.ent), 6, dl, contents(w.ctx), 64);
    w.elen = n;
    w.dlen = dl;
    w.nlen = nl;
    w.tid = tables.id_of(contents(w.ent));
    let x = contents(w.cx);
    x[0] = 0;
    x[1] = nl;
    x[2] = 64;
    x[3] = dl;
    x[4] = 1024;
    x[5] = 0 - 1;
    return 0;
}

// Begin reading the rows of the bound table.
pub fn scan_start[&q](w: &!q Work) -> [] int {
    build.put_be(contents(w.key), 0, w.tid, 4);
    w.klen = 4;
    w.fresh = false;
    if w.lon >= 0 {
        // from the first key the WHERE can be true at (`bounds`)
        let n = w.lon;
        copy(contents(w.lo), 0, n, contents(w.key), 4);
        w.klen = 4 + n;
        w.fresh = true;
    }
    return 0;
}

// The next row of the bound table in the tree `root`, in key order: its length (the row is in `slot`, and bound; its key in `key`), -1 when there is no other, or a refusal.
pub fn scan_next[&q, &z](p: &!z pager.Pager, w: &!q Work, root: int) -> [file_read] int {
    let kl = w.klen;
    let at_it = w.fresh;
    w.fresh = false;
    let r = btree.next_after(p, contents(w.sc), root, contents(w.key)[0..kl], at_it, contents(w.key2), contents(w.cur));
    if r == btree.not_found() {
        return 0 - 1;
    }
    if r < 0 {
        return tree_err(r);
    }
    let nk = r / 1024;
    let nv = r % 1024;
    if nk < 4 || commit.be(contents(w.key2), 0, 4) != w.tid {
        return 0 - 1;
    }
    if w.hin >= 0 {
        // past the last key the WHERE can be true at
        let hn = w.hin;
        if after_key(contents(w.key2), 4, nk - 4, contents(w.hi), hn) {
            return 0 - 1;
        }
    }
    let dl = w.dlen;
    if !row.row_ok(contents(w.ctx)[64..64 + dl], contents(w.cur)[0..nv]) {
        // a page that passed its CRC and does not hold a row of this table: nothing is computed from it
        return damaged();
    }
    copy(contents(w.key2), 0, nk, contents(w.key), 0);
    w.klen = nk;
    copy(contents(w.cur), 0, nv, contents(w.ctx), 1024);
    contents(w.cx)[5] = nv;
    return nv;
}

// Whether the key `k[ka..ka + kn]` is after the key `h[0..hn]` in the tree's order (bytes, a shorter one first).
fn after_key[&a, &b](k: &a [byte], ka: int, kn: int, h: &b [byte], hn: int) -> [] bool {
    var i = 0;
    while i < kn && i < hn {
        let d = int_of(k[ka + i]) - int_of(h[i]);
        if d != 0 {
            return d > 0;
        }
        i = i + 1;
    }
    return kn > hn;
}

// Whether the `Col` at `at` of `e` is column `c` of the bound table.
fn is_col[&q, &x](w: &!q Work, e: &x [byte], at: int, c: int) -> [] bool {
    let dl = w.dlen;
    let tn = commit.be(e, at + 1, 2);
    let cn = commit.be(e, at + 3 + tn, 2);
    let nm = row.col_name(contents(w.ctx)[64..64 + dl], c);
    return same(nm, 0, len(nm), e, at + 5 + tn, cn);
}

// The part of the table a scan has to read, from the WHERE's conditions (listed by `where_static`): if the key is one column of integers or text and a condition compares it with a constant, the rows
// before (`lo`) or after (`hi`) what that condition allows are not read. That may only be done when no condition can raise an error, because a row that is not read is a row whose error is not found (6g):
// so every condition must be made of columns, constants, comparisons, AND, OR, NOT, IS NULL and IN and nothing else. The bounds leave out no row the WHERE is true for, and every row read is still judged
// by the whole WHERE. 0, or a refusal.
fn bounds[&q, &x, &k](w: &!q Work, e: &x [byte], kinds: &k [int]) -> [] int {
    let dl = w.dlen;
    let b = eval.max_nodes();
    if row.key_columns(contents(w.ctx)[64..64 + dl]) != 1 {
        return 0;
    }
    var kc = 0;
    while row.col_pk(contents(w.ctx)[64..64 + dl], kc) != 1 {
        kc = kc + 1;
    }
    let kt = row.col_type(contents(w.ctx)[64..64 + dl], kc);
    if kt == row.t_bool() || kt == row.t_bytea() {
        return 0;
    }
    var j = 0;
    while j < w.nconj {
        let (cnt, end) = eval.scan(e, contents(w.pos)[p_conj() + j], contents(w.ws));
        if cnt < 0 {
            return malformed();
        }
        var i = 0;
        while i < cnt {
            let p = contents(w.ws)[i];
            let tag = int_of(e[p]);
            let quiet = tag == 0 || tag == 1 || tag == 8 || tag == 5 && int_of(e[p + 1]) <= 7 || tag == 7 && int_of(e[p + 1]) != 1;
            if !quiet {
                return 0;
            }
            i = i + 1;
        }
        j = j + 1;
    }
    j = 0;
    while j < w.nconj {
        let a = contents(w.pos)[p_conj() + j];
        var op = 0 - 1;
        if int_of(e[a]) == 5 {
            op = int_of(e[a + 1]);
        }
        if op == 0 || op >= 2 && op <= 5 {
            let (c1, mid) = eval.scan(e, a + 2, contents(w.ws));
            let (c2, end) = eval.scan(e, mid, contents(w.ws));
            var vat = 0 - 1;
            if c1 == 1 && c2 == 1 && int_of(e[a + 2]) == 0 && int_of(e[mid]) == 1 && is_col(w, e, a + 2, kc) {
                vat = mid;
            } else if c1 == 1 && c2 == 1 && int_of(e[mid]) == 0 && int_of(e[a + 2]) == 1 && is_col(w, e, mid, kc) {
                vat = a + 2;
                // constant < key is key > constant
                if op == 2 || op == 3 {
                    op = op + 2;
                } else if op == 4 || op == 5 {
                    op = op - 2;
                }
            }
            var n = 0 - 1;
            if vat >= 0 && ev(w, e, vat, kinds, 0) == 0 && contents(w.ws)[b + 1] == 0 {
                // the constant as a stored key (src/row.cho), in `nrow`
                let vt = contents(w.ws)[b];
                if kt != row.t_text() && (vt == 1 || vt == 5 || vt == 6) {
                    put_i64(contents(w.nrow), 0, contents(w.ws)[b + 2]);
                    contents(w.nrow)[0] = byte_of((int_of(contents(w.nrow)[0]) + 128) % 256);
                    n = 8;
                } else if kt == row.t_text() && (vt == 0 || vt == 3) && contents(w.ws)[b + 3] <= 90 {
                    let va = contents(w.ws)[b + 2];
                    let vn = contents(w.ws)[b + 3];
                    n = 0;
                    var i = 0;
                    while i < vn {
                        let c = int_of(contents(w.ar)[va + i]);
                        contents(w.nrow)[n] = byte_of(c);
                        n = n + 1;
                        if c == 0 {
                            contents(w.nrow)[n] = byte_of(255);
                            n = n + 1;
                        }
                        i = i + 1;
                    }
                    contents(w.nrow)[n] = byte_of(0);
                    contents(w.nrow)[n + 1] = byte_of(0);
                    n = n + 2;
                }
            }
            if n >= 0 && (op == 0 || op == 4 || op == 5) {
                copy(contents(w.nrow), 0, n, contents(w.lo), 0);
                w.lon = n;
            }
            if n >= 0 && (op == 0 || op == 2 || op == 3) {
                copy(contents(w.nrow), 0, n, contents(w.hi), 0);
                w.hin = n;
            }
        }
        j = j + 1;
    }
    return 0;
}

// The WHERE at `wpos` of `e` (0: there is none), before any row: its type is checked (an error is noted) and its top-level conditions (the operands of its ANDs) are listed. 0 or a refusal.
pub fn where_static[&q, &x, &k](w: &!q Work, e: &x [byte], kinds: &k [int], wpos: int) -> [] int {
    w.nconj = 0;
    if wpos == 0 {
        return 0;
    }
    contents(w.cx)[5] = 0 - 1;
    let r = ev(w, e, wpos, kinds, 1);
    if r < 0 {
        let s = stat(w, r);
        if s < 0 {
            return s;
        }
    } else {
        let b = eval.max_nodes();
        let ty = contents(w.ws)[b];
        if ty == 0 {
            // a literal as a whole condition: only NULL is read here
            if contents(w.ws)[b + 1] != 1 {
                return unsupported();
            }
        } else if ty != 2 {
            note(w, 6);
        }
    }
    contents(w.pos)[p_stack()] = wpos;
    var sp = 1;
    while sp > 0 {
        sp = sp - 1;
        let a = contents(w.pos)[p_stack() + sp];
        if a + 2 <= len(e) && int_of(e[a]) == 5 && int_of(e[a + 1]) == 6 {
            let (cnt, end) = eval.scan(e, a + 2, contents(w.ws));
            if cnt < 0 {
                return malformed();
            }
            if sp + 2 > 128 {
                return too_big();
            }
            contents(w.pos)[p_stack() + sp] = end;
            contents(w.pos)[p_stack() + sp + 1] = a + 2;
            sp = sp + 2;
        } else {
            if w.nconj >= max_parts() {
                return too_big();
            }
            contents(w.pos)[p_conj() + w.nconj] = a;
            w.nconj = w.nconj + 1;
        }
    }
    return bounds(w, e, kinds);
}

// Whether the bound row passes the WHERE at `wpos`: 1 it does, 0 it does not, 2 it raises an error (noted), or a refusal. With several conditions, an error in one beside another that is not true is
// order-dependent (6g): that is marked in the `Work` and the answer is 0.
pub fn passes[&q, &x, &k](w: &!q Work, e: &x [byte], kinds: &k [int], wpos: int) -> [] int {
    if wpos == 0 {
        return 1;
    }
    let b = eval.max_nodes();
    let r = ev(w, e, wpos, kinds, 1);
    if r < 0 {
        return unsupported();
    }
    let st = contents(w.ws)[b + 1];
    let a = contents(w.ws)[b + 2];
    if st == 0 && a == 1 {
        return 1;
    }
    if w.nconj <= 1 {
        if st == 2 {
            note(w, a - 1);
            return 2;
        }
        return 0;
    }
    var errs = 0;
    var others = 0;
    var j = 0;
    while j < w.nconj {
        let at = contents(w.pos)[p_conj() + j];
        let rj = ev(w, e, at, kinds, 1);
        if rj < 0 {
            return unsupported();
        }
        let sj = contents(w.ws)[b + 1];
        if sj == 2 {
            // the codes are 2 to 5: a mark for each
            let c = contents(w.ws)[b + 2];
            if c == 2 && errs % 2 == 0 {
                errs = errs + 1;
            } else if c == 3 && errs / 2 % 2 == 0 {
                errs = errs + 2;
            } else if c == 4 && errs / 4 % 2 == 0 {
                errs = errs + 4;
            } else if c == 5 && errs / 8 % 2 == 0 {
                errs = errs + 8;
            }
        } else if sj != 0 || contents(w.ws)[b + 2] != 1 {
            others = others + 1;
        }
        j = j + 1;
    }
    if errs == 0 {
        return 0;
    }
    if others > 0 {
        w.orderdep = true;
        return 0;
    }
    if errs % 2 == 1 {
        note(w, 1);
    }
    if errs / 2 % 2 == 1 {
        note(w, 2);
    }
    if errs / 4 % 2 == 1 {
        note(w, 3);
    }
    if errs / 8 % 2 == 1 {
        note(w, 4);
    }
    return 2;
}

// Record a change of the bound table: the row `old` (if `has_old`) became the row `new` (if `has_new`). 0, or `too_big()`.
pub fn change[&q, &o, &n](w: &!q Work, old: &o [byte], has_old: bool, new: &n [byte], has_new: bool) -> [] int {
    var at = w.cfill;
    let nl = w.nlen;
    let dl = w.dlen;
    if at + 2 + nl + 2 + 8 > rows_size() {
        return too_big();
    }
    build.put_be(contents(w.chg), at, nl, 2);
    at = copy(contents(w.ctx), 0, nl, contents(w.chg), at + 2);
    var kl = 0;
    if has_old {
        kl = row.plain_key(contents(w.ctx)[64..64 + dl], old, contents(w.chg)[at + 2..rows_size()]);
    } else {
        kl = row.plain_key(contents(w.ctx)[64..64 + dl], new, contents(w.chg)[at + 2..rows_size()]);
    }
    if kl < 0 || kl > 65535 {
        return too_big();
    }
    build.put_be(contents(w.chg), at, kl, 2);
    at = at + 2 + kl;
    if at + 8 > rows_size() {
        return too_big();
    }
    if has_old {
        let il = row.image(contents(w.ctx)[64..64 + dl], old, contents(w.chg)[at + 4..rows_size()]);
        if il < 0 {
            return too_big();
        }
        build.put_be(contents(w.chg), at, il, 4);
        at = at + 4 + il;
    } else {
        build.put_be(contents(w.chg), at, 4294967295, 4);
        at = at + 4;
    }
    if at + 4 > rows_size() {
        return too_big();
    }
    if has_new {
        let il = row.image(contents(w.ctx)[64..64 + dl], new, contents(w.chg)[at + 4..rows_size()]);
        if il < 0 {
            return too_big();
        }
        build.put_be(contents(w.chg), at, il, 4);
        at = at + 4 + il;
    } else {
        build.put_be(contents(w.chg), at, 4294967295, 4);
        at = at + 4;
    }
    w.cfill = at;
    w.nchg = w.nchg + 1;
    return 0;
}

// ---- SELECT

// The position after the stored value at `at`.
fn after[&r](rows: &r [byte], at: int) -> [] int {
    let tag = int_of(rows[at]);
    if tag == 0 {
        return at + 1;
    }
    if tag == 1 {
        return at + 9;
    }
    if tag == 2 {
        return at + 2;
    }
    return at + 3 + commit.be(rows, at + 1, 2);
}

fn nth[&r](rows: &r [byte], at: int, k: int) -> [] int {
    var p = at;
    var i = 0;
    while i < k {
        p = after(rows, p);
        i = i + 1;
    }
    return p;
}

// How the stored values at `x` and `y` (of one type, or null) compare: -1, 0, 1. A null is above every value (it comes last going up).
fn cmpv[&r](rows: &r [byte], x: int, y: int) -> [] int {
    let tx = int_of(rows[x]);
    let ty = int_of(rows[y]);
    if tx == 0 || ty == 0 {
        if tx == ty {
            return 0;
        }
        if tx == 0 {
            return 1;
        }
        return 0 - 1;
    }
    if tx == 1 {
        let a = row.int_at(rows, x + 1);
        let b = row.int_at(rows, y + 1);
        if a < b {
            return 0 - 1;
        }
        if a > b {
            return 1;
        }
        return 0;
    }
    if tx == 2 {
        return int_of(rows[x + 1]) - int_of(rows[y + 1]);
    }
    let xn = commit.be(rows, x + 1, 2);
    let yn = commit.be(rows, y + 1, 2);
    var i = 0;
    while i < xn && i < yn {
        let d = int_of(rows[x + 3 + i]) - int_of(rows[y + 3 + i]);
        if d != 0 {
            return d;
        }
        i = i + 1;
    }
    return xn - yn;
}

// How the rows at `a` and `b` compare: by the ORDER BY (`mode` 0: `norder` expressions, their values' places and directions in `pos`), or by all the bytes of their `nitems` items (`mode` 1: any order in
// which equal rows are neighbours, for DISTINCT).
fn order[&r, &p](rows: &r [byte], pos: &p [int], a: int, b: int, mode: int, nitems: int, norder: int) -> [] int {
    if mode == 1 {
        let ea = nth(rows, a, nitems);
        let eb = nth(rows, b, nitems);
        var i = 0;
        while a + i < ea && b + i < eb {
            let d = int_of(rows[a + i]) - int_of(rows[b + i]);
            if d != 0 {
                return d;
            }
            i = i + 1;
        }
        return ea - a - (eb - b);
    }
    var j = 0;
    while j < norder {
        let vi = pos[p_oval() + j];
        var c = cmpv(rows, nth(rows, a, vi), nth(rows, b, vi));
        if pos[p_odir() + j] == 1 {
            c = 0 - c;
        }
        if c != 0 {
            return c;
        }
        j = j + 1;
    }
    return 0;
}

fn merge_pass[&s, &d, &r, &p](src: &s [int], dst: &!d [int], rows: &r [byte], pos: &p [int], n: int, width: int, mode: int, nitems: int, norder: int) -> [] int {
    var lo = 0;
    while lo < n {
        var mid = lo + width;
        if mid > n {
            mid = n;
        }
        var hi = lo + 2 * width;
        if hi > n {
            hi = n;
        }
        var i = lo;
        var j = mid;
        var k = lo;
        while k < hi {
            var left = i < mid;
            if i < mid && j < hi {
                left = order(rows, pos, src[i], src[j], mode, nitems, norder) <= 0;
            }
            if left {
                dst[k] = src[i];
                i = i + 1;
            } else {
                dst[k] = src[j];
                j = j + 1;
            }
            k = k + 1;
        }
        lo = hi;
    }
    return 0;
}

// Sort the first `n` rows of `idx` (a merge sort: rows that compare equal keep their order).
fn sort_rows[&q](w: &!q Work, n: int, mode: int) -> [] int {
    var width = 1;
    var flip = false;
    let ni = w.nitems;
    let no = w.norder;
    while width < n {
        if flip {
            merge_pass(contents(w.idx2), contents(w.idx), contents(w.rows), contents(w.pos), n, width, mode, ni, no);
        } else {
            merge_pass(contents(w.idx), contents(w.idx2), contents(w.rows), contents(w.pos), n, width, mode, ni, no);
        }
        flip = !flip;
        width = width * 2;
    }
    if flip {
        var i = 0;
        while i < n {
            contents(w.idx)[i] = contents(w.idx2)[i];
            i = i + 1;
        }
    }
    return 0;
}

// Whether a note of the lowering (a literal that is not a string or an integer) is on a `Const` between `from` and `to`.
fn noted_in[&k](kinds: &k [int], from: int, to: int) -> [] bool {
    if len(kinds) < 142 {
        return false;
    }
    if kinds[8] < 0 {
        return true;
    }
    var i = 0;
    while i < kinds[8] && 140 + 2 * i + 1 < len(kinds) {
        let at = kinds[140 + 2 * i];
        if at >= from && at < to {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// A LIMIT or OFFSET at `at` of `e` (the flag of an `Opt`): the position after it, with its value in `info[2]` (-1: none), or a refusal. A negative one is an error of the statement (noted, `which`).
fn bound[&q, &x, &k](w: &!q Work, e: &x [byte], kinds: &k [int], at: int, which: int) -> [] int {
    contents(w.info)[2] = 0 - 1;
    if at >= len(e) {
        return malformed();
    }
    if int_of(e[at]) == 0 {
        return at + 1;
    }
    let r = ev(w, e, at + 1, kinds, 0);
    if r < 0 {
        // an error of types in a LIMIT has its own rules in PostgreSQL: not answered here
        return unsupported();
    }
    let b = eval.max_nodes();
    let ty = contents(w.ws)[b];
    let st = contents(w.ws)[b + 1];
    let end = contents(w.info)[1];
    if st == 1 && (ty == 0 || ty == 1 || ty == 5 || ty == 6) {
        return end;
    }
    if st != 0 || ty != 1 && ty != 5 && ty != 6 {
        return unsupported();
    }
    let v = contents(w.ws)[b + 2];
    if v < 0 {
        note(w, which);
        return end;
    }
    contents(w.info)[2] = v;
    return end;
}

// SELECT (a `Select2`, ir.md section 6) over one table of the tree `root`. On 0: `count_of` rows of `columns_of` values (`type_of`, `row_at`, `row_byte`).
pub fn select[&q, &z, &x, &k](p: &!z pager.Pager, w: &!q Work, root: int, e: &x [byte], kinds: &k [int]) -> [file_read] int {
    start(w, root);
    if len(e) < 6 || int_of(e[0]) != 6 {
        return malformed();
    }
    let distinct = int_of(e[1]) == 1;
    let ni = commit.be(e, 2, 4);
    if ni > max_items() {
        return too_big();
    }
    if ni < 1 {
        return unsupported();
    }
    w.nitems = ni;
    var at = 6;
    var i = 0;
    while i < ni {
        let (cnt, end) = eval.scan(e, at, contents(w.ws));
        if cnt < 0 {
            return malformed();
        }
        contents(w.pos)[p_item() + i] = at;
        contents(w.pos)[p_iend() + i] = end;
        at = end;
        i = i + 1;
    }
    if at + 4 > len(e) {
        return malformed();
    }
    if commit.be(e, at, 4) != 1 {
        // joins: not in this slice
        return unsupported();
    }
    let name_at = at + 4;
    if name_at + 2 > len(e) {
        return malformed();
    }
    at = name_at + 2 + commit.be(e, name_at, 2) + 2;
    if at >= len(e) {
        return malformed();
    }
    var wpos = 0;
    if int_of(e[at]) == 1 {
        wpos = at + 1;
        let (cnt, end) = eval.scan(e, wpos, contents(w.ws));
        if cnt < 0 {
            return malformed();
        }
        at = end;
    } else {
        at = at + 1;
    }
    if at + 5 > len(e) {
        return malformed();
    }
    if commit.be(e, at, 4) != 0 || int_of(e[at + 4]) != 0 {
        // GROUP BY and HAVING: not in this slice
        return unsupported();
    }
    at = at + 5;
    if at + 4 > len(e) {
        return malformed();
    }
    let no = commit.be(e, at, 4);
    if no > max_parts() {
        return too_big();
    }
    w.norder = no;
    at = at + 4;
    let b = eval.max_nodes();
    var extra = 0;
    i = 0;
    while i < no {
        let (cnt, end) = eval.scan(e, at, contents(w.ws));
        if cnt < 0 || end + 2 > len(e) {
            return malformed();
        }
        contents(w.pos)[p_ord() + i] = at;
        contents(w.pos)[p_odir() + i] = int_of(e[end]);
        if int_of(e[end + 1]) != 0 {
            return unsupported();
        }
        var slot = 0 - 1;
        if int_of(e[at]) == 1 {
            // a bare constant: an integer is the place of an item; PostgreSQL refuses any other, with errors this slice does not reproduce
            if int_of(e[at + 1]) != 1 || noted_in(kinds, at, at + 1) {
                return unsupported();
            }
            let place = row.int_at(e, at + 2);
            if place < 1 || place > ni {
                return unsupported();
            }
            slot = place - 1;
        } else if int_of(e[at]) == 7 && int_of(e[at + 1]) == 1 && int_of(e[at + 2]) == 1 {
            return unsupported();
        } else {
            // the same expression as an item is that item
            var j = 0;
            while j < ni && slot < 0 {
                let ia = contents(w.pos)[p_item() + j];
                let ie = contents(w.pos)[p_iend() + j];
                if same(e, at, end - at, e, ia, ie - ia) && !noted_in(kinds, at, end) && !noted_in(kinds, ia, ie) {
                    slot = j;
                }
                j = j + 1;
            }
            if slot < 0 {
                if distinct {
                    // PostgreSQL wants it in the select list, and this file cannot tell that it is not there under another spelling
                    return unsupported();
                }
                slot = 0 - 1 - extra;
                extra = extra + 1;
            }
        }
        contents(w.pos)[p_oval() + i] = slot;
        at = end + 2;
        i = i + 1;
    }
    // the extra ORDER BY values follow the items in a row
    i = 0;
    while i < no {
        let slot = contents(w.pos)[p_oval() + i];
        if slot < 0 {
            contents(w.pos)[p_oval() + i] = ni + (0 - 1 - slot);
        }
        i = i + 1;
    }
    let r0 = bind_table(p, w, root, e, name_at);
    if r0 != 0 {
        return r0;
    }
    // before any row: the types, and what is wrong with them
    i = 0;
    while i < ni {
        let r = ev(w, e, contents(w.pos)[p_item() + i], kinds, 1);
        if r < 0 {
            let s = stat(w, r);
            if s < 0 {
                return s;
            }
        } else {
            var ty = contents(w.ws)[b];
            if ty == 0 {
                ty = 3;
            }
            contents(w.pos)[p_itype() + i] = ty;
        }
        i = i + 1;
    }
    let rw = where_static(w, e, kinds, wpos);
    if rw < 0 {
        return rw;
    }
    contents(w.cx)[5] = 0 - 1;
    i = 0;
    while i < no {
        if contents(w.pos)[p_oval() + i] >= ni {
            let r = ev(w, e, contents(w.pos)[p_ord() + i], kinds, 1);
            if r < 0 {
                let s = stat(w, r);
                if s < 0 {
                    return s;
                }
            }
        }
        i = i + 1;
    }
    if at >= len(e) {
        return malformed();
    }
    var bounded = int_of(e[at]) == 1;
    at = bound(w, e, kinds, at, e_limit());
    if at < 0 {
        return at;
    }
    let limit = contents(w.info)[2];
    if at >= len(e) {
        return malformed();
    }
    if int_of(e[at]) == 1 {
        bounded = true;
    }
    at = bound(w, e, kinds, at, e_offset());
    if at < 0 {
        return at;
    }
    let offset = contents(w.info)[2];
    if at != len(e) {
        return malformed();
    }
    if w.code != 0 {
        return verdict(w);
    }
    // the rows
    var n = 0;
    scan_start(w);
    var more = true;
    while more {
        let rl = scan_next(p, w, root);
        if rl == 0 - 1 {
            more = false;
        } else if rl < 0 {
            return rl;
        } else {
            let pass = passes(w, e, kinds, wpos);
            if pass < 0 {
                return pass;
            }
            if pass == 1 {
                if n >= max_rows() {
                    return too_big();
                }
                let begin = w.rfill;
                var fill = begin;
                var bad = false;
                var k = 0;
                while k < ni + extra {
                    var ea = 0;
                    if k < ni {
                        ea = contents(w.pos)[p_item() + k];
                    } else {
                        // the k-th extra ORDER BY expression
                        var j = 0;
                        while j < no {
                            if contents(w.pos)[p_oval() + j] == k {
                                ea = contents(w.pos)[p_ord() + j];
                            }
                            j = j + 1;
                        }
                    }
                    let r = ev(w, e, ea, kinds, 1);
                    if r < 0 {
                        return unsupported();
                    }
                    if contents(w.ws)[b + 1] == 2 {
                        note(w, contents(w.ws)[b + 2] - 1);
                        bad = true;
                    } else if !bad {
                        fill = enc(contents(w.rows), fill, contents(w.ws), b, contents(w.ar));
                        if fill == 0 - 1 {
                            return too_big();
                        }
                        if fill < 0 {
                            return unsupported();
                        }
                    }
                    k = k + 1;
                }
                if !bad {
                    contents(w.idx)[n] = begin;
                    w.rfill = fill;
                    n = n + 1;
                }
            }
        }
    }
    if w.orderdep {
        return order_dependent();
    }
    if w.code != 0 {
        if bounded {
            // PostgreSQL may stop before the row that raises
            return order_dependent();
        }
        return verdict(w);
    }
    if distinct {
        sort_rows(w, n, 1);
        var kept = 0;
        i = 0;
        while i < n {
            let cur = contents(w.idx)[i];
            if kept == 0 || order(contents(w.rows), contents(w.pos), contents(w.idx)[kept - 1], cur, 1, ni, no) != 0 {
                contents(w.idx)[kept] = cur;
                kept = kept + 1;
            }
            i = i + 1;
        }
        n = kept;
    }
    if no > 0 {
        sort_rows(w, n, 0);
    }
    var first = 0;
    if offset > 0 {
        first = offset;
        if first > n {
            first = n;
        }
    }
    var count = n - first;
    if limit >= 0 && limit < count {
        count = limit;
    }
    w.first = first;
    w.count = count;
    return 0;
}

// The snapshot of the tree `root` that the lowering reads (`tables.schema_text`), into `out`: its length, or a refusal.
pub fn schema[&q, &z, &o](p: &!z pager.Pager, w: &!q Work, root: int, out: &!o [byte]) -> [file_read] int {
    let n = tables.schema_text(p, contents(w.sc), root, contents(w.key), contents(w.key2), contents(w.ent), out);
    if n < 0 {
        return tree_err(n);
    }
    return n;
}

// The scratch of the tree, for a caller that commits or sweeps between statements.
pub fn scratch[&q](w: &!q Work) -> [] &!q [byte] {
    return contents(w.sc);
}
