edition 9;
module cdb.tlsid;

import std.crypto;
import std.dirs;
import tls;

// The server's certificate and key (docs/m3-engine.md 6bq, 6bu): `chain.pem` and `key.pem` beneath a directory handle, given to the TLS package when the server starts
// and again whenever they have changed. Nothing here holds a path: the directory was opened once, by the program, and this reads beneath it.

// What `load` answers when the files are what was loaded last, and when one of them cannot be read (the package's refusals are below these).
pub fn unchanged() -> [] int {
    return 1;
}

pub fn no_chain() -> [] int {
    return 0 - 30001;
}

pub fn no_key() -> [] int {
    return 0 - 30002;
}

// The file `leaf` beneath `dir`, whole, into `into`: how many bytes, or -1 if it cannot be read or does not fit.
fn read_whole[&d, &l, &o](dir: &d Dir, leaf: &l [byte], into: &!o [byte]) -> [dir_read, file_read] int {
    var at = 0 - 1;
    match dirs.open_file(dir, leaf) {
        Opened::Ok(of) => {
            var file = of;
            at = 0;
            var going = true;
            borrow mut file as &!fw in {
                while going {
                    if at == len(into) {
                        at = 0 - 1;
                        going = false;
                    } else {
                        match file_read(fw, into[at..len(into)]) {
                            Read::Got(n) => {
                                at = at + n;
                            }
                            Read::End => {
                                going = false;
                            }
                            Read::Failed(e) => {
                                at = 0 - 1;
                                going = false;
                            }
                        }
                    }
                }
            }
            file_close(file);
        }
        Opened::Failed(e) => {
        }
    }
    return at;
}

// Read the two files and give them to the package: as its first identity when `first`, in place of it otherwise. `seen` (64 bytes) is the hash of each file as last
// taken: files that are the same are not given again (`unchanged()`). 0 when the package took them; `no_chain()`, `no_key()`, or the package's refusal, and then
// the identity it had is the one it has (a key that is not the certificate's, which is what a renewal half written is, is such a refusal).
pub fn load[&h, &d, &e, &s](heap: &!h Heap, dir: &d Dir, eng: &!e tls.Engine, first: bool, now_ms: int, seen: &!s [byte]) -> [heap, dir_read, file_read] int {
    var answer = 0;
    let chain = box_slice(heap, 65536, byte_of(0));
    let key = box_slice(heap, 8192, byte_of(0));
    borrow mut chain as &!cw in {
        borrow mut key as &!kw in {
            region r {
                let now = alloc_slice[r](64, byte_of(0));
                let cn = read_whole(dir, "chain.pem", contents(cw));
                let kn = read_whole(dir, "key.pem", contents(kw));
                if cn < 0 {
                    answer = no_chain();
                } else if kn < 0 {
                    answer = no_key();
                } else {
                    crypto.sha256(contents(cw)[0..cn], now[0..32]);
                    crypto.sha256(contents(kw)[0..kn], now[32..64]);
                    var same = !first;
                    var i = 0;
                    while i < 64 {
                        if int_of(now[i]) != int_of(seen[i]) {
                            same = false;
                        }
                        i = i + 1;
                    }
                    if same {
                        answer = unchanged();
                    } else if first {
                        answer = tls.add_identity(eng, contents(cw)[0..cn], contents(kw)[0..kn], "localhost", now_ms);
                    } else {
                        answer = tls.replace_identity(eng, 0, contents(cw)[0..cn], contents(kw)[0..kn], now_ms);
                    }
                    if answer >= 0 && !same {
                        answer = 0;
                        i = 0;
                        while i < 64 {
                            seen[i] = now[i];
                            i = i + 1;
                        }
                    }
                }
            }
            // the key's copy is overwritten
            var z = 0;
            while z < len(contents(kw)) {
                contents(kw)[z] = byte_of(0);
                z = z + 1;
            }
        }
    }
    unbox_slice(heap, chain);
    unbox_slice(heap, key);
    return answer;
}

// What is said of a `load` that did not take the files.
pub fn reason(code: int) -> [] &static [byte] {
    if code == no_chain() {
        return "chain.pem cannot be read";
    }
    if code == no_key() {
        return "key.pem cannot be read";
    }
    return tls.refusal_tag(code);
}
