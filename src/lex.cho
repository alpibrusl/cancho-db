module cdb.lex;

// The SQL lexer and statement splitter (docs/m1-lowering.md section 3), sans-io: bytes in, tokens out.
//
// It reads exactly the forms of PostgreSQL's lexer that the proxy's grammar needs, and REFUSES everything else. Refusal is the
// default: a form this file does not name is an error, never passed through. The forms refused are the ones whose lexing
// depends on server state or is easy to get subtly wrong (E'' and U&'' strings, $$ quoting, bit and hex strings, non-ASCII
// identifiers, `$$` quoting), plus two PostgreSQL behaviours that would let a name be checked as one thing and run as another:
// identifiers longer than 63 bytes (PostgreSQL silently truncates them, so two different long names become one) and a number
// followed by identifier characters (`1abc`, `1_000`, `0x1F`: accepted or refused depending on the server version).
//
// Nothing here recurses and nothing allocates: tokens go into a caller's int slice, four ints each:
//
//     kind, start, length, flag
//
// `start` and `length` locate the token's text in the input: for a quoted identifier or a string, the text BETWEEN the quotes,
// still with its doubled quotes (`flag` is 1 if there are any); for the rest, the token itself. An unquoted identifier's text is
// as written: folding to lower case is the consumer's.

pub fn t_ident() -> [] int {
    return 1;
}

pub fn t_quoted() -> [] int {
    return 2;
}

pub fn t_string() -> [] int {
    return 3;
}

pub fn t_number() -> [] int {
    return 4;
}

pub fn t_operator() -> [] int {
    return 5;
}

// one of ( ) [ ] , . :
pub fn t_punct() -> [] int {
    return 6;
}

// the two-byte `::`
pub fn t_cast() -> [] int {
    return 7;
}

// `;`, the statement separator
pub fn t_semicolon() -> [] int {
    return 8;
}

// a parameter, `$` and its number: `$1` to `$65535`, no leading zero (the number is the statement's own, docs/m1-extended.md P3-D1)
pub fn t_param() -> [] int {
    return 9;
}

// The ways a lex is refused: `tokenize` answers `0 - code`. Each has a tag (`error_name`) for the rule-tagged refusal.
pub fn e_unterminated() -> [] int {
    return 1;
}

pub fn e_escape_string() -> [] int {
    return 2;
}

pub fn e_unicode_escape() -> [] int {
    return 3;
}

pub fn e_bit_string() -> [] int {
    return 4;
}

pub fn e_dollar_quote() -> [] int {
    return 5;
}

pub fn e_parameter() -> [] int {
    return 6;
}

pub fn e_non_ascii() -> [] int {
    return 7;
}

pub fn e_nul_byte() -> [] int {
    return 8;
}

pub fn e_unknown_character() -> [] int {
    return 9;
}

pub fn e_number_junk() -> [] int {
    return 10;
}

pub fn e_identifier_too_long() -> [] int {
    return 11;
}

pub fn e_empty_identifier() -> [] int {
    return 12;
}

pub fn e_too_long() -> [] int {
    return 13;
}

pub fn error_name(code: int) -> [] &static [byte] {
    if code == 1 {
        return "unterminated";
    }
    if code == 2 {
        return "escape-string";
    }
    if code == 3 {
        return "unicode-escape";
    }
    if code == 4 {
        return "bit-string";
    }
    if code == 5 {
        return "dollar-quote";
    }
    if code == 6 {
        return "parameter";
    }
    if code == 7 {
        return "non-ascii";
    }
    if code == 8 {
        return "nul-byte";
    }
    if code == 9 {
        return "unknown-character";
    }
    if code == 10 {
        return "number-junk";
    }
    if code == 11 {
        return "identifier-too-long";
    }
    if code == 12 {
        return "empty-identifier";
    }
    return "too-long";
}

// The longest identifier PostgreSQL keeps (NAMEDATALEN - 1); it truncates longer ones without a word.
fn max_ident() -> [] int {
    return 63;
}

fn is_ident_start(c: int) -> [] bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_';
}

fn is_digit(c: int) -> [] bool {
    return c >= '0' && c <= '9';
}

fn is_ident_char(c: int) -> [] bool {
    return is_ident_start(c) || is_digit(c) || c == '$';
}

// PostgreSQL's operator characters.
fn is_op_char(c: int) -> [] bool {
    return c == '+' || c == '-' || c == '*' || c == '/' || c == '<' || c == '>' || c == '=' || c == '~' || c == '!' || c == '@' || c == '#' || c == '%' || c == '^' || c == '&' || c == '|' || c == '`' || c == '?';
}

// An operator that may end in `+` or `-` (PostgreSQL: only if it contains one of these).
fn is_special_op_char(c: int) -> [] bool {
    return c == '~' || c == '!' || c == '@' || c == '#' || c == '%' || c == '^' || c == '&' || c == '|' || c == '`' || c == '?';
}

fn put[&t](toks: &!t [int], n: int, kind: int, start: int, length: int, flag: int) -> [] int {
    toks[4 * n] = kind;
    toks[4 * n + 1] = start;
    toks[4 * n + 2] = length;
    toks[4 * n + 3] = flag;
    return n + 1;
}

// Splits `sql` into tokens, into `toks` (four ints a token). Answers the number of tokens, or `0 - code` for a refusal.
// Whitespace is space, tab, newline and carriage return only: a form feed or vertical tab is whitespace in some PostgreSQL
// versions and not in others, so it is refused.
pub fn tokenize[&s, &t](sql: &s [byte], toks: &!t [int]) -> [] int {
    let cap = len(toks) / 4;
    let n_in = len(sql);
    var i = 0;
    var n = 0;
    while i < n_in {
        let c = int_of(sql[i]);
        if n >= cap - 1 {
            return 0 - e_too_long();
        }
        if c == 0 {
            return 0 - e_nul_byte();
        }
        if c >= 128 {
            return 0 - e_non_ascii();
        }
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            i = i + 1;
        } else if c == '-' && i + 1 < n_in && int_of(sql[i + 1]) == '-' {
            // a line comment, to the end of the line
            i = i + 2;
            while i < n_in && int_of(sql[i]) != '\n' {
                if int_of(sql[i]) == 0 {
                    return 0 - e_nul_byte();
                }
                i = i + 1;
            }
        } else if c == '/' && i + 1 < n_in && int_of(sql[i + 1]) == '*' {
            // a block comment, which PostgreSQL nests
            var depth = 1;
            i = i + 2;
            while depth > 0 {
                if i >= n_in {
                    return 0 - e_unterminated();
                }
                let d = int_of(sql[i]);
                if d == 0 {
                    return 0 - e_nul_byte();
                }
                if d == '/' && i + 1 < n_in && int_of(sql[i + 1]) == '*' {
                    depth = depth + 1;
                    i = i + 2;
                } else if d == '*' && i + 1 < n_in && int_of(sql[i + 1]) == '/' {
                    depth = depth - 1;
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            }
        } else if c == '\'' {
            // a string: '' is a quote, and there are no backslash escapes (standard_conforming_strings is on upstream)
            var j = i + 1;
            var doubled = 0;
            var closed = false;
            while !closed {
                if j >= n_in {
                    return 0 - e_unterminated();
                }
                let d = int_of(sql[j]);
                if d == 0 {
                    return 0 - e_nul_byte();
                }
                if d == '\'' {
                    if j + 1 < n_in && int_of(sql[j + 1]) == '\'' {
                        doubled = 1;
                        j = j + 2;
                    } else {
                        closed = true;
                    }
                } else {
                    j = j + 1;
                }
            }
            n = put(toks, n, t_string(), i + 1, j - i - 1, doubled);
            i = j + 1;
        } else if c == '"' {
            // a quoted identifier: "" is a quote
            var j = i + 1;
            var doubled = 0;
            var closed = false;
            var width = 0;
            while !closed {
                if j >= n_in {
                    return 0 - e_unterminated();
                }
                let d = int_of(sql[j]);
                if d == 0 {
                    return 0 - e_nul_byte();
                }
                if d >= 128 {
                    return 0 - e_non_ascii();
                }
                if d == '"' {
                    if j + 1 < n_in && int_of(sql[j + 1]) == '"' {
                        doubled = 1;
                        width = width + 1;
                        j = j + 2;
                    } else {
                        closed = true;
                    }
                } else {
                    width = width + 1;
                    j = j + 1;
                }
            }
            if width == 0 {
                return 0 - e_empty_identifier();
            }
            if width > max_ident() {
                return 0 - e_identifier_too_long();
            }
            n = put(toks, n, t_quoted(), i + 1, j - i - 1, doubled);
            i = j + 1;
        } else if c == '$' {
            // `$1` is a parameter; anything else is a dollar quote, which is not in the grammar
            if i + 1 < n_in && is_digit(int_of(sql[i + 1])) {
                // `$0`, a leading zero, a number over 65535 (PostgreSQL's own limit) and a number with identifier characters after it
                // (`$1a`: PostgreSQL reads two tokens, which is not worth the doubt) are refused
                var j = i + 1;
                var v = 0;
                while j < n_in && is_digit(int_of(sql[j])) && v <= 65535 {
                    v = v * 10 + int_of(sql[j]) - '0';
                    j = j + 1;
                }
                if int_of(sql[i + 1]) == '0' || v > 65535 || j < n_in && (is_digit(int_of(sql[j])) || is_ident_char(int_of(sql[j]))) {
                    return 0 - e_parameter();
                }
                n = put(toks, n, t_param(), i, j - i, 0);
                i = j;
            } else {
                return 0 - e_dollar_quote();
            }
        } else if is_ident_start(c) {
            var j = i + 1;
            while j < n_in && is_ident_char(int_of(sql[j])) {
                j = j + 1;
            }
            if j - i > max_ident() {
                return 0 - e_identifier_too_long();
            }
            // a one-letter prefix directly before a quote changes what the quote means
            if j - i == 1 && j < n_in && int_of(sql[j]) == '\'' {
                let p = c;
                if p == 'e' || p == 'E' {
                    return 0 - e_escape_string();
                }
                if p == 'b' || p == 'B' || p == 'x' || p == 'X' || p == 'n' || p == 'N' {
                    return 0 - e_bit_string();
                }
            }
            if j - i == 1 && (c == 'u' || c == 'U') && j + 1 < n_in && int_of(sql[j]) == '&' && (int_of(sql[j + 1]) == '\'' || int_of(sql[j + 1]) == '"') {
                return 0 - e_unicode_escape();
            }
            n = put(toks, n, t_ident(), i, j - i, 0);
            i = j;
        } else if is_digit(c) || c == '.' && i + 1 < n_in && is_digit(int_of(sql[i + 1])) {
            // digits [. digits] [e [+-] digits], with nothing identifier-like after it
            var j = i;
            while j < n_in && is_digit(int_of(sql[j])) {
                j = j + 1;
            }
            if j < n_in && int_of(sql[j]) == '.' {
                j = j + 1;
                while j < n_in && is_digit(int_of(sql[j])) {
                    j = j + 1;
                }
            }
            if j < n_in && (int_of(sql[j]) == 'e' || int_of(sql[j]) == 'E') {
                var k = j + 1;
                if k < n_in && (int_of(sql[k]) == '+' || int_of(sql[k]) == '-') {
                    k = k + 1;
                }
                if k < n_in && is_digit(int_of(sql[k])) {
                    while k < n_in && is_digit(int_of(sql[k])) {
                        k = k + 1;
                    }
                    j = k;
                }
            }
            if j < n_in && is_ident_char(int_of(sql[j])) {
                return 0 - e_number_junk();
            }
            n = put(toks, n, t_number(), i, j - i, 0);
            i = j;
        } else if c == ':' && i + 1 < n_in && int_of(sql[i + 1]) == ':' {
            n = put(toks, n, t_cast(), i, 2, 0);
            i = i + 2;
        } else if c == ';' {
            n = put(toks, n, t_semicolon(), i, 1, 0);
            i = i + 1;
        } else if c == '(' || c == ')' || c == '[' || c == ']' || c == ',' || c == '.' || c == ':' {
            n = put(toks, n, t_punct(), i, 1, 0);
            i = i + 1;
        } else if is_op_char(c) {
            // the longest run of operator characters that does not run into a comment, then PostgreSQL's rule that a
            // multi-character operator ends in + or - only if it also has one of ~ ! @ # % ^ & | ` ?
            var j = i + 1;
            var stop = false;
            while j < n_in && !stop && is_op_char(int_of(sql[j])) {
                let d = int_of(sql[j]);
                if d == '-' && j + 1 < n_in && int_of(sql[j + 1]) == '-' {
                    stop = true;
                } else if d == '/' && j + 1 < n_in && int_of(sql[j + 1]) == '*' {
                    stop = true;
                } else {
                    j = j + 1;
                }
            }
            var special = false;
            var k = i;
            while k < j {
                if is_special_op_char(int_of(sql[k])) {
                    special = true;
                }
                k = k + 1;
            }
            if !special {
                while j - i > 1 && (int_of(sql[j - 1]) == '+' || int_of(sql[j - 1]) == '-') {
                    j = j - 1;
                }
            }
            n = put(toks, n, t_operator(), i, j - i, 0);
            i = j;
        } else {
            return 0 - e_unknown_character();
        }
    }
    return n;
}

// Cuts `n` tokens into statements at `;`, dropping empty ones. Into `out`, two ints a statement: the first token's index and
// the index after its last. Answers the number of statements, or -1 if `out` is too small.
pub fn statements[&t, &o](toks: &t [int], n: int, out: &!o [int]) -> [] int {
    var count = 0;
    var from = 0;
    var i = 0;
    while i <= n {
        var cut = i == n;
        if !cut {
            cut = toks[4 * i] == t_semicolon();
        }
        if cut {
            if i > from {
                if 2 * count + 2 > len(out) {
                    return 0 - 1;
                }
                out[2 * count] = from;
                out[2 * count + 1] = i;
                count = count + 1;
            }
            from = i + 1;
        }
        i = i + 1;
    }
    return count;
}
