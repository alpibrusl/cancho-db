edition 9;
module cdb.execw;

import cdb.commit;
import cdb.build;
import cdb.row;
import cdb.eval;
import cdb.btree;
import cdb.pager;
import cdb.tables;
import cdb.index;
import cdb.parse;
import cdb.lower;
import cdb.exec;
import cdb.checks;
import cdb.via;
import cdb.uniq;

// The statements of the engine that write rows (docs/m3-engine.md 6g): INSERT, UPDATE, DELETE (the ones that define are in src/execc.cho). Each reads the tree it is given and answers as src/exec.cho says; on 0 the new root is
// `exec.root_of`, the number of rows `exec.count_of`, and the changes are recorded. Nothing of the tree it was given is overwritten, so a statement that fails has changed nothing.

// The column of the bound table whose name is the `Name` at `at` of `e`: its index, or -1.
fn column[&q, &x](w: &!q exec.Work, e: &x [byte], at: int) -> [] int {
    let cl = commit.be(e, at, 2);
    let dl = w.dlen;
    let def = contents(w.ctx)[64..64 + dl];
    let n = row.columns(def);
    var c = 0;
    while c < n {
        let nm = row.col_name(def, c);
        if exec.same(nm, 0, len(nm), e, at + 2, cl) {
            return c;
        }
        c = c + 1;
    }
    return 0 - 1;
}

fn col_type[&q](w: &!q exec.Work, c: int) -> [] int {
    let dl = w.dlen;
    return row.col_type(contents(w.ctx)[64..64 + dl], c);
}

fn columns[&q](w: &!q exec.Work) -> [] int {
    let dl = w.dlen;
    return row.columns(contents(w.ctx)[64..64 + dl]);
}

// Whether the row `r` has a null where the bound table does not take one.
fn null_in[&q, &r](w: &!q exec.Work, r: &r [byte]) -> [] bool {
    let dl = w.dlen;
    let el = w.elen;
    let n = columns(w);
    var at = 0;
    var c = 0;
    while c < n {
        if int_of(r[at]) == 0 && (row.col_pk(contents(w.ctx)[64..64 + dl], c) > 0 || tables.not_null(contents(w.ent)[0..el], c)) {
            return true;
        }
        at = at + tables.stored_len(r, at);
        c = c + 1;
    }
    return false;
}

// The key of the row `r` of the bound table in the tree (the table's number, then the stored key), into `key2`: its length, or -1 if it is too long.
fn tree_key[&q, &r](w: &!q exec.Work, r: &r [byte]) -> [] int {
    let dl = w.dlen;
    build.put_be(contents(w.key2), 0, w.tid, 4);
    let n = row.stored_key(contents(w.ctx)[64..64 + dl], r, contents(w.key2)[4..4 + exec.max_stored_key()]);
    if n < 0 {
        return 0 - 1;
    }
    return 4 + n;
}

// Evaluate the expression at `at` of `e` for column `c` and stage its stored value in `tmp` at `fill`: the position after it; -1 if it raised an error (noted); or a refusal (below -1).
fn staged[&q, &x, &k](w: &!q exec.Work, e: &x [byte], at: int, kinds: &k [int], ntab: int, c: int, fill: int) -> [] int {
    let b = eval.max_nodes();
    let r = exec.ev_open(w, e, at, kinds, ntab);
    if r < 0 {
        return exec.unsupported();
    }
    let r2 = eval.assign(contents(w.ws), b, col_type(w, c), contents(w.ar), contents(w.info));
    if r2 < 0 {
        return exec.unsupported();
    }
    if contents(w.ws)[b + 1] == 2 {
        exec.note(w, contents(w.ws)[b + 2] - 1);
        return 0 - 1;
    }
    let f = exec.enc(contents(w.tmp)[0..65536], fill, contents(w.ws), b, contents(w.ar));
    if f == 0 - 1 {
        return exec.too_big();
    }
    if f < 0 {
        return exec.unsupported();
    }
    return f;
}

// Before any row: the expression at `at` for column `c` is checked. An error of its types, or an error of a constant (which PostgreSQL raises when it plans, whatever the rows), is noted. 0 or a refusal.
fn checked[&q, &x, &k](w: &!q exec.Work, e: &x [byte], at: int, kinds: &k [int], ntab: int, c: int) -> [] int {
    let b = eval.max_nodes();
    let r = exec.ev_open(w, e, at, kinds, ntab);
    if r < 0 {
        return exec.stat(w, r);
    }
    let to = col_type(w, c);
    if contents(w.ws)[b + 4] != 1 {
        if !eval.assignable(contents(w.ws)[b], to) {
            exec.note(w, 6);
        }
        return 0;
    }
    let r2 = eval.assign(contents(w.ws), b, to, contents(w.ar), contents(w.info));
    if r2 < 0 {
        return exec.stat(w, r2);
    }
    if contents(w.ws)[b + 1] == 2 {
        exec.note(w, contents(w.ws)[b + 2] - 1);
    }
    return 0;
}

// ---- INSERT

// INSERT (ir.md section 2): the rows as written, each stored before the next is checked.
pub fn insert[&q, &z, &x, &k](p: &!z pager.Pager, w: &!q exec.Work, root: int, e: &x [byte], kinds: &k [int], skip: bool) -> [file_read, file_write] int {
    exec.start(w, root);
    if len(e) < 3 || int_of(e[0]) != 1 {
        return exec.malformed();
    }
    let r0 = exec.bind_table(p, w, root, e, 1);
    if r0 != 0 {
        return r0;
    }
    // the table's checks, which every row stored is held to (docs/m3-engine.md 6bz)
    let nck = checks.load(p, w, root);
    if nck < 0 {
        return nck;
    }
    var at = 3 + w.nlen;
    if at + 4 > len(e) {
        return exec.malformed();
    }
    let nc = commit.be(e, at, 4);
    at = at + 4;
    if nc > exec.max_parts() {
        return exec.too_big();
    }
    let n = columns(w);
    // `insert ... select ... where` with no table: no row if the condition does not hold. It is read first: what is wrong with it is PostgreSQL's error before what is wrong with the row
    var held = 1;
    if exec.guard_len(w) > 0 {
        held = exec.guard_holds(w);
        if held < 0 {
            return held;
        }
    }
    // an identity column takes its values from the table's counter
    let el0 = w.elen;
    let ic = tables.identity_col(contents(w.ent)[0..el0]);
    let tid = w.tid;
    var last = 0;
    if ic >= 0 {
        last = exec.seq_last(p, w, root, tid);
        if last < 0 {
            return exec.damaged();
        }
    }
    var i = 0;
    while i < nc {
        if at + 2 > len(e) || at + 2 + commit.be(e, at, 2) > len(e) {
            return exec.malformed();
        }
        let c = column(w, e, at);
        if c < 0 {
            return exec.malformed();
        }
        if c == ic {
            // a value given to an identity column: PostgreSQL's error (428C9) is not reproduced
            return exec.unsupported();
        }
        var j = 0;
        while j < i {
            if contents(w.pos)[exec.p_scol() + j] == c {
                // a column named twice: PostgreSQL's error is not reproduced here
                return exec.unsupported();
            }
            j = j + 1;
        }
        contents(w.pos)[exec.p_scol() + i] = c;
        at = at + 2 + commit.be(e, at, 2);
        i = i + 1;
    }
    if at + 4 > len(e) {
        return exec.malformed();
    }
    let nr = commit.be(e, at, 4);
    at = at + 4;
    if nr > exec.max_rows() {
        return exec.too_big();
    }
    // the rows are made first: an error of a constant comes before any row is stored
    var fill = 0;
    var r = 0;
    while r < nr {
        if at + 4 > len(e) || commit.be(e, at, 4) != nc {
            return exec.malformed();
        }
        at = at + 4;
        var tf = 0;
        var bad = false;
        i = 0;
        while i < nc {
            let c = contents(w.pos)[exec.p_scol() + i];
            let s = checked(w, e, at, kinds, 0, c);
            if s < 0 {
                return s;
            }
            let end = contents(w.info)[1];
            contents(w.pos)[exec.p_soff() + i] = tf;
            if w.code == 0 {
                let f = staged(w, e, at, kinds, 0, c, tf);
                if f < 0 - 1 {
                    return f;
                }
                if f < 0 {
                    bad = true;
                } else {
                    tf = f;
                }
            } else {
                bad = true;
            }
            at = end;
            i = i + 1;
        }
        if !bad {
            // the stored row: each column's value, or its default, or null
            var ra = 0;
            var c = 0;
            while c < n {
                var from = 0 - 1;
                i = 0;
                while i < nc {
                    if contents(w.pos)[exec.p_scol() + i] == c {
                        from = contents(w.pos)[exec.p_soff() + i];
                    }
                    i = i + 1;
                }
                if c == ic {
                    if ra + 9 > exec.max_stored_row() {
                        return exec.too_big();
                    }
                    contents(w.nrow)[ra] = byte_of(1);
                    exec.put_i64(contents(w.nrow), ra + 1, last + r);
                    ra = ra + 9;
                } else if from >= 0 {
                    let l = tables.stored_len(contents(w.tmp), from);
                    if ra + l > exec.max_stored_row() {
                        return exec.too_big();
                    }
                    ra = exec.copy(contents(w.tmp), from, l, contents(w.nrow), ra);
                } else {
                    let el = w.elen;
                    let da = tables.default_at(contents(w.ent)[0..el], c);
                    if da < 0 && tables.default_now(contents(w.ent)[0..el], c) {
                        // DEFAULT now(): the time the transaction began, if there is a clock to say it
                        if !exec.clock_set(w) || ra + 9 > exec.max_stored_row() {
                            return exec.unsupported();
                        }
                        contents(w.nrow)[ra] = byte_of(1);
                        exec.put_i64(contents(w.nrow), ra + 1, exec.clock_of(w));
                        ra = ra + 9;
                    } else if da < 0 {
                        if ra + 1 > exec.max_stored_row() {
                            return exec.too_big();
                        }
                        contents(w.nrow)[ra] = byte_of(0);
                        ra = ra + 1;
                    } else {
                        let l = tables.stored_len(contents(w.ent), da);
                        if ra + l > exec.max_stored_row() {
                            return exec.too_big();
                        }
                        ra = exec.copy(contents(w.ent), da, l, contents(w.nrow), ra);
                    }
                }
                c = c + 1;
            }
            if fill + 2 + ra > exec.rows_size() {
                return exec.too_big();
            }
            build.put_be(contents(w.rows), fill, ra, 2);
            fill = exec.copy(contents(w.nrow), 0, ra, contents(w.rows), fill + 2);
        }
        r = r + 1;
    }
    if at != len(e) {
        return exec.malformed();
    }
    if w.code != 0 {
        if exec.draw_id(w) != 0 || ic >= 0 && exec.params_inner_bound(w) {
            // an error before any row is stored, in a statement that draws from a sequence, or that fills an identity column and has a value known only when it runs (a subquery's): whether
            // PostgreSQL raises it before the draw (when it plans) or after (at the row) is not decided here
            return exec.unsupported();
        }
        return exec.verdict(w);
    }
    var stored = nr;
    if held == 0 {
        stored = 0;
    }
    if exec.draw_id(w) != 0 && exec.guard_len(w) > 0 {
        // a `nextval` is answered where it is drawn once for certain: in the first row of an insert (the driver sees to that) that has no condition
        return exec.unsupported();
    }
    let sr = store_rows(p, w, root, stored, skip);
    if exec.draw_id(w) != 0 && sr >= 0 {
        // the row was reached: the value is drawn for good, as an identity column's is
        if !exec.seq_note(w, exec.draw_id(w), exec.draw_value(w)) {
            return exec.too_big();
        }
        if sr == 0 {
            let r1 = w.root;
            let pr = exec.seq_put(p, w, r1, exec.draw_id(w), exec.draw_value(w));
            if pr < 0 {
                return pr;
            }
            w.root = pr;
        }
    }
    if ic >= 0 && sr >= 0 {
        // the values drawn are drawn for good (PostgreSQL draws one for each row it reaches): every row's, or those up to the row that failed
        var drawn = stored;
        if sr > 0 {
            drawn = exec.failed_row(w) + 1;
        }
        if drawn > 0 {
            if !exec.seq_note(w, tid, last + drawn) {
                return exec.too_big();
            }
            if sr == 0 {
                let nroot = w.root;
                let pr = exec.seq_put(p, w, nroot, tid, last + drawn);
                if pr < 0 {
                    return pr;
                }
                w.root = pr;
            }
        }
    }
    return sr;
}

// Whether the row `r` has a value outside the range its column was given (a check; a null is inside).
fn range_out[&q, &r](w: &!q exec.Work, r: &r [byte]) -> [] bool {
    let el = w.elen;
    let n = columns(w);
    var at = 0;
    var c = 0;
    while c < n {
        let ra = tables.range_at(contents(w.ent)[0..el], c);
        if ra >= 0 && int_of(r[at]) == 1 {
            let v = row.int_at(r, at + 1);
            if v < row.int_at(contents(w.ent), ra) || v > row.int_at(contents(w.ent), ra + 8) {
                return true;
            }
        }
        at = at + tables.stored_len(r, at);
        c = c + 1;
    }
    return false;
}

// Store the `nr` rows staged in `rows` (a `u16` length before each), in order: the first row that has a null where none is taken, or whose key is there already, is the statement's error.
// With `skip` (ON CONFLICT DO NOTHING) a row whose key is there, or was stored by an earlier row, is left out and is no error; its nulls and its ranges are tested all the same, as PostgreSQL tests them first.
fn store_rows[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int, nr: int, skip: bool) -> [file_read, file_write] int {
    var nroot = root;
    var ra = 0;
    var r = 0;
    while r < nr {
        let rl = commit.be(contents(w.rows), ra, 2);
        exec.copy(contents(w.rows), ra + 2, rl, contents(w.nrow), 0);
        ra = ra + 2 + rl;
        exec.copy(contents(w.nrow), 0, rl, contents(w.cur), 0);
        exec.set_failed_row(w, r);
        if null_in(w, contents(w.cur)[0..rl]) {
            return exec.e_not_null();
        }
        let cv = checks.verdict(w, contents(w.cur)[0..rl], range_out(w, contents(w.cur)[0..rl]));
        if cv != 0 {
            return cv;
        }
        let kl = tree_key(w, contents(w.cur)[0..rl]);
        if kl < 0 {
            return exec.too_big();
        }
        let g = btree.get(p, contents(w.sc), nroot, contents(w.key2)[0..kl], contents(w.nrow));
        if g >= 0 && !skip {
            return exec.e_unique();
        }
        if g < 0 && g != btree.not_found() {
            return exec.tree_err(g);
        }
        // and no row has its values in a unique index (6bo): the same error, or with ON CONFLICT DO NOTHING the row is left out
        var dup = 0;
        if g < 0 && w.nix > 0 {
            dup = uniq.taken(p, w, nroot, contents(w.cur)[0..rl], contents(w.key2), kl);
            if dup < 0 {
                return dup;
            }
            if dup == 1 && !skip {
                return exec.e_unique();
            }
        }
        if g < 0 && dup == 0 {
            let nw = exec.row_put(p, w, nroot, contents(w.key2), kl, contents(w.cur)[0..rl], contents(w.cur)[0..0], 0);
            if nw < 0 {
                return nw;
            }
            nroot = nw;
            let cr = exec.change(w, contents(w.cur)[0..0], false, contents(w.cur)[0..rl], true);
            if cr < 0 {
                return cr;
            }
            let rr = exec.ret_row(w, contents(w.cur)[0..rl]);
            if rr < 0 {
                return rr;
            }
            w.count = w.count + 1;
        }
        r = r + 1;
    }
    w.root = nroot;
    return 0;
}

// ---- UPDATE and DELETE

// The bytes before a key in the tree a statement keeps beside the table while it moves rows to new keys: `o` then a key a row is leaving, `n` then a key a row is taking (its value: the row).
fn side_key[&q](w: &!q exec.Work, mark: int, from: int, n: int) -> [] int {
    contents(w.tmp)[65536] = byte_of(mark);
    exec.copy(contents(w.key2), from, n, contents(w.tmp), 65537);
    return 1 + n;
}

// UPDATE (ir.md section 2). Every row is computed from the rows as they were before the statement.
pub fn update[&q, &z, &x, &k](p: &!z pager.Pager, w: &!q exec.Work, root: int, e: &x [byte], kinds: &k [int]) -> [file_read, file_write] int {
    exec.start(w, root);
    if len(e) < 3 || int_of(e[0]) != 2 {
        return exec.malformed();
    }
    let r0 = exec.bind_table(p, w, root, e, 1);
    if r0 != 0 {
        return r0;
    }
    // the table's checks, which every row stored is held to (docs/m3-engine.md 6bz)
    let nck = checks.load(p, w, root);
    if nck < 0 {
        return nck;
    }
    var at = 3 + w.nlen;
    if at + 4 > len(e) {
        return exec.malformed();
    }
    let ns = commit.be(e, at, 4);
    at = at + 4;
    if ns < 1 || ns > exec.max_parts() {
        return exec.too_big();
    }
    let n = columns(w);
    let dl = w.dlen;
    var moves = false;
    var i = 0;
    while i < ns {
        if at + 2 > len(e) || at + 2 + commit.be(e, at, 2) > len(e) {
            return exec.malformed();
        }
        let c = column(w, e, at);
        if c < 0 {
            return exec.malformed();
        }
        let el0 = w.elen;
        if c == tables.identity_col(contents(w.ent)[0..el0]) {
            // an identity column is not set: PostgreSQL's error (428C9) is not reproduced
            return exec.unsupported();
        }
        var j = 0;
        while j < i {
            if contents(w.pos)[exec.p_scol() + j] == c {
                return exec.unsupported();
            }
            j = j + 1;
        }
        if row.col_pk(contents(w.ctx)[64..64 + dl], c) > 0 {
            moves = true;
        }
        at = at + 2 + commit.be(e, at, 2);
        let (cnt, end) = eval.scan(e, at, contents(w.ws));
        if cnt < 0 {
            return exec.malformed();
        }
        contents(w.pos)[exec.p_scol() + i] = c;
        contents(w.pos)[exec.p_spos() + i] = at;
        at = end;
        i = i + 1;
    }
    if at >= len(e) {
        return exec.malformed();
    }
    var wpos = 0;
    if int_of(e[at]) == 1 {
        wpos = at + 1;
        let (cnt, end) = eval.scan(e, wpos, contents(w.ws));
        if cnt < 0 || end != len(e) {
            return exec.malformed();
        }
    } else if at + 1 != len(e) {
        return exec.malformed();
    }
    let rw = via.where_static(w, e, kinds, wpos);
    if rw < 0 {
        return rw;
    }
    // the rows are found as a SELECT finds them: by an index, if the WHERE has a value or a small range of one (6bo)
    via.choose(w, e, kinds);
    contents(w.cx)[5] = 0 - 1;
    i = 0;
    while i < ns {
        let s = checked(w, e, contents(w.pos)[exec.p_spos() + i], kinds, 1, contents(w.pos)[exec.p_scol() + i]);
        if s < 0 {
            return s;
        }
        i = i + 1;
    }
    if w.code != 0 {
        return exec.verdict(w);
    }
    var nroot = root;
    var side = 0;
    var seen = 0;
    via.start(w);
    var more = true;
    while more {
        let rl = via.next(p, w, root);
        if rl == 0 - 1 {
            more = false;
        } else if rl < 0 {
            return rl;
        } else {
            let pass = exec.passes(w, e, kinds, wpos);
            if pass < 0 {
                return pass;
            }
            if pass == 1 {
                w.count = w.count + 1;
                var bad = false;
                var tf = 0;
                i = 0;
                while i < ns {
                    contents(w.pos)[exec.p_soff() + i] = tf;
                    let f = staged(w, e, contents(w.pos)[exec.p_spos() + i], kinds, 1, contents(w.pos)[exec.p_scol() + i], tf);
                    if f < 0 - 1 {
                        return f;
                    }
                    if f < 0 {
                        bad = true;
                    } else {
                        tf = f;
                    }
                    i = i + 1;
                }
                var ra = 0;
                if !bad {
                    // the new row: the old one with the assigned columns replaced
                    var oa = 0;
                    var c = 0;
                    while c < n {
                        let ol = tables.stored_len(contents(w.cur)[0..rl], oa);
                        if ol < 0 {
                            return exec.damaged();
                        }
                        var from = 0 - 1;
                        i = 0;
                        while i < ns {
                            if contents(w.pos)[exec.p_scol() + i] == c {
                                from = contents(w.pos)[exec.p_soff() + i];
                            }
                            i = i + 1;
                        }
                        if from >= 0 {
                            let l = tables.stored_len(contents(w.tmp), from);
                            if ra + l > exec.max_stored_row() {
                                return exec.too_big();
                            }
                            ra = exec.copy(contents(w.tmp), from, l, contents(w.nrow), ra);
                        } else {
                            if ra + ol > exec.max_stored_row() {
                                return exec.too_big();
                            }
                            ra = exec.copy(contents(w.cur), oa, ol, contents(w.nrow), ra);
                        }
                        oa = oa + ol;
                        c = c + 1;
                    }
                    if null_in(w, contents(w.nrow)[0..ra]) {
                        exec.note(w, exec.e_not_null());
                        bad = true;
                    } else {
                        // its range and its checks (the row bound is then the new one: nothing reads the old one's after this)
                        let cv = checks.verdict(w, contents(w.nrow)[0..ra], range_out(w, contents(w.nrow)[0..ra]));
                        if cv < 0 {
                            return cv;
                        }
                        if cv != 0 {
                            exec.note(w, cv);
                            bad = true;
                        }
                    }
                    if !bad {
                        // the row as it is after the update, changed or not: what RETURNING reads
                        let rr = exec.ret_row(w, contents(w.nrow)[0..ra]);
                        if rr < 0 {
                            return rr;
                        }
                    }
                }
                if !bad && !exec.same(contents(w.cur), 0, rl, contents(w.nrow), 0, ra) {
                    let okl = w.klen;
                    var moved = false;
                    var kl = okl;
                    if moves {
                        kl = tree_key(w, contents(w.nrow)[0..ra]);
                        if kl < 0 {
                            return exec.too_big();
                        }
                        moved = !exec.same(contents(w.key), 0, okl, contents(w.key2), 0, kl);
                    }
                    if uniq.any(w) {
                        if moved {
                            // a row that takes another key: moved if it keeps its values in every unique index (its entries follow it); one whose values
                            // there change too is not reasoned about (6bo)
                            let kp = uniq.keeps(w, contents(w.cur)[0..rl], contents(w.nrow)[0..ra], contents(w.key), okl);
                            if kp < 0 {
                                return kp;
                            }
                            if kp != 1 {
                                return exec.unsupported();
                            }
                        }
                        // (for a row that is moved this finds nothing to ask: its values stay)
                        let us = uniq.changed(p, w, root, nroot, seen, contents(w.cur)[0..rl], contents(w.nrow)[0..ra], contents(w.key), okl);
                        if us < 0 {
                            return us;
                        }
                        seen = us;
                    }
                    if !moved {
                        let nw = exec.row_put(p, w, nroot, contents(w.key), okl, contents(w.nrow)[0..ra], contents(w.cur)[0..rl], 1);
                        if nw < 0 {
                            return nw;
                        }
                        nroot = nw;
                        let cr = exec.change(w, contents(w.cur)[0..rl], true, contents(w.nrow)[0..ra], true);
                        if cr < 0 {
                            return cr;
                        }
                    } else {
                        // a row that takes another key: decided after the last row, when it is known which keys are left and which are taken
                        var sl = side_key(w, 'n', 4, kl - 4);
                        let g = btree.get(p, contents(w.sc), side, contents(w.tmp)[65536..65536 + sl], contents(w.lit));
                        if g >= 0 {
                            // two rows of this statement take one key
                            exec.note(w, exec.e_unique());
                        } else if g != btree.not_found() {
                            return exec.tree_err(g);
                        } else {
                            // the row under its new key is a new row: new salts, kept with it until the keys are settled
                            let ns = exec.new_salts(w);
                            if ns < 0 {
                                return ns;
                            }
                            let fl2 = exec.salted(w, contents(w.nrow)[0..ra]);
                            let s1 = btree.put(p, contents(w.sc), side, contents(w.tmp)[65536..65536 + sl], contents(w.full)[0..fl2]);
                            if s1 < 0 {
                                return exec.tree_err(s1);
                            }
                            side = s1;
                        }
                        exec.copy(contents(w.key), 0, okl, contents(w.key2), 0);
                        sl = side_key(w, 'o', 4, okl - 4);
                        let s2 = btree.put(p, contents(w.sc), side, contents(w.tmp)[65536..65536 + sl], contents(w.nrow)[0..0]);
                        if s2 < 0 {
                            return exec.tree_err(s2);
                        }
                        side = s2;
                        var cr = exec.change(w, contents(w.cur)[0..rl], true, contents(w.cur)[0..0], false);
                        if cr < 0 {
                            return cr;
                        }
                        cr = exec.change(w, contents(w.cur)[0..0], false, contents(w.nrow)[0..ra], true);
                        if cr < 0 {
                            return cr;
                        }
                    }
                }
            }
        }
    }
    if seen != 0 && !w.orderdep {
        // a row remembered as holding a value another row took kept it (`uniq.changed`)
        exec.note(w, exec.e_unique());
    }
    if side != 0 {
        let rm = settle(p, w, root, nroot, side);
        if rm < 0 {
            return rm;
        }
        nroot = rm;
    }
    if w.orderdep {
        return exec.order_dependent();
    }
    if w.code != 0 {
        return exec.verdict(w);
    }
    w.root = nroot;
    return 0;
}

// The rows of an UPDATE that take another key (`side`, see `side_key`), over the tree before the statement (`root`) and the tree it has made so far (`nroot`): the tree with them moved, or a refusal. A
// taken key that a row which stays has is an error (noted); one that a row is leaving is order-dependent (marked): the answer is then `nroot`, which the caller drops.
fn settle[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int, nroot: int, side: int) -> [file_read, file_write] int {
    var out = nroot;
    // first every key taken is checked
    contents(w.key)[0] = byte_of('n');
    var kl = 1;
    var more = true;
    while more {
        let r = btree.next_after(p, contents(w.sc), side, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return exec.tree_err(r);
        } else if int_of(contents(w.key2)[0]) != 'n' {
            more = false;
        } else {
            let nk = r / 1024;
            exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
            kl = nk;
            // the key in the table
            build.put_be(contents(w.tmp), 65536, w.tid, 4);
            exec.copy(contents(w.key2), 1, nk - 1, contents(w.tmp), 65540);
            let g = btree.get(p, contents(w.sc), root, contents(w.tmp)[65536..65539 + nk], contents(w.nrow));
            if g >= 0 {
                contents(w.key2)[0] = byte_of('o');
                let g2 = btree.get(p, contents(w.sc), side, contents(w.key2)[0..nk], contents(w.nrow));
                if g2 >= 0 {
                    w.orderdep = true;
                } else if g2 == btree.not_found() {
                    exec.note(w, exec.e_unique());
                } else {
                    return exec.tree_err(g2);
                }
            } else if g != btree.not_found() {
                return exec.tree_err(g);
            }
        }
    }
    if w.orderdep || w.code != 0 {
        return out;
    }
    // then the rows leave their keys, and take the new ones
    var pass = 0;
    while pass < 2 {
        var mark = 'o';
        if pass == 1 {
            mark = 'n';
        }
        contents(w.key)[0] = byte_of(mark);
        kl = 1;
        more = true;
        while more {
            let r = btree.next_after(p, contents(w.sc), side, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
            if r == btree.not_found() {
                more = false;
            } else if r < 0 {
                return exec.tree_err(r);
            } else if int_of(contents(w.key2)[0]) != mark {
                more = false;
            } else {
                let nk = r / 1024;
                let nv = r % 1024;
                exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
                kl = nk;
                build.put_be(contents(w.tmp), 65536, w.tid, 4);
                exec.copy(contents(w.key2), 1, nk - 1, contents(w.tmp), 65540);
                var nw = 0;
                if pass == 0 {
                    // (the row as it is under the key it leaves: its index entries leave with it, 6bo)
                    let og = btree.get(p, contents(w.sc), out, contents(w.tmp)[65536..65539 + nk], contents(w.full));
                    nw = exec.del_key(p, w, out, contents(w.tmp)[65536..65539 + nk], 3 + nk);
                    if nw >= 0 && og > 32 {
                        nw = exec.indexed(p, w, nw, contents(w.tmp)[65536..65539 + nk], 3 + nk, contents(w.full)[32..og], false, contents(w.full)[32..og], true);
                    }
                } else {
                    nw = exec.put_key(p, w, out, contents(w.tmp)[65536..65539 + nk], 3 + nk, contents(w.cur)[0..nv]);
                    if nw >= 0 && nv > 32 {
                        nw = exec.indexed(p, w, nw, contents(w.tmp)[65536..65539 + nk], 3 + nk, contents(w.cur)[32..nv], true, contents(w.cur)[32..nv], false);
                    }
                }
                if nw < 0 {
                    return nw;
                }
                out = nw;
            }
        }
        pass = pass + 1;
    }
    return out;
}

// DELETE (ir.md section 2).
pub fn delete[&q, &z, &x, &k](p: &!z pager.Pager, w: &!q exec.Work, root: int, e: &x [byte], kinds: &k [int]) -> [file_read, file_write] int {
    exec.start(w, root);
    if len(e) < 3 || int_of(e[0]) != 3 {
        return exec.malformed();
    }
    let r0 = exec.bind_table(p, w, root, e, 1);
    if r0 != 0 {
        return r0;
    }
    let at = 3 + w.nlen;
    if at >= len(e) {
        return exec.malformed();
    }
    var wpos = 0;
    if int_of(e[at]) == 1 {
        wpos = at + 1;
        let (cnt, end) = eval.scan(e, wpos, contents(w.ws));
        if cnt < 0 || end != len(e) {
            return exec.malformed();
        }
    } else if at + 1 != len(e) {
        return exec.malformed();
    }
    let rw = via.where_static(w, e, kinds, wpos);
    if rw < 0 {
        return rw;
    }
    via.choose(w, e, kinds);
    if w.code != 0 {
        return exec.verdict(w);
    }
    var nroot = root;
    via.start(w);
    var more = true;
    while more {
        let rl = via.next(p, w, root);
        if rl == 0 - 1 {
            more = false;
        } else if rl < 0 {
            return rl;
        } else {
            let pass = exec.passes(w, e, kinds, wpos);
            if pass < 0 {
                return pass;
            }
            if pass == 1 {
                let kl = w.klen;
                let nw = exec.row_del(p, w, nroot, contents(w.key), kl, contents(w.cur)[0..rl]);
                if nw < 0 {
                    return nw;
                }
                nroot = nw;
                let cr = exec.change(w, contents(w.cur)[0..rl], true, contents(w.cur)[0..0], false);
                if cr < 0 {
                    return cr;
                }
                let rr = exec.ret_row(w, contents(w.cur)[0..rl]);
                if rr < 0 {
                    return rr;
                }
                w.count = w.count + 1;
            }
        }
    }
    if w.orderdep {
        return exec.order_dependent();
    }
    if w.code != 0 {
        return exec.verdict(w);
    }
    w.root = nroot;
    return 0;
}

// What the table's built indexes have, or had, of a form of the row being erased (docs/m3-engine.md 6bo): the form is `full[a..b]`, the row's key `tmp[65540..65540 + kn]`.
// With `there` the entries are removed (the row as it is); either way their keys are taken out of the internal pages (6bc). The new root, or a refusal.
fn unindexed[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int, a: int, b: int, kn: int, there: bool) -> [file_read, file_write] int {
    var nroot = root;
    var i = 0;
    while i < w.nix {
        let l = index.entry(contents(w.ix), i * index.rec(), contents(w.ctx)[64..64 + w.dlen], contents(w.full)[a..b], contents(w.tmp)[65540..65540 + kn], contents(w.ixa));
        if l > 0 {
            if there {
                let d = btree.del(p, contents(w.sc), nroot, contents(w.ixa)[0..l]);
                if d >= 0 {
                    nroot = d;
                } else if d != btree.not_found() {
                    return exec.tree_err(d);
                }
            }
            let s = btree.scrub(p, contents(w.sc), nroot, contents(w.ixa)[0..l]);
            if s < 0 {
                return exec.tree_err(s);
            }
            nroot = s;
        }
        i = i + 1;
    }
    return nroot;
}

// Erase a row and its past (docs/m3-engine.md 6n): `e` is a DELETE whose WHERE is `<the key> = <a constant>` and nothing else. The row is removed with no history entry made for it, and every history
// entry of its key is removed: AS OF any transaction the row is then not there, and after two commits and a sweep (6c) no page of the file holds it. On 0 `count_of` is the row (0 or 1) plus the entries
// removed. A row that was moved to another key by an UPDATE has entries under each key it had: each is erased by its own key.
pub fn erase[&q, &z, &x, &k](p: &!z pager.Pager, w: &!q exec.Work, root: int, e: &x [byte], kinds: &k [int]) -> [file_read, file_write] int {
    exec.start(w, root);
    if len(e) < 3 || int_of(e[0]) != 3 {
        return exec.unsupported();
    }
    let r0 = exec.bind_table(p, w, root, e, 1);
    if r0 != 0 {
        return r0;
    }
    let at = 3 + w.nlen;
    if at + 1 >= len(e) || int_of(e[at]) != 1 {
        return exec.unsupported();
    }
    let rw = via.where_static(w, e, kinds, at + 1);
    if rw < 0 {
        return rw;
    }
    if w.code != 0 {
        return exec.verdict(w);
    }
    let kn = w.lon;
    if w.nconj != 1 || kn < 0 || w.hin != kn || !exec.same(contents(w.lo), 0, kn, contents(w.hi), 0, kn) {
        return exec.unsupported();
    }
    // the key in the tree, in `tmp` from 65536
    build.put_be(contents(w.tmp), 65536, w.tid, 4);
    exec.copy(contents(w.lo), 0, kn, contents(w.tmp), 65540);
    var nroot = root;
    // (the row as it is, for what its table's indexes have of it: 6bo)
    let g0 = btree.get(p, contents(w.sc), root, contents(w.tmp)[65536..65540 + kn], contents(w.full));
    let d = btree.del(p, contents(w.sc), nroot, contents(w.tmp)[65536..65540 + kn]);
    if d >= 0 {
        nroot = d;
        w.count = 1;
    } else if d != btree.not_found() {
        return exec.tree_err(d);
    }
    if g0 > 32 {
        nroot = unindexed(p, w, nroot, 32, g0, kn, true);
        if nroot < 0 {
            return nroot;
        }
    }
    // and no internal page of the tree keeps the key as the bound of a child (6bc), whether the row was there or went before
    let sr = btree.scrub(p, contents(w.sc), nroot, contents(w.tmp)[65536..65540 + kn]);
    if sr < 0 {
        return exec.tree_err(sr);
    }
    nroot = sr;
    // the row's history. Where the tree says all of its history is findable by key (6bi), the entries that begin as the row's key does and are a transaction's
    // number longer name the row's history entries: each is removed with the entry it names. Otherwise (a file from before) all of the history is read.
    let ik = tables.indexed_key(contents(w.key));
    let ig = btree.get(p, contents(w.sc), root, contents(w.key)[0..ik], contents(w.cur));
    if ig < 0 && ig != btree.not_found() {
        return exec.tree_err(ig);
    }
    var kl = tables.past_prefix(contents(w.tmp)[65536..65540 + kn], 4 + kn, contents(w.key));
    let pl = kl;
    exec.copy(contents(w.key), 0, pl, contents(w.tmp), 66000);
    var more = ig >= 0;
    while more {
        let r = btree.next_after(p, contents(w.sc), root, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return exec.tree_err(r);
        } else {
            let nk = r / 1024;
            if nk < pl || !exec.same(contents(w.key2), 0, pl, contents(w.tmp), 66000, pl) {
                more = false;
            } else {
                if nk == pl + 8 {
                    // the history entry: the history's space, the number, the key
                    build.put_be(contents(w.ukey), 0, 4294967295, 4);
                    exec.copy(contents(w.key2), pl, 8, contents(w.ukey), 4);
                    let hl = exec.copy(contents(w.tmp), 65536, 4 + kn, contents(w.ukey), 12);
                    // (what the row was then: an update took its index entries of then away plainly, and their keys may still bound a child, 6bo)
                    let hg = btree.get(p, contents(w.sc), nroot, contents(w.ukey)[0..hl], contents(w.full));
                    if hg > 33 && int_of(contents(w.full)[0]) == 1 {
                        nroot = unindexed(p, w, nroot, 33, hg, kn, false);
                        if nroot < 0 {
                            return nroot;
                        }
                    }
                    let hd = btree.del(p, contents(w.sc), nroot, contents(w.ukey)[0..hl]);
                    if hd >= 0 {
                        let hs = btree.scrub(p, contents(w.sc), hd, contents(w.ukey)[0..hl]);
                        if hs < 0 {
                            return exec.tree_err(hs);
                        }
                        nroot = hs;
                        w.count = w.count + 1;
                    } else if hd != btree.not_found() {
                        return exec.tree_err(hd);
                    }
                    let xd = btree.del(p, contents(w.sc), nroot, contents(w.key2)[0..nk]);
                    if xd < 0 {
                        return exec.tree_err(xd);
                    }
                    let xs = btree.scrub(p, contents(w.sc), xd, contents(w.key2)[0..nk]);
                    if xs < 0 {
                        return exec.tree_err(xs);
                    }
                    nroot = xs;
                }
                exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
                kl = nk;
            }
        }
    }
    if ig >= 0 {
        w.root = nroot;
        return 0;
    }
    build.put_be(contents(w.key), 0, 4294967295, 4);
    kl = 4;
    more = true;
    while more {
        let r = btree.next_after(p, contents(w.sc), root, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return exec.tree_err(r);
        } else {
            let nk = r / 1024;
            if nk < 12 || commit.be(contents(w.key2), 0, 4) != 4294967295 {
                return exec.damaged();
            }
            if exec.same(contents(w.key2), 12, nk - 12, contents(w.tmp), 65536, 4 + kn) {
                let nv = r % 1024;
                if nv > 33 && int_of(contents(w.cur)[0]) == 1 {
                    exec.copy(contents(w.cur), 0, nv, contents(w.full), 0);
                    nroot = unindexed(p, w, nroot, 33, nv, kn, false);
                    if nroot < 0 {
                        return nroot;
                    }
                }
                let nw = btree.del(p, contents(w.sc), nroot, contents(w.key2)[0..nk]);
                if nw < 0 {
                    return exec.tree_err(nw);
                }
                // (the entry's key holds the row's: no internal page keeps it either)
                let sw = btree.scrub(p, contents(w.sc), nw, contents(w.key2)[0..nk]);
                if sw < 0 {
                    return exec.tree_err(sw);
                }
                nroot = sw;
                w.count = w.count + 1;
                // and the entry by key, if this one was written since there are such (6bi): it holds the row's key
                let xl = tables.past_key(contents(w.tmp)[65536..65540 + kn], 4 + kn, 9223372036854775807 - commit.be(contents(w.key2), 4, 8), contents(w.ukey));
                let xd = btree.del(p, contents(w.sc), nroot, contents(w.ukey)[0..xl]);
                if xd >= 0 {
                    let xs = btree.scrub(p, contents(w.sc), xd, contents(w.ukey)[0..xl]);
                    if xs < 0 {
                        return exec.tree_err(xs);
                    }
                    nroot = xs;
                } else if xd != btree.not_found() {
                    return exec.tree_err(xd);
                }
            }
            exec.copy(contents(w.key2), 0, nk, contents(w.key), 0);
            kl = nk;
        }
    }
    w.root = nroot;
    return 0;
}
