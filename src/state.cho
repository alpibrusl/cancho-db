module cdb.state;

import std.crypto;
import cdb.build;

// Facts, `changes` and `state` (docs/spec/state.md), sans-io: the encoding of a fact, its leaf, the Merkle root of a commit's
// leaves, the `changes` hash and the `state` hash. A caller hands over bytes and gets bytes (or a rule number) back; nothing here
// reads a file, a clock or the network. The Python reference is tools/state.py; tests/state_check.py compares the two.

// The rules a fact can break (spec section 2 and 3), as the numbers these functions answer with.
pub fn e_kind() -> [] int {
    return 1;
}

pub fn e_table() -> [] int {
    return 2;
}

pub fn e_pk() -> [] int {
    return 3;
}

pub fn e_image() -> [] int {
    return 4;
}

pub fn e_order() -> [] int {
    return 5;
}

// the output slice is too small
pub fn e_space() -> [] int {
    return 6;
}

fn put_zero32[&o](out: &!o [byte], at: int) -> [] int {
    if at < 0 || at + 32 > len(out) {
        return 0 - 1;
    }
    var i = 0;
    while i < 32 {
        out[at + i] = byte_of(0);
        i = i + 1;
    }
    return at + 32;
}

fn is_zero[&d](h: &d [byte]) -> [] bool {
    var i = 0;
    while i < len(h) {
        if int_of(h[i]) != 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// `old` and `new` are 32 bytes, or empty when the hash is absent. The encoding of the fact (`table || pk || kind || old || new`,
// spec section 2) is written to `out` at `at`: the new position, or the negative of the rule it breaks.
pub fn put_fact[&o, &t, &p, &a, &b](out: &!o [byte], at: int, kind: int, table: &t [byte], pk: &p [byte], old: &a [byte], new: &b [byte]) -> [] int {
    if kind < 0 || kind > 2 {
        return 0 - e_kind();
    }
    if len(table) < 1 || len(table) > 255 {
        return 0 - e_table();
    }
    if len(pk) < 1 || len(pk) > 65535 {
        return 0 - e_pk();
    }
    var want_old = 1;
    var want_new = 1;
    if kind == 0 {
        want_old = 0;
    }
    if kind == 2 {
        want_new = 0;
    }
    if len(old) != 32 * want_old || len(new) != 32 * want_new {
        return 0 - e_image();
    }
    if len(old) == 32 && is_zero(old) || len(new) == 32 && is_zero(new) {
        return 0 - e_image();
    }
    var n = build.put_be(out, at, len(table), 2);
    n = build.put_bytes(out, n, table);
    n = build.put_be(out, n, len(pk), 4);
    n = build.put_bytes(out, n, pk);
    n = build.put_be(out, n, kind, 1);
    if len(old) == 32 {
        n = build.put_bytes(out, n, old);
    } else {
        n = put_zero32(out, n);
    }
    if len(new) == 32 {
        n = build.put_bytes(out, n, new);
    } else {
        n = put_zero32(out, n);
    }
    if n < 0 {
        return 0 - e_space();
    }
    return n;
}

// SHA-256 of `prefix`, a NUL, then each of the parts, into the 32 bytes of `out`.
fn hash3[&x, &a, &b, &c, &o](prefix: &x [byte], a: &a [byte], b: &b [byte], c: &c [byte], out: &!o [byte]) -> [] int {
    region r {
        let sha = alloc_slice[r](crypto.sha256_state_len(), 0);
        let nul = alloc_slice[r](1, byte_of(0));
        crypto.sha256_init(sha);
        crypto.sha256_update(sha, prefix);
        crypto.sha256_update(sha, nul);
        crypto.sha256_update(sha, a);
        crypto.sha256_update(sha, b);
        crypto.sha256_update(sha, c);
        crypto.sha256_final(sha, out);
    }
    return 0;
}

// The hash of a row's image (spec section 2 of state.md): SHA-256 of "cancho-db/row/v1", a NUL, the image; into the 32 bytes of `out`.
pub fn row_hash[&i, &o](image: &i [byte], out: &!o [byte]) -> [] int {
    return hash3("cancho-db/row/v1", image, "", "", out);
}

// Version 2 of the delta store (l3a.md section 9): the hash of a row image with a 16-byte salt, SHA-256 of "cancho-db/row/v2", a NUL, the salt, the image; into the 32 bytes of `out`.
pub fn row_hash2[&s, &i, &o](salt: &s [byte], image: &i [byte], out: &!o [byte]) -> [] int {
    return hash3("cancho-db/row/v2", salt, image, "", out);
}

// The commitment to a key (l3a.md section 9): SHA-256 of "cancho-db/key/v1", a NUL, the 16-byte salt, the key; into the 32 bytes of `out`.
pub fn key_commit[&s, &k, &o](salt: &s [byte], plain: &k [byte], out: &!o [byte]) -> [] int {
    return hash3("cancho-db/key/v1", salt, plain, "", out);
}

// The leaf of an encoded fact (spec section 2), into the 32 bytes of `out`.
pub fn leaf[&e, &o](enc: &e [byte], out: &!o [byte]) -> [] int {
    return hash3("cancho-db/fact/v1", enc, "", "", out);
}

// Whether `(t1, p1)` sorts strictly before `(t2, p2)`: table first, then pk, each an unsigned lexicographic byte string with a prefix first.
pub fn key_less[&a, &b, &c, &d](t1: &a [byte], p1: &b [byte], t2: &c [byte], p2: &d [byte]) -> [] bool {
    let c = cmp(t1, t2);
    if c != 0 {
        return c < 0;
    }
    return cmp(p1, p2) < 0;
}

fn cmp[&a, &b](x: &a [byte], y: &b [byte]) -> [] int {
    var i = 0;
    while i < len(x) && i < len(y) {
        if int_of(x[i]) != int_of(y[i]) {
            return int_of(x[i]) - int_of(y[i]);
        }
        i = i + 1;
    }
    return len(x) - len(y);
}

// The Merkle root (spec section 3) of the `n` leaves, 32 bytes each, in `lv`, into `out`; `lv` is used up. 32 zero bytes for no leaves.
pub fn merkle[&l, &o](lv: &!l [byte], n: int, out: &!o [byte]) -> [] int {
    var m = n;
    if m == 0 {
        var z = 0;
        while z < 32 {
            out[z] = byte_of(0);
            z = z + 1;
        }
        return 0;
    }
    region r {
        let both = alloc_slice[r](64, byte_of(0));
        let h = alloc_slice[r](32, byte_of(0));
        while m > 1 {
            var k = 0;
            while 2 * k + 1 < m {
                var j = 0;
                while j < 32 {
                    both[j] = lv[64 * k + j];
                    both[32 + j] = lv[64 * k + 32 + j];
                    j = j + 1;
                }
                hash3("cancho-db/node/v1", both, "", "", h);
                j = 0;
                while j < 32 {
                    lv[32 * k + j] = h[j];
                    j = j + 1;
                }
                k = k + 1;
            }
            if m % 2 == 1 {
                var j = 0;
                while j < 32 {
                    lv[32 * k + j] = lv[32 * (m - 1) + j];
                    j = j + 1;
                }
                k = k + 1;
            }
            m = k;
        }
        var j = 0;
        while j < 32 {
            out[j] = lv[j];
            j = j + 1;
        }
    }
    return 0;
}

// `changes` (spec section 3) from the number of facts and their root, into the 32 bytes of `out`.
pub fn changes[&r, &o](n: int, root: &r [byte], out: &!o [byte]) -> [] int {
    region g {
        let cnt = alloc_slice[g](4, byte_of(0));
        build.put_be(cnt, 0, n, 4);
        hash3("cancho-db/changes/v1", cnt, root, "", out);
    }
    return 0;
}

// `state` (spec section 4): the `np` parents' states, 32 bytes each in `parents`, and this commit's `changes`, into the 32 bytes of `out`.
pub fn state[&p, &c, &o](np: int, parents: &p [byte], chg: &c [byte], out: &!o [byte]) -> [] int {
    region g {
        let head = alloc_slice[g](1 + len(parents), byte_of(0));
        build.put_bytes(head, build.put_be(head, 0, np, 1), parents);
        hash3("cancho-db/state/v1", head, chg, "", out);
    }
    return 0;
}

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return 0 - 1;
}

// The hex text `all[a..b]` decoded into `w` at `at`: its length in bytes, or -1 if it is not hex (or odd).
pub fn hexdec[&s, &w](all: &s [byte], a: int, b: int, w: &!w [byte], at: int) -> [] int {
    if (b - a) % 2 != 0 {
        return 0 - 1;
    }
    var j = 0;
    while j < (b - a) / 2 {
        let hi = hexval(int_of(all[a + 2 * j]));
        let lo = hexval(int_of(all[a + 2 * j + 1]));
        if hi < 0 || lo < 0 {
            return 0 - 1;
        }
        w[at + j] = byte_of(hi * 16 + lo);
        j = j + 1;
    }
    return (b - a) / 2;
}

// The end of the token that starts at `a` (a space, the end of the line `le`, or the colon when `colon` is true).
pub fn token_end[&s](all: &s [byte], a: int, le: int, colon: bool) -> [] int {
    var e = a;
    while e < le && int_of(all[e]) != ' ' && !(colon && int_of(all[e]) == ':') {
        e = e + 1;
    }
    return e;
}

// The `changes` (spec section 3) of the facts text `all[ps..le]` (`kind:table:pk:old:new`, hex, `-` for an absent hash, separated by spaces: what `cdb.facts` makes and
// `C` in tools/state.py reads), into the 32 bytes of `digest`. Answers 0; a rule number (`e_*`) for the first fact that breaks one; or -1 for a text that is not facts or
// does not fit the scratch: `w` (decoded bytes: half the text), `meta` (9 ints a fact), `enc` (one fact's encoding, and the root) and `lv` (32 bytes a fact).
pub fn changes_of[&s, &ww, &mm, &ee, &ll, &rr](all: &s [byte], ps: int, le: int, w: &!ww [byte], meta: &!mm [int], enc: &!ee [byte], lv: &!ll [byte], digest: &!rr [byte]) -> [] int {
    var at = 0;
    var nf = 0;
    var p = ps;
    while p < le {
        let te = token_end(all, p, le, false);
        // kind:table:pk:old:new
        let ke = token_end(all, p, te, true);
        if ke == te || ke - p != 1 {
            return 0 - 1;
        }
        let base = 9 * nf;
        if base + 9 > len(meta) || 32 * nf + 32 > len(lv) {
            return 0 - 1;
        }
        meta[base] = int_of(all[p]) - '0';
        var q = ke + 1;
        var f = 1;
        while f < 5 {
            let fe = token_end(all, q, te, true);
            if f >= 3 && fe - q == 1 && int_of(all[q]) == '-' {
                meta[base + 2 * f - 1] = at;
                meta[base + 2 * f] = 0;
            } else {
                if at + (fe - q) / 2 > len(w) {
                    return 0 - 1;
                }
                let got = hexdec(all, q, fe, w, at);
                if got < 0 {
                    return 0 - 1;
                }
                meta[base + 2 * f - 1] = at;
                meta[base + 2 * f] = got;
                at = at + got;
            }
            if f < 4 {
                if fe >= te {
                    return 0 - 1;
                }
                q = fe + 1;
            } else if fe != te {
                return 0 - 1;
            }
            f = f + 1;
        }
        nf = nf + 1;
        p = te + 1;
    }
    var i = 0;
    while i < nf {
        let b = 9 * i;
        let kind = meta[b];
        let n = put_fact(enc, 0, kind, w[meta[b + 1]..meta[b + 1] + meta[b + 2]], w[meta[b + 3]..meta[b + 3] + meta[b + 4]], w[meta[b + 5]..meta[b + 5] + meta[b + 6]], w[meta[b + 7]..meta[b + 7] + meta[b + 8]]);
        if n < 0 {
            return 0 - n;
        }
        if i > 0 {
            let pb = 9 * (i - 1);
            if !key_less(w[meta[pb + 1]..meta[pb + 1] + meta[pb + 2]], w[meta[pb + 3]..meta[pb + 3] + meta[pb + 4]], w[meta[b + 1]..meta[b + 1] + meta[b + 2]], w[meta[b + 3]..meta[b + 3] + meta[b + 4]]) {
                return e_order();
            }
        }
        leaf(enc[0..n], lv[32 * i..32 * i + 32]);
        i = i + 1;
    }
    merkle(lv[0..32 * nf], nf, enc[0..32]);
    changes(nf, enc[0..32], digest);
    return 0;
}
