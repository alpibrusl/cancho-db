edition 9;
module cdb.refs;

import cdb.commit;
import cdb.build;
import cdb.row;
import cdb.btree;
import cdb.pager;
import cdb.tables;
import cdb.stmt;
import cdb.lower;
import cdb.exec;
import cdb.checks;

// A column that references another table's key (docs/m3-engine.md 6ca). When a table is made its references are read from the parser's tree and held to the table
// referenced (`prepare`), then kept under the catalog from both sides (`store`). A statement that stores rows of the table looks each reference up as the row is
// stored and says 23503 at its end (`load`, `row`, `failed`); one that takes rows out of a table that is referenced walks the tables that reference it (`gone`).

// Where the staged references of a statement that defines are, in `rows` (far above its staged checks), and where they are counted and end, in `pos`. Each: the
// column, what `on delete` says, the number of the table referenced, a byte and its name.
fn staged_at() -> [] int {
    return 1048576;
}

fn p_count() -> [] int {
    return exec.p_ddl() + 5;
}

fn p_fill() -> [] int {
    return exec.p_ddl() + 6;
}

// Where the references of a statement's table are listed, in `cki` (above the checks' list, src/checks.cho): whether one found no key (the statement's error, at
// its end), how many tables reference this one, the table's number, how many references it has, then three ints each: the column, the number of the table
// referenced, what `on delete` says.
fn k_failed() -> [] int {
    return 1296;
}

fn k_count() -> [] int {
    return 1300;
}

pub fn max_refs() -> [] int {
    return 64;
}

// The references of the statement `stmt` (a CREATE TABLE's node) for the table `name`, whose entry is built in `ent` (`nc` columns): each held to the table it
// names in the tree `root`, and staged. Errors are noted (no such table, no such column); 0, or a refusal.
pub fn prepare[&q, &z, &s, &t, &n, &k, &m](p: &!z pager.Pager, w: &!q exec.Work, root: int, sql: &s [byte], toks: &t [int], nodes: &n [int], kids: &k [int], stmt: int, name: &m [byte], nc: int) -> [file_read] int {
    contents(w.pos)[p_count()] = 0;
    contents(w.pos)[p_fill()] = staged_at();
    let dl = tables.def_len(contents(w.ent));
    var node = nodes[6 * stmt + 5];
    while node >= 0 {
        if nodes[6 * node] == stmt.n_ref() {
            if nodes[6 * node + 3] != 2 {
                return exec.malformed();
            }
            let count = contents(w.pos)[p_count()];
            let fill = contents(w.pos)[p_fill()];
            if count >= max_refs() || fill + 8 + tables.max_name() > len(contents(w.rows)) {
                return exec.too_big();
            }
            // the column that references: one of the table's (the parser read it as one)
            let cl = lower.name_text(sql, toks, nodes[6 * node + 5], contents(w.nrow)[0..256], 0);
            var col = 0 - 1;
            var c = 0;
            while c < nc {
                let cn = row.col_name(contents(w.ent)[6..6 + dl], c);
                if cl == len(cn) && exec.same(contents(w.nrow), 0, cl, cn, 0, cl) {
                    col = c;
                }
                c = c + 1;
            }
            if col < 0 {
                return exec.malformed();
            }
            let ty = row.col_type(contents(w.ent)[6..6 + dl], col);
            // the table referenced: another one, which is there
            let tl = lower.name_text(sql, toks, nodes[6 * node + 1], contents(w.rows)[fill + 7..fill + 7 + tables.max_name()], 0);
            if tl < 1 {
                return exec.unsupported();
            }
            if tl == len(name) && exec.same(contents(w.rows), fill + 7, tl, name, 0, tl) {
                // (a table that references itself: PostgreSQL takes it; not here)
                return exec.unsupported();
            }
            let g = tables.find(p, contents(w.sc), root, contents(w.rows)[fill + 7..fill + 7 + tl], contents(w.key), contents(w.cur));
            if g == btree.not_found() {
                exec.note(w, exec.e_no_table());
            } else if g < 0 {
                return exec.tree_err(g);
            } else {
                let tdl = tables.def_len(contents(w.cur));
                let tn = row.columns(contents(w.cur)[6..6 + tdl]);
                // the column referenced: the one named, or the key; it is the whole key, and of the same type
                let given = kids[nodes[6 * node + 2]];
                var tc = 0 - 1;
                c = 0;
                if given >= 0 {
                    let gl = lower.name_text(sql, toks, given, contents(w.nrow)[0..256], 0);
                    while c < tn {
                        let cn = row.col_name(contents(w.cur)[6..6 + tdl], c);
                        if gl == len(cn) && exec.same(contents(w.nrow), 0, gl, cn, 0, gl) {
                            tc = c;
                        }
                        c = c + 1;
                    }
                } else {
                    while c < tn {
                        if row.col_pk(contents(w.cur)[6..6 + tdl], c) == 1 {
                            tc = c;
                        }
                        c = c + 1;
                    }
                }
                if tc < 0 {
                    exec.note(w, exec.e_no_column());
                } else if row.key_columns(contents(w.cur)[6..6 + tdl]) != 1 || row.col_pk(contents(w.cur)[6..6 + tdl], tc) != 1 {
                    // (a column that is unique and not the key, which PostgreSQL takes; one that is neither, its 42830; a key of several columns)
                    return exec.unsupported();
                } else if row.col_type(contents(w.cur)[6..6 + tdl], tc) != ty {
                    // (PostgreSQL takes two types that compare, and says 42804 of two that do not)
                    return exec.unsupported();
                } else {
                    contents(w.rows)[fill] = byte_of(col);
                    contents(w.rows)[fill + 1] = byte_of(kids[nodes[6 * node + 2] + 1]);
                    build.put_be(contents(w.rows), fill + 2, tables.id_of(contents(w.cur)), 4);
                    contents(w.rows)[fill + 6] = byte_of(tl);
                    contents(w.pos)[p_count()] = count + 1;
                    contents(w.pos)[p_fill()] = fill + 7 + tl;
                }
            }
        }
        node = nodes[6 * node + 4];
    }
    return 0;
}

// Keep the staged references of the table `name`, numbered `id`, in the tree `root`: the new tree, or a refusal.
pub fn store[&q, &z, &m](p: &!z pager.Pager, w: &!q exec.Work, root: int, id: int, name: &m [byte]) -> [file_read, file_write] int {
    let n = contents(w.pos)[p_count()];
    var nroot = root;
    var a = staged_at();
    var i = 0;
    while i < n {
        let col = int_of(contents(w.rows)[a]);
        let to = commit.be(contents(w.rows), a + 2, 4);
        let tl = int_of(contents(w.rows)[a + 6]);
        // the value is the staged bytes after the column: what `on delete` says, the number, the name (its length is the value's)
        exec.copy(contents(w.rows), a + 7, tl, contents(w.rows), a + 6);
        var kl = tables.ref_key(id, col, contents(w.key));
        var nw = exec.put_key(p, w, nroot, contents(w.key), kl, contents(w.rows)[a + 1..a + 6 + tl]);
        if nw < 0 {
            return nw;
        }
        kl = tables.refd_key(to, id, col, contents(w.key));
        nw = exec.put_key(p, w, nw, contents(w.key), kl, name);
        if nw < 0 {
            return nw;
        }
        nroot = nw;
        a = a + 7 + tl;
        i = i + 1;
    }
    return nroot;
}

// Remove the references of the table numbered `id` from the tree `root`, on both sides (the table is dropped): the new tree, or a refusal.
pub fn forget[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int, id: int) -> [file_read, file_write] int {
    var nroot = root;
    var more = true;
    while more {
        let kl = tables.ref_key(id, 0 - 1, contents(w.key));
        let r = btree.next_after(p, contents(w.sc), nroot, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
        if r == btree.not_found() {
            more = false;
        } else if r < 0 {
            return exec.tree_err(r);
        } else {
            let nk = r / 1024;
            if nk != 11 || r % 1024 < 6 || !exec.same(contents(w.key2), 0, 9, contents(w.key), 0, 9) {
                more = false;
            } else {
                let to = commit.be(contents(w.cur), 1, 4);
                let col = hex(int_of(contents(w.key2)[9])) * 16 + hex(int_of(contents(w.key2)[10]));
                var nw = exec.del_key(p, w, nroot, contents(w.key2), nk);
                if nw < 0 {
                    return nw;
                }
                let bl = tables.refd_key(to, id, col, contents(w.key));
                nw = exec.del_key(p, w, nw, contents(w.key), bl);
                if nw < 0 {
                    return nw;
                }
                nroot = nw;
            }
        }
    }
    return nroot;
}

fn hex(c: int) -> [] int {
    if c >= 'a' {
        return c - 'a' + 10;
    }
    return c - '0';
}

// How many keys of the tree `root` begin with `prefix` (9 bytes: a kind and a table's number), up to `most`; or a refusal.
fn count_under[&q, &z, &x](p: &!z pager.Pager, w: &!q exec.Work, root: int, prefix: &x [byte], most: int) -> [file_read] int {
    var n = 0;
    region g {
        let key = alloc_slice[g](64, byte_of(0));
        let next = alloc_slice[g](256, byte_of(0));
        let v = alloc_slice[g](1024, byte_of(0));
        var kl = exec.copy(prefix, 0, 9, key, 0);
        var more = root != 0;
        while more && n >= 0 && n < most {
            let r = btree.next_after(p, contents(w.sc), root, key[0..kl], false, next, v);
            if r == btree.not_found() {
                more = false;
            } else if r < 0 {
                n = exec.tree_err(r);
            } else if r / 1024 < 10 || r / 1024 > 64 || !exec.same(next, 0, 9, prefix, 0, 9) {
                more = false;
            } else {
                n = n + 1;
                kl = exec.copy(next, 0, r / 1024, key, 0);
            }
        }
    }
    return n;
}

// Whether a table references the table numbered `id` (1, 0), or the table numbered `id` references one (`mine`); or a refusal.
pub fn any[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int, id: int, mine: bool) -> [file_read] int {
    var out = 0;
    region g {
        let prefix = alloc_slice[g](16, byte_of(0));
        if mine {
            tables.ref_key(id, 0 - 1, prefix);
        } else {
            tables.refd_key(id, 0 - 1, 0, prefix);
        }
        out = count_under(p, w, root, prefix[0..9], 1);
    }
    return out;
}

// Read the references of the bound table from the tree `root`, and whether it is referenced, for the statement: 0, or a refusal.
pub fn load[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int) -> [file_read] int {
    let id = w.tid;
    contents(w.cki)[k_failed()] = 0;
    contents(w.cki)[k_failed() + 2] = id;
    contents(w.cki)[k_count()] = 0;
    let by = any(p, w, root, id, false);
    if by < 0 {
        return by;
    }
    contents(w.cki)[k_failed() + 1] = by;
    var n = 0;
    var status = 0;
    region g {
        let key = alloc_slice[g](64, byte_of(0));
        let next = alloc_slice[g](256, byte_of(0));
        let v = alloc_slice[g](1024, byte_of(0));
        var kl = tables.ref_key(id, 0 - 1, key);
        var more = root != 0;
        while more {
            let r = btree.next_after(p, contents(w.sc), root, key[0..kl], false, next, v);
            if r == btree.not_found() {
                more = false;
            } else if r < 0 {
                status = exec.tree_err(r);
                more = false;
            } else if r / 1024 != 11 || commit.be(next, 0, 4) != 0 || int_of(next[4]) != 10 || commit.be(next, 5, 4) != id {
                more = false;
            } else if r % 1024 < 6 || n >= max_refs() {
                status = exec.damaged();
                more = false;
            } else {
                contents(w.cki)[k_count() + 1 + 3 * n] = hex(int_of(next[9])) * 16 + hex(int_of(next[10]));
                contents(w.cki)[k_count() + 2 + 3 * n] = commit.be(v, 1, 4);
                contents(w.cki)[k_count() + 3 + 3 * n] = int_of(v[0]);
                n = n + 1;
                kl = exec.copy(next, 0, 11, key, 0);
            }
        }
    }
    if status < 0 {
        return status;
    }
    contents(w.cki)[k_count()] = n;
    return 0;
}

// Whether the value at `va` of `r` (of type `ty`, not null) is a key of the table numbered `to` in the tree `root`: 1, 0, or a refusal. The key is the value as a
// key of one column stores it, which is what the table referenced has (its key is that one column, of that type).
fn finds[&q, &z, &r](p: &!z pager.Pager, w: &!q exec.Work, root: int, to: int, ty: int, r: &r [byte], va: int) -> [file_read] int {
    var out = 0;
    region g {
        let def = alloc_slice[g](7, byte_of(0));
        let key = alloc_slice[g](4 + exec.max_stored_key(), byte_of(0));
        let v = alloc_slice[g](1024, byte_of(0));
        build.put_be(def, 0, 1, 2);
        def[2] = byte_of(ty);
        def[3] = byte_of(1);
        build.put_be(def, 4, 1, 2);
        def[6] = byte_of('k');
        build.put_be(key, 0, to, 4);
        let vl = tables.stored_len(r, va);
        var kn = 0 - 1;
        if vl > 0 {
            kn = row.stored_key(def, r[va..va + vl], key[4..4 + exec.max_stored_key()]);
        }
        if kn < 0 {
            out = exec.too_big();
        } else {
            let got = btree.get(p, contents(w.sc), root, key[0..4 + kn], v);
            if got >= 0 {
                out = 1;
            } else if got != btree.not_found() {
                out = exec.tree_err(got);
            }
        }
    }
    return out;
}

// A row of the bound table is stored: each of its references is looked up in the tree `root` (the table referenced is not one the statement writes). One that
// finds no key is the statement's error at its end (`failed`), not now. 0, or a refusal.
pub fn row_stored[&q, &z, &r](p: &!z pager.Pager, w: &!q exec.Work, root: int, r: &r [byte]) -> [file_read, file_write] int {
    let n = contents(w.cki)[k_count()];
    if n == 0 {
        return 0;
    }
    let dl = w.dlen;
    var i = 0;
    while i < n {
        let col = contents(w.cki)[k_count() + 1 + 3 * i];
        let va = row.value_at(contents(w.ctx)[64..64 + dl], r, col);
        if va < 0 {
            return exec.damaged();
        }
        if int_of(r[va]) != 0 {
            let f = finds(p, w, root, contents(w.cki)[k_count() + 2 + 3 * i], row.col_type(contents(w.ctx)[64..64 + dl], col), r, va);
            if f < 0 {
                return f;
            }
            if f == 0 {
                contents(w.cki)[k_failed()] = 1;
            }
        }
        i = i + 1;
    }
    return alone(p, w);
}

// A transaction beside the others (6bw) that counts on a row it did not write, or takes one others may count on, is held to the rule of `serializable`: a key of
// no table is noted among the keys it wrote, which says so to whoever puts it on the branch (src/merge.cho). 0, or a refusal.
fn alone[&q, &z](p: &!z pager.Pager, w: &!q exec.Work) -> [file_read, file_write] int {
    if w.wroot < 0 {
        return 0;
    }
    var nw = 0;
    region g {
        let tk = alloc_slice[g](1, byte_of(0));
        nw = btree.put(p, contents(w.sc), w.wroot, tk, tk);
    }
    if nw < 0 {
        return exec.tree_err(nw);
    }
    w.wroot = nw;
    return 0;
}

// Whether a row stored by the statement found no key for a reference: 23503 is then the statement's error, if nothing else was.
pub fn failed[&q](w: &q exec.Work) -> [] bool {
    return contents(w.cki)[k_failed()] == 1;
}

// The rows that reference a row of the table numbered `id` which is not in the tree `root`: 0 if there is none; else 1 if one of them says nothing of that
// (23503), plus 2 if one says `cascade` or `set null`; or a refusal. `deleted`: the rows of `id` went; otherwise their keys changed, of which a reference can say
// nothing here (`on update` is not read), so every such row is of the first kind.
fn scan[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int, id: int, deleted: bool) -> [file_read] int {
    var out = 0;
    var strict = false;
    var soft = false;
    region g {
        let key = alloc_slice[g](64, byte_of(0));
        let next = alloc_slice[g](256, byte_of(0));
        let cname = alloc_slice[g](1024, byte_of(0));
        let ent = alloc_slice[g](1024, byte_of(0));
        let scratch = alloc_slice[g](256, byte_of(0));
        let rk = alloc_slice[g](4 + exec.max_stored_key(), byte_of(0));
        let rnext = alloc_slice[g](4 + exec.max_stored_key() + 8, byte_of(0));
        let rv = alloc_slice[g](1024, byte_of(0));
        let act = alloc_slice[g](1024, byte_of(0));
        var kl = tables.refd_key(id, 0 - 1, 0, key);
        var more = root != 0;
        while more && out == 0 {
            let r = btree.next_after(p, contents(w.sc), root, key[0..kl], false, next, cname);
            if r == btree.not_found() {
                more = false;
            } else if r < 0 {
                out = exec.tree_err(r);
            } else if r / 1024 != 14 || commit.be(next, 0, 4) != 0 || int_of(next[4]) != 11 || commit.be(next, 5, 4) != id {
                more = false;
            } else {
                kl = exec.copy(next, 0, 14, key, 0);
                let child = commit.be(next, 9, 4);
                let col = int_of(next[13]);
                let en = tables.find(p, contents(w.sc), root, cname[0..r % 1024], scratch, ent);
                let al = tables.ref_key(child, col, scratch);
                let an = btree.get(p, contents(w.sc), root, scratch[0..al], act);
                if en < 0 || an < 6 {
                    out = exec.damaged();
                } else {
                    let dl = tables.def_len(ent);
                    let ty = row.col_type(ent[6..6 + dl], col);
                    // every row of the referencing table
                    build.put_be(rk, 0, child, 4);
                    var rl = 4;
                    var rows = true;
                    while rows && out == 0 {
                        let rr = btree.next_after(p, contents(w.sc), root, rk[0..rl], false, rnext, rv);
                        if rr == btree.not_found() {
                            rows = false;
                        } else if rr < 0 {
                            out = exec.tree_err(rr);
                        } else if rr / 1024 < 5 || commit.be(rnext, 0, 4) != child {
                            rows = false;
                        } else if rr % 1024 < 32 || rr / 1024 > 4 + exec.max_stored_key() {
                            out = exec.damaged();
                        } else {
                            rl = exec.copy(rnext, 0, rr / 1024, rk, 0);
                            let va = row.value_at(ent[6..6 + dl], rv[32..rr % 1024], col);
                            if va < 0 {
                                out = exec.damaged();
                            } else if int_of(rv[32 + va]) != 0 {
                                let f = finds(p, w, root, id, ty, rv[32..rr % 1024], va);
                                if f < 0 {
                                    out = f;
                                } else if f == 0 && (int_of(act[0]) == 0 || !deleted) {
                                    strict = true;
                                } else if f == 0 {
                                    soft = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if out < 0 {
        return out;
    }
    var found = 0;
    if strict {
        found = 1;
    }
    if soft {
        found = found + 2;
    }
    return found;
}

// Whether a table references the statement's (`load`).
pub fn referenced[&q](w: &q exec.Work) -> [] bool {
    return contents(w.cki)[k_failed() + 1] != 0;
}

// The rows of the table `name` whose references find no key in the tree `w.root`, after rows of a table it references went: one whose reference says `cascade`
// goes too, one whose reference says `set null` has that column made null (if it may be, and its table's checks still hold: else that error). Each is a change of
// the statement. The tree is left in `w.root` and how many rows went in `cki`; 0, an error, or a refusal. The table is left bound.
fn child_pass[&q, &z, &m](p: &!z pager.Pager, w: &!q exec.Work, name: &m [byte]) -> [file_read, file_write] int {
    let from = w.root;
    var out = from;
    var status = 0;
    var went = 0;
    region g {
        let bind = alloc_slice[g](2 + len(name), byte_of(0));
        let marks = alloc_slice[g](row.max_columns(), 0);
        build.put_be(bind, 0, len(name), 2);
        exec.copy(name, 0, len(name), bind, 2);
        status = exec.bind_table(p, w, from, bind, 0);
        if status > 0 {
            status = exec.damaged();
        }
        if status == 0 {
            status = load(p, w, from);
        }
        if status == 0 {
            let lc = checks.load(p, w, from);
            if lc < 0 {
                status = lc;
            }
        }
        let n = contents(w.cki)[k_count()];
        let dl = w.dlen;
        let el = w.elen;
        let nc = row.columns(contents(w.ctx)[64..64 + dl]);
        // every row of it: the bounds the statement's WHERE gave its own table's walk are not this table's
        w.lon = 0 - 1;
        w.hin = 0 - 1;
        exec.scan_start(w);
        var more = status == 0;
        while more && status == 0 {
            let rl = exec.scan_next(p, w, from);
            if rl == 0 - 1 {
                more = false;
            } else if rl < 0 {
                status = rl;
            } else {
                let kl = w.klen;
                var del = false;
                var nulls = 0;
                var c = 0;
                while c < nc {
                    marks[c] = 0;
                    c = c + 1;
                }
                var i = 0;
                while i < n && status == 0 {
                    let col = contents(w.cki)[k_count() + 1 + 3 * i];
                    let act = contents(w.cki)[k_count() + 3 + 3 * i];
                    let va = row.value_at(contents(w.ctx)[64..64 + dl], contents(w.cur)[0..rl], col);
                    if va < 0 {
                        status = exec.damaged();
                    } else if act != 0 && int_of(contents(w.cur)[va]) != 0 {
                        let f = finds(p, w, from, contents(w.cki)[k_count() + 2 + 3 * i], row.col_type(contents(w.ctx)[64..64 + dl], col), contents(w.cur)[0..rl], va);
                        if f < 0 {
                            status = f;
                        } else if f == 0 && act == 1 {
                            del = true;
                        } else if f == 0 {
                            marks[col] = 1;
                            nulls = nulls + 1;
                        }
                    }
                    i = i + 1;
                }
                if status == 0 && del {
                    let nw = exec.row_del(p, w, out, contents(w.key), kl, contents(w.cur)[0..rl]);
                    if nw < 0 {
                        status = nw;
                    } else {
                        out = nw;
                        status = exec.change(w, contents(w.cur)[0..rl], true, contents(w.cur)[0..0], false);
                        went = went + 1;
                    }
                } else if status == 0 && nulls > 0 {
                    // the row with those columns null
                    var ra = 0;
                    var oa = 0;
                    c = 0;
                    while c < nc && status == 0 {
                        let ol = tables.stored_len(contents(w.cur)[0..rl], oa);
                        if ol < 0 {
                            status = exec.damaged();
                        } else if marks[c] == 1 {
                            if tables.not_null(contents(w.ent)[0..el], c) || row.col_pk(contents(w.ctx)[64..64 + dl], c) != 0 {
                                status = exec.e_not_null();
                            }
                            contents(w.nrow)[ra] = byte_of(0);
                            ra = ra + 1;
                        } else {
                            ra = exec.copy(contents(w.cur), oa, ol, contents(w.nrow), ra);
                        }
                        oa = oa + ol;
                        c = c + 1;
                    }
                    if status == 0 {
                        status = checks.hold(w, contents(w.nrow)[0..ra]);
                    }
                    if status == 0 {
                        let nw = exec.row_put(p, w, out, contents(w.key), kl, contents(w.nrow)[0..ra], contents(w.cur)[0..rl], 1);
                        if nw < 0 {
                            status = nw;
                        } else {
                            out = nw;
                            status = exec.change(w, contents(w.cur)[0..rl], true, contents(w.nrow)[0..ra], true);
                        }
                    }
                }
            }
        }
    }
    w.root = out;
    contents(w.cki)[k_failed() + 3] = went;
    return status;
}

// After rows of the statement's table went (`deleted`), or their keys changed: every table that references it is walked in the tree the statement made (`root`).
// A row whose reference finds no key there goes too, or has its column made null, if its reference says so, and then the rows that reference *it* are walked in
// turn (a list of tables, in place of recursion); what is left that references nothing is 23503. The tree is left in `w.root`, and another table may be left
// bound. 0, an error, or a refusal.
pub fn gone[&q, &z](p: &!z pager.Pager, w: &!q exec.Work, root: int, deleted: bool) -> [file_read, file_write] int {
    w.root = root;
    if contents(w.cki)[k_failed() + 1] == 0 {
        return 0;
    }
    let id = contents(w.cki)[k_failed() + 2];
    var status = alone(p, w);
    if status < 0 {
        return status;
    }
    let first = scan(p, w, root, id, deleted);
    if first < 0 {
        return first;
    }
    if first == 0 {
        return 0;
    }
    if first == 1 {
        return exec.e_ref();
    }
    region g {
        // the tables rows went from, in the order they are to be walked: `ids[0]` is how many
        let ids = alloc_slice[g](66, 0);
        let key = alloc_slice[g](64, byte_of(0));
        let next = alloc_slice[g](256, byte_of(0));
        let cname = alloc_slice[g](1024, byte_of(0));
        ids[0] = 1;
        ids[1] = id;
        var done = 0;
        while done < ids[0] && status == 0 {
            let parent = ids[1 + done];
            var kl = tables.refd_key(parent, 0 - 1, 0, key);
            var last = 0 - 1;
            var more = true;
            while more && status == 0 {
                let r = btree.next_after(p, contents(w.sc), w.root, key[0..kl], false, next, cname);
                if r == btree.not_found() {
                    more = false;
                } else if r < 0 {
                    status = exec.tree_err(r);
                } else if r / 1024 != 14 || commit.be(next, 0, 4) != 0 || int_of(next[4]) != 11 || commit.be(next, 5, 4) != parent {
                    more = false;
                } else {
                    kl = exec.copy(next, 0, 14, key, 0);
                    let child = commit.be(next, 9, 4);
                    if child != last {
                        last = child;
                        status = child_pass(p, w, cname[0..r % 1024]);
                        if status == 0 && contents(w.cki)[k_failed() + 3] > 0 {
                            if ids[0] >= 64 {
                                status = exec.too_big();
                            } else {
                                ids[0] = ids[0] + 1;
                                ids[ids[0]] = child;
                            }
                        }
                    }
                }
            }
            done = done + 1;
        }
        // what is left: a row that references nothing now, of a reference that says nothing of it
        var left = 0;
        var i = 0;
        while i < ids[0] && status == 0 {
            let s2 = scan(p, w, w.root, ids[1 + i], true);
            if s2 < 0 {
                status = s2;
            } else if s2 != 0 {
                left = 1;
            }
            i = i + 1;
        }
        if status == 0 && left == 1 {
            status = exec.e_ref();
        } else if status == 0 && first % 2 == 1 {
            // a row that referenced with nothing said went with another reference of its own: PostgreSQL's answer depends on which it comes to first
            status = exec.unsupported();
        }
    }
    return status;
}
