module cdb.stmt;

import cdb.lex;
import cdb.parse;

// The statement parser (docs/m1-lowering.md sections 2 and 7: slice P1b-2), sans-io, over the expression parser of
// src/parse.cho: tokens in, a tree in the same caller arrays, rendered by `parse.render`.
//
// This slice reads a SELECT:
//
//     SELECT [DISTINCT] item [, item]... [FROM source [, source]...] [WHERE e] [GROUP BY e, ...] [HAVING e]
//            [ORDER BY e [ASC|DESC], ...] [LIMIT e] [OFFSET e]
//
//     item   = * | t.* | e [[AS] name]
//     source = t [[AS] name] { [INNER] JOIN t [[AS] name] ON e | LEFT [OUTER] JOIN t [[AS] name] ON e }
//
// Everything else is refused with a tag, never passed through: set operations (`set-operation`), the other joins and `USING`
// (`unsupported-join`), schema-qualified tables, `NULLS FIRST`, `FOR UPDATE`, `OFFSET` before `LIMIT` and the like
// (`syntax`, `unknown-construct`). A sub-select anywhere is `subquery`, from the expression parser.
//
// The tree: a SELECT's children are its clauses in order (ITEMS, FROM, WHERE, GROUP, HAVING, ORDERBY, LIMIT, OFFSET: only
// the ones present), each a node of its own kind; see `parse.cho` for the node layout.

fn is_name_tok[&s, &t](sql: &s [byte], toks: &t [int], i: int, end: int) -> [] bool {
    if i >= end {
        return false;
    }
    let k = parse.tkind(toks, i);
    if k == lex.t_quoted() {
        return true;
    }
    if k != lex.t_ident() {
        return false;
    }
    return !parse.is_reserved(sql, parse.tstart(toks, i), parse.tlen(toks, i));
}

// PostgreSQL's non-reserved words that may not be a bare select-list label (`pg_get_keywords()`, `barelabel` false): after an
// expression they continue it (`1 day`, `x filter (...)`, `f() over (...)`), so `select a day` is a syntax error there.
fn bare_label_ok[&s, &t](sql: &s [byte], toks: &t [int], i: int) -> [] bool {
    if parse.tkind(toks, i) != lex.t_ident() {
        return true;
    }
    let a = parse.tstart(toks, i);
    let n = parse.tlen(toks, i);
    return !(parse.word_is(sql, a, n, "day") || parse.word_is(sql, a, n, "filter") || parse.word_is(sql, a, n, "hour") || parse.word_is(sql, a, n, "minute") || parse.word_is(sql, a, n, "month") || parse.word_is(sql, a, n, "over") || parse.word_is(sql, a, n, "second") || parse.word_is(sql, a, n, "varying") || parse.word_is(sql, a, n, "within") || parse.word_is(sql, a, n, "without") || parse.word_is(sql, a, n, "year"));
}

// An optional `[AS] name` at `pos`. Answers the token index of the name or -1 in st[9], and the position after it.
fn alias[&s, &t, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, mode: int, st: &!x [int]) -> [] int {
    st[9] = 0 - 1;
    var p = pos;
    if parse.kw(sql, toks, p, end, "as") {
        p = p + 1;
        if p >= end {
            return parse.fail(st, p, parse.e_syntax());
        }
        if parse.tkind(toks, p) == lex.t_ident() && parse.is_reserved(sql, parse.tstart(toks, p), parse.tlen(toks, p)) {
            return parse.fail(st, p, parse.e_reserved_word());
        }
        if !is_name_tok(sql, toks, p, end) {
            return parse.fail(st, p, parse.e_syntax());
        }
        st[9] = p;
        return p + 1;
    }
    // `UPDATE t SET ...`: SET is not a keyword PostgreSQL reserves, but it is never an alias there
    if mode != 1 && parse.kw(sql, toks, p, end, "set") {
        return p;
    }
    // mode 0: a table alias, bare or after AS; 1: a select-list label; 2: AS is required (INSERT INTO t AS a)
    if mode != 2 && is_name_tok(sql, toks, p, end) && (mode != 1 || bare_label_ok(sql, toks, p)) {
        st[9] = p;
        return p + 1;
    }
    return p;
}

// Appends `id` to the staging array.
fn stage[&t, &x](tmp: &!t [int], st: &!x [int], id: int) -> [] int {
    if st[10] >= len(tmp) {
        return 0 - parse.e_too_big();
    }
    tmp[st[10]] = id;
    st[10] = st[10] + 1;
    return 0;
}

// Whether the string literal at token `i` is a commit id: 64 lower-case hexadecimal digits and nothing else.
fn is_commit_id[&s, &t](sql: &s [byte], toks: &t [int], i: int) -> [] bool {
    if parse.tlen(toks, i) != 64 {
        return false;
    }
    let a = parse.tstart(toks, i);
    var k = 0;
    while k < 64 {
        let c = int_of(sql[a + k]);
        if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// A table reference `name [[AS] alias]`, as a TABLE leaf, staged. Answers the position after it.
fn table_ref[&s, &t, &n, &k, &g, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, allow_paren: bool, nodes: &!n [int], kids: &!k [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    if pos >= end {
        return parse.fail(st, pos, parse.e_syntax());
    }
    if parse.punct(sql, toks, pos, end, '(') {
        if parse.kw(sql, toks, pos + 1, end, "select") || parse.kw(sql, toks, pos + 1, end, "with") || parse.kw(sql, toks, pos + 1, end, "values") {
            return parse.fail(st, pos + 1, parse.e_subquery());
        }
        return parse.fail(st, pos, parse.e_unknown_construct());
    }
    if parse.tkind(toks, pos) == lex.t_ident() && parse.is_reserved(sql, parse.tstart(toks, pos), parse.tlen(toks, pos)) {
        return parse.fail(st, pos, parse.e_reserved_word());
    }
    if !is_name_tok(sql, toks, pos, end) {
        return parse.fail(st, pos, parse.e_syntax());
    }
    if parse.punct(sql, toks, pos + 1, end, '.') || !allow_paren && parse.punct(sql, toks, pos + 1, end, '(') {
        return parse.fail(st, pos + 1, parse.e_unknown_construct());
    }
    var amode = 0;
    if allow_paren {
        amode = 2;
    }
    // `AS OF '<64 hex digits>'` (docs/m2-branches.md D27): `AS`, the word `of` and a string literal; without the literal, `as of` is an alias named `of`, as before
    var asof = 0 - 1;
    var after = pos + 1;
    if parse.kw(sql, toks, pos + 1, end, "as") && parse.kw(sql, toks, pos + 2, end, "of") && pos + 3 < end && parse.tkind(toks, pos + 3) == lex.t_string() {
        if !is_commit_id(sql, toks, pos + 3) {
            return parse.fail(st, pos + 3, parse.e_as_of_bad_commit());
        }
        asof = pos + 3;
        after = pos + 4;
    }
    let q = alias(sql, toks, after, end, amode, st);
    if q < 0 {
        return q;
    }
    let id = parse.mk(nodes, kids, st, parse.n_table(), pos, tmp, 0, st[9], asof);
    if id < 0 {
        return parse.fail(st, pos, 0 - id);
    }
    let r = stage(tmp, st, id);
    if r < 0 {
        return parse.fail(st, pos, 0 - r);
    }
    return q;
}

// One expression, staged. Answers the position after it.
fn expr_item[&s, &t, &n, &k, &v, &o, &g, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    let q = parse.expr(sql, toks, pos, end, nodes, kids, vs, os, st);
    if q < 0 {
        return q;
    }
    let r = stage(tmp, st, st[2]);
    if r < 0 {
        return parse.fail(st, pos, 0 - r);
    }
    return q;
}

// Closes the staged items into a node of `kind` (children: the staged ids), clears the staging area, and stages that node's
// id for the caller's list `clauses` below the mark `mark`.
fn close_list[&n, &k, &g, &x](nodes: &!n [int], kids: &!k [int], tmp: &!g [int], st: &!x [int], kind: int, mark: int, data: int) -> [] int {
    let id = parse.mk(nodes, kids, st, kind, data, tmp[mark..st[10]], st[10] - mark, 0 - 1, 0 - 1);
    st[10] = mark;
    return id;
}

// The items of a select list from `from` (`*`, `t.*`, or an expression and its alias), each staged: the position after the last.
fn item_list[&s, &t, &n, &k, &v, &o, &g, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    var pos = from;
    var more = true;
    while more {
        if pos >= end {
            return parse.fail(st, pos, parse.e_syntax());
        }
        if parse.opr(sql, toks, pos, end, "*") {
            let id = parse.mk(nodes, kids, st, parse.n_star(), 0 - 1, tmp, 0, 0 - 1, 0 - 1);
            if id < 0 {
                return parse.fail(st, pos, 0 - id);
            }
            let r = stage(tmp, st, id);
            if r < 0 {
                return parse.fail(st, pos, 0 - r);
            }
            pos = pos + 1;
        } else if is_name_tok(sql, toks, pos, end) && parse.punct(sql, toks, pos + 1, end, '.') && parse.opr(sql, toks, pos + 2, end, "*") {
            let id = parse.mk(nodes, kids, st, parse.n_star(), pos, tmp, 0, 0 - 1, 0 - 1);
            if id < 0 {
                return parse.fail(st, pos, 0 - id);
            }
            let r = stage(tmp, st, id);
            if r < 0 {
                return parse.fail(st, pos, 0 - r);
            }
            pos = pos + 3;
        } else {
            let mark = st[10];
            var q = expr_item(sql, toks, pos, end, nodes, kids, vs, os, tmp, st);
            if q < 0 {
                return q;
            }
            q = alias(sql, toks, q, end, 1, st);
            if q < 0 {
                return q;
            }
            // the expression is staged at `mark`; replace it by an ITEM node holding it
            let id = parse.mk(nodes, kids, st, parse.n_item(), st[9], tmp[mark..mark + 1], 1, 0 - 1, 0 - 1);
            if id < 0 {
                return parse.fail(st, pos, 0 - id);
            }
            st[10] = mark;
            let r = stage(tmp, st, id);
            if r < 0 {
                return parse.fail(st, pos, 0 - r);
            }
            pos = q;
        }
        if parse.punct(sql, toks, pos, end, ',') {
            pos = pos + 1;
        } else {
            more = false;
        }
    }
    return pos;
}

// RETURNING items, the word at `pos`, after an INSERT, UPDATE or DELETE of the table whose TABLE node is `table`: a SELECT of the items FROM that table is built beside the statement (its node in
// `st[13]`), which is how the engine reads them (docs/m3-engine.md 6aa). One of the engine's forms. The position after the items.
fn returning[&s, &t, &n, &k, &v, &o, &g, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, table: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    engine_form(st, parse.e_returning());
    st[10] = 0;
    let q = item_list(sql, toks, pos + 1, end, nodes, kids, vs, os, tmp, st);
    if q < 0 {
        return q;
    }
    let items = close_list(nodes, kids, tmp, st, parse.n_items(), 0, 0);
    if items < 0 {
        return parse.fail(st, pos, 0 - items);
    }
    var r = stage(tmp, st, table);
    if r < 0 {
        return parse.fail(st, pos, 0 - r);
    }
    let source = close_list(nodes, kids, tmp, st, parse.n_from(), 0, 0);
    if source < 0 {
        return parse.fail(st, pos, 0 - source);
    }
    r = stage(tmp, st, items);
    if r >= 0 {
        r = stage(tmp, st, source);
    }
    if r < 0 {
        return parse.fail(st, pos, 0 - r);
    }
    let sel = parse.mk(nodes, kids, st, parse.n_select(), 0, tmp[0..2], 2, 0 - 1, 0 - 1);
    st[10] = 0;
    if sel < 0 {
        return parse.fail(st, pos, 0 - sel);
    }
    st[13] = sel;
    return q;
}

// Parses the SELECT in tokens [from, end). On success st[2] is the root and the answer is `end`; otherwise `0 - code`, with
// st[3] the token. `tmp` stages children while lists are built; `clauses` collects a SELECT's own children. `st` is the state
// `parse.reset` made, and at least 12 ints.
pub fn select[&s, &t, &n, &k, &v, &o, &g, &c, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], clauses: &!c [int], st: &!x [int]) -> [] int {
    if !parse.kw(sql, toks, from, end, "select") {
        return parse.fail(st, from, parse.e_unsupported_statement());
    }
    st[10] = 0;
    st[11] = 0;
    var pos = from + 1;
    var distinct = 0;
    if parse.kw(sql, toks, pos, end, "distinct") {
        distinct = 1;
        pos = pos + 1;
    }
    // the items
    pos = item_list(sql, toks, pos, end, nodes, kids, vs, os, tmp, st);
    if pos < 0 {
        return pos;
    }
    var more = true;
    var items = close_list(nodes, kids, tmp, st, parse.n_items(), 0, 0);
    if items < 0 {
        return parse.fail(st, pos, 0 - items);
    }
    clauses[0] = items;
    var nclauses = 1;
    // FROM
    if parse.kw(sql, toks, pos, end, "from") {
        pos = pos + 1;
        more = true;
        while more {
            var q = table_ref(sql, toks, pos, end, false, nodes, kids, tmp, st);
            if q < 0 {
                return q;
            }
            pos = q;
            // joins bind left to right: `a join b on c join d on e` is `((a join b on c) join d on e)`
            var joining = true;
            while joining {
                var kind = 0 - 1;
                if parse.kw(sql, toks, pos, end, "join") {
                    kind = 0;
                    pos = pos + 1;
                } else if parse.kw(sql, toks, pos, end, "inner") && parse.kw(sql, toks, pos + 1, end, "join") {
                    kind = 0;
                    pos = pos + 2;
                } else if parse.kw(sql, toks, pos, end, "left") {
                    if parse.kw(sql, toks, pos + 1, end, "outer") && parse.kw(sql, toks, pos + 2, end, "join") {
                        pos = pos + 3;
                    } else if parse.kw(sql, toks, pos + 1, end, "join") {
                        pos = pos + 2;
                    } else {
                        return parse.fail(st, pos, parse.e_unsupported_join());
                    }
                    kind = 1;
                } else if parse.kw(sql, toks, pos, end, "right") || parse.kw(sql, toks, pos, end, "full") || parse.kw(sql, toks, pos, end, "cross") || parse.kw(sql, toks, pos, end, "natural") {
                    return parse.fail(st, pos, parse.e_unsupported_join());
                }
                if kind < 0 {
                    joining = false;
                } else {
                    q = table_ref(sql, toks, pos, end, false, nodes, kids, tmp, st);
                    if q < 0 {
                        return q;
                    }
                    pos = q;
                    if !parse.kw(sql, toks, pos, end, "on") {
                        if parse.kw(sql, toks, pos, end, "using") {
                            return parse.fail(st, pos, parse.e_unsupported_join());
                        }
                        return parse.fail(st, pos, parse.e_syntax());
                    }
                    q = expr_item(sql, toks, pos + 1, end, nodes, kids, vs, os, tmp, st);
                    if q < 0 {
                        return q;
                    }
                    pos = q;
                    // staged: left, right, condition: they become one JOIN node, which is the new left
                    let top = st[10];
                    let id = parse.mk(nodes, kids, st, parse.n_join(), kind, tmp[top - 3..top], 3, 0 - 1, 0 - 1);
                    if id < 0 {
                        return parse.fail(st, pos, 0 - id);
                    }
                    st[10] = top - 3;
                    let r = stage(tmp, st, id);
                    if r < 0 {
                        return parse.fail(st, pos, 0 - r);
                    }
                }
            }
            if parse.punct(sql, toks, pos, end, ',') {
                pos = pos + 1;
            } else {
                more = false;
            }
        }
        let id = close_list(nodes, kids, tmp, st, parse.n_from(), 0, 0);
        if id < 0 {
            return parse.fail(st, pos, 0 - id);
        }
        clauses[nclauses] = id;
        nclauses = nclauses + 1;
    }
    // WHERE
    if parse.kw(sql, toks, pos, end, "where") {
        let q = expr_item(sql, toks, pos + 1, end, nodes, kids, vs, os, tmp, st);
        if q < 0 {
            return q;
        }
        pos = q;
        let id = close_list(nodes, kids, tmp, st, parse.n_where(), 0, 0);
        if id < 0 {
            return parse.fail(st, pos, 0 - id);
        }
        clauses[nclauses] = id;
        nclauses = nclauses + 1;
    }
    // GROUP BY
    if parse.kw(sql, toks, pos, end, "group") {
        if !parse.kw(sql, toks, pos + 1, end, "by") {
            return parse.fail(st, pos + 1, parse.e_syntax());
        }
        pos = pos + 2;
        more = true;
        while more {
            // GROUP BY ROLLUP (...) and CUBE (...) are grouping sets in PostgreSQL, not calls
            if (parse.kw(sql, toks, pos, end, "rollup") || parse.kw(sql, toks, pos, end, "cube")) && parse.punct(sql, toks, pos + 1, end, '(') {
                return parse.fail(st, pos, parse.e_unknown_construct());
            }
            let q = expr_item(sql, toks, pos, end, nodes, kids, vs, os, tmp, st);
            if q < 0 {
                return q;
            }
            pos = q;
            if parse.punct(sql, toks, pos, end, ',') {
                pos = pos + 1;
            } else {
                more = false;
            }
        }
        let id = close_list(nodes, kids, tmp, st, parse.n_group(), 0, 0);
        if id < 0 {
            return parse.fail(st, pos, 0 - id);
        }
        clauses[nclauses] = id;
        nclauses = nclauses + 1;
    }
    // HAVING
    if parse.kw(sql, toks, pos, end, "having") {
        let q = expr_item(sql, toks, pos + 1, end, nodes, kids, vs, os, tmp, st);
        if q < 0 {
            return q;
        }
        pos = q;
        let id = close_list(nodes, kids, tmp, st, parse.n_having(), 0, 0);
        if id < 0 {
            return parse.fail(st, pos, 0 - id);
        }
        clauses[nclauses] = id;
        nclauses = nclauses + 1;
    }
    // ORDER BY
    if parse.kw(sql, toks, pos, end, "order") {
        if !parse.kw(sql, toks, pos + 1, end, "by") {
            return parse.fail(st, pos + 1, parse.e_syntax());
        }
        pos = pos + 2;
        more = true;
        while more {
            let mark = st[10];
            var q = expr_item(sql, toks, pos, end, nodes, kids, vs, os, tmp, st);
            if q < 0 {
                return q;
            }
            var dir = 0;
            if parse.kw(sql, toks, q, end, "asc") {
                dir = 1;
                q = q + 1;
            } else if parse.kw(sql, toks, q, end, "desc") {
                dir = 2;
                q = q + 1;
            }
            if parse.kw(sql, toks, q, end, "nulls") || parse.kw(sql, toks, q, end, "using") {
                return parse.fail(st, q, parse.e_unknown_construct());
            }
            let id = parse.mk(nodes, kids, st, parse.n_order(), dir, tmp[mark..mark + 1], 1, 0 - 1, 0 - 1);
            if id < 0 {
                return parse.fail(st, pos, 0 - id);
            }
            st[10] = mark;
            let r = stage(tmp, st, id);
            if r < 0 {
                return parse.fail(st, pos, 0 - r);
            }
            pos = q;
            if parse.punct(sql, toks, pos, end, ',') {
                pos = pos + 1;
            } else {
                more = false;
            }
        }
        let id = close_list(nodes, kids, tmp, st, parse.n_orderby(), 0, 0);
        if id < 0 {
            return parse.fail(st, pos, 0 - id);
        }
        clauses[nclauses] = id;
        nclauses = nclauses + 1;
    }
    // LIMIT, OFFSET
    if parse.kw(sql, toks, pos, end, "limit") {
        let q = expr_item(sql, toks, pos + 1, end, nodes, kids, vs, os, tmp, st);
        if q < 0 {
            return q;
        }
        pos = q;
        let id = close_list(nodes, kids, tmp, st, parse.n_limit(), 0, 0);
        if id < 0 {
            return parse.fail(st, pos, 0 - id);
        }
        clauses[nclauses] = id;
        nclauses = nclauses + 1;
    }
    if parse.kw(sql, toks, pos, end, "offset") {
        let q = expr_item(sql, toks, pos + 1, end, nodes, kids, vs, os, tmp, st);
        if q < 0 {
            return q;
        }
        pos = q;
        let id = close_list(nodes, kids, tmp, st, parse.n_offset(), 0, 0);
        if id < 0 {
            return parse.fail(st, pos, 0 - id);
        }
        clauses[nclauses] = id;
        nclauses = nclauses + 1;
    }
    if pos < end {
        if parse.kw(sql, toks, pos, end, "union") || parse.kw(sql, toks, pos, end, "intersect") || parse.kw(sql, toks, pos, end, "except") {
            return parse.fail(st, pos, parse.e_set_operation());
        }
        return parse.fail(st, pos, parse.e_syntax());
    }
    let root = parse.mk(nodes, kids, st, parse.n_select(), distinct, clauses[0..nclauses], nclauses, 0 - 1, 0 - 1);
    if root < 0 {
        return parse.fail(st, pos, 0 - root);
    }
    st[2] = root;
    return end;
}

// ---- INSERT, UPDATE, DELETE

// A name token (a column), as a NAME leaf, staged. Answers the position after it.
fn name_item[&s, &t, &n, &k, &g, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, nodes: &!n [int], kids: &!k [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    if pos >= end {
        return parse.fail(st, pos, parse.e_syntax());
    }
    if parse.tkind(toks, pos) == lex.t_ident() && parse.is_reserved(sql, parse.tstart(toks, pos), parse.tlen(toks, pos)) {
        return parse.fail(st, pos, parse.e_reserved_word());
    }
    if !is_name_tok(sql, toks, pos, end) {
        return parse.fail(st, pos, parse.e_syntax());
    }
    let id = parse.mk(nodes, kids, st, parse.n_name(), pos, tmp, 0, 0 - 1, 0 - 1);
    if id < 0 {
        return parse.fail(st, pos, 0 - id);
    }
    let r = stage(tmp, st, id);
    if r < 0 {
        return parse.fail(st, pos, 0 - r);
    }
    return pos + 1;
}

// After a complete statement: what may follow it is refused with the tag of what it is.
fn leftover[&s, &t, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, st: &!x [int]) -> [] int {
    if parse.kw(sql, toks, pos, end, "returning") {
        return parse.fail(st, pos, parse.e_returning());
    }
    if parse.kw(sql, toks, pos, end, "on") {
        return parse.fail(st, pos, parse.e_on_conflict());
    }
    return parse.fail(st, pos, parse.e_syntax());
}

// An optional WHERE at `pos`, appended to `clauses` at `n`. Answers the position after it, and the new count in st[11].
fn where_clause[&s, &t, &n, &k, &v, &o, &g, &c, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], clauses: &!c [int], count: int, st: &!x [int]) -> [] int {
    st[11] = count;
    if !parse.kw(sql, toks, pos, end, "where") {
        return pos;
    }
    let q = expr_item(sql, toks, pos + 1, end, nodes, kids, vs, os, tmp, st);
    if q < 0 {
        return q;
    }
    let id = close_list(nodes, kids, tmp, st, parse.n_where(), 0, 0);
    if id < 0 {
        return parse.fail(st, pos, 0 - id);
    }
    clauses[count] = id;
    st[11] = count + 1;
    return q;
}

// INSERT INTO t [(c, ...)] VALUES (e, ...) [, (e, ...)]...
pub fn insert[&s, &t, &n, &k, &v, &o, &g, &c, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], clauses: &!c [int], st: &!x [int]) -> [] int {
    st[10] = 0;
    var pos = from + 1;
    if !parse.kw(sql, toks, pos, end, "into") {
        return parse.fail(st, pos, parse.e_syntax());
    }
    pos = table_ref(sql, toks, pos + 1, end, true, nodes, kids, tmp, st);
    if pos < 0 {
        return pos;
    }
    clauses[0] = tmp[0];
    st[10] = 0;
    var n = 1;
    if parse.punct(sql, toks, pos, end, '(') {
        if parse.kw(sql, toks, pos + 1, end, "select") || parse.kw(sql, toks, pos + 1, end, "with") || parse.kw(sql, toks, pos + 1, end, "values") {
            return parse.fail(st, pos + 1, parse.e_subquery());
        }
        pos = pos + 1;
        var more = true;
        while more {
            let q = name_item(sql, toks, pos, end, nodes, kids, tmp, st);
            if q < 0 {
                return q;
            }
            pos = q;
            if parse.punct(sql, toks, pos, end, ',') {
                pos = pos + 1;
            } else {
                more = false;
            }
        }
        if !parse.punct(sql, toks, pos, end, ')') {
            return parse.fail(st, pos, parse.e_syntax());
        }
        pos = pos + 1;
        let id = close_list(nodes, kids, tmp, st, parse.n_cols(), 0, 0);
        if id < 0 {
            return parse.fail(st, pos, 0 - id);
        }
        clauses[n] = id;
        n = n + 1;
    }
    var guard = 0 - 1;
    var rows = true;
    if parse.kw(sql, toks, pos, end, "select") {
        // SELECT expression, ... [WHERE condition], with no FROM: the one row of a VALUES, stored if the condition holds (docs/m3-engine.md 6ac). One of the engine's forms; with a FROM it
        // is refused as it was. The condition is kept as a SELECT of it, whose node is the root's data, plus one
        engine_form(st, parse.e_insert_select());
        let at = pos;
        let mark = st[10];
        pos = pos + 1;
        var items = true;
        while items {
            pos = expr_item(sql, toks, pos, end, nodes, kids, vs, os, tmp, st);
            if pos < 0 {
                return pos;
            }
            if parse.punct(sql, toks, pos, end, ',') {
                pos = pos + 1;
            } else {
                items = false;
            }
        }
        let row = close_list(nodes, kids, tmp, st, parse.n_row(), mark, 0);
        if row < 0 {
            return parse.fail(st, at, 0 - row);
        }
        let r = stage(tmp, st, row);
        if r < 0 {
            return parse.fail(st, at, 0 - r);
        }
        if parse.kw(sql, toks, pos, end, "where") {
            pos = parse.expr(sql, toks, pos + 1, end, nodes, kids, vs, os, st);
            if pos < 0 {
                return pos;
            }
            // a SELECT of the one item FROM the statement's table (the lowering knows no SELECT without a table; the engine computes the item over no row), built in the last two places
            // of `clauses`
            clauses[14] = st[2];
            clauses[14] = parse.mk(nodes, kids, st, parse.n_item(), 0 - 1, clauses[14..15], 1, 0 - 1, 0 - 1);
            if clauses[14] >= 0 {
                clauses[14] = parse.mk(nodes, kids, st, parse.n_items(), 0, clauses[14..15], 1, 0 - 1, 0 - 1);
            }
            clauses[15] = clauses[0];
            clauses[15] = parse.mk(nodes, kids, st, parse.n_from(), 0, clauses[15..16], 1, 0 - 1, 0 - 1);
            if clauses[14] < 0 || clauses[15] < 0 {
                return parse.fail(st, at, parse.e_too_big());
            }
            guard = parse.mk(nodes, kids, st, parse.n_select(), 0, clauses[14..16], 2, 0 - 1, 0 - 1);
            if guard < 0 {
                return parse.fail(st, at, 0 - guard);
            }
        }
        if pos < end && !parse.kw(sql, toks, pos, end, "on") && !parse.kw(sql, toks, pos, end, "returning") {
            return parse.fail(st, at, parse.e_insert_select());
        }
        rows = false;
    } else {
        if parse.kw(sql, toks, pos, end, "with") {
            return parse.fail(st, pos, parse.e_insert_select());
        }
        if !parse.kw(sql, toks, pos, end, "values") {
            return parse.fail(st, pos, parse.e_syntax());
        }
        pos = pos + 1;
    }
    while rows {
        if !parse.punct(sql, toks, pos, end, '(') {
            return parse.fail(st, pos, parse.e_syntax());
        }
        if parse.kw(sql, toks, pos + 1, end, "select") || parse.kw(sql, toks, pos + 1, end, "with") {
            return parse.fail(st, pos + 1, parse.e_subquery());
        }
        pos = pos + 1;
        let mark = st[10];
        var items = true;
        while items {
            let q = expr_item(sql, toks, pos, end, nodes, kids, vs, os, tmp, st);
            if q < 0 {
                return q;
            }
            pos = q;
            if parse.punct(sql, toks, pos, end, ',') {
                pos = pos + 1;
            } else {
                items = false;
            }
        }
        if !parse.punct(sql, toks, pos, end, ')') {
            return parse.fail(st, pos, parse.e_syntax());
        }
        pos = pos + 1;
        let row = close_list(nodes, kids, tmp, st, parse.n_row(), mark, 0);
        if row < 0 {
            return parse.fail(st, pos, 0 - row);
        }
        let r = stage(tmp, st, row);
        if r < 0 {
            return parse.fail(st, pos, 0 - r);
        }
        if parse.punct(sql, toks, pos, end, ',') {
            pos = pos + 1;
        } else {
            rows = false;
        }
    }
    let values = close_list(nodes, kids, tmp, st, parse.n_values(), 0, 0);
    if values < 0 {
        return parse.fail(st, pos, 0 - values);
    }
    clauses[n] = values;
    n = n + 1;
    // ON CONFLICT DO NOTHING, with no target: `ex` of the root is 1 (one of the engine's forms, docs/m3-engine.md 6z)
    var oc = 0 - 1;
    if parse.kw(sql, toks, pos, end, "on") && parse.kw(sql, toks, pos + 1, end, "conflict") && parse.kw(sql, toks, pos + 2, end, "do") && parse.kw(sql, toks, pos + 3, end, "nothing") {
        oc = 1;
        engine_form(st, parse.e_on_conflict());
        pos = pos + 4;
    }
    var ret = 0 - 1;
    if parse.kw(sql, toks, pos, end, "returning") {
        pos = returning(sql, toks, pos, end, clauses[0], nodes, kids, vs, os, tmp, st);
        if pos < 0 {
            return pos;
        }
        ret = st[13];
    }
    if pos < end {
        return leftover(sql, toks, pos, end, st);
    }
    let root = parse.mk(nodes, kids, st, parse.n_insert(), guard + 1, clauses[0..n], n, oc, ret);
    if root < 0 {
        return parse.fail(st, pos, 0 - root);
    }
    st[2] = root;
    return end;
}

// UPDATE t [[AS] a] SET c = e [, c = e]... [WHERE e]
pub fn update[&s, &t, &n, &k, &v, &o, &g, &c, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], clauses: &!c [int], st: &!x [int]) -> [] int {
    st[10] = 0;
    var pos = table_ref(sql, toks, from + 1, end, false, nodes, kids, tmp, st);
    if pos < 0 {
        return pos;
    }
    clauses[0] = tmp[0];
    st[10] = 0;
    if !parse.kw(sql, toks, pos, end, "set") {
        return parse.fail(st, pos, parse.e_syntax());
    }
    pos = pos + 1;
    var more = true;
    while more {
        let mark = st[10];
        var q = name_item(sql, toks, pos, end, nodes, kids, tmp, st);
        if q < 0 {
            return q;
        }
        if !parse.opr(sql, toks, q, end, "=") {
            return parse.fail(st, q, parse.e_syntax());
        }
        // the column and the expression are staged; they become one ASSIGN node: its data is the column's token, its child the value
        let column = tmp[mark];
        let col_tok = nodes[6 * column + 1];
        st[10] = mark;
        q = expr_item(sql, toks, q + 1, end, nodes, kids, vs, os, tmp, st);
        if q < 0 {
            return q;
        }
        let id = parse.mk(nodes, kids, st, parse.n_assign(), col_tok, tmp[mark..mark + 1], 1, 0 - 1, 0 - 1);
        if id < 0 {
            return parse.fail(st, pos, 0 - id);
        }
        st[10] = mark;
        let r = stage(tmp, st, id);
        if r < 0 {
            return parse.fail(st, pos, 0 - r);
        }
        pos = q;
        if parse.punct(sql, toks, pos, end, ',') {
            pos = pos + 1;
        } else {
            more = false;
        }
    }
    let assigns = close_list(nodes, kids, tmp, st, parse.n_set(), 0, 0);
    if assigns < 0 {
        return parse.fail(st, pos, 0 - assigns);
    }
    clauses[1] = assigns;
    pos = where_clause(sql, toks, pos, end, nodes, kids, vs, os, tmp, clauses, 2, st);
    if pos < 0 {
        return pos;
    }
    let n = st[11];
    var ret = 0 - 1;
    if parse.kw(sql, toks, pos, end, "returning") {
        pos = returning(sql, toks, pos, end, clauses[0], nodes, kids, vs, os, tmp, st);
        if pos < 0 {
            return pos;
        }
        ret = st[13];
    }
    if pos < end {
        return leftover(sql, toks, pos, end, st);
    }
    let root = parse.mk(nodes, kids, st, parse.n_update(), 0, clauses[0..n], n, 0 - 1, ret);
    if root < 0 {
        return parse.fail(st, pos, 0 - root);
    }
    st[2] = root;
    return end;
}

// DELETE FROM t [[AS] a] [WHERE e]
pub fn delete[&s, &t, &n, &k, &v, &o, &g, &c, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], clauses: &!c [int], st: &!x [int]) -> [] int {
    st[10] = 0;
    var pos = from + 1;
    if !parse.kw(sql, toks, pos, end, "from") {
        return parse.fail(st, pos, parse.e_syntax());
    }
    pos = table_ref(sql, toks, pos + 1, end, false, nodes, kids, tmp, st);
    if pos < 0 {
        return pos;
    }
    clauses[0] = tmp[0];
    st[10] = 0;
    pos = where_clause(sql, toks, pos, end, nodes, kids, vs, os, tmp, clauses, 1, st);
    if pos < 0 {
        return pos;
    }
    let n = st[11];
    var ret = 0 - 1;
    if parse.kw(sql, toks, pos, end, "returning") {
        pos = returning(sql, toks, pos, end, clauses[0], nodes, kids, vs, os, tmp, st);
        if pos < 0 {
            return pos;
        }
        ret = st[13];
    }
    if pos < end {
        if parse.kw(sql, toks, pos, end, "using") {
            return parse.fail(st, pos, parse.e_unknown_construct());
        }
        return leftover(sql, toks, pos, end, st);
    }
    let root = parse.mk(nodes, kids, st, parse.n_delete(), 0, clauses[0..n], n, 0 - 1, ret);
    if root < 0 {
        return parse.fail(st, pos, 0 - root);
    }
    st[2] = root;
    return end;
}

// ---- the closed DDL

// A plain name at `pos` (not reserved, no dots). The token is left in st[9]; answers the position after it.
fn plain_name[&s, &t, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, st: &!x [int]) -> [] int {
    if pos >= end {
        return parse.fail(st, pos, parse.e_syntax());
    }
    if parse.tkind(toks, pos) == lex.t_ident() && parse.is_reserved(sql, parse.tstart(toks, pos), parse.tlen(toks, pos)) {
        return parse.fail(st, pos, parse.e_reserved_word());
    }
    if !is_name_tok(sql, toks, pos, end) {
        return parse.fail(st, pos, parse.e_syntax());
    }
    if parse.punct(sql, toks, pos + 1, end, '.') {
        return parse.fail(st, pos + 1, parse.e_unknown_construct());
    }
    st[9] = pos;
    return pos + 1;
}

// A column definition `name type [NOT NULL] [PRIMARY KEY] [UNIQUE] [DEFAULT literal] [CHECK (expression)] [GENERATED ALWAYS AS IDENTITY]` (the constraints in any order, each once),
// staged as a COLDEF. Answers the position after it.
fn coldef[&s, &t, &n, &k, &v, &o, &g, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    var p = plain_name(sql, toks, pos, end, st);
    if p < 0 {
        return p;
    }
    let col = st[9];
    p = parse.parse_type(sql, toks, p, end, st);
    if p < 0 {
        return p;
    }
    let mark = st[10];
    let ty = parse.mk(nodes, kids, st, parse.n_type(), st[6], tmp, 0, st[7], st[8]);
    if ty < 0 {
        return parse.fail(st, pos, 0 - ty);
    }
    var r = stage(tmp, st, ty);
    if r < 0 {
        return parse.fail(st, pos, 0 - r);
    }
    var flags = 0;
    var more = true;
    while more {
        var bit = 0;
        if parse.kw(sql, toks, p, end, "not") && parse.kw(sql, toks, p + 1, end, "null") {
            bit = 1;
            p = p + 2;
        } else if parse.kw(sql, toks, p, end, "primary") && parse.kw(sql, toks, p + 1, end, "key") {
            bit = 2;
            p = p + 2;
        } else if parse.kw(sql, toks, p, end, "unique") {
            bit = 4;
            p = p + 1;
        } else if parse.kw(sql, toks, p, end, "default") {
            bit = 8;
        } else if parse.kw(sql, toks, p, end, "check") && parse.punct(sql, toks, p + 1, end, '(') {
            bit = 16;
        } else if parse.kw(sql, toks, p, end, "generated") && parse.kw(sql, toks, p + 1, end, "always") && parse.kw(sql, toks, p + 2, end, "as") && parse.kw(sql, toks, p + 3, end, "identity") {
            bit = 32;
            p = p + 4;
        }
        if bit == 0 {
            more = false;
        } else if flags / bit % 2 == 1 {
            return parse.fail(st, p, parse.e_syntax());
        } else if bit == 16 {
            // CHECK (expression): the expression is staged after the type and the default (before the default if it is written first: bit 64)
            let q = parse.expr(sql, toks, p + 1, end, nodes, kids, vs, os, st);
            if q < 0 {
                return q;
            }
            r = stage(tmp, st, st[2]);
            if r < 0 {
                return parse.fail(st, p, 0 - r);
            }
            if flags / 8 % 2 == 0 {
                flags = flags + 64;
            }
            flags = flags + 16;
            engine_form(st, parse.e_unsupported_statement());
            p = q;
        } else if bit == 8 {
            // the default is a literal: a number (optionally negative), a string, NULL, TRUE or FALSE
            let q = parse.expr(sql, toks, p + 1, end, nodes, kids, vs, os, st);
            if q < 0 {
                return q;
            }
            let root = st[2];
            var kind = nodes[6 * root];
            if kind == parse.n_neg() {
                kind = nodes[6 * kids[nodes[6 * root + 2]]];
                if kind != parse.n_num() {
                    return parse.fail(st, p + 1, parse.e_unknown_construct());
                }
            } else if kind != parse.n_num() && kind != parse.n_str() && kind != parse.n_null() && kind != parse.n_true() && kind != parse.n_false() {
                return parse.fail(st, p + 1, parse.e_unknown_construct());
            }
            r = stage(tmp, st, root);
            if r < 0 {
                return parse.fail(st, p, 0 - r);
            }
            flags = flags + 8;
            p = q;
        } else {
            if bit == 32 {
                engine_form(st, parse.e_unsupported_statement());
            }
            flags = flags + bit;
        }
    }
    if flags / 8 % 2 == 0 && flags / 64 % 2 == 1 {
        // a check and no default: nothing came after it
        flags = flags - 64;
    }
    // the flags a statement of the proxy's grammar has are below 8; the engine's forms (docs/m3-engine.md 6x) are above: 16 a check, 32 an identity, 64 the check is staged before the default
    let id = parse.mk(nodes, kids, st, parse.n_coldef(), col, tmp[mark..st[10]], st[10] - mark, flags % 8 + flags / 16 * 16, 0 - 1);
    st[10] = mark;
    if id < 0 {
        return parse.fail(st, pos, 0 - id);
    }
    r = stage(tmp, st, id);
    if r < 0 {
        return parse.fail(st, pos, 0 - r);
    }
    return p;
}

// The statement uses a form that only the engine takes (docs/m3-engine.md 6x): `st[12]` is the refusal the guard gives for it, the first such form's (what the parser said of it before it read it,
// where that was more than `syntax`).
fn engine_form[&x](st: &!x [int], code: int) -> [] int {
    if st[12] == 0 {
        st[12] = code;
    }
    return 0;
}

// `IF NOT EXISTS` at `pos`: 1 (and the statement is marked as one of the engine's forms), or 0.
fn if_not_exists[&s, &t, &x](sql: &s [byte], toks: &t [int], pos: int, end: int, st: &!x [int]) -> [] int {
    if parse.kw(sql, toks, pos, end, "if") && parse.kw(sql, toks, pos + 1, end, "not") && parse.kw(sql, toks, pos + 2, end, "exists") {
        engine_form(st, parse.e_unsupported_statement());
        return 1;
    }
    return 0;
}

// `name, ...)` from `pos`, each staged as a NAME: the position after the `)`.
fn name_list[&s, &t, &n, &k, &g, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    var pos = from;
    var more = true;
    while more {
        pos = name_item(sql, toks, pos, end, nodes, kids, tmp, st);
        if pos < 0 {
            return pos;
        }
        if parse.punct(sql, toks, pos, end, ',') {
            pos = pos + 1;
        } else {
            more = false;
        }
    }
    if !parse.punct(sql, toks, pos, end, ')') {
        return parse.fail(st, pos, parse.e_syntax());
    }
    return pos + 1;
}

// CREATE TABLE [IF NOT EXISTS] t (column definition | PRIMARY KEY (column, ...), ...): `ex` of the root is 1 for IF NOT EXISTS
fn create_table[&s, &t, &n, &k, &v, &o, &g, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    st[10] = 0;
    let ine = if_not_exists(sql, toks, from + 2, end, st);
    var pos = plain_name(sql, toks, from + 2 + 3 * ine, end, st);
    if pos < 0 {
        return pos;
    }
    let table = st[9];
    if !parse.punct(sql, toks, pos, end, '(') {
        return parse.fail(st, pos, parse.e_syntax());
    }
    pos = pos + 1;
    var more = true;
    var keyed = false;
    while more {
        if parse.kw(sql, toks, pos, end, "primary") && parse.kw(sql, toks, pos + 1, end, "key") && parse.punct(sql, toks, pos + 2, end, '(') {
            // PRIMARY KEY (column, ...): a COLS among the column definitions, once
            if keyed {
                return parse.fail(st, pos, parse.e_syntax());
            }
            keyed = true;
            engine_form(st, parse.e_unsupported_statement());
            let mark = st[10];
            pos = name_list(sql, toks, pos + 3, end, nodes, kids, tmp, st);
            if pos < 0 {
                return pos;
            }
            let id = close_list(nodes, kids, tmp, st, parse.n_cols(), mark, 0 - 1);
            if id < 0 {
                return parse.fail(st, pos, 0 - id);
            }
            let r = stage(tmp, st, id);
            if r < 0 {
                return parse.fail(st, pos, 0 - r);
            }
        } else {
            pos = coldef(sql, toks, pos, end, nodes, kids, vs, os, tmp, st);
        }
        if pos < 0 {
            return pos;
        }
        if parse.punct(sql, toks, pos, end, ',') {
            pos = pos + 1;
        } else {
            more = false;
        }
    }
    if !parse.punct(sql, toks, pos, end, ')') {
        return parse.fail(st, pos, parse.e_syntax());
    }
    pos = pos + 1;
    if pos < end {
        return parse.fail(st, pos, parse.e_syntax());
    }
    let root = close_list(nodes, kids, tmp, st, parse.n_create_table(), 0, table);
    if root < 0 {
        return parse.fail(st, pos, 0 - root);
    }
    nodes[6 * root + 4] = ine;
    st[2] = root;
    return end;
}

// ALTER TABLE t ADD [COLUMN] [IF NOT EXISTS] column definition; ALTER TABLE t ALTER [COLUMN] c [SET DATA] TYPE type. `ex` of the root: 1 for IF NOT EXISTS, 2 for the change of type
fn alter_table[&s, &t, &n, &k, &v, &o, &g, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    st[10] = 0;
    var pos = plain_name(sql, toks, from + 2, end, st);
    if pos < 0 {
        return pos;
    }
    let table = st[9];
    var how = 0;
    if parse.kw(sql, toks, pos, end, "alter") {
        // ALTER [COLUMN] c [SET DATA] TYPE type: a column definition of the name and the type
        how = 2;
        engine_form(st, parse.e_unsupported_statement());
        pos = pos + 1;
        if parse.kw(sql, toks, pos, end, "column") {
            pos = pos + 1;
        }
        let at = pos;
        pos = plain_name(sql, toks, pos, end, st);
        if pos < 0 {
            return pos;
        }
        let col = st[9];
        if parse.kw(sql, toks, pos, end, "set") && parse.kw(sql, toks, pos + 1, end, "data") {
            pos = pos + 2;
        }
        if !parse.kw(sql, toks, pos, end, "type") {
            return parse.fail(st, pos, parse.e_unsupported_statement());
        }
        pos = parse.parse_type(sql, toks, pos + 1, end, st);
        if pos < 0 {
            return pos;
        }
        let ty = parse.mk(nodes, kids, st, parse.n_type(), st[6], tmp, 0, st[7], st[8]);
        if ty < 0 {
            return parse.fail(st, at, 0 - ty);
        }
        var r = stage(tmp, st, ty);
        if r < 0 {
            return parse.fail(st, at, 0 - r);
        }
        let id = parse.mk(nodes, kids, st, parse.n_coldef(), col, tmp[0..st[10]], st[10], 0, 0 - 1);
        st[10] = 0;
        if id < 0 {
            return parse.fail(st, at, 0 - id);
        }
        r = stage(tmp, st, id);
        if r < 0 {
            return parse.fail(st, at, 0 - r);
        }
    } else {
        if !parse.kw(sql, toks, pos, end, "add") {
            return parse.fail(st, pos, parse.e_unsupported_statement());
        }
        pos = pos + 1;
        if parse.kw(sql, toks, pos, end, "column") {
            pos = pos + 1;
        }
        how = if_not_exists(sql, toks, pos, end, st);
        pos = coldef(sql, toks, pos + 3 * how, end, nodes, kids, vs, os, tmp, st);
        if pos < 0 {
            return pos;
        }
    }
    if pos < end {
        return parse.fail(st, pos, parse.e_syntax());
    }
    let root = close_list(nodes, kids, tmp, st, parse.n_alter_add(), 0, table);
    if root < 0 {
        return parse.fail(st, pos, 0 - root);
    }
    nodes[6 * root + 4] = how;
    st[2] = root;
    return end;
}

// CREATE [UNIQUE] INDEX [IF NOT EXISTS] name ON t (column, ...) [WHERE expression]. `ex` of the root: 1 unique, 2 IF NOT EXISTS, 4 a condition (the last child)
fn create_index[&s, &t, &n, &k, &v, &o, &g, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    st[10] = 0;
    var pos = from + 1;
    var unique = 0;
    if parse.kw(sql, toks, pos, end, "unique") {
        unique = 1;
        pos = pos + 1;
    }
    let ine = if_not_exists(sql, toks, pos + 1, end, st);
    pos = plain_name(sql, toks, pos + 1 + 3 * ine, end, st);
    if pos < 0 {
        return pos;
    }
    let name = st[9];
    if !parse.kw(sql, toks, pos, end, "on") {
        return parse.fail(st, pos, parse.e_syntax());
    }
    pos = plain_name(sql, toks, pos + 1, end, st);
    if pos < 0 {
        return pos;
    }
    let table = st[9];
    if !parse.punct(sql, toks, pos, end, '(') {
        return parse.fail(st, pos, parse.e_syntax());
    }
    pos = name_list(sql, toks, pos + 1, end, nodes, kids, tmp, st);
    if pos < 0 {
        return pos;
    }
    var cond = 0;
    if parse.kw(sql, toks, pos, end, "where") {
        // the condition of a partial index: staged after the columns
        cond = 1;
        engine_form(st, parse.e_unsupported_statement());
        let at = pos;
        pos = parse.expr(sql, toks, pos + 1, end, nodes, kids, vs, os, st);
        if pos < 0 {
            return pos;
        }
        let r = stage(tmp, st, st[2]);
        if r < 0 {
            return parse.fail(st, at, 0 - r);
        }
    }
    if pos < end {
        return parse.fail(st, pos, parse.e_syntax());
    }
    let root = parse.mk(nodes, kids, st, parse.n_create_index(), name, tmp[0..st[10]], st[10], unique + 2 * ine + 4 * cond, table);
    if root < 0 {
        return parse.fail(st, pos, 0 - root);
    }
    st[2] = root;
    return end;
}

// CREATE SEQUENCE [IF NOT EXISTS] name [MINVALUE n] [START [WITH] n]: no other option, and no negative number (docs/m3-engine.md 6ad). One of the engine's forms.
// `truncate [table] NAME`: one table, and none of the options (several tables, `restart identity`, `cascade`).
fn truncate_table[&s, &t, &n, &k, &g, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    st[10] = 0;
    engine_form(st, parse.e_unsupported_statement());
    var at = from + 1;
    if parse.kw(sql, toks, at, end, "table") {
        at = at + 1;
    }
    let pos = plain_name(sql, toks, at, end, st);
    if pos < 0 {
        return pos;
    }
    if pos < end {
        return parse.fail(st, pos, parse.e_unsupported_statement());
    }
    let root = parse.mk(nodes, kids, st, parse.n_truncate(), st[9], tmp, 0, 0 - 1, 0 - 1);
    if root < 0 {
        return parse.fail(st, from, 0 - root);
    }
    st[2] = root;
    return end;
}

fn create_sequence[&s, &t, &n, &k, &g, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    st[10] = 0;
    engine_form(st, parse.e_unsupported_statement());
    let ine = if_not_exists(sql, toks, from + 2, end, st);
    var pos = plain_name(sql, toks, from + 2 + 3 * ine, end, st);
    if pos < 0 {
        return pos;
    }
    let name = st[9];
    var low = 0 - 1;
    var start = 0 - 1;
    var more = true;
    while more {
        if parse.kw(sql, toks, pos, end, "minvalue") && low < 0 && pos + 1 < end && parse.tkind(toks, pos + 1) == lex.t_number() {
            low = pos + 1;
            pos = pos + 2;
        } else if parse.kw(sql, toks, pos, end, "start") && start < 0 {
            pos = pos + 1;
            if parse.kw(sql, toks, pos, end, "with") {
                pos = pos + 1;
            }
            if pos >= end || parse.tkind(toks, pos) != lex.t_number() {
                return parse.fail(st, pos, parse.e_syntax());
            }
            start = pos;
            pos = pos + 1;
        } else {
            more = false;
        }
    }
    if pos < end {
        return parse.fail(st, pos, parse.e_unsupported_statement());
    }
    if ine == 1 {
        let id = parse.mk(nodes, kids, st, parse.n_name(), name, tmp, 0, 0 - 1, 0 - 1);
        if id < 0 {
            return parse.fail(st, from, 0 - id);
        }
        let r = stage(tmp, st, id);
        if r < 0 {
            return parse.fail(st, from, 0 - r);
        }
    }
    let root = parse.mk(nodes, kids, st, parse.n_create_seq(), name, tmp[0..st[10]], st[10], low, start);
    st[10] = 0;
    if root < 0 {
        return parse.fail(st, from, 0 - root);
    }
    st[2] = root;
    return end;
}

// DROP TABLE t, DROP INDEX name
fn drop_object[&s, &t, &n, &k, &g, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    var kind = parse.n_drop_table();
    if parse.kw(sql, toks, from + 1, end, "index") {
        kind = parse.n_drop_index();
    }
    let pos = plain_name(sql, toks, from + 2, end, st);
    if pos < 0 {
        return pos;
    }
    if pos < end {
        return parse.fail(st, pos, parse.e_syntax());
    }
    let root = parse.mk(nodes, kids, st, kind, st[9], tmp, 0, 0 - 1, 0 - 1);
    if root < 0 {
        return parse.fail(st, pos, 0 - root);
    }
    st[2] = root;
    return end;
}

// ---- transaction control

// BEGIN [WORK | TRANSACTION], START TRANSACTION, COMMIT [WORK | TRANSACTION], END [...], ROLLBACK [...], ABORT [...]: with no
// options (no isolation level, `READ ONLY`, `AND CHAIN`, `TO SAVEPOINT`, `PREPARED`: each is refused). The tree is one leaf; the
// proxy, not PostgreSQL, answers the client for it, so the statement has no effects and no IR.
fn txn_control[&s, &t, &n, &k, &g, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], tmp: &!g [int], st: &!x [int]) -> [] int {
    var kind = parse.n_begin();
    var pos = from + 1;
    if parse.kw(sql, toks, from, end, "commit") || parse.kw(sql, toks, from, end, "end") {
        kind = parse.n_commit();
    } else if parse.kw(sql, toks, from, end, "rollback") || parse.kw(sql, toks, from, end, "abort") {
        kind = parse.n_rollback();
    } else if parse.kw(sql, toks, from, end, "start") {
        // START TRANSACTION is the long spelling of BEGIN, and TRANSACTION is not optional there
        if !parse.kw(sql, toks, pos, end, "transaction") {
            return parse.fail(st, pos, parse.e_unsupported_statement());
        }
        pos = pos + 1;
    } else if parse.kw(sql, toks, pos, end, "work") || parse.kw(sql, toks, pos, end, "transaction") {
        pos = pos + 1;
    }
    if kind != parse.n_begin() && (parse.kw(sql, toks, pos, end, "work") || parse.kw(sql, toks, pos, end, "transaction")) {
        pos = pos + 1;
    }
    if pos < end {
        return parse.fail(st, pos, parse.e_unknown_construct());
    }
    let root = parse.mk(nodes, kids, st, kind, 0 - 1, tmp, 0, 0 - 1, 0 - 1);
    if root < 0 {
        return parse.fail(st, from, 0 - root);
    }
    st[2] = root;
    return end;
}

// One statement: the first word says which. Anything else is `unsupported-statement`. `st` is at least 14 ints.
pub fn statement[&s, &t, &n, &k, &v, &o, &g, &c, &x](sql: &s [byte], toks: &t [int], from: int, end: int, nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], tmp: &!g [int], clauses: &!c [int], st: &!x [int]) -> [] int {
    // `st[12]` is set by a form that only the engine takes (`engine_form`): the guard refuses a statement that has one
    st[12] = 0;
    if parse.kw(sql, toks, from, end, "select") {
        return select(sql, toks, from, end, nodes, kids, vs, os, tmp, clauses, st);
    }
    if parse.kw(sql, toks, from, end, "insert") {
        return insert(sql, toks, from, end, nodes, kids, vs, os, tmp, clauses, st);
    }
    if parse.kw(sql, toks, from, end, "update") {
        return update(sql, toks, from, end, nodes, kids, vs, os, tmp, clauses, st);
    }
    if parse.kw(sql, toks, from, end, "delete") {
        return delete(sql, toks, from, end, nodes, kids, vs, os, tmp, clauses, st);
    }
    if parse.kw(sql, toks, from, end, "create") {
        if parse.kw(sql, toks, from + 1, end, "table") {
            return create_table(sql, toks, from, end, nodes, kids, vs, os, tmp, st);
        }
        if parse.kw(sql, toks, from + 1, end, "index") || parse.kw(sql, toks, from + 1, end, "unique") && parse.kw(sql, toks, from + 2, end, "index") {
            return create_index(sql, toks, from, end, nodes, kids, vs, os, tmp, st);
        }
        if parse.kw(sql, toks, from + 1, end, "sequence") {
            return create_sequence(sql, toks, from, end, nodes, kids, tmp, st);
        }
        return parse.fail(st, from + 1, parse.e_unsupported_statement());
    }
    if parse.kw(sql, toks, from, end, "begin") || parse.kw(sql, toks, from, end, "start") || parse.kw(sql, toks, from, end, "commit") || parse.kw(sql, toks, from, end, "end") || parse.kw(sql, toks, from, end, "rollback") || parse.kw(sql, toks, from, end, "abort") {
        return txn_control(sql, toks, from, end, nodes, kids, tmp, st);
    }
    if parse.kw(sql, toks, from, end, "alter") && parse.kw(sql, toks, from + 1, end, "table") {
        return alter_table(sql, toks, from, end, nodes, kids, vs, os, tmp, st);
    }
    if parse.kw(sql, toks, from, end, "drop") && (parse.kw(sql, toks, from + 1, end, "table") || parse.kw(sql, toks, from + 1, end, "index")) {
        return drop_object(sql, toks, from, end, nodes, kids, tmp, st);
    }
    if parse.kw(sql, toks, from, end, "truncate") {
        return truncate_table(sql, toks, from, end, nodes, kids, tmp, st);
    }
    return parse.fail(st, from, parse.e_unsupported_statement());
}
