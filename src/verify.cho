// verify -- the L1 verifier of docs/spec/commit.md, in cancho.
//
//     verify LOG [--expect <64 hex digits>]
//
// Writes one line, `ok commits=N branches=B` or `reject rule=TAG record=I`, and exits 0 (ok), 1 (reject) or 2 (usage,
// or a file it cannot read: no verdict). The second verifier, tools/verify.py, is written from the spec alone; the
// vectors in vectors/ hold them to the same answers.
//
// What this program can reach is what the spec needs and nothing more: `cancho authority` reports `args`, `heap`,
// `fs_read("")` and `file_read` (the log), `io_write` and `err_write`, and no network, no process, no signals and no
// foreign code (checked in tests/authority.sh).

import std.buffer;
import std.io;
import std.bytes;
import std.flags;
import std.map;
import std.crypto;
import std.ed25519;
import cdb.commit;
import cdb.l2;

// One named file, read whole through a handle (`examples/seek`'s `read_file`). `-1` on a failure.
fn read_file[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], text: buffer.Buffer) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    var out = text;
    var total = 0;
    var trouble = 0;

    match open_read(fs, path) {
        Opened::Failed(reason) => {
            trouble = reason;
            if trouble == 0 {
                trouble = 1;
            }
        }
        Opened::Ok(opened) => {
            var file = opened;
            var chunk = buffer.empty(heap, 65536);
            borrow mut file as &!handle in {
                var going = true;
                while going {
                    var got = 0;
                    borrow mut chunk as &!c in {
                        match file_read(handle, buffer.room(c)) {
                            Read::Got(n) => {
                                got = n;
                                buffer.filled(c, n);
                            }
                            Read::End => {
                                going = false;
                            }
                            Read::Failed(reason) => {
                                going = false;
                                trouble = reason;
                                if trouble == 0 {
                                    trouble = 1;
                                }
                            }
                        }
                    }
                    if got > 0 {
                        borrow chunk as &c in {
                            out = buffer.append(heap, out, buffer.bytes(c));
                        }
                        total = total + got;
                        borrow mut chunk as &!c in {
                            buffer.clear(c);
                        }
                    }
                }
            }
            file_close(file);
            buffer.drop(heap, chunk);
        }
    }

    if trouble != 0 {
        return (out, 0 - 1);
    }
    return (out, total);
}

// The value of a hex digit, or -1.
fn hex_digit(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10;
    }
    return 0 - 1;
}

// 64 hex digits into `out[0..32]`; `false` for anything else.
fn parse_hex32[&t, &o](text: &t [byte], out: &!o [byte]) -> [] bool {
    if len(text) != 64 {
        return false;
    }
    var i = 0;
    while i < 32 {
        let hi = hex_digit(int_of(text[2 * i]));
        let lo = hex_digit(int_of(text[2 * i + 1]));
        if hi < 0 || lo < 0 {
            return false;
        }
        out[i] = byte_of(hi * 16 + lo);
        i = i + 1;
    }
    return true;
}

fn same[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    return bytes.equal(x, y);
}

// The verdict for the bytes of a log (spec §4, §5). `verdict[0]` is a rule code (`commit.ok()` when it verifies),
// `verdict[1]` the record it names (-1 for none), `verdict[2]` the commits seen and `verdict[3]` the branches.
// `expect` is empty, or the 32 bytes of an id that must occur in the log.
//
// No early `return` in the loop: the maps are owned and are dropped once, at the end, on every path.
fn verify[&h, &d, &e, &o](heap: &!h Heap, data: &d [byte], expect: &e [byte], verdict: &!o [int]) -> [heap] int {
    var rule = 0;
    var bad_at = 0 - 1;
    var commits = 0;
    var seen = map.empty(heap, 64, 0, 7);
    var counts = map.empty(heap, 16, 0, 11);
    var tips = map.empty(heap, 16, 0, 13);
    // every id, in log order, 32 bytes each: a branch's tip is an index into this
    var ids = buffer.empty(heap, 4096);

    if len(data) < 8 {
        rule = commit.truncated();
    } else if !same(data[0..8], "CHODBLG1") {
        rule = commit.bad_magic();
    } else if len(data) < 40 {
        rule = commit.truncated();
    }

    region r {
        let out = alloc_slice[r](commit.out_len(), 0);
        let ident = alloc_slice[r](32, byte_of(0));
        let sha = alloc_slice[r](crypto.sha256_state_len(), 0);
        let nul = alloc_slice[r](1, byte_of(0));
        var at = 40;

        while rule == 0 && at < len(data) {
            let index = commits;
            if len(data) - at < 4 {
                rule = commit.truncated();
            } else {
                let length = commit.be(data, at, 4);
                if length > 16777216 {
                    rule = commit.record_too_large();
                } else if len(data) - at - 4 < length + 64 {
                    rule = commit.truncated();
                } else {
                    let enc = data[at + 4..at + 4 + length];
                    let sig = data[at + 4 + length..at + 4 + length + 64];
                    at = at + 4 + length + 64;

                    rule = commit.decode(enc, out);
                    if rule == 0 {
                        crypto.sha256_init(sha);
                        crypto.sha256_update(sha, "cancho-db/commit/v1");
                        crypto.sha256_update(sha, nul);
                        crypto.sha256_update(sha, enc);
                        crypto.sha256_final(sha, ident);

                        let branch = enc[out[commit.f_branch_at()]..out[commit.f_branch_at()] + out[commit.f_branch_len()]];
                        let np = out[commit.f_parents()];
                        let pat = out[commit.f_parents_at()];
                        var count_here = 0;
                        var tip_index = 0 - 1;
                        borrow counts as &m in {
                            count_here = map.get(m, branch, 0);
                        }
                        borrow tips as &m in {
                            tip_index = map.get(m, branch, 0 - 1);
                        }

                        var is_dup = false;
                        borrow seen as &m in {
                            is_dup = map.has(m, ident);
                        }
                        if is_dup {
                            rule = commit.duplicate_commit();
                        } else if crypto_ok(data[8..40], ident, sig) == 0 {
                            rule = commit.bad_signature();
                        } else if out[commit.f_seq_hi()] != 0 || out[commit.f_seq_lo()] != count_here {
                            rule = commit.seq_gap();
                        } else if count_here == 0 {
                            if np == 2 {
                                rule = commit.parent_count();
                            } else if np == 1 {
                                var known = false;
                                borrow seen as &m in {
                                    known = map.has(m, enc[pat..pat + 32]);
                                }
                                if !known {
                                    rule = commit.parent_unknown();
                                }
                            }
                        } else if np == 0 {
                            rule = commit.parent_count();
                        } else {
                            borrow ids as &b in {
                                if !same(enc[pat..pat + 32], buffer.bytes(b)[tip_index * 32..tip_index * 32 + 32]) {
                                    rule = commit.parent_mismatch();
                                }
                            }
                            if rule == 0 && np == 2 {
                                if same(enc[pat..pat + 32], enc[pat + 32..pat + 64]) {
                                    rule = commit.parent_count();
                                } else {
                                    var known = false;
                                    borrow seen as &m in {
                                        known = map.has(m, enc[pat + 32..pat + 64]);
                                    }
                                    if !known {
                                        rule = commit.parent_unknown();
                                    }
                                }
                            }
                        }

                        if rule == 0 {
                            seen = map.put(heap, seen, ident, commits);
                            counts = map.put(heap, counts, branch, count_here + 1);
                            tips = map.put(heap, tips, branch, commits);
                            ids = buffer.append(heap, ids, ident);
                            commits = commits + 1;
                        }
                    }
                }
            }
            if rule != 0 {
                bad_at = index;
            }
        }

        if rule == 0 && len(expect) == 32 {
            var found = false;
            borrow seen as &m in {
                found = map.has(m, expect);
            }
            if !found {
                rule = commit.expected_missing();
            }
        }
    }

    verdict[0] = rule;
    verdict[1] = bad_at;
    verdict[2] = commits;
    borrow counts as &m in {
        verdict[3] = map.size(m);
    }
    map.drop(heap, seen);
    map.drop(heap, counts);
    map.drop(heap, tips);
    buffer.drop(heap, ids);
    return 0;
}

// `1` if `sig` is a valid Ed25519 signature by `pk` over the 32 id bytes.
fn crypto_ok[&k, &m, &s](pk: &k [byte], id: &m [byte], sig: &s [byte]) -> [] int {
    return ed25519.verify(pk, id, sig);
}

// One named file into a buffer, or a message on standard error and `false`. The buffer comes back either way.
fn load[&h, &f, &i, &p](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, path: &p [byte], text: buffer.Buffer) -> [heap, fs_read(""), file_read, err_write] (buffer.Buffer, bool) {
    let (grown, got) = read_file(heap, fs, path, text);
    if got < 0 {
        io.error_all(io, "verify: cannot read: ");
        io.error_all(io, path);
        io.error_all(io, "\n");
        return (grown, false);
    }
    return (grown, true);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(ffi);

    var path: &static [byte] = "";
    var have_path = false;
    var expect_text: &static [byte] = "";
    var have_expect = false;
    var root_text: &static [byte] = "";
    var have_root = false;
    var tokens_path: &static [byte] = "";
    var have_tokens = false;
    var revoked_path: &static [byte] = "";
    var have_revoked = false;
    var stmts_path: &static [byte] = "";
    var have_stmts = false;
    var usage = false;
    var status = 0;

    borrow mut heap as &!h in {
        borrow args as &g in {
            var c = flags.start();
            var going = true;
            while going {
                let (next, step) = flags.step(g, c);
                c = next;
                match step {
                    flags.Arg::Short(letter) => {
                        usage = true;
                    }
                    flags.Arg::Long(name) => {
                        if flags.named(name, "expect") && !have_expect {
                            let (after, given) = flags.value(g, c);
                            c = after;
                            expect_text = given;
                            have_expect = true;
                        } else if flags.named(name, "root") && !have_root {
                            let (after, given) = flags.value(g, c);
                            c = after;
                            root_text = given;
                            have_root = true;
                        } else if flags.named(name, "tokens") && !have_tokens {
                            let (after, given) = flags.value(g, c);
                            c = after;
                            tokens_path = given;
                            have_tokens = true;
                        } else if flags.named(name, "stmts") && !have_stmts {
                            let (after, given) = flags.value(g, c);
                            c = after;
                            stmts_path = given;
                            have_stmts = true;
                        } else if flags.named(name, "revoked") && !have_revoked {
                            let (after, given) = flags.value(g, c);
                            c = after;
                            revoked_path = given;
                            have_revoked = true;
                        } else {
                            usage = true;
                        }
                    }
                    flags.Arg::Operand(text) => {
                        if have_path {
                            usage = true;
                        } else {
                            path = text;
                            have_path = true;
                        }
                    }
                    flags.Arg::Done => {
                        going = false;
                    }
                }
            }
        }

        if !have_path || !have_root && (have_tokens || have_revoked || have_stmts) || have_root && !have_tokens {
            usage = true;
        }

        // `--expect` and `--root` as 32 bytes each, or empty when absent
        var expect_bytes = buffer.empty(h, 32);
        var root_bytes = buffer.empty(h, 32);
        if !usage {
            region x {
                let tmp = alloc_slice[x](32, byte_of(0));
                if have_expect {
                    if parse_hex32(expect_text, tmp) {
                        expect_bytes = buffer.append(h, expect_bytes, tmp);
                    } else {
                        usage = true;
                    }
                }
                if have_root {
                    if parse_hex32(root_text, tmp) {
                        root_bytes = buffer.append(h, root_bytes, tmp);
                    } else {
                        usage = true;
                    }
                }
            }
        }

        if usage {
            status = 2;
            borrow mut io as &!e in {
                io.error_all(e, "usage: verify LOG [--expect <64 hex digits>] [--root <64 hex digits> --tokens FILE [--revoked FILE] [--stmts FILE]]\n");
            }
        } else {
            var text = buffer.empty(h, 65536);
            var tokens_text = buffer.empty(h, 16);
            var revoked_text = buffer.empty(h, 16);
            var stmts_text = buffer.empty(h, 16);
            var good = true;
            borrow fs as &f in {
                borrow mut io as &!e in {
                    let (a, ok_log) = load(h, f, e, path, text);
                    text = a;
                    good = ok_log;
                    if good && have_tokens {
                        let (b, ok_tokens) = load(h, f, e, tokens_path, tokens_text);
                        tokens_text = b;
                        good = ok_tokens;
                    }
                    if good && have_revoked {
                        let (b, ok_revoked) = load(h, f, e, revoked_path, revoked_text);
                        revoked_text = b;
                        good = ok_revoked;
                    }
                    if good && have_stmts {
                        let (b, ok_stmts) = load(h, f, e, stmts_path, stmts_text);
                        stmts_text = b;
                        good = ok_stmts;
                    }
                }
            }
            if !good {
                status = 2;
            } else {
                region x {
                    let verdict = alloc_slice[x](4, 0);
                    borrow text as &t in {
                        borrow expect_bytes as &eb in {
                            verify(h, buffer.bytes(t), buffer.bytes(eb), verdict);
                        }
                        if verdict[0] == 0 && have_root {
                            borrow root_bytes as &rb in {
                                borrow tokens_text as &tt in {
                                    borrow revoked_text as &rt in {
                                        borrow stmts_text as &st in {
                                            l2.run(h, buffer.bytes(t), buffer.bytes(rb), buffer.bytes(tt), buffer.bytes(rt), have_revoked, buffer.bytes(st), have_stmts, verdict);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    borrow mut io as &!o in {
                        if verdict[0] == 0 {
                            io.write_all(o, "ok commits=");
                            io.print_nat(o, verdict[2]);
                            io.write_all(o, " branches=");
                            io.print_nat(o, verdict[3]);
                            if have_stmts {
                                io.write_all(o, " level=2+ir");
                            } else if have_root {
                                io.write_all(o, " level=2");
                            }
                            io.newline(o);
                        } else {
                            status = 1;
                            io.write_all(o, "reject rule=");
                            io.write_all(o, commit.rule_name(verdict[0]));
                            io.write_all(o, " record=");
                            io.print_int(o, verdict[1]);
                            io.newline(o);
                        }
                    }
                }
            }
            buffer.drop(h, text);
            buffer.drop(h, tokens_text);
            buffer.drop(h, revoked_text);
            buffer.drop(h, stmts_text);
        }
        buffer.drop(h, expect_bytes);
        buffer.drop(h, root_bytes);
    }

    release(args);
    release(fs);
    release(io);
    release(heap);
    return status;
}
