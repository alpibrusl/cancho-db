edition 9;

import std.buffer;
import std.io;
import cdb.lex;
import cdb.parse;
import cdb.stmt;
import cdb.lower;
import cdb.commit;
import cdb.pager;
import cdb.btree;
import cdb.pstore;
import cdb.exec;
import cdb.execs;
import cdb.execw;
import cdb.answer;
import cdb.drive;
import cdb.facts;
import cdb.tables;
import cdb.build;
import cdb.row;

// `enginecheck PAGEFILE [CRASH TORN]`: the engine's statements (src/exec.cho, src/execw.cho) over a page file, for tests/engine_check.py. PAGEFILE is made if it is missing; the branch is slot 0 of its catalog. Standard
// input, a line each:
//
//     !commit        make the statements so far durable (src/pstore.cho)      -> `committed SEQ` or `err CODE`
//     !sweep         zero and reuse the pages nothing names                   -> `swept N` or `err CODE`
//     !steps         how many writes and syncs the page file has seen         -> `steps N`
//     !txn           the number of the branch's last transaction (6n)                 -> `txn N`
//     !asof N        statements read the branch as it was after transaction N (`-`: as it is)  -> `asof N`
//     !erase DELETE  the row that `delete from T where KEY = CONSTANT` names, and its history (6n)   -> `ok ERASE N`
//     !fork S        slot S becomes the same tree as the branch                -> `forked`
//     !branch S      statements go to slot S (the branch is slot 0 at start)   -> `branch`
//     !mark          nothing                                                  -> `mark` (a separator for a test that reads the output)
//     anything else  one SQL statement, which is run and, if it is done, becomes the state the next one sees
//                    (`begin`, `commit` and `rollback` are answered here: the statements between them build on the transaction's own tree)
//
// With CRASH and TORN the process stops being able to write at step CRASH (TORN bytes of that write happen): it prints `crashed` and ends with status 6, leaving the file as a kill there would.
//
// For a statement: `refused TAG` (the lexer, the parser, the lowering or the engine refuses it), `error SQLSTATE`, or `ok KIND N` (N rows) followed by, for a SELECT, a line `N` with the name of each column (hex), a line `T` with the type of each column
// and a line `R` for each row with each value (`-` null, a number, 0 or 1, or the bytes in hex, `.` if there are none); for a statement that writes, a line `C TABLE KEY BEFORE AFTER` for each change (hex,
// `-` for no image). After `ok`, a line `G` with the command's tag as a client is sent it. Then a line `S` with the transaction's state as PostgreSQL reports it (`I` none, `T` in one, `E` in one that has failed), and a line `.`. Types are PostgreSQL's identifiers and values its text (src/answer.cho).

fn digit(v: int) -> [] int {
    if v < 10 {
        return '0' + v;
    }
    return 'a' + v - 10;
}

fn put_str[&i, &s](io: &!i Io, text: &s [byte]) -> [io_write] int {
    var j = 0;
    while j < len(text) {
        putchar(io, int_of(text[j]));
        j = j + 1;
    }
    return 0;
}

fn put_int[&i](io: &!i Io, v: int) -> [io_write] int {
    if v < 0 {
        putchar(io, '-');
        var div = 1;
        while v / div <= 0 - 10 {
            div = div * 10;
        }
        while div > 0 {
            putchar(io, '0' - v / div % 10);
            div = div / 10;
        }
        return 0;
    }
    var div = 1;
    while v / div >= 10 {
        div = div * 10;
    }
    while div > 0 {
        putchar(io, '0' + v / div % 10);
        div = div / 10;
    }
    return 0;
}

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

fn hex_byte[&i](io: &!i Io, v: int) -> [io_write] int {
    putchar(io, digit(v / 16));
    putchar(io, digit(v % 16));
    return 0;
}

// The rows of a SELECT's answer.
fn put_rows[&i, &q](io: &!i Io, w: &!q exec.Work) -> [io_write] int {
    let nc = exec.columns_of(w);
    putchar(io, 'T');
    var c = 0;
    while c < nc {
        putchar(io, ' ');
        put_int(io, answer.oid(exec.type_of(w, c)));
        c = c + 1;
    }
    putchar(io, '\n');
    region r {
        let buf = alloc_slice[r](4096, byte_of(0));
        var k = 0;
        while k < exec.count_of(w) {
            var at = exec.row_at(w, k);
            putchar(io, 'R');
            c = 0;
            while c < nc {
                putchar(io, ' ');
                // the value as a client is sent it (src/answer.cho); one longer than this buffer is not printed whole here
                let n = answer.text(exec.rows_of(w), at, buf, 0);
                if n == 0 - 1 {
                    putchar(io, '-');
                } else if n == 0 {
                    putchar(io, '.');
                } else if n < 0 {
                    putchar(io, '?');
                } else {
                    var j = 0;
                    while j < n {
                        hex_byte(io, int_of(buf[j]));
                        j = j + 1;
                    }
                }
                at = answer.skip(exec.rows_of(w), at);
                c = c + 1;
            }
            putchar(io, '\n');
            k = k + 1;
        }
    }
    return 0;
}

fn change_run[&i, &q](io: &!i Io, w: &!q exec.Work, at: int, size: int) -> [io_write] int {
    var n = 0;
    var k = 0;
    while k < size {
        n = n * 256 + exec.change_byte(w, at + k);
        k = k + 1;
    }
    putchar(io, ' ');
    if size == 4 && n == 4294967295 {
        putchar(io, '-');
        return at + 4;
    }
    k = 0;
    while k < n {
        hex_byte(io, exec.change_byte(w, at + size + k));
        k = k + 1;
    }
    if n == 0 {
        putchar(io, '.');
    }
    return at + size + n;
}

fn put_changes[&i, &q](io: &!i Io, w: &!q exec.Work) -> [io_write] int {
    var at = 0;
    var c = 0;
    while c < exec.changes_of(w) {
        putchar(io, 'C');
        at = change_run(io, w, at, 2);
        at = change_run(io, w, at, 2);
        at = change_run(io, w, at, 4);
        at = change_run(io, w, at, 4);
        // the salts (docs/m3-engine.md 6ag): the key's, the old row's, the new row's
        putchar(io, ' ');
        var k = 0;
        while k < 16 {
            hex_byte(io, exec.change_byte(w, at + k));
            k = k + 1;
        }
        at = at + 16;
        var side = 0;
        while side < 2 {
            putchar(io, ' ');
            if exec.change_byte(w, at) == 1 {
                k = 0;
                while k < 16 {
                    hex_byte(io, exec.change_byte(w, at + 1 + k));
                    k = k + 1;
                }
            } else {
                putchar(io, '-');
            }
            at = at + 17;
            side = side + 1;
        }
        putchar(io, '\n');
        c = c + 1;
    }
    return 0;
}

// Run one statement over the tree `root`: the tree after it (`root` itself unless the statement is done).
fn run_sql[&h, &i, &z, &q, &s, &f](heap: &!h Heap, io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, sql: &s [byte], root: int, mode: int, flag: &!f [int], part: bool) -> [heap, io_write, file_read, file_write] int {
    let cap = len(sql) + 4;
    var tb = box_slice(heap, 4 * cap, 0);
    var nb = box_slice(heap, 6 * (cap + 64), 0);
    var kb = box_slice(heap, cap + 64, 0);
    var vb = box_slice(heap, 64, 0);
    var ob = box_slice(heap, 4 * 64, 0);
    var rb = box_slice(heap, 2 * 256, 0);
    var st = box_slice(heap, 16, 0);
    var gb = box_slice(heap, cap, 0);
    var cb = box_slice(heap, 16, 0);
    var schema = box_slice(heap, 65536, byte_of(0));
    var ir = box_slice(heap, 65536, byte_of(0));
    var sc = box_slice(heap, 1024, 0);
    var out = root;
    borrow mut tb as &!tw in {
        borrow mut nb as &!nw in {
            borrow mut kb as &!kw in {
                borrow mut vb as &!vw in {
                    borrow mut ob as &!ow in {
                        borrow mut rb as &!rw in {
                            borrow mut st as &!sw in {
                                borrow mut gb as &!gw in {
                                    borrow mut cb as &!cw in {
                                        borrow mut schema as &!mw in {
                                            borrow mut ir as &!iw in {
                                                borrow mut sc as &!xw in {
                                                    var rc = 0;
                                                    var kind = 0 - 1;
                                                    var named = false;
                                                    var ctl = 0;
                                                    var returned = 0 - 1;
                                                    exec.set_guard(w, 0);
                                                    let sl = exec.schema(pg, w, root, contents(mw));
                                                    let n = lex.tokenize(sql, contents(tw));
                                                    if sl < 0 {
                                                        rc = sl;
                                                    } else if n < 0 {
                                                        put_str(io, "refused ");
                                                        put_str(io, lex.error_name(0 - n));
                                                        named = true;
                                                    } else if !exec.params_fit(w, sql, contents(tw), n, part) {
                                                        rc = exec.unsupported();
                                                    } else {
                                                        parse.reset(contents(sw));
                                                        let q0 = stmt.statement(sql, contents(tw), 0, n, contents(nw), contents(kw), contents(vw), contents(ow), contents(gw), contents(cw), contents(sw));
                                                        if q0 < 0 {
                                                            put_str(io, "refused ");
                                                            put_str(io, parse.error_name(0 - q0));
                                                            named = true;
                                                        } else if contents(nw)[6 * contents(sw)[2]] == parse.n_begin() || contents(nw)[6 * contents(sw)[2]] == parse.n_commit() || contents(nw)[6 * contents(sw)[2]] == parse.n_rollback() {
                                                            // the transaction's own statements are the caller's to answer
                                                            ctl = 20;
                                                            if contents(nw)[6 * contents(sw)[2]] == parse.n_commit() {
                                                                ctl = 21;
                                                            } else if contents(nw)[6 * contents(sw)[2]] == parse.n_rollback() {
                                                                ctl = 22;
                                                            }
                                                            named = true;
                                                        } else if mode == 3 {
                                                            // the transaction has failed: nothing runs until it is ended
                                                            rc = exec.e_aborted();
                                                        } else if contents(nw)[6 * contents(sw)[2]] == parse.n_create_seq() {
                                                            // CREATE SEQUENCE has no IR: it is the engine's alone
                                                            if mode != 0 || exec.params_bound(w) > 0 {
                                                                rc = exec.unsupported();
                                                            } else {
                                                                rc = execw.create_sequence(pg, w, root, sql, contents(tw), contents(nw), contents(sw)[2]);
                                                            }
                                                            kind = 13;
                                                        } else {
                                                            let top = contents(sw)[2];
                                                            let ln = lower.lower(sql, contents(tw), contents(nw), contents(kw), top, contents(mw)[0..sl], contents(rw), contents(iw), contents(xw));
                                                            if ln < 0 {
                                                                put_str(io, "refused ");
                                                                put_str(io, lower.error_name(0 - ln));
                                                                named = true;
                                                            } else {
                                                                let e = contents(iw)[0..ln];
                                                                kind = int_of(e[0]);
                                                                if exec.params_bound(w) > 0 && kind != 6 && kind != 1 && kind != 2 && kind != 3 {
                                                                    // PostgreSQL takes no parameters in a statement that is not a query
                                                                    rc = exec.unsupported();
                                                                } else if mode == 1 && kind != 6 {
                                                                    // the tree read AS OF a transaction is not one to write to
                                                                    put_str(io, "refused engine-as-of-write");
                                                                    named = true;
                                                                } else if mode == 2 {
                                                                    rc = execw.erase(pg, w, root, e, contents(xw));
                                                                    kind = 9;
                                                                } else if kind == 6 {
                                                                    rc = execs.select(pg, w, root, e, contents(xw));
                                                                } else if kind == 1 && contents(nw)[6 * top + 1] > 0 && execw.guard_lower(w, sql, contents(tw), contents(nw), contents(kw), contents(nw)[6 * top + 1] - 1, contents(mw)[0..sl]) < 0 {
                                                                    // the condition of an `insert ... select ... where` does not lower
                                                                    rc = exec.unsupported();
                                                                } else if (kind == 1 || kind == 2 || kind == 3) && contents(nw)[6 * top + 5] >= 0 {
                                                                    // RETURNING (docs/m3-engine.md 6aa): the items are a SELECT over the table, read before the statement over no rows (what is
                                                                    // wrong with them is known before anything is written) and after it over the rows it wrote
                                                                    let rn = contents(nw)[6 * top + 5];
                                                                    region rr {
                                                                        let ir2 = alloc_slice[rr](32768, byte_of(0));
                                                                        let sc2 = alloc_slice[rr](1024, 0);
                                                                        let l2 = lower.lower(sql, contents(tw), contents(nw), contents(kw), rn, contents(mw)[0..sl], contents(rw), ir2, sc2);
                                                                        if l2 < 0 {
                                                                            put_str(io, "refused ");
                                                                            put_str(io, lower.error_name(0 - l2));
                                                                            named = true;
                                                                        } else {
                                                                            exec.ret_set(w, 3);
                                                                            rc = execs.select(pg, w, root, ir2[0..l2], sc2);
                                                                            if rc == 0 {
                                                                                exec.ret_set(w, 1);
                                                                                if kind == 1 {
                                                                                    rc = execw.insert(pg, w, root, e, contents(xw), contents(nw)[6 * top + 4] == 1);
                                                                                } else if kind == 2 {
                                                                                    rc = execw.update(pg, w, root, e, contents(xw));
                                                                                } else {
                                                                                    rc = execw.delete(pg, w, root, e, contents(xw));
                                                                                }
                                                                                if rc == 0 {
                                                                                    let r1 = exec.root_of(w);
                                                                                    exec.ret_set(w, 2);
                                                                                    rc = execs.select(pg, w, r1, ir2[0..l2], sc2);
                                                                                    returned = rn;
                                                                                }
                                                                            }
                                                                            exec.ret_set(w, 0);
                                                                        }
                                                                    }
                                                                } else if kind == 1 {
                                                                    rc = execw.insert(pg, w, root, e, contents(xw), contents(nw)[6 * top + 4] == 1);
                                                                } else if kind == 2 {
                                                                    rc = execw.update(pg, w, root, e, contents(xw));
                                                                } else if kind == 3 {
                                                                    rc = execw.delete(pg, w, root, e, contents(xw));
                                                                } else if kind == 4 && ln > 1 && int_of(e[1]) == 0 {
                                                                    rc = execw.create_table(pg, w, root, e, sql, contents(tw), contents(nw), contents(kw), top);
                                                                    kind = 7;
                                                                } else if kind == 4 && ln > 1 && int_of(e[1]) == 2 {
                                                                    rc = execw.drop_table(pg, w, root, e);
                                                                    kind = 8;
                                                                } else if kind == 4 && ln > 1 && int_of(e[1]) == 1 {
                                                                    rc = execw.alter_add(pg, w, root, e, sql, contents(tw), contents(nw), contents(kw), top);
                                                                    kind = 10;
                                                                } else if kind == 4 && ln > 1 && int_of(e[1]) == 3 {
                                                                    rc = execw.create_index(pg, w, root, e, sql, contents(tw), contents(nw), contents(kw), top);
                                                                    kind = 11;
                                                                } else if kind == 4 && ln > 1 && int_of(e[1]) == 4 {
                                                                    rc = execw.drop_index(pg, w, root, e, sql, contents(tw), contents(nw), top);
                                                                    kind = 12;
                                                                } else {
                                                                    rc = exec.unsupported();
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if !named {
                                                        if rc < 0 {
                                                            put_str(io, "refused ");
                                                            put_str(io, exec.refusal_name(rc));
                                                        } else if rc > 0 {
                                                            put_str(io, "error ");
                                                            put_str(io, exec.sqlstate(rc));
                                                        } else {
                                                            put_str(io, "ok ");
                                                            if kind == 6 {
                                                                put_str(io, "SELECT ");
                                                            } else if kind == 1 {
                                                                put_str(io, "INSERT ");
                                                            } else if kind == 2 {
                                                                put_str(io, "UPDATE ");
                                                            } else if kind == 3 {
                                                                put_str(io, "DELETE ");
                                                            } else if kind == 9 {
                                                                put_str(io, "ERASE ");
                                                            } else if kind == 10 {
                                                                put_str(io, "ALTER ");
                                                            } else if kind == 11 {
                                                                put_str(io, "INDEX ");
                                                            } else if kind == 12 {
                                                                put_str(io, "DROPINDEX ");
                                                            } else if kind == 7 || kind == 13 {
                                                                put_str(io, "CREATE ");
                                                            } else {
                                                                put_str(io, "DROP ");
                                                            }
                                                            put_int(io, exec.count_of(w));
                                                            putchar(io, '\n');
                                                            if kind != 9 {
                                                                // the command's tag, as a client is sent it
                                                                putchar(io, 'G');
                                                                putchar(io, ' ');
                                                                region tr {
                                                                    let tb2 = alloc_slice[tr](64, byte_of(0));
                                                                    let tn = answer.tag(kind, exec.count_of(w), tb2);
                                                                    put_str(io, tb2[0..tn]);
                                                                }
                                                                putchar(io, '\n');
                                                            }
                                                            if kind == 6 || returned >= 0 {
                                                                // the names of the columns, as a client is sent them: what the lowering knows and the IR does not carry
                                                                var top2 = contents(sw)[2];
                                                                if returned >= 0 {
                                                                    top2 = returned;
                                                                }
                                                                let nn = lower.output_names(sql, contents(tw), contents(nw), contents(kw), top2, contents(mw)[0..sl], contents(xw), contents(iw));
                                                                putchar(io, 'N');
                                                                var na = 0;
                                                                while na + 2 <= nn {
                                                                    let l = int_of(contents(iw)[na]) * 256 + int_of(contents(iw)[na + 1]);
                                                                    putchar(io, ' ');
                                                                    var j = 0;
                                                                    while j < l {
                                                                        hex_byte(io, int_of(contents(iw)[na + 2 + j]));
                                                                        j = j + 1;
                                                                    }
                                                                    if l == 0 {
                                                                        putchar(io, '.');
                                                                    }
                                                                    na = na + 2 + l;
                                                                }
                                                                putchar(io, '\n');
                                                                put_rows(io, w);
                                                            }
                                                            if kind != 6 && kind < 9 || kind == answer.k_drop_table() || kind == answer.k_alter_table() {
                                                                put_changes(io, w);
                                                            }
                                                            out = exec.root_of(w);
                                                        }
                                                    }
                                                    flag[0] = 0;
                                                    if ctl != 0 {
                                                        out = 0 - ctl;
                                                    } else if named || rc != 0 {
                                                        putchar(io, '\n');
                                                        flag[0] = 1;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, tb);
    unbox_slice(heap, nb);
    unbox_slice(heap, kb);
    unbox_slice(heap, vb);
    unbox_slice(heap, ob);
    unbox_slice(heap, rb);
    unbox_slice(heap, st);
    unbox_slice(heap, gb);
    unbox_slice(heap, cb);
    unbox_slice(heap, schema);
    unbox_slice(heap, ir);
    unbox_slice(heap, sc);
    return out;
}

fn starts[&a](all: &a [byte], ls: int, le: int, word: &static [byte]) -> [] bool {
    if le - ls != len(word) {
        return false;
    }
    var i = 0;
    while i < len(word) {
        if int_of(all[ls + i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn unhex(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return 0 - 1;
}

// One value of a `!params` line, as the next parameter: false if it is not hex, or there is no room.
fn set_param[&q, &t](w: &!q exec.Work, tok: &t [byte]) -> [] bool {
    if len(tok) == 1 && int_of(tok[0]) == '-' {
        return exec.param_add(w, tok[0..0], true);
    }
    if len(tok) == 1 && int_of(tok[0]) == '.' {
        return exec.param_add(w, tok[0..0], false);
    }
    if len(tok) < 2 || len(tok) % 2 != 0 {
        return false;
    }
    var ok = true;
    region r {
        let b = alloc_slice[r](len(tok) / 2, byte_of(0));
        var i = 0;
        while i < len(b) {
            let hi = unhex(int_of(tok[2 * i]));
            let lo = unhex(int_of(tok[2 * i + 1]));
            if hi < 0 || lo < 0 {
                ok = false;
            } else {
                b[i] = byte_of(hi * 16 + lo);
            }
            i = i + 1;
        }
        if ok {
            ok = exec.param_add(w, b, false);
        }
    }
    return ok;
}

// The facts of a commit, as a line: `F`, how many, and `changes` in hex (docs/m3-engine.md 6af); `F -` if they are not to be had (`froot` below 0).
fn put_facts[&i, &z, &q](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, froot: int) -> [io_write, file_read] int {
    var n = froot;
    region r {
        let h = alloc_slice[r](32, byte_of(0));
        if n >= 0 {
            n = facts.changes(pg, w, froot, h);
        }
        if n < 0 {
            put_str(io, "F -\n");
        } else {
            put_str(io, "F ");
            put_int(io, n);
            putchar(io, ' ');
            var k = 0;
            while k < 32 {
                hex_byte(io, int_of(h[k]));
                k = k + 1;
            }
            putchar(io, '\n');
        }
    }
    return 0;
}

// The commit the facts `froot` are, as a line: `L` and the record of the log in hex (docs/m3-engine.md 6ah), `L -` if it is not to be had; nothing while no key was given (`!log`) or
// off the first branch. The tree with the head of the log moved (`root` itself if no commit was made).
fn put_commit[&i, &z, &q, &f](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, root: int, froot: int, fl: &f [int], cur: int) -> [io_write, file_read, file_write] int {
    var nw = root;
    if fl[1] == 0 || cur != 0 {
        return nw;
    }
    region r {
        let seed = alloc_slice[r](32, byte_of(0));
        let rec = alloc_slice[r](facts.max_record(), byte_of(0));
        var k = 0;
        while k < 32 {
            seed[k] = byte_of(fl[2 + k]);
            k = k + 1;
        }
        var sealed = froot;
        if sealed >= 0 {
            sealed = facts.seal(pg, w, root, froot, seed, rec);
        }
        if sealed < 0 {
            put_str(io, "L -\n");
        } else {
            nw = sealed;
            put_str(io, "L ");
            let n = 4 + commit.be(rec, 0, 4) + 64;
            k = 0;
            while k < n {
                hex_byte(io, int_of(rec[k]));
                k = k + 1;
            }
            putchar(io, '\n');
        }
    }
    return nw;
}

// Every row of the table `name` as a line: `D`, then in hex the plain key, the key's salt, the row's image and the row's salt, as the facts have them (what a live dump holds,
// docs/spec/l3a.md 3b); `rows N` at the end, `rows -` if there is no such table or a row cannot be shown.
fn put_table[&i, &z, &q, &n](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, root: int, name: &n [byte]) -> [io_write, file_read] int {
    let el = tables.find(pg, contents(w.sc), root, name, contents(w.key), contents(w.nrow));
    if el < 0 {
        put_str(io, "rows -\n");
        return 0;
    }
    let id = tables.id_of(contents(w.nrow));
    let dl = tables.def_len(contents(w.nrow));
    var kl = build.put_be(contents(w.key), 0, id, 4);
    var n = 0;
    var more = true;
    region g {
        let text = alloc_slice[g](16384, byte_of(0));
        while more {
            let r = btree.next_after(pg, contents(w.sc), root, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
            if r < 0 || r / 1024 < 4 || commit.be(contents(w.key2), 0, 4) != id {
                more = false;
            } else {
                let nv = r % 1024;
                var pl = 0 - 1;
                var il = 0 - 1;
                if nv >= 32 {
                    pl = row.plain_key(contents(w.nrow)[6..6 + dl], contents(w.cur)[32..nv], text[0..8192]);
                    il = row.image(contents(w.nrow)[6..6 + dl], contents(w.cur)[32..nv], text[8192..16384]);
                }
                if pl < 0 || il < 0 {
                    more = false;
                    n = 0 - 1;
                } else {
                    putchar(io, 'D');
                    var part = 0;
                    while part < 4 {
                        putchar(io, ' ');
                        var a = 0;
                        var b = pl;
                        if part == 1 {
                            b = 16;
                        } else if part == 2 {
                            a = 8192;
                            b = 8192 + il;
                        } else if part == 3 {
                            a = 16;
                            b = 32;
                        }
                        if a == b {
                            putchar(io, '.');
                        }
                        while a < b {
                            if part % 2 == 0 {
                                hex_byte(io, int_of(text[a]));
                            } else {
                                hex_byte(io, int_of(contents(w.cur)[a]));
                            }
                            a = a + 1;
                        }
                        part = part + 1;
                    }
                    putchar(io, '\n');
                    kl = exec.copy(contents(w.key2), 0, r / 1024, contents(w.key), 0);
                    n = n + 1;
                }
            }
        }
    }
    if n < 0 {
        put_str(io, "rows -\n");
    } else {
        put_str(io, "rows ");
        put_int(io, n);
        putchar(io, '\n');
    }
    return 0;
}

// Whether the line begins with `word` and goes on.
fn begins[&a](all: &a [byte], ls: int, le: int, word: &static [byte]) -> [] bool {
    if le - ls <= len(word) {
        return false;
    }
    var i = 0;
    while i < len(word) {
        if int_of(all[ls + i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The digits from `from` to `to` as a number (-1 if there is anything else, or too much).
fn number[&a](all: &a [byte], from: int, to: int) -> [] int {
    var v = 0;
    var i = from;
    if to <= from || to - from > 15 {
        return 0 - 1;
    }
    while i < to {
        let c = int_of(all[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + c - '0';
        i = i + 1;
    }
    return v;
}

fn run[&h, &i, &z, &q, &b, &a](heap: &!h Heap, io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, sub: &!b drive.Sub, all: &a [byte]) -> [heap, io_write, file_read, file_write] int {
    var roots = box_slice(heap, 16, 0);
    var seq = 0;
    var status = 0;
    var cur = 0;
    var view = 0 - 1;
    var tstate = 0;
    var troot = 0;
    // the facts of the transaction that is open: their tree (below 0: they are not to be had), and whether it wrote
    var tfacts = 0;
    var twrote = false;
    var flags = box_slice(heap, 34, 0);
    borrow mut flags as &!fw in {
        borrow mut roots as &!rw in {
            let rs = contents(rw);
            let fl = contents(fw);
            seq = pstore.load(pg, exec.scratch(w), rs);
            if seq == pstore.no_database() {
                seq = pstore.init(pg, exec.scratch(w));
            }
            if seq < 0 {
                put_str(io, "err ");
                put_int(io, seq);
                putchar(io, '\n');
                status = 5;
            }
            var ls = 0;
            while ls < len(all) && status == 0 {
                var le = ls;
                while le < len(all) && int_of(all[le]) != '\n' {
                    le = le + 1;
                }
                // each line is a window of the pager: the pages a statement hands out are its own until it is done
                let wr = pager.begin(pg);
                if wr < 0 && !pager.crashed(pg) {
                    put_str(io, "err ");
                    put_int(io, wr);
                    putchar(io, '\n');
                    status = 5;
                }
                if starts(all, ls, le, "!commit") {
                    let r = pstore.commit(pg, exec.scratch(w), rs, seq);
                    if r < 0 {
                        put_str(io, "err ");
                        put_int(io, r);
                    } else {
                        seq = r;
                        put_str(io, "committed ");
                        put_int(io, r);
                    }
                    putchar(io, '\n');
                } else if starts(all, ls, le, "!sweep") {
                    let r = pstore.sweep(heap, pg, exec.scratch(w), rs);
                    if r < 0 {
                        put_str(io, "err ");
                    } else {
                        put_str(io, "swept ");
                    }
                    put_int(io, r);
                    putchar(io, '\n');
                } else if starts(all, ls, le, "!unseed") {
                    // from here on there is no seed to make salts of: a statement that writes a row is refused
                    exec.unseed(w);
                    put_str(io, "unseeded\n");
                } else if begins(all, ls, le, "!log ") {
                    // from here on every commit of the first branch that changed rows is a record of the log, signed with the key this is the seed of (64 hex digits)
                    region lr {
                        let seed = alloc_slice[lr](32, byte_of(0));
                        let hd = alloc_slice[lr](40, byte_of(0));
                        let pk = alloc_slice[lr](32, byte_of(0));
                        var k = 0;
                        var okl = le - ls == 5 + 64;
                        while k < 32 && okl {
                            let hi = unhex(int_of(all[ls + 5 + 2 * k]));
                            let lo = unhex(int_of(all[ls + 6 + 2 * k]));
                            okl = hi >= 0 && lo >= 0;
                            seed[k] = byte_of((hi * 16 + lo) % 256);
                            k = k + 1;
                        }
                        if okl {
                            k = 0;
                            while k < 32 {
                                fl[2 + k] = int_of(seed[k]);
                                k = k + 1;
                            }
                            fl[1] = 1;
                            build.public_key(seed, pk);
                            let hn = build.log_header(hd, 0, pk);
                            put_str(io, "L ");
                            k = 0;
                            while k < hn {
                                hex_byte(io, int_of(hd[k]));
                                k = k + 1;
                            }
                            putchar(io, '\n');
                        } else {
                            put_str(io, "L -\n");
                        }
                    }
                } else if begins(all, ls, le, "!rows ") {
                    put_table(io, pg, w, rs[cur], all[ls + 6..le]);
                } else if starts(all, ls, le, "!mark") {
                    put_str(io, "mark\n");
                } else if starts(all, ls, le, "!steps") {
                    put_str(io, "steps ");
                    put_int(io, pager.steps(pg));
                    putchar(io, '\n');
                } else if starts(all, ls, le, "!txn") {
                    put_str(io, "txn ");
                    put_int(io, exec.last_txn(pg, w, rs[cur]));
                    putchar(io, '\n');
                } else if begins(all, ls, le, "!asof ") {
                    if int_of(all[ls + 6]) == '-' {
                        view = 0 - 1;
                        put_str(io, "asof -\n");
                    } else {
                        let t = number(all, ls + 6, le);
                        view = exec.as_of(pg, w, rs[cur], t);
                        if view < 0 {
                            put_str(io, "err ");
                            put_int(io, view);
                            view = 0 - 1;
                        } else {
                            put_str(io, "asof ");
                            put_int(io, t);
                        }
                        putchar(io, '\n');
                    }
                } else if begins(all, ls, le, "!erase ") {
                    // the row a `delete from T where KEY = CONSTANT` names, and its past
                    if view < 0 {
                        rs[cur] = run_sql(heap, io, pg, w, all[ls + 7..le], rs[cur], 2, fl, false);
                        put_str(io, "S I\n.\n");
                    }
                } else if begins(all, ls, le, "!fork ") {
                    let to = number(all, ls + 6, le);
                    if to >= 0 && to < 16 {
                        rs[to] = rs[cur];
                        put_str(io, "forked\n");
                    }
                } else if begins(all, ls, le, "!branch ") {
                    let to = number(all, ls + 8, le);
                    if to >= 0 && to < 16 {
                        cur = to;
                        view = 0 - 1;
                        put_str(io, "branch\n");
                    }
                } else if begins(all, ls, le, "!params ") {
                    // the values bound to the parameters of the next statement: each in hex, `.` for an empty one, `-` for a null
                    exec.params_clear(w);
                    var okp = true;
                    var a = ls + 8;
                    while a < le && okp {
                        var b = a;
                        while b < le && int_of(all[b]) != ' ' {
                            b = b + 1;
                        }
                        okp = set_param(w, all[a..b]);
                        a = b + 1;
                    }
                    if !okp {
                        put_str(io, "err params\n");
                        status = 5;
                    }
                } else if le > ls {
                    if view >= 0 {
                        run_sql(heap, io, pg, w, all[ls..le], view, 1, fl, false);
                        put_str(io, "S I\n.\n");
                    } else {
                        // a statement outside a transaction is one of its own; inside one (BEGIN ... COMMIT) the statements build on the transaction's tree, which becomes the branch's at COMMIT
                        let last = exec.last_txn(pg, w, rs[cur]);
                        if last < 0 {
                            put_str(io, "err ");
                            put_int(io, last);
                            putchar(io, '\n');
                        } else if tstate == 0 {
                            exec.set_txn(w, last + 1);
                            exec.set_once(w, true);
                            var after = 0;
                            exec.draw_set(w, 0, 0);
                            let pl = drive.prepare(pg, w, sub, all[ls..le], rs[cur]);
                            if pl >= 0 {
                                after = run_sql(heap, io, pg, w, drive.text(sub)[0..pl], rs[cur], 0, fl, true);
                            } else {
                                after = run_sql(heap, io, pg, w, all[ls..le], rs[cur], 0, fl, false);
                            }
                            if after == 0 - 20 {
                                tstate = 1;
                                troot = rs[cur];
                                put_str(io, "ok BEGIN 0\nG BEGIN\n");
                            } else if after == 0 - 21 {
                                put_str(io, "ok COMMIT 0\nG COMMIT\n");
                            } else if after == 0 - 22 {
                                put_str(io, "ok ROLLBACK 0\nG ROLLBACK\n");
                            } else if fl[0] != 0 {
                                // the statement failed, or was refused: what it drew from a counter stays drawn (docs/m3-engine.md 6y)
                                let sr = exec.seq_replay(pg, w, rs[cur]);
                                if sr < 0 {
                                    put_str(io, "err ");
                                    put_int(io, sr);
                                    putchar(io, '\n');
                                } else {
                                    rs[cur] = sr;
                                }
                            } else if after != rs[cur] {
                                // the facts of the commit this statement is (docs/m3-engine.md 6af)
                                var sfacts = 0;
                                let swrote = exec.changes_of(w) > 0;
                                if swrote {
                                    sfacts = facts.take(pg, w, 0);
                                    put_facts(io, pg, w, sfacts);
                                }
                                // the statement wrote: its number is used
                                let marked = exec.mark_txn(pg, w, after, last + 1);
                                if marked < 0 {
                                    put_str(io, "err ");
                                    put_int(io, marked);
                                    putchar(io, '\n');
                                } else {
                                    rs[cur] = marked;
                                    if swrote {
                                        rs[cur] = put_commit(io, pg, w, marked, sfacts, fl, cur);
                                    }
                                }
                            }
                            if tstate == 0 {
                                // nothing is left to roll back: the tree that stays has what was drawn
                                exec.seq_forget(w);
                            }
                        } else {
                            exec.set_txn(w, last + 1);
                            // a key may be written more than once in a transaction: what it held before the transaction is its first record (6n)
                            exec.set_once(w, false);
                            var mode = 0;
                            if tstate == 2 {
                                mode = 3;
                            }
                            var after = 0;
                            var pl = 0 - 1;
                            exec.draw_set(w, 0, 0);
                            if mode == 0 {
                                pl = drive.prepare(pg, w, sub, all[ls..le], troot);
                            }
                            if pl >= 0 {
                                after = run_sql(heap, io, pg, w, drive.text(sub)[0..pl], troot, mode, fl, true);
                            } else {
                                after = run_sql(heap, io, pg, w, all[ls..le], troot, mode, fl, false);
                            }
                            if after == 0 - 20 && tstate == 2 {
                                // in a transaction that has failed BEGIN is refused like any other statement
                                put_str(io, "error 25P02\n");
                            } else if after == 0 - 20 {
                                // PostgreSQL warns and goes on
                                put_str(io, "ok BEGIN 0\nG BEGIN\n");
                            } else if after == 0 - 21 || after == 0 - 22 {
                                if after == 0 - 21 && tstate == 1 {
                                    if troot != rs[cur] {
                                        let marked = exec.mark_txn(pg, w, troot, last + 1);
                                        if marked < 0 {
                                            put_str(io, "err ");
                                            put_int(io, marked);
                                            putchar(io, '\n');
                                        } else {
                                            rs[cur] = marked;
                                        }
                                    }
                                    put_str(io, "ok COMMIT 0\nG COMMIT\n");
                                    if twrote {
                                        put_facts(io, pg, w, tfacts);
                                        rs[cur] = put_commit(io, pg, w, rs[cur], tfacts, fl, cur);
                                    }
                                    exec.seq_forget(w);
                                } else {
                                    // a rollback, or the commit of a transaction that failed: what its statements drew from counters stays drawn
                                    let sr = exec.seq_replay(pg, w, rs[cur]);
                                    if sr < 0 {
                                        put_str(io, "err ");
                                        put_int(io, sr);
                                        putchar(io, '\n');
                                    } else {
                                        rs[cur] = sr;
                                    }
                                    put_str(io, "ok ROLLBACK 0\nG ROLLBACK\n");
                                }
                                tstate = 0;
                                tfacts = 0;
                                twrote = false;
                            } else if fl[0] != 0 {
                                // an error, or a refusal: the transaction has failed
                                tstate = 2;
                            } else {
                                troot = after;
                                if exec.changes_of(w) > 0 && tfacts >= 0 {
                                    tfacts = facts.take(pg, w, tfacts);
                                    twrote = true;
                                }
                            }
                        }
                        if tstate == 0 {
                            put_str(io, "S I\n.\n");
                        } else if tstate == 1 {
                            put_str(io, "S T\n.\n");
                        } else {
                            put_str(io, "S E\n.\n");
                        }
                    }
                }
                if !begins(all, ls, le, "!params ") {
                    exec.params_clear(w);
                }
                if pager.crashed(pg) {
                    // the crash point was reached (the test hook of src/pager.cho): nothing more is written, as if the process had died there
                    put_str(io, "crashed\n");
                    status = 6;
                }
                ls = le + 1;
            }
        }
    }
    unbox_slice(heap, roots);
    unbox_slice(heap, flags);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(tty);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    var status = 2;
    borrow fs as &fsr in {
        borrow args as &g in {
            if arg_count(g) == 2 || arg_count(g) == 4 {
                status = 3;
                match open_new(fsr, arg(g, 1)) {
                    Opened::Ok(nf) => {
                        file_close(nf);
                    }
                    Opened::Failed(e) => {
                    }
                }
                match open_rw(fsr, arg(g, 1)) {
                    Opened::Failed(e) => {
                        status = 4;
                    }
                    Opened::Ok(rf) => {
                        var f = rf;
                        var size = 0;
                        borrow mut f as &!fw in {
                            match file_size(fw) {
                                Done::Ok(n) => {
                                    size = n;
                                }
                                Done::Failed(e) => {
                                }
                            }
                        }
                        borrow mut heap as &!hh in {
                            var pg = pager.new_pager(hh, f, size);
                            if arg_count(g) == 4 {
                                var crash = 0;
                                var torn = 0;
                                var i = 0;
                                while i < len(arg(g, 2)) {
                                    crash = crash * 10 + int_of(arg(g, 2)[i]) - '0';
                                    i = i + 1;
                                }
                                i = 0;
                                while i < len(arg(g, 3)) {
                                    torn = torn * 10 + int_of(arg(g, 3)[i]) - '0';
                                    i = i + 1;
                                }
                                borrow mut pg as &!cq in {
                                    pager.set_crash(cq, crash, torn);
                                }
                            }
                            var wk = exec.new_work(hh);
                            var text = buffer.empty(hh, 4096);
                            borrow mut io as &!oo in {
                                text = read_stdin(hh, oo, text);
                            }
                            borrow text as &t in {
                                borrow mut io as &!oo in {
                                    borrow mut pg as &!pp in {
                                        borrow mut wk as &!ww in {
                                            // the seed of the salts (docs/m3-engine.md 6ag): 32 bytes from the system, kept nowhere
                                            region sr {
                                                let sd = alloc_slice[sr](32, byte_of(0));
                                                match open_read(fsr, "/dev/urandom") {
                                                    Opened::Ok(uf) => {
                                                        var u = uf;
                                                        borrow mut u as &!uw in {
                                                            match file_read(uw, sd) {
                                                                Read::Got(n) => {
                                                                    if n == 32 {
                                                                        exec.seed(ww, sd);
                                                                    }
                                                                }
                                                                Read::End => {
                                                                }
                                                                Read::Failed(e) => {
                                                                }
                                                            }
                                                        }
                                                        file_close(u);
                                                    }
                                                    Opened::Failed(e) => {
                                                    }
                                                }
                                            }
                                            var subs = drive.new(hh);
                                            borrow mut subs as &!sb in {
                                                status = run(hh, oo, pp, ww, sb, buffer.bytes(t));
                                            }
                                            drive.free(hh, subs);
                                        }
                                    }
                                }
                            }
                            buffer.drop(hh, text);
                            exec.drop_work(hh, wk);
                            pager.drop_pager(hh, pg);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(args);
    release(io);
    release(heap);
    return status;
}
