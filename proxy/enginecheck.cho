edition 9;

import std.buffer;
import std.io;
import cdb.lex;
import cdb.parse;
import cdb.stmt;
import cdb.lower;
import cdb.commit;
import cdb.pager;
import cdb.btree;
import cdb.pstore;
import cdb.exec;
import cdb.execs;
import cdb.execw;
import cdb.answer;
import cdb.drive;
import cdb.facts;
import cdb.session;
import cdb.token;
import cdb.tables;
import cdb.build;
import cdb.row;

// `enginecheck PAGEFILE [CRASH TORN]`: the engine's statements (src/exec.cho, src/execw.cho) over a page file, for tests/engine_check.py. PAGEFILE is made if it is missing; the branch is slot 0 of its catalog. Standard
// input, a line each:
//
//     !commit        make the statements so far durable (src/pstore.cho)      -> `committed SEQ` or `err CODE`
//     !sweep         zero and reuse the pages nothing names                   -> `swept N` or `err CODE`
//     !indexed       whether the tree says all of its history is findable by key (6bi)   -> `indexed` or `unindexed`
//     !unindex       make the tree one from before that: the mark and every by-key entry are removed    -> `unindexed`
//     !purge         the same from what was written since the last sweep or purge (6bh), checked against the sweep's walk
//                                                                             -> `purged N`, `purge-fallback`, `purge-unsafe`, `purge-incomplete` or `err CODE`
//     !steps         how many writes and syncs the page file has seen         -> `steps N`
//     !txn           the number of the branch's last transaction (6n)                 -> `txn N`
//     !asof N        statements read the branch as it was after transaction N (`-`: as it is)  -> `asof N`
//     !erase DELETE  the row that `delete from T where KEY = CONSTANT` names, and its history (6n)   -> `ok ERASE N`
//     !fork S        slot S becomes the same tree as the branch                -> `forked`
//     !branch S      statements go to slot S (the branch is slot 0 at start)   -> `branch`
//     !seed HEX      the seed of the salts is these 32 bytes, not the system's (for a test whose runs must write the same pages)  -> `seeded`
//     !log HEX       commits of the first branch are records of the log, signed with the key of this seed (6ah)  -> `L` and the log's header in hex
//     !rows T        every row of the table T with its salts (6ah)             -> `D key keysalt image salt` each, then `rows N`
//     !token HEX     statements are held against this token and commits made under it (6at, 6au); `!token -` none  -> `token N`
//     !tokens        the tokens kept with the log (6at)                         -> `K hex` each, then `tokens N`
//     !stmts         the statements' records kept with the log (6au)            -> `Y hex` each, then `stmts N`
//     !records       the log as it is in the page file (6as)                    -> `L` and the header, `L` and each record, `records N`
//     !store         the facts of every commit as they are in the page file    -> `X seq table commitment was is` each, then `store N`
//     !schema        the schema as the lowering reads it (6bc)                 -> `M` and the text in hex
//     !mark          nothing                                                  -> `mark` (a separator for a test that reads the output)
//     anything else  one SQL statement, which is run and, if it is done, becomes the state the next one sees
//                    (`begin`, `commit` and `rollback` are answered here: the statements between them build on the transaction's own tree)
//
// With CRASH and TORN the process stops being able to write at step CRASH (TORN bytes of that write happen): it prints `crashed` and ends with status 6, leaving the file as a kill there would.
//
// For a statement: `refused TAG` (the lexer, the parser, the lowering or the engine refuses it), `error SQLSTATE`, or `ok KIND N` (N rows) followed by, for a SELECT, a line `N` with the name of each column (hex), a line `T` with the type of each column
// and a line `R` for each row with each value (`-` null, a number, 0 or 1, or the bytes in hex, `.` if there are none); for a statement that writes, a line `C TABLE KEY BEFORE AFTER` for each change (hex,
// `-` for no image). After `ok`, a line `G` with the command's tag as a client is sent it. Then a line `S` with the transaction's state as PostgreSQL reports it (`I` none, `T` in one, `E` in one that has failed), and a line `.`. Types are PostgreSQL's identifiers and values its text (src/answer.cho).

fn digit(v: int) -> [] int {
    if v < 10 {
        return '0' + v;
    }
    return 'a' + v - 10;
}

fn put_str[&i, &s](io: &!i Io, text: &s [byte]) -> [io_write] int {
    var j = 0;
    while j < len(text) {
        putchar(io, int_of(text[j]));
        j = j + 1;
    }
    return 0;
}

fn put_int[&i](io: &!i Io, v: int) -> [io_write] int {
    if v < 0 {
        putchar(io, '-');
        var div = 1;
        while v / div <= 0 - 10 {
            div = div * 10;
        }
        while div > 0 {
            putchar(io, '0' - v / div % 10);
            div = div / 10;
        }
        return 0;
    }
    var div = 1;
    while v / div >= 10 {
        div = div * 10;
    }
    while div > 0 {
        putchar(io, '0' + v / div % 10);
        div = div / 10;
    }
    return 0;
}

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

fn hex_byte[&i](io: &!i Io, v: int) -> [io_write] int {
    putchar(io, digit(v / 16));
    putchar(io, digit(v % 16));
    return 0;
}

// The rows of a SELECT's answer.
fn put_rows[&i, &q](io: &!i Io, w: &!q exec.Work) -> [io_write] int {
    let nc = exec.columns_of(w);
    putchar(io, 'T');
    var c = 0;
    while c < nc {
        putchar(io, ' ');
        put_int(io, answer.oid(exec.type_of(w, c)));
        c = c + 1;
    }
    putchar(io, '\n');
    region r {
        let buf = alloc_slice[r](4096, byte_of(0));
        var k = 0;
        while k < exec.count_of(w) {
            var at = exec.row_at(w, k);
            putchar(io, 'R');
            c = 0;
            while c < nc {
                putchar(io, ' ');
                // the value as a client is sent it (src/answer.cho); one longer than this buffer is not printed whole here
                let n = answer.text(exec.rows_of(w), at, buf, 0);
                if n == 0 - 1 {
                    putchar(io, '-');
                } else if n == 0 {
                    putchar(io, '.');
                } else if n < 0 {
                    putchar(io, '?');
                } else {
                    var j = 0;
                    while j < n {
                        hex_byte(io, int_of(buf[j]));
                        j = j + 1;
                    }
                }
                at = answer.skip(exec.rows_of(w), at);
                c = c + 1;
            }
            putchar(io, '\n');
            k = k + 1;
        }
    }
    return 0;
}

fn change_run[&i, &q](io: &!i Io, w: &!q exec.Work, at: int, size: int) -> [io_write] int {
    var n = 0;
    var k = 0;
    while k < size {
        n = n * 256 + exec.change_byte(w, at + k);
        k = k + 1;
    }
    putchar(io, ' ');
    if size == 4 && n == 4294967295 {
        putchar(io, '-');
        return at + 4;
    }
    k = 0;
    while k < n {
        hex_byte(io, exec.change_byte(w, at + size + k));
        k = k + 1;
    }
    if n == 0 {
        putchar(io, '.');
    }
    return at + size + n;
}

fn put_changes[&i, &q](io: &!i Io, w: &!q exec.Work) -> [io_write] int {
    var at = 0;
    var c = 0;
    while c < exec.changes_of(w) {
        putchar(io, 'C');
        at = change_run(io, w, at, 2);
        at = change_run(io, w, at, 2);
        at = change_run(io, w, at, 4);
        at = change_run(io, w, at, 4);
        // the salts (docs/m3-engine.md 6ag): the key's, the old row's, the new row's
        putchar(io, ' ');
        var k = 0;
        while k < 16 {
            hex_byte(io, exec.change_byte(w, at + k));
            k = k + 1;
        }
        at = at + 16;
        var side = 0;
        while side < 2 {
            putchar(io, ' ');
            if exec.change_byte(w, at) == 1 {
                k = 0;
                while k < 16 {
                    hex_byte(io, exec.change_byte(w, at + 1 + k));
                    k = k + 1;
                }
            } else {
                putchar(io, '-');
            }
            at = at + 17;
            side = side + 1;
        }
        putchar(io, '\n');
        c = c + 1;
    }
    return 0;
}

// Run one statement over the tree `root`: the tree after it (`root` itself unless the statement is done).
fn run_sql[&h, &i, &z, &q, &s, &f](heap: &!h Heap, io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, sql: &s [byte], root: int, mode: int, flag: &!f [int], part: bool) -> [heap, io_write, file_read, file_write] int {
    var run = drive.run_new(heap, len(sql));
    var out = root;
    borrow mut run as &!m in {
        // the statement is read, lowered and run by the engine (src/drive.cho); what is here is how its answer is written for a test to read
        region kt {
            let tk = alloc_slice[kt](flag[48], byte_of(0));
            var ti = 0;
            while ti < len(tk) {
                tk[ti] = byte_of(flag[49 + ti]);
                ti = ti + 1;
            }
            out = drive.run(heap, pg, w, m, sql, root, mode, part, tk);
        }
        let o = drive.outcome(m);
        flag[0] = 0;
        if o == drive.o_ok() {
            let kind = drive.kind(m);
            put_str(io, "ok ");
            if kind == 6 {
                put_str(io, "SELECT ");
            } else if kind == 1 {
                put_str(io, "INSERT ");
            } else if kind == 2 {
                put_str(io, "UPDATE ");
            } else if kind == 3 {
                put_str(io, "DELETE ");
            } else if kind == 9 {
                put_str(io, "ERASE ");
            } else if kind == 10 {
                put_str(io, "ALTER ");
            } else if kind == 11 {
                put_str(io, "INDEX ");
            } else if kind == 12 {
                put_str(io, "DROPINDEX ");
            } else if kind == answer.k_truncate() {
                put_str(io, "TRUNCATE ");
            } else if kind == 7 || kind == 13 {
                put_str(io, "CREATE ");
            } else {
                put_str(io, "DROP ");
            }
            put_int(io, exec.count_of(w));
            putchar(io, '\n');
            if kind != 9 {
                // the command's tag, as a client is sent it
                putchar(io, 'G');
                putchar(io, ' ');
                region tr {
                    let tb2 = alloc_slice[tr](64, byte_of(0));
                    let tn = answer.tag(kind, exec.count_of(w), tb2);
                    put_str(io, tb2[0..tn]);
                }
                putchar(io, '\n');
            }
            if drive.has_rows(m) {
                // the names of the columns, as a client is sent them
                let nm = drive.names(m);
                putchar(io, 'N');
                var na = 0;
                while na + 2 <= len(nm) {
                    let l = int_of(nm[na]) * 256 + int_of(nm[na + 1]);
                    putchar(io, ' ');
                    var j = 0;
                    while j < l {
                        hex_byte(io, int_of(nm[na + 2 + j]));
                        j = j + 1;
                    }
                    if l == 0 {
                        putchar(io, '.');
                    }
                    na = na + 2 + l;
                }
                putchar(io, '\n');
                put_rows(io, w);
            }
            if kind != 6 && kind < 9 || kind == answer.k_drop_table() || kind == answer.k_alter_table() || kind == answer.k_truncate() {
                put_changes(io, w);
            }
        } else if o != drive.o_control() {
            if o == drive.o_error() {
                put_str(io, "error ");
                put_str(io, exec.sqlstate(drive.code(m)));
            } else {
                put_str(io, "refused ");
                put_str(io, drive.refusal(m));
            }
            putchar(io, '\n');
            flag[0] = 1;
        }
    }
    drive.run_free(heap, run);
    return out;
}

fn starts[&a](all: &a [byte], ls: int, le: int, word: &static [byte]) -> [] bool {
    if le - ls != len(word) {
        return false;
    }
    var i = 0;
    while i < len(word) {
        if int_of(all[ls + i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn unhex(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return 0 - 1;
}

// One value of a `!params` line, as the next parameter: false if it is not hex, or there is no room.
fn set_param[&q, &t](w: &!q exec.Work, tok: &t [byte]) -> [] bool {
    if len(tok) == 1 && int_of(tok[0]) == '-' {
        return exec.param_add(w, tok[0..0], true);
    }
    if len(tok) == 1 && int_of(tok[0]) == '.' {
        return exec.param_add(w, tok[0..0], false);
    }
    if len(tok) < 2 || len(tok) % 2 != 0 {
        return false;
    }
    var ok = true;
    region r {
        let b = alloc_slice[r](len(tok) / 2, byte_of(0));
        var i = 0;
        while i < len(b) {
            let hi = unhex(int_of(tok[2 * i]));
            let lo = unhex(int_of(tok[2 * i + 1]));
            if hi < 0 || lo < 0 {
                ok = false;
            } else {
                b[i] = byte_of(hi * 16 + lo);
            }
            i = i + 1;
        }
        if ok {
            ok = exec.param_add(w, b, false);
        }
    }
    return ok;
}

// The facts of a commit, as a line: `F`, how many, and `changes` in hex (docs/m3-engine.md 6af); `F -` if they are not to be had (`froot` below 0).
fn put_facts[&i, &z, &q](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, froot: int) -> [io_write, file_read] int {
    var n = froot;
    region r {
        let h = alloc_slice[r](32, byte_of(0));
        if n >= 0 {
            n = facts.changes(pg, w, froot, h);
        }
        if n < 0 {
            put_str(io, "F -\n");
        } else {
            put_str(io, "F ");
            put_int(io, n);
            putchar(io, ' ');
            var k = 0;
            while k < 32 {
                hex_byte(io, int_of(h[k]));
                k = k + 1;
            }
            putchar(io, '\n');
        }
    }
    return 0;
}

// Every row of the table `name` as a line: `D`, then in hex the plain key, the key's salt, the row's image and the row's salt, as the facts have them (what a live dump holds,
// docs/spec/l3a.md 3b); `rows N` at the end, `rows -` if there is no such table or a row cannot be shown.
fn put_table[&i, &z, &q, &n](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, root: int, name: &n [byte]) -> [io_write, file_read] int {
    let el = tables.find(pg, contents(w.sc), root, name, contents(w.key), contents(w.nrow));
    if el < 0 {
        put_str(io, "rows -\n");
        return 0;
    }
    let id = tables.id_of(contents(w.nrow));
    let dl = tables.def_len(contents(w.nrow));
    var kl = build.put_be(contents(w.key), 0, id, 4);
    var n = 0;
    var more = true;
    region g {
        let text = alloc_slice[g](16384, byte_of(0));
        while more {
            let r = btree.next_after(pg, contents(w.sc), root, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
            if r < 0 || r / 1024 < 4 || commit.be(contents(w.key2), 0, 4) != id {
                more = false;
            } else {
                let nv = r % 1024;
                var pl = 0 - 1;
                var il = 0 - 1;
                if nv >= 32 {
                    pl = row.plain_key(contents(w.nrow)[6..6 + dl], contents(w.cur)[32..nv], text[0..8192]);
                    il = row.image(contents(w.nrow)[6..6 + dl], contents(w.cur)[32..nv], text[8192..16384]);
                }
                if pl < 0 || il < 0 {
                    more = false;
                    n = 0 - 1;
                } else {
                    putchar(io, 'D');
                    var part = 0;
                    while part < 4 {
                        putchar(io, ' ');
                        var a = 0;
                        var b = pl;
                        if part == 1 {
                            b = 16;
                        } else if part == 2 {
                            a = 8192;
                            b = 8192 + il;
                        } else if part == 3 {
                            a = 16;
                            b = 32;
                        }
                        if a == b {
                            putchar(io, '.');
                        }
                        while a < b {
                            if part % 2 == 0 {
                                hex_byte(io, int_of(text[a]));
                            } else {
                                hex_byte(io, int_of(contents(w.cur)[a]));
                            }
                            a = a + 1;
                        }
                        part = part + 1;
                    }
                    putchar(io, '\n');
                    kl = exec.copy(contents(w.key2), 0, r / 1024, contents(w.key), 0);
                    n = n + 1;
                }
            }
        }
    }
    if n < 0 {
        put_str(io, "rows -\n");
    } else {
        put_str(io, "rows ");
        put_int(io, n);
        putchar(io, '\n');
    }
    return 0;
}

// Whether the line begins with `word` and goes on.
fn begins[&a](all: &a [byte], ls: int, le: int, word: &static [byte]) -> [] bool {
    if le - ls <= len(word) {
        return false;
    }
    var i = 0;
    while i < len(word) {
        if int_of(all[ls + i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The digits from `from` to `to` as a number (-1 if there is anything else, or too much).
fn number[&a](all: &a [byte], from: int, to: int) -> [] int {
    var v = 0;
    var i = from;
    if to <= from || to - from > 15 {
        return 0 - 1;
    }
    while i < to {
        let c = int_of(all[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + c - '0';
        i = i + 1;
    }
    return v;
}

fn run[&h, &i, &z, &q, &b, &a](heap: &!h Heap, io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, sub: &!b drive.Sub, all: &a [byte]) -> [heap, io_write, file_read, file_write] int {
    var roots = box_slice(heap, 16, 0);
    var seq = 0;
    var status = 0;
    var cur = 0;
    var view = 0 - 1;
    var flags = box_slice(heap, 49 + 4096, 0);
    borrow mut flags as &!fw in {
        borrow mut roots as &!rw in {
            let rs = contents(rw);
            let fl = contents(fw);
            seq = pstore.load(pg, exec.scratch(w), rs);
            if seq == pstore.no_database() {
                seq = pstore.init(pg, exec.scratch(w));
            }
            if seq < 0 {
                put_str(io, "err ");
                put_int(io, seq);
                putchar(io, '\n');
                status = 5;
            }
            var ls = 0;
            while ls < len(all) && status == 0 {
                var le = ls;
                while le < len(all) && int_of(all[le]) != '\n' {
                    le = le + 1;
                }
                // each line is a window of the pager: the pages a statement hands out are its own until it is done
                let wr = pager.begin(pg);
                if wr < 0 && !pager.crashed(pg) {
                    put_str(io, "err ");
                    put_int(io, wr);
                    putchar(io, '\n');
                    status = 5;
                }
                if starts(all, ls, le, "!commit") {
                    let r = pstore.commit(pg, exec.scratch(w), rs, seq);
                    if r < 0 {
                        put_str(io, "err ");
                        put_int(io, r);
                    } else {
                        seq = r;
                        put_str(io, "committed ");
                        put_int(io, r);
                    }
                    putchar(io, '\n');
                } else if starts(all, ls, le, "!indexed") || starts(all, ls, le, "!unindex") {
                    // whether the tree says its history is findable by key (6bi); `!unindex` makes the tree one from before that: the mark and every such entry go
                    var said = 0;
                    region ix {
                        let k = alloc_slice[ix](256, byte_of(0));
                        let nx = alloc_slice[ix](256, byte_of(0));
                        let v = alloc_slice[ix](1024, byte_of(0));
                        let ik = tables.indexed_key(k);
                        if starts(all, ls, le, "!unindex") {
                            let d = btree.del(pg, exec.scratch(w), rs[cur], k[0..ik]);
                            if d >= 0 {
                                rs[cur] = d;
                            }
                            build.put_be(k, 0, tables.log_space(), 4);
                            k[4] = byte_of(13);
                            var going = true;
                            while going {
                                let r = btree.next_after(pg, exec.scratch(w), rs[cur], k[0..5], true, nx, v);
                                if r < 0 || r / 1024 < 5 || commit.be(nx, 0, 4) != tables.log_space() || int_of(nx[4]) != 13 {
                                    going = false;
                                } else {
                                    // (and no internal page keeps it as a bound: a file from before never had it)
                                    var d2 = btree.del(pg, exec.scratch(w), rs[cur], nx[0..r / 1024]);
                                    if d2 >= 0 {
                                        d2 = btree.scrub(pg, exec.scratch(w), d2, nx[0..r / 1024]);
                                    }
                                    if d2 < 0 {
                                        going = false;
                                        said = d2;
                                    } else {
                                        rs[cur] = d2;
                                    }
                                }
                            }
                            tables.indexed_key(k);
                        }
                        if said == 0 && btree.get(pg, exec.scratch(w), rs[cur], k[0..ik], v) >= 0 {
                            said = 1;
                        }
                    }
                    if said < 0 {
                        put_str(io, "err ");
                        put_int(io, said);
                        putchar(io, '\n');
                    } else if said == 1 {
                        put_str(io, "indexed\n");
                    } else {
                        put_str(io, "unindexed\n");
                    }
                } else if starts(all, ls, le, "!purge") {
                    // what an erase does in place of a sweep (6bh), held to the sweep's walk before it writes; a tree built to read the past is garbage to it
                    view = 0 - 1;
                    let r = pstore.purge(heap, pg, exec.scratch(w), rs, true);
                    if r == pstore.no_base() {
                        put_str(io, "purge-fallback");
                    } else if r == pstore.unsafe_purge() {
                        put_str(io, "purge-unsafe");
                    } else if r == pstore.incomplete_purge() {
                        put_str(io, "purge-incomplete");
                    } else if r < 0 {
                        put_str(io, "err ");
                        put_int(io, r);
                    } else {
                        put_str(io, "purged ");
                        put_int(io, r);
                    }
                    putchar(io, '\n');
                } else if starts(all, ls, le, "!sweep") {
                    let r = pstore.sweep(heap, pg, exec.scratch(w), rs);
                    if r < 0 {
                        put_str(io, "err ");
                    } else {
                        put_str(io, "swept ");
                    }
                    put_int(io, r);
                    putchar(io, '\n');
                } else if begins(all, ls, le, "!seed ") {
                    // the seed of the salts, given (64 hex digits) in place of the system's: for a test that needs two runs to write the same pages (tests/engine_crash.py)
                    region zr {
                        let sd = alloc_slice[zr](32, byte_of(0));
                        var k = 0;
                        var oks = le - ls == 6 + 64;
                        while k < 32 && oks {
                            let hi = unhex(int_of(all[ls + 6 + 2 * k]));
                            let lo = unhex(int_of(all[ls + 7 + 2 * k]));
                            oks = hi >= 0 && lo >= 0;
                            sd[k] = byte_of((hi * 16 + lo) % 256);
                            k = k + 1;
                        }
                        if oks && exec.seed(w, sd) {
                            put_str(io, "seeded\n");
                        } else {
                            put_str(io, "seeded -\n");
                        }
                    }
                } else if starts(all, ls, le, "!unseed") {
                    // from here on there is no seed to make salts of: a statement that writes a row is refused
                    exec.unseed(w);
                    put_str(io, "unseeded\n");
                } else if begins(all, ls, le, "!log ") {
                    // from here on every commit of the first branch that changed rows is a record of the log, signed with the key this is the seed of (64 hex digits)
                    region lr {
                        let seed = alloc_slice[lr](32, byte_of(0));
                        let hd = alloc_slice[lr](40, byte_of(0));
                        let pk = alloc_slice[lr](32, byte_of(0));
                        var k = 0;
                        var okl = le - ls == 5 + 64;
                        while k < 32 && okl {
                            let hi = unhex(int_of(all[ls + 5 + 2 * k]));
                            let lo = unhex(int_of(all[ls + 6 + 2 * k]));
                            okl = hi >= 0 && lo >= 0;
                            seed[k] = byte_of((hi * 16 + lo) % 256);
                            k = k + 1;
                        }
                        if okl {
                            k = 0;
                            while k < 32 {
                                fl[2 + k] = int_of(seed[k]);
                                k = k + 1;
                            }
                            fl[1] = 1;
                            build.public_key(seed, pk);
                            let hn = build.log_header(hd, 0, pk);
                            put_str(io, "L ");
                            k = 0;
                            while k < hn {
                                hex_byte(io, int_of(hd[k]));
                                k = k + 1;
                            }
                            putchar(io, '\n');
                        } else {
                            put_str(io, "L -\n");
                        }
                    }
                } else if begins(all, ls, le, "!token ") {
                    // from here on statements are held against this token, and commits are made under it (docs/m3-engine.md 6at, 6au): the token in hex; `!token -` for none
                    var tn = 0;
                    var okt = (le - ls - 7) % 2 == 0 && (le - ls - 7) / 2 <= 4096;
                    while okt && ls + 7 + 2 * tn + 1 < le {
                        let hi = unhex(int_of(all[ls + 7 + 2 * tn]));
                        let lo = unhex(int_of(all[ls + 8 + 2 * tn]));
                        okt = hi >= 0 && lo >= 0;
                        fl[49 + tn] = (hi * 16 + lo) % 256;
                        tn = tn + 1;
                    }
                    if okt {
                        fl[48] = tn;
                        put_str(io, "token ");
                        put_int(io, tn);
                        putchar(io, '\n');
                    } else {
                        fl[48] = 0;
                        put_str(io, "token -\n");
                    }
                } else if starts(all, ls, le, "!records") {
                    // the log as it is in the page file (docs/m3-engine.md 6as): `L` and the header, then `L` and each record, in hex; `records N`
                    region xr {
                        let rec = alloc_slice[xr](facts.max_record(), byte_of(0));
                        var n = facts.header(pg, w, rs[cur], rec);
                        var seq2 = 0;
                        while n > 0 {
                            put_str(io, "L ");
                            var k = 0;
                            while k < n {
                                hex_byte(io, int_of(rec[k]));
                                k = k + 1;
                            }
                            putchar(io, '\n');
                            n = facts.record(pg, w, rs[cur], seq2, rec);
                            seq2 = seq2 + 1;
                        }
                        if n < 0 {
                            put_str(io, "records -\n");
                        } else {
                            put_str(io, "records ");
                            if seq2 > 0 {
                                // (the first line was the header)
                                seq2 = seq2 - 1;
                            }
                            put_int(io, seq2);
                            putchar(io, '\n');
                        }
                    }
                } else if starts(all, ls, le, "!tokens") || starts(all, ls, le, "!stmts") {
                    // what is kept with the log under an id: the tokens (docs/m3-engine.md 6at; `K` and each in hex, `tokens N`), the statements' records (6au; `Y`, `stmts N`)
                    var what = 7;
                    if starts(all, ls, le, "!stmts") {
                        what = 8;
                    }
                    region xr {
                        let id = alloc_slice[xr](32, byte_of(0));
                        let tk = alloc_slice[xr](60000, byte_of(0));
                        var an = 0;
                        var count = 0;
                        var n = facts.next_kept(pg, w, rs[cur], what, id, an, tk);
                        while n > 0 {
                            an = 32;
                            if what == 7 {
                                put_str(io, "K ");
                            } else {
                                put_str(io, "Y ");
                            }
                            var k = 0;
                            while k < n {
                                hex_byte(io, int_of(tk[k]));
                                k = k + 1;
                            }
                            putchar(io, '\n');
                            count = count + 1;
                            n = facts.next_kept(pg, w, rs[cur], what, id, an, tk);
                        }
                        if n < 0 {
                            put_str(io, "kept -\n");
                        } else {
                            if what == 7 {
                                put_str(io, "tokens ");
                            } else {
                                put_str(io, "stmts ");
                            }
                            put_int(io, count);
                            putchar(io, '\n');
                        }
                    }
                } else if starts(all, ls, le, "!store") {
                    // the facts of every commit as they are in the page file: `X`, the commit's number, then in hex the table, the commitment and the two hashes (`-`: none)
                    region xr {
                        let fk = alloc_slice[xr](256, byte_of(0));
                        let fv = alloc_slice[xr](66, byte_of(0));
                        var an = 0;
                        var count = 0;
                        var n = facts.next_fact(pg, w, rs[cur], fk, an, fv);
                        while n > 0 {
                            an = n;
                            put_str(io, "X ");
                            put_int(io, commit.be(fk, 0, 8));
                            putchar(io, ' ');
                            var k = 8;
                            while int_of(fk[k]) != 0 {
                                hex_byte(io, int_of(fk[k]));
                                k = k + 1;
                            }
                            putchar(io, ' ');
                            k = k + 1;
                            while k < n {
                                hex_byte(io, int_of(fk[k]));
                                k = k + 1;
                            }
                            var side = 0;
                            while side < 2 {
                                putchar(io, ' ');
                                if int_of(fv[33 * side]) == 1 {
                                    k = 1;
                                    while k < 33 {
                                        hex_byte(io, int_of(fv[33 * side + k]));
                                        k = k + 1;
                                    }
                                } else {
                                    putchar(io, '-');
                                }
                                side = side + 1;
                            }
                            putchar(io, '\n');
                            count = count + 1;
                            n = facts.next_fact(pg, w, rs[cur], fk, an, fv);
                        }
                        if n < 0 {
                            put_str(io, "store -\n");
                        } else {
                            put_str(io, "store ");
                            put_int(io, count);
                            putchar(io, '\n');
                        }
                    }
                } else if begins(all, ls, le, "!rows ") {
                    put_table(io, pg, w, rs[cur], all[ls + 6..le]);
                } else if starts(all, ls, le, "!schema") {
                    // the schema as the lowering reads it, whose hash a commit records (docs/m3-engine.md 6bc): `M` and the text in hex (`.`: none)
                    region xr {
                        let text = alloc_slice[xr](32768, byte_of(0));
                        let n = exec.schema(pg, w, rs[cur], text);
                        if n < 0 {
                            put_str(io, "M -\n");
                        } else {
                            put_str(io, "M ");
                            if n == 0 {
                                putchar(io, '.');
                            }
                            var k = 0;
                            while k < n {
                                hex_byte(io, int_of(text[k]));
                                k = k + 1;
                            }
                            putchar(io, '\n');
                        }
                    }
                } else if starts(all, ls, le, "!mark") {
                    put_str(io, "mark\n");
                } else if starts(all, ls, le, "!steps") {
                    put_str(io, "steps ");
                    put_int(io, pager.steps(pg));
                    putchar(io, '\n');
                } else if starts(all, ls, le, "!txn") {
                    put_str(io, "txn ");
                    put_int(io, exec.last_txn(pg, w, rs[cur]));
                    putchar(io, '\n');
                } else if begins(all, ls, le, "!asof ") {
                    if int_of(all[ls + 6]) == '-' {
                        view = 0 - 1;
                        put_str(io, "asof -\n");
                    } else {
                        let t = number(all, ls + 6, le);
                        view = exec.as_of(pg, w, rs[cur], t);
                        if view < 0 {
                            put_str(io, "err ");
                            put_int(io, view);
                            view = 0 - 1;
                        } else {
                            put_str(io, "asof ");
                            put_int(io, t);
                        }
                        putchar(io, '\n');
                    }
                } else if begins(all, ls, le, "!erase ") {
                    // the row a `delete from T where KEY = CONSTANT` names, and its past
                    if view < 0 {
                        rs[cur] = run_sql(heap, io, pg, w, all[ls + 7..le], rs[cur], 2, fl, false);
                        put_str(io, "S I\n.\n");
                    }
                } else if begins(all, ls, le, "!fork ") {
                    let to = number(all, ls + 6, le);
                    if to >= 0 && to < 16 {
                        rs[to] = rs[cur];
                        put_str(io, "forked\n");
                    }
                } else if begins(all, ls, le, "!branch ") {
                    let to = number(all, ls + 8, le);
                    if to >= 0 && to < 16 {
                        cur = to;
                        view = 0 - 1;
                        put_str(io, "branch\n");
                    }
                } else if begins(all, ls, le, "!params ") {
                    // the values bound to the parameters of the next statement: each in hex, `.` for an empty one, `-` for a null
                    exec.params_clear(w);
                    var okp = true;
                    var a = ls + 8;
                    while a < le && okp {
                        var b = a;
                        while b < le && int_of(all[b]) != ' ' {
                            b = b + 1;
                        }
                        okp = set_param(w, all[a..b]);
                        a = b + 1;
                    }
                    if !okp {
                        put_str(io, "err params\n");
                        status = 5;
                    }
                } else if le > ls {
                    if view >= 0 {
                        run_sql(heap, io, pg, w, all[ls..le], view, 1, fl, false);
                        put_str(io, "S I\n.\n");
                    } else {
                        // which tree the statement runs on, and what it leaves, is the session's (src/session.cho)
                        let on = session.open(pg, w, fl[40..48], rs[cur]);
                        if on < 0 {
                            put_str(io, "err ");
                            put_int(io, on);
                            putchar(io, '\n');
                        } else {
                            let mode = session.mode(fl[40..48]);
                            var pl = 0 - 1;
                            if mode == 0 {
                                pl = drive.prepare(pg, w, sub, all[ls..le], on);
                            }
                            var after = 0;
                            if pl >= 0 {
                                after = run_sql(heap, io, pg, w, drive.text(sub)[0..pl], on, mode, fl, true);
                            } else {
                                after = run_sql(heap, io, pg, w, all[ls..le], on, mode, fl, false);
                            }
                            region cr {
                                // commits of the first branch are records of the log once a key was given (`!log`)
                                var kn = 0;
                                if fl[1] != 0 && cur == 0 {
                                    kn = 32;
                                }
                                let key = alloc_slice[cr](kn, byte_of(0));
                                let rec = alloc_slice[cr](facts.max_record(), byte_of(0));
                                var k = 0;
                                while k < kn {
                                    key[k] = byte_of(fl[2 + k]);
                                    k = k + 1;
                                }
                                // who (6at): the token given with `!token`, at time 0 (this program has no clock)
                                var wn = 0;
                                if fl[48] > 0 {
                                    wn = facts.who_fixed() + fl[48];
                                }
                                let who = alloc_slice[cr](wn, byte_of(0));
                                var wi = 0;
                                while facts.who_fixed() + wi < wn {
                                    who[facts.who_fixed() + wi] = byte_of(fl[49 + wi]);
                                    wi = wi + 1;
                                }
                                if wn > 0 {
                                    token.prefix_id(who[facts.who_fixed()..wn], token.blocks(who[facts.who_fixed()..wn]), who[0..32]);
                                    token.principal_of(who[facts.who_fixed()..wn], who[32..64]);
                                }
                                let nr = session.close(heap, pg, w, fl[40..48], rs[cur], after, fl[0] != 0, key, who, rec);
                                let said = session.said(fl[40..48]);
                                if said == 1 {
                                    put_str(io, "ok BEGIN 0\nG BEGIN\n");
                                } else if said == 2 {
                                    put_str(io, "ok COMMIT 0\nG COMMIT\n");
                                } else if said == 3 {
                                    put_str(io, "ok ROLLBACK 0\nG ROLLBACK\n");
                                } else if said == 4 {
                                    put_str(io, "error 25P02\n");
                                } else if said == 5 {
                                    put_str(io, "refused commit-too-large\n");
                                }
                                if nr < 0 {
                                    put_str(io, "err ");
                                    put_int(io, nr);
                                    putchar(io, '\n');
                                } else {
                                    rs[cur] = nr;
                                }
                                // the facts of the commit (docs/m3-engine.md 6af), and its record (6ah)
                                if session.facts_of(fl[40..48]) != 0 - 2 {
                                    put_facts(io, pg, w, session.facts_of(fl[40..48]));
                                }
                                if session.sealed(fl[40..48]) < 0 {
                                    put_str(io, "L -\n");
                                } else if session.sealed(fl[40..48]) > 0 {
                                    put_str(io, "L ");
                                    let n = 4 + commit.be(rec, 0, 4) + 64;
                                    k = 0;
                                    while k < n {
                                        hex_byte(io, int_of(rec[k]));
                                        k = k + 1;
                                    }
                                    putchar(io, '\n');
                                }
                            }
                        }
                        if session.state(fl[40..48]) == session.idle() {
                            put_str(io, "S I\n.\n");
                        } else if session.state(fl[40..48]) == session.open_txn() {
                            put_str(io, "S T\n.\n");
                        } else {
                            put_str(io, "S E\n.\n");
                        }
                    }
                }
                if !begins(all, ls, le, "!params ") {
                    exec.params_clear(w);
                }
                if pager.crashed(pg) {
                    // the crash point was reached (the test hook of src/pager.cho): nothing more is written, as if the process had died there
                    put_str(io, "crashed\n");
                    status = 6;
                }
                ls = le + 1;
            }
        }
    }
    unbox_slice(heap, roots);
    unbox_slice(heap, flags);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(tty);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    var status = 2;
    borrow fs as &fsr in {
        borrow args as &g in {
            if arg_count(g) == 2 || arg_count(g) == 4 {
                status = 3;
                match open_new(fsr, arg(g, 1)) {
                    Opened::Ok(nf) => {
                        file_close(nf);
                    }
                    Opened::Failed(e) => {
                    }
                }
                match open_rw(fsr, arg(g, 1)) {
                    Opened::Failed(e) => {
                        status = 4;
                    }
                    Opened::Ok(rf) => {
                        var f = rf;
                        var size = 0;
                        borrow mut f as &!fw in {
                            match file_size(fw) {
                                Done::Ok(n) => {
                                    size = n;
                                }
                                Done::Failed(e) => {
                                }
                            }
                        }
                        borrow mut heap as &!hh in {
                            var pg = pager.new_pager(hh, f, size);
                            if arg_count(g) == 4 {
                                var crash = 0;
                                var torn = 0;
                                var i = 0;
                                while i < len(arg(g, 2)) {
                                    crash = crash * 10 + int_of(arg(g, 2)[i]) - '0';
                                    i = i + 1;
                                }
                                i = 0;
                                while i < len(arg(g, 3)) {
                                    torn = torn * 10 + int_of(arg(g, 3)[i]) - '0';
                                    i = i + 1;
                                }
                                borrow mut pg as &!cq in {
                                    pager.set_crash(cq, crash, torn);
                                }
                            }
                            var wk = exec.new_work(hh);
                            var text = buffer.empty(hh, 4096);
                            borrow mut io as &!oo in {
                                text = read_stdin(hh, oo, text);
                            }
                            borrow text as &t in {
                                borrow mut io as &!oo in {
                                    borrow mut pg as &!pp in {
                                        borrow mut wk as &!ww in {
                                            // the seed of the salts (docs/m3-engine.md 6ag): 32 bytes from the system, kept nowhere
                                            region sr {
                                                let sd = alloc_slice[sr](32, byte_of(0));
                                                match open_read(fsr, "/dev/urandom") {
                                                    Opened::Ok(uf) => {
                                                        var u = uf;
                                                        borrow mut u as &!uw in {
                                                            match file_read(uw, sd) {
                                                                Read::Got(n) => {
                                                                    if n == 32 {
                                                                        exec.seed(ww, sd);
                                                                    }
                                                                }
                                                                Read::End => {
                                                                }
                                                                Read::Failed(e) => {
                                                                }
                                                            }
                                                        }
                                                        file_close(u);
                                                    }
                                                    Opened::Failed(e) => {
                                                    }
                                                }
                                            }
                                            var subs = drive.new(hh);
                                            borrow mut subs as &!sb in {
                                                status = run(hh, oo, pp, ww, sb, buffer.bytes(t));
                                            }
                                            drive.free(hh, subs);
                                        }
                                    }
                                }
                            }
                            buffer.drop(hh, text);
                            exec.drop_work(hh, wk);
                            pager.drop_pager(hh, pg);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(args);
    release(io);
    release(heap);
    return status;
}
