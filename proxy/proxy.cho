edition 9;

import std.buffer;
import std.conns;
import std.io;
import std.addr;
import std.bytes;
import cdb.commit;
import cdb.token;
import cdb.login;
import cdb.guard;
import cdb.snapshot;
import cdb.build;
import cdb.store;
import cdb.upstream;
import cdb.shared;
import cdb.commitpath;
import cdb.catalog;
import cdb.extended;

// `proxy` -- slice P0 of the cancho-db proxy (`docs/m1-proxy.md`): the front door in front of PostgreSQL.
//
//     proxy <listen port> <upstream host> <upstream port> <branch> <root key, 64 hex digits> <upstream user> <upstream database>
//
// A client connects, is asked for a password, and the password must be a capability token (`src/login.cho`, D1 and D2): it
// is checked against the root key and must allow the one branch this server serves. Only then does the proxy open a
// connection to PostgreSQL as the configured upstream role (trust login), relay the login to the client, and from there
// forward the server's messages untouched. The client's are cut into whole messages: a simple query is checked by the guard
// (`src/guard.cho`, docs/m1-lowering.md section 5.2) and only its rendering goes on; the extended protocol is refused.
//
// One thread, one poller, every connection in one `std.conns` table: the structure of `cancho-pg`'s `pooler/proxy.cho`
// (the same author and licence), with a handshake phase before a client is paired with its server connection. `cancho`'s
// `tcp_listen` binds every address, so "loopback only" (D1) is enforced where the connection is accepted: a peer that is
// not a loopback address is closed before a byte is read from it.
//
// One thing is blocking and is P0's stated limit: opening the connection to PostgreSQL (`tcp_connect`), which is fine for a
// local upstream and would stall the loop for a black-holed one. Its login answer is waited for at most `login_ms()`, and a
// client that does not finish its own login in `hello_ms()` is closed.

// ------------------------------------------------------------------------------------------------ the login

fn put_first(c: int) -> [] int {
    return c;
}

// Everything in client `k`'s login buffer that can be decided is decided: the startup packet (answering `SSLRequest` and
// `GSSENCRequest` with `N`), then the password. A refusal is sent and `k` closed; a good password makes it kind 5.
fn hello_progress[&t, &c, &k](tab: &!t conns.Table, core: &!c shared.Core, clk: &k Clock, k: int) -> [conn_write, poll, clock] int {
    let st = contents(core.state);
    let hb = contents(core.hbuf);
    let cfg = contents(core.cfg);
    let ci = contents(core.cfgi);
    let p = shared.stride() * k;
    let base = k * shared.hello_size();
    var going = true;
    while going && st[p] != 0 && st[p + 4] == 0 {
        going = false;
        if st[p] == 1 {
            // a startup-phase packet at the start of the buffer
            if st[p + 5] >= 4 {
                let bl = login.startup_body_len(hb[base..base + 4]);
                if bl < 0 {
                    shared.refuse(tab, core, k, "FATAL", "08P01", "startup-length", "invalid length of startup packet");
                } else if st[p + 5] >= 4 + bl {
                    region r {
                        let out = alloc_slice[r](6, 0);
                        let kind = login.parse_startup(hb[base + 4..base + 4 + bl], out);
                        if kind == login.kind_ssl() || kind == login.kind_gss() {
                            // plain only: answer N and take the next packet from where this one ended
                            let no = alloc_slice[r](1, byte_of('N'));
                            if shared.send(tab, core, k, no) {
                                var i = 0;
                                while i < st[p + 5] - 4 - bl {
                                    hb[base + i] = hb[base + 4 + bl + i];
                                    i = i + 1;
                                }
                                st[p + 5] = st[p + 5] - 4 - bl;
                                going = true;
                            }
                        } else if kind == login.kind_cancel() {
                            shared.shut(tab, core, k);
                        } else if kind == login.kind_startup() {
                            st[p + 6] = 4 + out[2];
                            st[p + 7] = out[3];
                            st[p + 8] = 0 - 1;
                            st[p + 9] = 0;
                            if out[4] >= 0 {
                                st[p + 8] = 4 + out[4];
                                st[p + 9] = out[5];
                            }
                            st[p + 10] = 4 + bl;
                            let ask = alloc_slice[r](9, byte_of(0));
                            let n = login.auth_cleartext(ask);
                            if shared.send(tab, core, k, ask[0..n]) {
                                st[p] = 2;
                                going = true;
                            }
                        } else if kind == login.err_version() {
                            shared.refuse(tab, core, k, "FATAL", "0A000", "unsupported-protocol", "only protocol 3.0 is supported");
                        } else {
                            shared.refuse(tab, core, k, "FATAL", "08P01", "startup-malformed", "invalid startup packet");
                        }
                    }
                }
            }
        } else if st[p] == 2 {
            let h0 = st[p + 10];
            if st[p + 5] >= h0 + 5 {
                let ln = commit.be(hb, base + h0 + 1, 4);
                if int_of(hb[base + h0]) != 'p' || ln < 5 || h0 + 1 + ln > shared.hello_size() {
                    shared.refuse(tab, core, k, "FATAL", "08P01", "password-malformed", "expected a password message");
                } else if st[p + 5] >= h0 + 1 + ln {
                    let text = hb[base + h0 + 5..base + h0 + 1 + ln - 1];
                    if int_of(hb[base + h0 + ln]) != 0 {
                        shared.refuse(tab, core, k, "FATAL", "08P01", "password-malformed", "password is not terminated");
                    } else {
                        region r {
                            let blob = alloc_slice[r](len(text) + 4, byte_of(0));
                            let n = login.decode_b64url(text, blob);
                            var rule = login.login_bad_token();
                            if n >= 0 {
                                var now = 0;
                                now = clock_unix_ms(clk);
                                let database = hb[base + st[p + 6]..base + st[p + 6] + st[p + 7]];
                                rule = login.check(blob[0..n], database, cfg[32 + ci[0]..32 + ci[0] + ci[1]], cfg[0..32], now / 4294967296, now % 4294967296);
                            }
                            if rule != login.login_ok() {
                                shared.refuse(tab, core, k, "FATAL", login.sqlstate(rule), login.rule_name(rule), "the capability token was refused");
                            } else if n - 32 > shared.token_max() || n - 32 < 8 {
                                shared.refuse(tab, core, k, "FATAL", "28000", "login-token-size", "the capability token is too large to keep");
                            } else {
                                // the token without the seed of its last key is what the guard checks each query against
                                let tk = contents(core.tokb);
                                var q = 0;
                                while q < n - 32 {
                                    tk[k * shared.token_max() + q] = blob[q];
                                    q = q + 1;
                                }
                                st[p + 12] = n - 32;
                                st[p] = 5;
                                st[p + 4] = 0;
                                shared.settle(tab, core, k);
                            }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

// Client `k` (kind 1 or 2) has something to read.
fn hello_read[&t, &c, &k](tab: &!t conns.Table, core: &!c shared.Core, clk: &k Clock, k: int) -> [conn_read, conn_write, poll, clock] int {
    let st = contents(core.state);
    let hb = contents(core.hbuf);
    let p = shared.stride() * k;
    let base = k * shared.hello_size();
    if st[p + 5] >= shared.hello_size() {
        shared.refuse(tab, core, k, "FATAL", "08P01", "login-too-long", "login message too long");
        return 0;
    }
    match conns.read(tab, k, hb[base + st[p + 5]..base + shared.hello_size()]) {
        Received::Data(got) => {
            st[p + 5] = st[p + 5] + got;
            hello_progress(tab, core, clk, k);
        }
        Received::End => {
            shared.shut(tab, core, k);
        }
        Received::Again => {
        }
        Received::Failed(e) => {
            shared.shut(tab, core, k);
        }
    }
    return 0;
}

// ------------------------------------------------------------------------------------------------ the client's messages

// Cut whole messages off the front of client `k`'s buffer until a simple query is there (for the guard) or no whole message
// is. Terminate goes to PostgreSQL; the extended protocol is refused (`0A000`): the error is answered at once, the messages up
// to the next Sync are discarded as PostgreSQL itself would, and Sync is answered `ReadyForQuery`.
fn frame_client[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let mb = contents(core.mbuf);
    let p = shared.stride() * k;
    let base = k * shared.msg_max();
    var going = true;
    while going && st[p] == 3 && st[p + 14] == 0 {
        going = false;
        if st[p + 13] >= 5 {
            let ty = int_of(mb[base]);
            let ln = commit.be(mb, base + 1, 4);
            if ln < 4 || ln + 1 > shared.msg_max() {
                shared.refuse(tab, core, k, "FATAL", "08P01", "message-too-long", "a message is longer than the proxy will hold");
            } else if st[p + 13] >= ln + 1 {
                if ty == 'Q' {
                    st[p + 14] = 1;
                } else if ty == 'X' {
                    shared.send(tab, core, st[p + 1], mb[base..base + ln + 1]);
                    shared.consume(core, k, ln + 1);
                    going = st[p] == 3;
                } else if ty == 'P' || ty == 'B' || ty == 'E' || ty == 'D' || ty == 'C' || ty == 'S' || ty == 'H' {
                    // the extended protocol (src/extended.cho): after an error every message up to `Sync` is discarded, `Sync` itself is acted on
                    if st[p + 15] != 0 && ty != 'S' {
                        shared.consume(core, k, ln + 1);
                        going = st[p] == 3;
                    } else {
                        st[p + 14] = 1;
                    }
                } else if ty == 'F' || ty == 'd' || ty == 'c' || ty == 'f' {
                    // a function call and COPY are not supported: one error, the messages up to `Sync` discarded, `Sync` answered
                    if st[p + 15] == 0 {
                        region r {
                            let buf = alloc_slice[r](640, byte_of(0));
                            let n = login.error_response(buf, "ERROR", "0A000", "unsupported-message", "this message of the protocol is not supported");
                            shared.send(tab, core, k, buf[0..n]);
                        }
                        st[p + 15] = 1;
                    }
                    shared.consume(core, k, ln + 1);
                    going = st[p] == 3;
                } else {
                    shared.refuse(tab, core, k, "FATAL", "08P01", "protocol-violation", "unexpected frontend message");
                }
            }
        }
    }
    shared.settle(tab, core, k);
    return 0;
}

// Client `k` (paired) can be read: take what it has sent into its message buffer, and act on whole messages.
fn client_read[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let mb = contents(core.mbuf);
    let p = shared.stride() * k;
    let base = k * shared.msg_max();
    match conns.read(tab, k, mb[base + st[p + 13]..base + shared.msg_max()]) {
        Received::Data(got) => {
            st[p + 13] = st[p + 13] + got;
            frame_client(tab, core, k);
        }
        Received::End => {
            shared.finish(tab, core, k);
        }
        Received::Again => {
        }
        Received::Failed(e) => {
            shared.finish(tab, core, k);
        }
    }
    return 0;
}

// ------------------------------------------------------------------------------------------------ accepting and pairing

// Whether the peer of the connection in `slot` is a loopback address: 127.0.0.0/8 or ::1.
fn is_loopback[&t](tab: &!t conns.Table, slot: int) -> [] bool {
    match conns.peer(tab, slot) {
        conns.Peered::Known(who) => {
            return login.is_loopback(who);
        }
        conns.Peered::Unavailable(e) => {
            return false;
        }
    }
}

// Take every client waiting on the listener: loopback ones start their login, others are closed unread.
fn accept_all[&h, &l, &c, &k](heap: &!h Heap, conn: conns.Table, listener: &!l Listener, core: &!c shared.Core, clk: &k Clock) -> [heap, conn_accept, poll, clock] conns.Table {
    let st = contents(core.state);
    var table = conn;
    var more = true;
    while more {
        match tcp_accept(listener) {
            Accepted::Ok(client) => {
                var held = 0;
                borrow table as &tt in {
                    held = conns.live(tt);
                }
                if held + 2 > 2 * shared.max_clients() {
                    conn_close(client);
                } else {
                    let (t1, a) = conns.put(heap, table, client);
                    table = t1;
                    if a >= 0 {
                        borrow mut table as &!ct in {
                            if !is_loopback(ct, a) {
                                conns.close(ct, a);
                            } else {
                                let p = shared.stride() * a;
                                st[p] = 1;
                                st[p + 1] = 0 - 1;
                                st[p + 2] = 0;
                                st[p + 3] = 1;
                                st[p + 4] = 0;
                                st[p + 5] = 0;
                                st[p + 12] = 0;
                                st[p + 13] = 0;
                                st[p + 14] = 0;
                                st[p + 15] = 0;
                                st[p + 16] = 0;
                                st[p + 17] = 0;
                                st[p + 18] = 0;
                                st[p + 19] = 0;
                                st[p + 20] = 0;
                                st[p + 21] = 0;
                                st[p + 22] = 0;
                                st[p + 11] = clock_ms(clk);
                                if conns.nonblocking(ct, a) != 0 || conns.nodelay(ct, a) != 0 || conns.watch(ct, core.poller, a, a + 1, 1) != 0 {
                                    shared.shut(ct, core, a);
                                }
                            }
                        }
                    }
                }
            }
            Accepted::Again => {
                more = false;
            }
            Accepted::Failed(e) => {
                more = false;
            }
        }
    }
    return table;
}

// Open the connection to PostgreSQL for client `k` (kind 5), log in to it (trust), and pair them. Blocking, and the one
// place that is: PostgreSQL is local and trusted (docs/m1-proxy.md section 3, P0's limit). The server's login answer is
// relayed to the client as it is.
fn pair_one[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c shared.Core, net: &n Net(""), host: &n [byte], port: int, k: int) -> [heap, net_out(""), conn_read, conn_write, poll] conns.Table {
    let st = contents(core.state);
    let cfg = contents(core.cfg);
    let ci = contents(core.cfgi);
    let hb = contents(core.hbuf);
    let rb = contents(core.rbuf);
    let p = shared.stride() * k;
    var table = tab;
    var failed = 0;
    var detail = 0;
    match tcp_connect(net, host, port) {
        Dialed::Ok(server) => {
            let (t1, b) = conns.put(heap, table, server);
            table = t1;
            if b < 0 {
                failed = 1;
            } else {
                // StartupMessage, protocol 3.0, as the configured role: the client chooses nothing about this session
                region r {
                    let msg = alloc_slice[r](1024, byte_of(0));
                    var at = 8;
                    at = upstream.put_cstr(msg, at, "user");
                    at = upstream.put_cstr(msg, at, cfg[32 + ci[2]..32 + ci[2] + ci[3]]);
                    at = upstream.put_cstr(msg, at, "database");
                    at = upstream.put_cstr(msg, at, cfg[32 + ci[4]..32 + ci[4] + ci[5]]);
                    at = upstream.put_cstr(msg, at, "application_name");
                    if st[p + 8] >= 0 && at + st[p + 9] + 4 < 1000 {
                        at = upstream.put_cstr(msg, at, hb[k * shared.hello_size() + st[p + 8]..k * shared.hello_size() + st[p + 8] + st[p + 9]]);
                    } else {
                        at = upstream.put_cstr(msg, at, "cancho-db");
                    }
                    msg[at] = byte_of(0);
                    at = at + 1;
                    msg[0] = byte_of(at / 16777216 % 256);
                    msg[1] = byte_of(at / 65536 % 256);
                    msg[2] = byte_of(at / 256 % 256);
                    msg[3] = byte_of(at % 256);
                    msg[4] = byte_of(0);
                    msg[5] = byte_of(3);
                    msg[6] = byte_of(0);
                    msg[7] = byte_of(0);
                    borrow mut table as &!tw in {
                        var sent = 0;
                        while sent < at && failed == 0 {
                            match conns.write(tw, b, msg[sent..at]) {
                                Sent::Wrote(x) => {
                                    sent = sent + x;
                                }
                                Sent::Again => {
                                }
                                Sent::Failed(e) => {
                                    failed = 1;
                                }
                            }
                        }
                    }
                }
                // read PostgreSQL's answer up to and including ReadyForQuery
                var fill = 0;
                var done = false;
                while failed == 0 && !done {
                    var got = 0 - 1;
                    borrow mut table as &!tw in {
                        got = upstream.login_read(tw, b, rb[fill..shared.relay_max()], shared.login_ms());
                    }
                    if got < 0 {
                        failed = 1;
                    } else if got == 0 {
                        failed = 4;
                    } else {
                        fill = fill + got;
                    }
                    var pos = 0;
                    var more = true;
                    var first = true;
                    while more && failed == 0 && !done {
                        if pos + 5 > fill {
                            more = false;
                        } else {
                            let ln = commit.be(rb, pos + 1, 4);
                            if ln < 4 || ln > shared.relay_max() {
                                failed = 1;
                            } else if pos + 1 + ln > fill {
                                more = false;
                            } else {
                                let t = int_of(rb[pos]);
                                if t == 'R' && pos == 0 && commit.be(rb, 5, 4) != 0 {
                                    failed = 2;
                                } else if t == 'E' {
                                    failed = 3;
                                } else if t == 'Z' {
                                    done = true;
                                }
                                pos = pos + 1 + ln;
                            }
                        }
                    }
                    if fill >= shared.relay_max() && !done {
                        failed = 1;
                    }
                }
                if failed == 0 {
                    // pair: the relay goes to the client, and from here both are forwarded
                    let q = shared.stride() * b;
                    st[q] = 3;
                    st[q + 1] = k;
                    st[q + 2] = 0;
                    st[q + 3] = 0;
                    st[q + 4] = 0;
                    st[q + 12] = 0 - 1;
                    st[q + 13] = 0;
                    st[q + 14] = 0;
                    st[q + 15] = 0;
                    st[q + 16] = 0;
                    st[q + 17] = 0;
                    st[q + 18] = 0;
                    st[q + 19] = 0;
                    st[q + 20] = 0;
                    st[q + 21] = 0;
                    st[q + 22] = 0;
                    st[p] = 3;
                    st[p + 1] = b;
                    st[p + 13] = 0;
                    st[p + 14] = 0;
                    st[p + 15] = 0;
                    st[p + 16] = 0;
                    st[p + 17] = 0;
                    st[p + 18] = 0;
                    extended.reset(core, k);
                    borrow mut table as &!ct in {
                        if conns.nonblocking(ct, b) != 0 || conns.nodelay(ct, b) != 0 || conns.watch(ct, core.poller, b, b + 1, 1) != 0 {
                            shared.shut(ct, core, b);
                            shared.shut(ct, core, k);
                        } else {
                            st[q + 3] = 1;
                            shared.send(ct, core, k, rb[0..fill]);
                            shared.settle(ct, core, k);
                        }
                    }
                } else {
                    // PostgreSQL did not accept the proxy's own login (or answered with an error): the client is told, and
                    // an error PostgreSQL sent is relayed as it is.
                    detail = b;
                    borrow mut table as &!ct in {
                        conns.close(ct, b);
                        if failed == 3 {
                            if shared.send(ct, core, k, rb[0..fill]) {
                                shared.close_after(ct, core, k);
                            }
                        } else if failed == 2 {
                            shared.refuse(ct, core, k, "FATAL", "28000", "upstream-auth-unsupported", "the database requires a password the proxy does not have");
                        } else if failed == 4 {
                            shared.refuse(ct, core, k, "FATAL", "08006", "upstream-timeout", "the database did not answer in time");
                        } else {
                            shared.refuse(ct, core, k, "FATAL", "08006", "upstream-unavailable", "the database closed the connection during login");
                        }
                    }
                }
            }
        }
        Dialed::Failed(e) => {
            borrow mut table as &!ct in {
                shared.refuse(ct, core, k, "FATAL", "08006", "upstream-unavailable", "cannot reach the database");
            }
        }
    }
    if failed == 1 && st[p] == 5 {
        borrow mut table as &!ct in {
            shared.refuse(ct, core, k, "FATAL", "08006", "upstream-unavailable", "cannot reach the database");
        }
    }
    return table;
}

// Pair every client whose login has been accepted.
fn pair_all[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c shared.Core, net: &n Net(""), host: &n [byte], port: int) -> [heap, net_out(""), conn_read, conn_write, poll] conns.Table {
    var table = tab;
    var k = 0;
    while k < 2 * shared.max_clients() {
        let kind = contents(core.state)[shared.stride() * k];
        if kind == 5 {
            table = pair_one(heap, table, core, net, host, port, k);
        }
        k = k + 1;
    }
    return table;
}

// ------------------------------------------------------------------------------------------------ the guard

// ------------------------------------------------------------------------------------------------ transactions

// The statement of client `client` has finished on upstream connection `k`, which the proxy had wrapped in a transaction of its
// own (the client was in autocommit): make it permanent and tell the client, now. The held `CommandComplete` messages are
// released only if the commit succeeded; a statement that failed is rolled back and the client has the error already.
fn finish_autocommit[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, client: int) -> [conn_read, conn_write, poll, file_write] int {
    let st = contents(core.state);
    let hd = contents(core.hold);
    let q = shared.stride() * k;
    let cp = shared.stride() * client;
    let failed = st[q + 22] == 1;
    st[q + 21] = 0;
    st[q + 22] = 0;
    st[cp + 17] = 0;
    contents(core.xi)[8 * client] = 0;
    var r = 0;
    if failed {
        r = commitpath.upstream_exec(tab, core, k, "ROLLBACK");
        commitpath.reset(core, client);
    } else {
        r = commitpath.conclude(tab, core, client);
    }
    if r < 0 {
        contents(core.aux)[2] = 1;
        shared.finish(tab, core, k);
        return 0;
    }
    if !failed && r == 1 {
        st[cp + 18] = 0;
        shared.answer_error(tab, core, client, 73, "40000", "commit-failed", "the database refused to commit the statement");
        return 0;
    }
    if !failed && r == 2 {
        st[cp + 18] = 0;
        shared.answer_error(tab, core, client, 73, "58000", "log-unavailable", "the commit could not be written to the log, so it was rolled back");
        return 0;
    }
    if !failed && r == 3 {
        st[cp + 18] = 0;
        shared.answer_error(tab, core, client, 73, "54000", "transaction-too-large", "the statement changed more rows than one commit can record, so it was rolled back");
        return 0;
    }
    if !failed && st[cp + 18] > 0 {
        shared.send(tab, core, client, hd[client * shared.hold_max()..client * shared.hold_max() + st[cp + 18]]);
    }
    st[cp + 18] = 0;
    region z {
        let rq = alloc_slice[z](8, byte_of(0));
        let n = login.ready_for_query(rq, 'I');
        shared.send(tab, core, client, rq[0..n]);
    }
    return 0;
}

// The upstream side `k` of a pair has sent `got` bytes (in `rbuf`). Messages are relayed to the client as they come, in pieces if
// need be, except the ones the proxy acts on: `CommandComplete` (held while the statement is an autocommit one) and
// `ReadyForQuery` (which ends it, and carries the transaction status the proxy keeps).
fn relay_server[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, got: int) -> [conn_read, conn_write, poll, file_write] int {
    let st = contents(core.state);
    let rb = contents(core.rbuf);
    let sb = contents(core.sbuf);
    let hd = contents(core.hold);
    let xi = contents(core.xi);
    let q = shared.stride() * k;
    let client = st[q + 1];
    let cp = shared.stride() * client;
    var pos = 0;
    while pos < got && st[q] == 3 && st[cp] == 3 {
        if st[q + 20] > 0 {
            // inside a message that is relayed as it comes
            var n = got - pos;
            if n > st[q + 20] {
                n = st[q + 20];
            }
            if !shared.send(tab, core, client, rb[pos..pos + n]) {
                shared.finish(tab, core, k);
                return 0;
            }
            st[q + 20] = st[q + 20] - n;
            pos = pos + n;
            if st[q + 20] == 0 && xi[8 * client + 2] == 1 {
                // the message that completes what the client asked for has gone to it whole: the next client message may be acted on
                xi[8 * client + 2] = 0;
                xi[8 * client] = 0;
                st[cp + 17] = 0;
            }
        } else {
            // at a message boundary: collect the five bytes of its header
            while st[q + 19] < 5 && pos < got {
                sb[k * shared.sbuf_max() + st[q + 19]] = rb[pos];
                st[q + 19] = st[q + 19] + 1;
                pos = pos + 1;
            }
            if st[q + 19] >= 5 {
                let ty = int_of(sb[k * shared.sbuf_max()]);
                let ln = commit.be(sb, k * shared.sbuf_max() + 1, 4);
                if ln < 4 {
                    shared.finish(tab, core, k);
                    return 0;
                }
                if ty == 'C' || ty == 'Z' {
                    // small and acted on: collect it whole
                    if ln + 1 > shared.sbuf_max() {
                        shared.finish(tab, core, k);
                        return 0;
                    }
                    while st[q + 19] < ln + 1 && pos < got {
                        sb[k * shared.sbuf_max() + st[q + 19]] = rb[pos];
                        st[q + 19] = st[q + 19] + 1;
                        pos = pos + 1;
                    }
                    if st[q + 19] >= ln + 1 {
                        let whole = sb[k * shared.sbuf_max()..k * shared.sbuf_max() + ln + 1];
                        st[q + 19] = 0;
                        if ty == 'C' && xi[8 * client] == 4 {
                            // an Execute is complete (the tag is held or relayed below)
                            xi[8 * client] = 0;
                            st[cp + 17] = 0;
                        }
                        if ty == 'C' && st[q + 21] == 1 {
                            // held: the client is told only when the statements are permanent. Only the NEWEST tag is held: an older one is
                            // released now, in its place (a message of two statements with rows is `T D C T D C Z`, not `T D T D C C Z`)
                            if st[cp + 18] > 0 {
                                if !shared.send(tab, core, client, hd[client * shared.hold_max()..client * shared.hold_max() + st[cp + 18]]) {
                                    shared.finish(tab, core, k);
                                    return 0;
                                }
                                st[cp + 18] = 0;
                            }
                            if st[cp + 18] + len(whole) > shared.hold_max() {
                                shared.finish(tab, core, k);
                                return 0;
                            }
                            var i = 0;
                            while i < len(whole) {
                                hd[client * shared.hold_max() + st[cp + 18] + i] = whole[i];
                                i = i + 1;
                            }
                            st[cp + 18] = st[cp + 18] + len(whole);
                        } else if ty == 'Z' && st[q + 21] == 1 {
                            finish_autocommit(tab, core, k, client);
                        } else {
                            if ty == 'Z' {
                                // the transaction state the server says it is in, which the proxy keeps
                                let status = int_of(whole[5]);
                                st[cp + 17] = 0;
                                xi[8 * client] = 0;
                                if status == 'I' {
                                    st[cp + 16] = 0;
                                } else if status == 'T' {
                                    st[cp + 16] = 1;
                                } else {
                                    st[cp + 16] = 2;
                                }
                            }
                            if !shared.send(tab, core, client, whole) {
                                shared.finish(tab, core, k);
                                return 0;
                            }
                        }
                    }
                } else {
                    if ty == 'E' && st[q + 21] == 1 {
                        st[q + 22] = 1;
                    }
                    // what completes the extended-protocol message in flight (src/extended.cho)
                    var completes = false;
                    let cls = xi[8 * client];
                    if cls == 1 && ty == '1' || cls == 2 && ty == '2' || cls == 3 && (ty == 'n' || ty == 'T') || cls == 5 && ty == '3' || cls == 4 && (ty == 's' || ty == 'I') {
                        completes = true;
                    }
                    if ty == 'E' && cls > 0 {
                        // the server's error: it discards what follows up to `Sync`, and so does the proxy; a statement that failed to parse is not there
                        completes = true;
                        st[cp + 15] = 2;
                        if cls == 1 && xi[8 * client + 1] >= 0 {
                            contents(core.xstm)[client * shared.x_stmts() * shared.x_stmt_rec() + xi[8 * client + 1] * shared.x_stmt_rec()] = byte_of(0);
                        }
                    }
                    if completes {
                        if ln == 4 {
                            xi[8 * client] = 0;
                            st[cp + 17] = 0;
                        } else {
                            xi[8 * client + 2] = 1;
                        }
                    }
                    if st[q + 21] == 1 && st[cp + 18] > 0 {
                        // anything that follows a held tag releases it first, so the client sees the server's order
                        if !shared.send(tab, core, client, hd[client * shared.hold_max()..client * shared.hold_max() + st[cp + 18]]) {
                            shared.finish(tab, core, k);
                            return 0;
                        }
                        st[cp + 18] = 0;
                    }
                    if !shared.send(tab, core, client, sb[k * shared.sbuf_max()..k * shared.sbuf_max() + 5]) {
                        shared.finish(tab, core, k);
                        return 0;
                    }
                    st[q + 19] = 0;
                    st[q + 20] = ln - 4;
                }
            }
        }
    }
    return 0;
}

// Upstream connection `k` of a pair can be read.
fn server_read[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int) -> [conn_read, conn_write, poll, file_write] int {
    let rb = contents(core.rbuf);
    match conns.read(tab, k, rb[0..shared.chunk()]) {
        Received::Data(got) => {
            relay_server(tab, core, k, got);
        }
        Received::End => {
            shared.finish(tab, core, k);
        }
        Received::Again => {
        }
        Received::Failed(e) => {
            shared.finish(tab, core, k);
        }
    }
    return 0;
}

// The poller said connection `k` is ready.
fn step[&t, &c, &k](tab: &!t conns.Table, core: &!c shared.Core, clk: &k Clock, k: int, readiness: int) -> [conn_read, conn_write, poll, clock, file_write] int {
    let st = contents(core.state);
    let p = shared.stride() * k;
    if readiness % 4 >= 2 && st[p + 2] > 0 {
        shared.drain(tab, core, k);
    }
    if st[p] != 0 && readiness % 2 == 1 {
        if st[p] == 1 || st[p] == 2 {
            if st[p + 4] == 0 {
                hello_read(tab, core, clk, k);
            } else {
                shared.shut(tab, core, k);
            }
        } else if st[p] == 3 {
            if st[p + 3] % 2 == 1 {
                if st[p + 12] > 0 {
                    client_read(tab, core, k);
                } else {
                    server_read(tab, core, k);
                }
            } else {
                shared.finish(tab, core, k);
            }
        }
    }
    return 0;
}

// The client's BEGIN, COMMIT or ROLLBACK, which the proxy answers itself from its own record of the client's transaction, after
// doing what it means upstream. (A COMMIT of a failed transaction is a ROLLBACK, as in PostgreSQL.) `BEGIN` inside a transaction is
// an error here where PostgreSQL only warns, and COMMIT or ROLLBACK with none open is answered with no warning: both stated in
// docs/m1-commit-path.md.
fn transaction_control[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, kind: int) -> [conn_read, conn_write, poll, file_write] int {
    let st = contents(core.state);
    let p = shared.stride() * k;
    let b = st[p + 1];
    let ts = st[p + 16];
    if kind == 1 {
        if ts == 0 {
            let r = commitpath.upstream_exec(tab, core, b, "BEGIN");
            if r != 0 {
                shared.answer_error(tab, core, k, 73, "08006", "upstream-unavailable", "the database could not begin a transaction");
                return 0;
            }
            st[p + 16] = 1;
            shared.answer_tag(tab, core, k, 'T', "BEGIN");
        } else if ts == 1 {
            shared.answer_error(tab, core, k, 'T', "25001", "transaction-in-progress", "there is already a transaction in progress");
        } else {
            shared.answer_error(tab, core, k, 'E', "25P02", "in-failed-transaction", "current transaction is aborted, commands ignored until end of transaction block");
        }
        return 0;
    }
    if ts == 0 {
        if kind == 2 {
            shared.answer_tag(tab, core, k, 'I', "COMMIT");
        } else {
            shared.answer_tag(tab, core, k, 'I', "ROLLBACK");
        }
        return 0;
    }
    let committing = kind == 2 && ts == 1;
    var r = 0;
    if committing {
        r = commitpath.conclude(tab, core, k);
    } else {
        r = commitpath.upstream_exec(tab, core, b, "ROLLBACK");
        commitpath.reset(core, k);
    }
    st[p + 16] = 0;
    if r < 0 {
        contents(core.aux)[2] = 1;
        shared.finish(tab, core, k);
    } else if r == 1 {
        shared.answer_error(tab, core, k, 73, "40000", "commit-failed", "the database refused to commit the transaction");
    } else if r == 2 {
        shared.answer_error(tab, core, k, 73, "58000", "log-unavailable", "the commit could not be written to the log, so it was rolled back");
    } else if r == 3 {
        shared.answer_error(tab, core, k, 73, "54000", "transaction-too-large", "the transaction changed more rows than one commit can record, so it was rolled back");
    } else if committing {
        shared.answer_tag(tab, core, k, 'I', "COMMIT");
    } else {
        shared.answer_tag(tab, core, k, 'I', "ROLLBACK");
    }
    return 0;
}

// A statement the guard refused. Inside a transaction that aborts it, as an error would in PostgreSQL: the proxy rolls the
// upstream transaction back at once (its locks go with it) and the client is `E` until its own ROLLBACK.
fn refused_query[&t, &c, &v](tab: &!t conns.Table, core: &!c shared.Core, k: int, vd: &v [int]) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let p = shared.stride() * k;
    let ts = st[p + 16];
    if ts == 1 {
        commitpath.upstream_exec(tab, core, st[p + 1], "ROLLBACK");
        commitpath.reset(core, k);
        st[p + 16] = 2;
    }
    var status = 'E';
    if ts == 0 {
        status = 'I';
    }
    shared.answer_error(tab, core, k, status, guard.sqlstate(vd), guard.tag(vd), "the statement was not run");
    return 0;
}

// A statement the guard allowed but a commit cannot hold (`commitpath.add`'s 1 and 2): refused as a failed statement is, which aborts a
// transaction it is in.
fn refuse_unrecordable[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, why: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let p = shared.stride() * k;
    let ts = st[p + 16];
    if ts == 1 {
        commitpath.upstream_exec(tab, core, st[p + 1], "ROLLBACK");
        st[p + 16] = 2;
    }
    commitpath.reset(core, k);
    var status = 'E';
    if ts == 0 {
        status = 'I';
    }
    if why == 1 {
        shared.answer_error(tab, core, k, status, "54000", "transaction-too-large", "the transaction is larger than one commit can record");
    } else {
        shared.answer_error(tab, core, k, status, "0A000", "nondeterministic", "now() and the like are not recorded in a commit yet, so the statement was not run");
    }
    return 0;
}

// An allowed statement, rendered into `core.rend` (`rl` bytes): sent upstream as it is inside a transaction; in autocommit the
// proxy opens a transaction first, and `finish_autocommit` ends it when the statement has. In a failed transaction nothing is sent.
fn run_query[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, rl: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let p = shared.stride() * k;
    let b = st[p + 1];
    let ts = st[p + 16];
    if ts == 2 {
        shared.answer_error(tab, core, k, 'E', "25P02", "in-failed-transaction", "current transaction is aborted, commands ignored until end of transaction block");
        return 0;
    }
    if ts == 0 {
        let r = commitpath.upstream_exec(tab, core, b, "BEGIN");
        if r != 0 {
            shared.answer_error(tab, core, k, 73, "08006", "upstream-unavailable", "the database could not begin a transaction");
            return 0;
        }
        st[shared.stride() * b + 21] = 1;
        st[shared.stride() * b + 22] = 0;
        st[p + 18] = 0;
    }
    let out = contents(core.qout);
    let total = rl + 6;
    out[0] = byte_of('Q');
    out[1] = byte_of((rl + 5) / 16777216 % 256);
    out[2] = byte_of((rl + 5) / 65536 % 256);
    out[3] = byte_of((rl + 5) / 256 % 256);
    out[4] = byte_of((rl + 5) % 256);
    var i = 0;
    while i < rl {
        out[5 + i] = contents(core.rend)[i];
        i = i + 1;
    }
    out[5 + rl] = byte_of(0);
    st[p + 17] = 1;
    shared.send(tab, core, b, out[0..total]);
    return 0;
}

// Client `k` has a whole simple query waiting: ask the catalog, run the guard, and either send PostgreSQL the guard's rendering
// or tell the client it is refused.
fn serve_one[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c shared.Core, net: &n Net(""), host: &n [byte], port: int, k: int) -> [heap, net_out(""), conn_read, conn_write, poll, file_write] conns.Table {
    let st = contents(core.state);
    let mb = contents(core.mbuf);
    let p = shared.stride() * k;
    let base = k * shared.msg_max();
    let ln = commit.be(mb, base + 1, 4);
    var table = tab;
    if int_of(mb[base]) != 'Q' {
        // the extended protocol: one message
        table = extended.handle(heap, table, core, net, host, port, k);
        if st[p] == 3 {
            shared.consume(core, k, ln + 1);
            st[p + 14] = 0;
            borrow mut table as &!tw in {
                frame_client(tw, core, k);
            }
        }
        return table;
    }
    if int_of(mb[base + ln]) != 0 {
        borrow mut table as &!tw in {
            shared.refuse(tw, core, k, "FATAL", "08P01", "protocol-violation", "a query is not terminated");
        }
        return table;
    }
    let sql = mb[base + 5..base + ln];
    let (t1, snap_len) = catalog.read_snapshot(heap, table, core, net, host, port);
    table = t1;
    // the transaction state the client is in decides what is said, and what is sent
    let ts = st[p + 16];
    var status = 'E';
    if ts == 0 {
        status = 'I';
    } else if ts == 1 {
        status = 'T';
    }
    if snap_len < 0 {
        borrow mut table as &!tw in {
            shared.answer_error(tw, core, k, status, "08006", "catalog-unavailable", "the schema could not be read, so the query was not checked");
        }
    } else {
        region r {
            let vd = alloc_slice[r](16, 0);
            let ids = alloc_slice[r](512, byte_of(0));
            let irs = alloc_slice[r](16384, byte_of(0));
            let effs = alloc_slice[r](8192, byte_of(0));
            let verdict = guard.check(heap, contents(core.tokb)[k * shared.token_max()..k * shared.token_max() + st[p + 12]], contents(core.snap)[0..snap_len], sql, contents(core.rend), vd, ids, irs, effs);
            borrow mut table as &!tw in {
                if verdict != 0 {
                    refused_query(tw, core, k, vd);
                } else if vd[6] > 0 {
                    if vd[6] == 1 && ts == 0 {
                        commitpath.begin(core, k, contents(core.snap)[0..snap_len]);
                    }
                    transaction_control(tw, core, k, vd[6]);
                } else if ts == 2 {
                    run_query(tw, core, k, vd[3]);
                } else {
                    if ts == 0 {
                        commitpath.begin(core, k, contents(core.snap)[0..snap_len]);
                    }
                    let added = commitpath.add(core, k, vd[7], ids, irs[0..vd[8]], effs[0..vd[9]]);
                    if added == 0 {
                        run_query(tw, core, k, vd[3]);
                    } else {
                        refuse_unrecordable(tw, core, k, added);
                    }
                }
            }
        }
    }
    if st[p] == 3 {
        shared.consume(core, k, ln + 1);
        st[p + 14] = 0;
        borrow mut table as &!tw in {
            frame_client(tw, core, k);
        }
    }
    return table;
}

// Serve every client that has a whole simple query waiting, until none has.
fn serve_all[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c shared.Core, net: &n Net(""), host: &n [byte], port: int) -> [heap, net_out(""), conn_read, conn_write, poll, file_write] conns.Table {
    var table = tab;
    var again = true;
    while again {
        again = false;
        var k = 0;
        while k < 2 * shared.max_clients() {
            let st = contents(core.state);
            if st[shared.stride() * k] == 3 && st[shared.stride() * k + 14] == 1 && st[shared.stride() * k + 17] == 0 {
                table = serve_one(heap, table, core, net, host, port, k);
                again = true;
            }
            k = k + 1;
        }
    }
    return table;
}

// Close clients that have taken too long over their login.
fn sweep[&t, &c, &k](tab: &!t conns.Table, core: &!c shared.Core, clk: &k Clock) -> [clock] int {
    let st = contents(core.state);
    let now = clock_ms(clk);
    var k = 0;
    while k < 2 * shared.max_clients() {
        let p = shared.stride() * k;
        if (st[p] == 1 || st[p] == 2) && now - st[p + 11] > shared.hello_ms() {
            shared.shut(tab, core, k);
        }
        k = k + 1;
    }
    return 0;
}

fn run[&h, &l, &n, &k, &o](heap: &!h Heap, io: &!o Io, listener: &!l Listener, net: &n Net(""), clk: &k Clock, host: &n [byte], port: int, cfg: Box[[byte]], cfgi: Box[[int]], kept: shared.Store) -> [heap, err_write, conn_accept, conn_read, conn_write, net_out(""), poll, clock, file_write] int {
    match poller_new() {
        Polling::Ok(p) => {
            var poller = p;
            borrow mut poller as &!pw in {
                poller_add_listener(pw, listener, 0);
            }
            let slots = 2 * shared.max_clients();
            var core = shared.new_core(heap, poller, cfg, cfgi, kept, slots);
            var tab = conns.empty(heap, 64);
            // settle what a crash left before anything is served (P2-D11)
            var recovered = 0 - 1;
            borrow mut core as &!cw in {
                let (t0, rs) = catalog.recover(heap, tab, cw, net, host, port);
                tab = t0;
                recovered = rs;
                if rs == 0 {
                    let aux = contents(cw.aux);
                    if aux[3] + aux[4] + aux[5] > 0 {
                        io.error_all(io, "proxy: recovery: committed ");
                        err_nat(io, aux[3]);
                        io.error_all(io, ", rolled back ");
                        err_nat(io, aux[4]);
                        io.error_all(io, ", left alone ");
                        err_nat(io, aux[5]);
                        io.error_all(io, " prepared transaction(s)\n");
                    }
                    // the row-delta capture is installed before anything is served (docs/m2-branches.md D14, D15)
                    var ir = 0 - 1;
                    borrow mut tab as &!tw in {
                        ir = catalog.install_capture(tw, cw, aux[0]);
                    }
                    if ir != 0 {
                        recovered = 7;
                        if ir == 1 {
                            let at = commitpath.first_text_at(contents(cw.snapin));
                            io.error_all(io, "proxy: these tables cannot be tracked by the row-delta capture (a primary key is needed, and partitioned tables are not supported): ");
                            io.error_all(io, contents(cw.snapin)[at..at + commit.be(contents(cw.snapin), at - 4, 4)]);
                            io.error_all(io, "\n");
                        } else if ir >= 10 {
                            io.error_all(io, "proxy: the row-delta capture could not be installed (statement ");
                            err_nat(io, ir - 10);
                            io.error_all(io, " of sql/capture.sql; creating its event trigger needs a superuser upstream role)\n");
                        } else {
                            io.error_all(io, "proxy: the row-delta capture could not be installed: PostgreSQL could not be asked or refused to track the tables\n");
                        }
                    }
                } else if rs == 1 {
                    io.error_all(io, "proxy: PostgreSQL has max_prepared_transactions = 0, so a write cannot be made two-phase: set it above 0\n");
                } else {
                    io.error_all(io, "proxy: could not settle the prepared transactions: PostgreSQL could not be asked\n");
                }
            }
            while recovered == 0 {
                var retry = false;
                borrow core as &cr in {
                    retry = contents(cr.aux)[2] == 1;
                }
                if retry {
                    borrow mut core as &!cw in {
                        let (t0, rs) = catalog.recover(heap, tab, cw, net, host, port);
                        tab = t0;
                    }
                }
                var ready = 0 - 1;
                borrow mut core as &!cw in {
                    ready = poller_wait(cw.poller, contents(cw.events), 1000);
                    contents(cw.aux)[1] = clock_unix_ms(clk);
                }
                var j = 0;
                while j < ready {
                    var token = 0 - 1;
                    var readiness = 0;
                    borrow core as &cr in {
                        token = contents(cr.events)[2 * j];
                        readiness = contents(cr.events)[2 * j + 1];
                    }
                    if token == 0 {
                        borrow mut core as &!cw in {
                            tab = accept_all(heap, tab, listener, cw, clk);
                        }
                    } else {
                        borrow mut tab as &!tw in {
                            borrow mut core as &!cw in {
                                if contents(cw.state)[shared.stride() * (token - 1)] != 0 {
                                    step(tw, cw, clk, token - 1, readiness);
                                }
                            }
                        }
                    }
                    j = j + 1;
                }
                borrow mut core as &!cw in {
                    tab = pair_all(heap, tab, cw, net, host, port);
                    tab = serve_all(heap, tab, cw, net, host, port);
                    borrow mut tab as &!tw in {
                        sweep(tw, cw, clk);
                    }
                }
            }
            conns.drop(heap, tab);
            shared.drop_core(heap, core);
            if recovered == 1 {
                return 5;
            }
            if recovered == 7 {
                return 7;
            }
            if recovered < 0 {
                return 6;
            }
            return 0;
        }
        Polling::Failed(e) => {
            unbox_slice(heap, cfg);
            unbox_slice(heap, cfgi);
            shared.drop_store(heap, kept);
            return 4;
        }
    }
}

// ------------------------------------------------------------------------------------------------ the command line

fn number_of[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 || len(text) > 5 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        n = n * 10 + (c - '0');
        i = i + 1;
    }
    return n;
}

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10;
    }
    return 0 - 1;
}

// Copies `text` into `dst` at `at`; answers where it ended.
fn copy_in[&d, &s](dst: &!d [byte], at: int, text: &s [byte]) -> [] int {
    var i = 0;
    while i < len(text) {
        dst[at + i] = text[i];
        i = i + 1;
    }
    return at + len(text);
}

// Listen on `listen_port` and serve until the loop ends.
fn serve_port[&h, &n, &k, &o](heap: &!h Heap, io: &!o Io, net: &n Net(""), clock: &k Clock, host: &n [byte], listen_port: int, server_port: int, cfg: Box[[byte]], cfgi: Box[[int]], kept: shared.Store) -> [heap, io_write, err_write, conn_accept, conn_read, conn_write, net_out(""), net_in(""), poll, clock, file_write] int {
    var status = 3;
    match tcp_listen(net, listen_port, 1024, 0) {
        Listening::Ok(l) => {
            var listener = l;
            borrow mut listener as &!lh in {
                listener_nonblocking(lh);
                io.write_all(io, "listening\n");
                status = run(heap, io, lh, net, clock, host, server_port, cfg, cfgi, kept);
            }
            listener_close(listener);
        }
        Listening::Failed(e) => {
            unbox_slice(heap, cfg);
            unbox_slice(heap, cfgi);
            shared.drop_store(heap, kept);
            status = 3;
        }
    }
    return status;
}

// A natural number on standard error (`io.print_nat` writes to standard output).
fn err_nat[&o](io: &!o Io, n: int) -> [err_write] int {
    region r {
        let digits = alloc_slice[r](24, byte_of(0));
        var at = 24;
        var v = n;
        if v == 0 {
            at = at - 1;
            digits[at] = byte_of('0');
        }
        while v > 0 {
            at = at - 1;
            digits[at] = byte_of('0' + v % 10);
            v = v / 10;
        }
        io.error_all(io, digits[at..24]);
    }
    return 0;
}

fn refuse_start[&o, &a](io: &!o Io, what: &a [byte], code: int) -> [err_write] int {
    io.error_all(io, "proxy: ");
    io.error_all(io, what);
    io.error_all(io, ": ");
    if code >= 1000 {
        io.error_all(io, store.refusal_name(code));
    } else {
        io.error_all(io, "cannot open");
    }
    io.error_all(io, "\n");
    return 3;
}

// Open the log directory (P2c): the key, the three files, the lock, the scan; say what was found; serve; close. The listener is
// opened only after all of that (docs/m1-commit-path.md P2-D11). Nothing appends to the log until P2d.
fn with_log[&h, &n, &k, &o, &f, &d, &b](heap: &!h Heap, io: &!o Io, fs: &f Fs(""), net: &n Net(""), clock: &k Clock, host: &n [byte], listen_port: int, server_port: int, cfg: Box[[byte]], cfgi: Box[[int]], logdir: &d [byte], keyfile: &b [byte], branch: &b [byte]) -> [heap, io_write, err_write, fs_read(""), dir_read, dir_write, file_read, file_write, conn_accept, conn_read, conn_write, net_out(""), net_in(""), poll, clock] int {
    var status = 3;
    var seed = box_slice(heap, 32, byte_of(0));
    var pk = box_slice(heap, 32, byte_of(0));
    var tip = box_slice(heap, 64, byte_of(0));
    var info = box_slice(heap, 8, 0);
    var idtab = box_slice(heap, 32 * shared.ids_max(), byte_of(0));
    var keyed = false;
    borrow mut seed as &!sw in {
        match open_read(fs, keyfile) {
            Opened::Ok(kf) => {
                var key = kf;
                borrow mut key as &!w in {
                    match file_read(w, contents(sw)) {
                        Read::Got(n2) => {
                            keyed = n2 == 32;
                        }
                        Read::End => {
                            keyed = false;
                        }
                        Read::Failed(e) => {
                            keyed = false;
                        }
                    }
                }
                file_close(key);
            }
            Opened::Failed(e) => {
                keyed = false;
            }
        }
    }
    if !keyed {
        refuse_start(io, "key file (32 bytes expected)", 0);
        unbox_slice(heap, cfg);
        unbox_slice(heap, cfgi);
    } else {
        borrow seed as &sr in {
            borrow mut pk as &!pw in {
                build.public_key(contents(sr), contents(pw));
            }
        }
        match open_dir(fs, logdir) {
            DirOpened::Failed(e) => {
                refuse_start(io, "log directory", e);
                unbox_slice(heap, cfg);
                unbox_slice(heap, cfgi);
            }
            DirOpened::Ok(dh) => {
                var dir = dh;
                borrow dir as &dr in {
                    borrow pk as &pr in {
                        borrow mut info as &!iw in {
                            borrow mut idtab as &!xw in {
                                borrow mut tip as &!tw in {
                                    match store.open_log(heap, dr, contents(pr), branch, contents(iw), contents(tw), contents(xw)) {
                                        Opened::Failed(code) => {
                                            refuse_start(io, "log", code);
                                            if code == store.r_corrupt() {
                                                io.error_all(io, "proxy: the verifier's verdict: rule ");
                                                io.error_all(io, commit.rule_name(contents(iw)[1]));
                                                io.error_all(io, ", record ");
                                                err_nat(io, contents(iw)[2]);
                                                io.newline(io);
                                            }
                                            unbox_slice(heap, cfg);
                                            unbox_slice(heap, cfgi);
                                        }
                                        Opened::Ok(lf) => {
                                            var logfile = lf;
                                            match store.open_store(heap, dr, "tokens", "CHODBTK1") {
                                                Opened::Failed(code) => {
                                                    refuse_start(io, "token store", code);
                                                    unbox_slice(heap, cfg);
                                                    unbox_slice(heap, cfgi);
                                                    file_close(logfile);
                                                }
                                                Opened::Ok(tf) => {
                                                    var tokens = tf;
                                                    match store.open_store(heap, dr, "stmts", "CHODBST2") {
                                                        Opened::Failed(code) => {
                                                            refuse_start(io, "statement store", code);
                                                            unbox_slice(heap, cfg);
                                                            unbox_slice(heap, cfgi);
                                                            file_close(tokens);
                                                            file_close(logfile);
                                                        }
                                                        Opened::Ok(sf) => {
                                                            var stmts = sf;
                                                            io.error_all(io, "proxy: log has ");
                                                            err_nat(io, contents(iw)[0]);
                                                            io.error_all(io, " commits, next seq ");
                                                            err_nat(io, contents(iw)[3]);
                                                            if contents(iw)[4] > 0 {
                                                                io.error_all(io, ", cut ");
                                                                err_nat(io, contents(iw)[4]);
                                                                io.error_all(io, " bytes of torn tail");
                                                            }
                                                            io.newline(io);
                                                            borrow seed as &sd2 in {
                                                                let kept = shared.new_store(heap, logfile, tokens, stmts, contents(sd2), contents(tw), contents(iw)[3], contents(iw)[5], contents(xw), contents(iw)[0]);
                                                                status = serve_port(heap, io, net, clock, host, listen_port, server_port, cfg, cfgi, kept);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                dir_close(dir);
            }
        }
    }
    unbox_slice(heap, seed);
    unbox_slice(heap, pk);
    unbox_slice(heap, tip);
    unbox_slice(heap, info);
    unbox_slice(heap, idtab);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(signals);
    release(exec);
    release(tty);
    var status = 2;
    var listen_port = 0 - 1;
    var server_port = 0 - 1;
    var good = false;
    borrow args as &g in {
        let n = arg_count(g);
        if n == 10 {
            listen_port = number_of(arg(g, 1));
            server_port = number_of(arg(g, 3));
            good = listen_port > 0 && listen_port < 65536 && server_port > 0 && server_port < 65536 && len(arg(g, 4)) > 0 && len(arg(g, 5)) == 64 && len(arg(g, 6)) > 0 && len(arg(g, 7)) > 0;
            good = good && len(arg(g, 8)) > 0 && len(arg(g, 9)) > 0;
            var i = 0;
            while good && i < 64 {
                if hexval(int_of(arg(g, 5)[i])) < 0 {
                    good = false;
                }
                i = i + 1;
            }
        }
    }
    if !good {
        borrow mut io as &!e in {
            io.error_all(e, "usage: proxy <listen port> <upstream host> <upstream port> <branch> <root key, 64 hex digits> <upstream user> <upstream database> <log directory> <signing key file, 32 bytes>\n");
        }
    } else {
        status = 3;
        borrow args as &g in {
            let branch = arg(g, 4);
            let user = arg(g, 6);
            let dbname = arg(g, 7);
            borrow mut heap as &!h in {
                var cfg = box_slice(h, 32 + len(branch) + len(user) + len(dbname), byte_of(0));
                var cfgi = box_slice(h, 6, 0);
                borrow mut cfg as &!cb in {
                    borrow mut cfgi as &!ib in {
                        let c = contents(cb);
                        let ci = contents(ib);
                        var j = 0;
                        while j < 32 {
                            c[j] = byte_of(hexval(int_of(arg(g, 5)[2 * j])) * 16 + hexval(int_of(arg(g, 5)[2 * j + 1])));
                            j = j + 1;
                        }
                        var at = 0;
                        ci[0] = at;
                        ci[1] = len(branch);
                        at = copy_in(c, 32 + at, branch) - 32;
                        ci[2] = at;
                        ci[3] = len(user);
                        at = copy_in(c, 32 + at, user) - 32;
                        ci[4] = at;
                        ci[5] = len(dbname);
                        at = copy_in(c, 32 + at, dbname) - 32;
                    }
                }
                borrow net as &nn in {
                    borrow clock as &ck in {
                        borrow mut io as &!o in {
                            borrow fs as &fr in {
                                status = with_log(h, o, fr, nn, ck, arg(g, 2), listen_port, server_port, cfg, cfgi, arg(g, 8), arg(g, 9), branch);
                            }
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(net);
    release(clock);
    release(args);
    release(io);
    release(heap);
    return status;
}
