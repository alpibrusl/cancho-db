edition 5;

import std.buffer;
import std.conns;
import std.io;
import std.addr;
import std.bytes;
import cdb.commit;
import cdb.token;
import cdb.login;
import cdb.guard;

// `proxy` -- slice P0 of the cancho-db proxy (`docs/m1-proxy.md`): the front door in front of PostgreSQL.
//
//     proxy <listen port> <upstream host> <upstream port> <branch> <root key, 64 hex digits> <upstream user> <upstream database>
//
// A client connects, is asked for a password, and the password must be a capability token (`src/login.cho`, D1 and D2): it
// is checked against the root key and must allow the one branch this server serves. Only then does the proxy open a
// connection to PostgreSQL as the configured upstream role (trust login), relay the login to the client, and from there
// forward the server's messages untouched. The client's are cut into whole messages: a simple query is checked by the guard
// (`src/guard.cho`, docs/m1-lowering.md section 5.2) and only its rendering goes on; the extended protocol is refused.
//
// One thread, one poller, every connection in one `std.conns` table: the structure of `cancho-pg`'s `pooler/proxy.cho`
// (the same author and licence), with a handshake phase before a client is paired with its server connection. `cancho`'s
// `tcp_listen` binds every address, so "loopback only" (D1) is enforced where the connection is accepted: a peer that is
// not a loopback address is closed before a byte is read from it.
//
// One thing is blocking and is P0's stated limit: opening the connection to PostgreSQL (`tcp_connect`), which is fine for a
// local upstream and would stall the loop for a black-holed one. Its login answer is waited for at most `login_ms()`, and a
// client that does not finish its own login in `hello_ms()` is closed.

fn max_clients() -> [] int {
    return 64;
}

fn chunk() -> [] int {
    return 32768;
}

fn queue_size() -> [] int {
    return 65536;
}

// The most a client may send before it is paired: its startup packet and its password message together.
fn hello_size() -> [] int {
    return 16384;
}

// How long a client may take over its login.
fn hello_ms() -> [] int {
    return 10000;
}

// How long the proxy waits for PostgreSQL's login answer before it gives up on it.
fn login_ms() -> [] int {
    return 5000;
}

// The most of PostgreSQL's login answer (parameter statuses, key data, ready) the proxy will hold to relay.
fn relay_max() -> [] int {
    return 16384;
}

// The most of a client's token the proxy keeps (the token without its seed), and of one client message it will hold.
fn token_max() -> [] int {
    return 8192;
}

fn msg_max() -> [] int {
    return 65536;
}

// The schema snapshot's text, and the catalog answer it is built from.
fn snap_max() -> [] int {
    return 65536;
}

fn snapin_max() -> [] int {
    return 262144;
}

// Per connection `k`, `state[24k..24k+24]` is:
//
//     0  kind: 0 free, 1 client sending its startup, 2 client sending its password, 5 login accepted (waiting to be
//        paired), 3 paired (forwarding)
//     1  its peer's slot (paired), or -1
//     2  bytes waiting to be sent to it
//     3  what it is watched for (1 to read, 2 to write, 3 both, 0 neither)
//     4  1 if it closes once its queue has gone
//     5  bytes held in its login buffer
//     6  where the database name starts in the login buffer (kinds 2 and 5), and 7 how long it is
//     8  where application_name starts (-1 if absent), and 9 how long it is
//     10 where the password message starts in the login buffer (the startup packet is before it)
//     11 when it was accepted (monotonic ms)
//     12 for a paired client, the length of its token (more than 0); for the upstream side of a pair, -1
//     13 bytes of the client's messages held in its message buffer
//     14 1 if a whole simple query is at the start of that buffer, waiting for the guard
//     15 1 while the client's extended-protocol messages are discarded up to the next Sync
//     16 a paired client's transaction state: 0 idle, 1 in a transaction, 2 in a failed one (the proxy's own record, `I` `T` `E`)
//     17 1 while a statement of the client is in flight upstream (its ReadyForQuery has not come)
//     18 bytes of held CommandComplete messages (kept until the statement may be said to be done)
//     19 for the upstream side of a pair: bytes of a message being collected (a CommandComplete or a ReadyForQuery)
//     20 for the upstream side: bytes of the message being relayed that are still to come
//     21 for the upstream side: 1 while the statement in flight is an autocommit one the proxy wrapped in its own transaction
//     22 for the upstream side: 1 if that statement answered with an error
//     (kind 6 is the proxy's own catalog connection: not watched, used one question at a time)
fn stride() -> [] int {
    return 24;
}

// The most of one statement's CommandComplete messages the proxy holds back, and of one message it collects whole.
fn hold_max() -> [] int {
    return 2048;
}

fn sbuf_max() -> [] int {
    return 512;
}

res struct Core {
    poller: Poller,
    events: Box[[int]],
    state: Box[[int]],
    rbuf: Box[[byte]],
    pends: Box[[byte]],
    hbuf: Box[[byte]],
    // The configuration: the root key (32 bytes), then the branch, the upstream user and the upstream database, each
    // NUL-ended, with where each starts in `cfgi`: [branch_at, branch_len, user_at, user_len, db_at, db_len].
    cfg: Box[[byte]],
    cfgi: Box[[int]],
    // each client's token, `token_max()` a slot; its message buffer, `msg_max()` a slot
    tokb: Box[[byte]],
    mbuf: Box[[byte]],
    // the schema snapshot, the catalog's raw answer, the guard's output and the query sent upstream
    snap: Box[[byte]],
    snapin: Box[[byte]],
    rend: Box[[byte]],
    qout: Box[[byte]],
    // [0] the slot of the catalog connection, or -1
    aux: Box[[int]],
    // held CommandComplete messages, `hold_max()` a slot; a message being collected, `sbuf_max()` a slot
    hold: Box[[byte]],
    sbuf: Box[[byte]],
}

// ------------------------------------------------------------------------------------------------ sending

// Hand `data` to the kernel without waiting for room, and keep what it did not take. Answers the new number of bytes
// queued, or -1 if the queue cannot hold the rest or the connection has failed (`cancho-pg`'s `emit`).
fn emit[&c, &d, &e](table: &!c conns.Table, slot: int, data: &d [byte], pend: &!e [byte], pending: int) -> [conn_write] int {
    var at = 0;
    if pending == 0 {
        match conns.write(table, slot, data) {
            Sent::Wrote(n) => {
                at = n;
            }
            Sent::Again => {
            }
            Sent::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    if at >= len(data) {
        return pending;
    }
    if pending + len(data) - at > len(pend) {
        return 0 - 1;
    }
    var i = at;
    while i < len(data) {
        pend[pending + i - at] = data[i];
        i = i + 1;
    }
    return pending + len(data) - at;
}

fn shut[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    conns.close(tab, k);
    st[stride() * k] = 0;
    return 0;
}

// Watch `k` for what it now waits on.
fn settle[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p] == 0 {
        return 0;
    }
    var want = 0;
    if st[p] == 1 || st[p] == 2 {
        // still logging in: read while it is not closing
        if st[p + 4] == 0 {
            want = 1;
        }
    } else if st[p] == 3 {
        if st[p + 4] == 0 && st[stride() * st[p + 1] + 2] + chunk() <= queue_size() && st[p + 14] == 0 {
            want = 1;
        }
    }
    if st[p + 2] > 0 {
        want = want + 2;
    }
    if want != st[p + 3] {
        conns.rewatch(tab, core.poller, k, k + 1, want);
        st[p + 3] = want;
    }
    return 0;
}

// `k` closes once what is queued for it has been sent.
fn close_after[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    let st = contents(core.state);
    if st[stride() * k + 2] == 0 {
        shut(tab, core, k);
    } else {
        st[stride() * k + 4] = 1;
        settle(tab, core, k);
    }
    return 0;
}

// `k` is finished (the peer closed, or it failed). Close it; a paired peer goes once what is queued for it has been sent.
fn finish[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    let st = contents(core.state);
    let peer = st[stride() * k + 1];
    let paired = st[stride() * k] == 3;
    shut(tab, core, k);
    if paired && peer >= 0 && st[stride() * peer] == 3 {
        close_after(tab, core, peer);
    }
    return 0;
}

// Connection `k` can be written to: send what is queued for it.
fn drain[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let pd = contents(core.pends);
    let p = stride() * k;
    let obase = k * queue_size();
    match conns.write(tab, k, pd[obase..obase + st[p + 2]]) {
        Sent::Wrote(sent) => {
            var at = 0;
            while at < st[p + 2] - sent {
                pd[obase + at] = pd[obase + sent + at];
                at = at + 1;
            }
            st[p + 2] = st[p + 2] - sent;
            if st[p + 2] == 0 && st[p + 4] == 1 {
                shut(tab, core, k);
            } else {
                settle(tab, core, k);
                if st[p] == 3 {
                    settle(tab, core, st[p + 1]);
                }
            }
        }
        Sent::Again => {
        }
        Sent::Failed(e) => {
            finish(tab, core, k);
        }
    }
    return 0;
}

// Queue `data` for `k`; false if it cannot be (the connection is then closed).
fn send[&t, &c, &d](tab: &!t conns.Table, core: &!c Core, k: int, data: &d [byte]) -> [conn_write, poll] bool {
    let st = contents(core.state);
    let pd = contents(core.pends);
    let q = stride() * k;
    let pending = emit(tab, k, data, pd[k * queue_size()..k * queue_size() + queue_size()], st[q + 2]);
    if pending < 0 {
        shut(tab, core, k);
        return false;
    }
    st[q + 2] = pending;
    settle(tab, core, k);
    return true;
}

// Tell client `k` it is refused (`ErrorResponse`, severity and SQLSTATE and the tag `login.cho` or this file gives) and
// close it once that has been sent. Nothing has reached PostgreSQL.
fn refuse[&t, &c, &a, &b, &d, &e](tab: &!t conns.Table, core: &!c Core, k: int, severity: &a [byte], sqlstate: &b [byte], tag: &d [byte], text: &e [byte]) -> [conn_write, poll] int {
    region r {
        let buf = alloc_slice[r](512, byte_of(0));
        let n = login.error_response(buf, severity, sqlstate, tag, text);
        if send(tab, core, k, buf[0..n]) {
            close_after(tab, core, k);
        }
    }
    return 0;
}

// ------------------------------------------------------------------------------------------------ the login

fn put_first(c: int) -> [] int {
    return c;
}

// Everything in client `k`'s login buffer that can be decided is decided: the startup packet (answering `SSLRequest` and
// `GSSENCRequest` with `N`), then the password. A refusal is sent and `k` closed; a good password makes it kind 5.
fn hello_progress[&t, &c, &k](tab: &!t conns.Table, core: &!c Core, clk: &k Clock, k: int) -> [conn_write, poll, clock] int {
    let st = contents(core.state);
    let hb = contents(core.hbuf);
    let cfg = contents(core.cfg);
    let ci = contents(core.cfgi);
    let p = stride() * k;
    let base = k * hello_size();
    var going = true;
    while going && st[p] != 0 && st[p + 4] == 0 {
        going = false;
        if st[p] == 1 {
            // a startup-phase packet at the start of the buffer
            if st[p + 5] >= 4 {
                let bl = login.startup_body_len(hb[base..base + 4]);
                if bl < 0 {
                    refuse(tab, core, k, "FATAL", "08P01", "startup-length", "invalid length of startup packet");
                } else if st[p + 5] >= 4 + bl {
                    region r {
                        let out = alloc_slice[r](6, 0);
                        let kind = login.parse_startup(hb[base + 4..base + 4 + bl], out);
                        if kind == login.kind_ssl() || kind == login.kind_gss() {
                            // plain only: answer N and take the next packet from where this one ended
                            let no = alloc_slice[r](1, byte_of('N'));
                            if send(tab, core, k, no) {
                                var i = 0;
                                while i < st[p + 5] - 4 - bl {
                                    hb[base + i] = hb[base + 4 + bl + i];
                                    i = i + 1;
                                }
                                st[p + 5] = st[p + 5] - 4 - bl;
                                going = true;
                            }
                        } else if kind == login.kind_cancel() {
                            shut(tab, core, k);
                        } else if kind == login.kind_startup() {
                            st[p + 6] = 4 + out[2];
                            st[p + 7] = out[3];
                            st[p + 8] = 0 - 1;
                            st[p + 9] = 0;
                            if out[4] >= 0 {
                                st[p + 8] = 4 + out[4];
                                st[p + 9] = out[5];
                            }
                            st[p + 10] = 4 + bl;
                            let ask = alloc_slice[r](9, byte_of(0));
                            let n = login.auth_cleartext(ask);
                            if send(tab, core, k, ask[0..n]) {
                                st[p] = 2;
                                going = true;
                            }
                        } else if kind == login.err_version() {
                            refuse(tab, core, k, "FATAL", "0A000", "unsupported-protocol", "only protocol 3.0 is supported");
                        } else {
                            refuse(tab, core, k, "FATAL", "08P01", "startup-malformed", "invalid startup packet");
                        }
                    }
                }
            }
        } else if st[p] == 2 {
            let h0 = st[p + 10];
            if st[p + 5] >= h0 + 5 {
                let ln = commit.be(hb, base + h0 + 1, 4);
                if int_of(hb[base + h0]) != 'p' || ln < 5 || h0 + 1 + ln > hello_size() {
                    refuse(tab, core, k, "FATAL", "08P01", "password-malformed", "expected a password message");
                } else if st[p + 5] >= h0 + 1 + ln {
                    let text = hb[base + h0 + 5..base + h0 + 1 + ln - 1];
                    if int_of(hb[base + h0 + ln]) != 0 {
                        refuse(tab, core, k, "FATAL", "08P01", "password-malformed", "password is not terminated");
                    } else {
                        region r {
                            let blob = alloc_slice[r](len(text) + 4, byte_of(0));
                            let n = login.decode_b64url(text, blob);
                            var rule = login.login_bad_token();
                            if n >= 0 {
                                var now = 0;
                                now = clock_unix_ms(clk);
                                let database = hb[base + st[p + 6]..base + st[p + 6] + st[p + 7]];
                                rule = login.check(blob[0..n], database, cfg[32 + ci[0]..32 + ci[0] + ci[1]], cfg[0..32], now / 4294967296, now % 4294967296);
                            }
                            if rule != login.login_ok() {
                                refuse(tab, core, k, "FATAL", login.sqlstate(rule), login.rule_name(rule), "the capability token was refused");
                            } else if n - 32 > token_max() || n - 32 < 8 {
                                refuse(tab, core, k, "FATAL", "28000", "login-token-size", "the capability token is too large to keep");
                            } else {
                                // the token without the seed of its last key is what the guard checks each query against
                                let tk = contents(core.tokb);
                                var q = 0;
                                while q < n - 32 {
                                    tk[k * token_max() + q] = blob[q];
                                    q = q + 1;
                                }
                                st[p + 12] = n - 32;
                                st[p] = 5;
                                st[p + 4] = 0;
                                settle(tab, core, k);
                            }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

// Client `k` (kind 1 or 2) has something to read.
fn hello_read[&t, &c, &k](tab: &!t conns.Table, core: &!c Core, clk: &k Clock, k: int) -> [conn_read, conn_write, poll, clock] int {
    let st = contents(core.state);
    let hb = contents(core.hbuf);
    let p = stride() * k;
    let base = k * hello_size();
    if st[p + 5] >= hello_size() {
        refuse(tab, core, k, "FATAL", "08P01", "login-too-long", "login message too long");
        return 0;
    }
    match conns.read(tab, k, hb[base + st[p + 5]..base + hello_size()]) {
        Received::Data(got) => {
            st[p + 5] = st[p + 5] + got;
            hello_progress(tab, core, clk, k);
        }
        Received::End => {
            shut(tab, core, k);
        }
        Received::Again => {
        }
        Received::Failed(e) => {
            shut(tab, core, k);
        }
    }
    return 0;
}

// ------------------------------------------------------------------------------------------------ the client's messages

// Tell client `k` something went wrong with its query, and that PostgreSQL has not been asked (`ErrorResponse`, then
// `ReadyForQuery` with the transaction status `status`: `I`, `T` or `E`): the connection stays open.
fn answer_error[&t, &c, &a, &b, &d](tab: &!t conns.Table, core: &!c Core, k: int, status: int, sqlstate: &a [byte], tag: &b [byte], text: &d [byte]) -> [conn_write, poll] int {
    region r {
        let buf = alloc_slice[r](640, byte_of(0));
        var n = login.error_response(buf, "ERROR", sqlstate, tag, text);
        n = n + login.ready_for_query(buf[n..640], status);
        send(tab, core, k, buf[0..n]);
    }
    return 0;
}

// `CommandComplete` with the command tag `tag`, then `ReadyForQuery` with `status`, to client `k`: what PostgreSQL would say for
// a `BEGIN`, `COMMIT` or `ROLLBACK` that the proxy answered itself.
fn answer_tag[&t, &c, &a](tab: &!t conns.Table, core: &!c Core, k: int, status: int, tag: &a [byte]) -> [conn_write, poll] int {
    region r {
        let buf = alloc_slice[r](128, byte_of(0));
        let ln = len(tag) + 5;
        buf[0] = byte_of('C');
        buf[1] = byte_of(0);
        buf[2] = byte_of(0);
        buf[3] = byte_of(ln / 256 % 256);
        buf[4] = byte_of(ln % 256);
        var i = 0;
        while i < len(tag) {
            buf[5 + i] = tag[i];
            i = i + 1;
        }
        buf[5 + len(tag)] = byte_of(0);
        let n = 6 + len(tag) + login.ready_for_query(buf[6 + len(tag)..128], status);
        send(tab, core, k, buf[0..n]);
    }
    return 0;
}

// Drop the first `n` bytes of client `k`'s message buffer.
fn consume[&c](core: &!c Core, k: int, n: int) -> [] int {
    let st = contents(core.state);
    let mb = contents(core.mbuf);
    let p = stride() * k;
    let base = k * msg_max();
    var i = 0;
    while i < st[p + 13] - n {
        mb[base + i] = mb[base + n + i];
        i = i + 1;
    }
    st[p + 13] = st[p + 13] - n;
    return 0;
}

// Cut whole messages off the front of client `k`'s buffer until a simple query is there (for the guard) or no whole message
// is. Terminate goes to PostgreSQL; the extended protocol is refused (`0A000`): the error is answered at once, the messages up
// to the next Sync are discarded as PostgreSQL itself would, and Sync is answered `ReadyForQuery`.
fn frame_client[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let mb = contents(core.mbuf);
    let p = stride() * k;
    let base = k * msg_max();
    var going = true;
    while going && st[p] == 3 && st[p + 14] == 0 {
        going = false;
        if st[p + 13] >= 5 {
            let ty = int_of(mb[base]);
            let ln = commit.be(mb, base + 1, 4);
            if ln < 4 || ln + 1 > msg_max() {
                refuse(tab, core, k, "FATAL", "08P01", "message-too-long", "a message is longer than the proxy will hold");
            } else if st[p + 13] >= ln + 1 {
                if ty == 'Q' {
                    st[p + 14] = 1;
                } else if ty == 'X' {
                    send(tab, core, st[p + 1], mb[base..base + ln + 1]);
                    consume(core, k, ln + 1);
                    going = st[p] == 3;
                } else if ty == 'P' || ty == 'B' || ty == 'E' || ty == 'D' || ty == 'C' || ty == 'S' || ty == 'H' || ty == 'F' || ty == 'd' || ty == 'c' || ty == 'f' {
                    if ty == 'S' {
                        region r {
                            let z = alloc_slice[r](8, byte_of(0));
                            let n = login.ready_for_query(z, 'I');
                            send(tab, core, k, z[0..n]);
                        }
                        st[p + 15] = 0;
                    } else if ty != 'H' && st[p + 15] == 0 {
                        region r {
                            let buf = alloc_slice[r](640, byte_of(0));
                            let n = login.error_response(buf, "ERROR", "0A000", "extended-protocol", "only the simple query protocol is supported");
                            send(tab, core, k, buf[0..n]);
                        }
                        st[p + 15] = 1;
                    }
                    consume(core, k, ln + 1);
                    going = st[p] == 3;
                } else {
                    refuse(tab, core, k, "FATAL", "08P01", "protocol-violation", "unexpected frontend message");
                }
            }
        }
    }
    settle(tab, core, k);
    return 0;
}

// Client `k` (paired) can be read: take what it has sent into its message buffer, and act on whole messages.
fn client_read[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let mb = contents(core.mbuf);
    let p = stride() * k;
    let base = k * msg_max();
    match conns.read(tab, k, mb[base + st[p + 13]..base + msg_max()]) {
        Received::Data(got) => {
            st[p + 13] = st[p + 13] + got;
            frame_client(tab, core, k);
        }
        Received::End => {
            finish(tab, core, k);
        }
        Received::Again => {
        }
        Received::Failed(e) => {
            finish(tab, core, k);
        }
    }
    return 0;
}

// ------------------------------------------------------------------------------------------------ accepting and pairing

// Whether the peer of the connection in `slot` is a loopback address: 127.0.0.0/8 or ::1.
fn is_loopback[&t](tab: &!t conns.Table, slot: int) -> [] bool {
    match conns.peer(tab, slot) {
        conns.Peered::Known(who) => {
            return login.is_loopback(who);
        }
        conns.Peered::Unavailable(e) => {
            return false;
        }
    }
}

// Take every client waiting on the listener: loopback ones start their login, others are closed unread.
fn accept_all[&h, &l, &c, &k](heap: &!h Heap, conn: conns.Table, listener: &!l Listener, core: &!c Core, clk: &k Clock) -> [heap, conn_accept, poll, clock] conns.Table {
    let st = contents(core.state);
    var table = conn;
    var more = true;
    while more {
        match tcp_accept(listener) {
            Accepted::Ok(client) => {
                var held = 0;
                borrow table as &tt in {
                    held = conns.live(tt);
                }
                if held + 2 > 2 * max_clients() {
                    conn_close(client);
                } else {
                    let (t1, a) = conns.put(heap, table, client);
                    table = t1;
                    if a >= 0 {
                        borrow mut table as &!ct in {
                            if !is_loopback(ct, a) {
                                conns.close(ct, a);
                            } else {
                                let p = stride() * a;
                                st[p] = 1;
                                st[p + 1] = 0 - 1;
                                st[p + 2] = 0;
                                st[p + 3] = 1;
                                st[p + 4] = 0;
                                st[p + 5] = 0;
                                st[p + 12] = 0;
                                st[p + 13] = 0;
                                st[p + 14] = 0;
                                st[p + 15] = 0;
                                st[p + 16] = 0;
                                st[p + 17] = 0;
                                st[p + 18] = 0;
                                st[p + 19] = 0;
                                st[p + 20] = 0;
                                st[p + 21] = 0;
                                st[p + 22] = 0;
                                st[p + 11] = clock_ms(clk);
                                if conns.nonblocking(ct, a) != 0 || conns.nodelay(ct, a) != 0 || conns.watch(ct, core.poller, a, a + 1, 1) != 0 {
                                    shut(ct, core, a);
                                }
                            }
                        }
                    }
                }
            }
            Accepted::Again => {
                more = false;
            }
            Accepted::Failed(e) => {
                more = false;
            }
        }
    }
    return table;
}

// Put `b` after `x` into `out` as a NUL-ended string at `at`; answers where it ends.
fn put_cstr[&o, &s](out: &!o [byte], at: int, text: &s [byte]) -> [] int {
    var i = 0;
    while i < len(text) {
        out[at + i] = text[i];
        i = i + 1;
    }
    out[at + len(text)] = byte_of(0);
    return at + len(text) + 1;
}

// Read what the connection in `slot` has to say within `wait_ms`, into `into`: the number of bytes (more than 0), 0 if
// nothing came in time, -1 if the connection ended or failed. A private poller bounds the wait, so a silent upstream
// costs one client a refusal and not the loop its attention.
fn login_read[&t, &b](tab: &!t conns.Table, slot: int, into: &!b [byte], wait_ms: int) -> [conn_read, poll] int {
    match poller_new() {
        Polling::Ok(p) => {
            var poller = p;
            var answer = 0 - 1;
            region r {
                let ev = alloc_slice[r](8, 0);
                borrow mut poller as &!pw in {
                    if conns.watch(tab, pw, slot, 1, 1) == 0 {
                        let n = poller_wait(pw, ev, wait_ms);
                        if n > 0 {
                            match conns.read(tab, slot, into) {
                                Received::Data(g) => {
                                    answer = g;
                                }
                                Received::End => {
                                    answer = 0 - 1;
                                }
                                Received::Again => {
                                    answer = 0;
                                }
                                Received::Failed(e) => {
                                    answer = 0 - 1;
                                }
                            }
                        } else if n == 0 {
                            answer = 0;
                        }
                    }
                }
            }
            poller_close(poller);
            return answer;
        }
        Polling::Failed(e) => {
            return 0 - 1;
        }
    }
}

// Open the connection to PostgreSQL for client `k` (kind 5), log in to it (trust), and pair them. Blocking, and the one
// place that is: PostgreSQL is local and trusted (docs/m1-proxy.md section 3, P0's limit). The server's login answer is
// relayed to the client as it is.
fn pair_one[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c Core, net: &n Net(""), host: &n [byte], port: int, k: int) -> [heap, net_out(""), conn_read, conn_write, poll] conns.Table {
    let st = contents(core.state);
    let cfg = contents(core.cfg);
    let ci = contents(core.cfgi);
    let hb = contents(core.hbuf);
    let rb = contents(core.rbuf);
    let p = stride() * k;
    var table = tab;
    var failed = 0;
    var detail = 0;
    match tcp_connect(net, host, port) {
        Dialed::Ok(server) => {
            let (t1, b) = conns.put(heap, table, server);
            table = t1;
            if b < 0 {
                failed = 1;
            } else {
                // StartupMessage, protocol 3.0, as the configured role: the client chooses nothing about this session
                region r {
                    let msg = alloc_slice[r](1024, byte_of(0));
                    var at = 8;
                    at = put_cstr(msg, at, "user");
                    at = put_cstr(msg, at, cfg[32 + ci[2]..32 + ci[2] + ci[3]]);
                    at = put_cstr(msg, at, "database");
                    at = put_cstr(msg, at, cfg[32 + ci[4]..32 + ci[4] + ci[5]]);
                    at = put_cstr(msg, at, "application_name");
                    if st[p + 8] >= 0 && at + st[p + 9] + 4 < 1000 {
                        at = put_cstr(msg, at, hb[k * hello_size() + st[p + 8]..k * hello_size() + st[p + 8] + st[p + 9]]);
                    } else {
                        at = put_cstr(msg, at, "cancho-db");
                    }
                    msg[at] = byte_of(0);
                    at = at + 1;
                    msg[0] = byte_of(at / 16777216 % 256);
                    msg[1] = byte_of(at / 65536 % 256);
                    msg[2] = byte_of(at / 256 % 256);
                    msg[3] = byte_of(at % 256);
                    msg[4] = byte_of(0);
                    msg[5] = byte_of(3);
                    msg[6] = byte_of(0);
                    msg[7] = byte_of(0);
                    borrow mut table as &!tw in {
                        var sent = 0;
                        while sent < at && failed == 0 {
                            match conns.write(tw, b, msg[sent..at]) {
                                Sent::Wrote(x) => {
                                    sent = sent + x;
                                }
                                Sent::Again => {
                                }
                                Sent::Failed(e) => {
                                    failed = 1;
                                }
                            }
                        }
                    }
                }
                // read PostgreSQL's answer up to and including ReadyForQuery
                var fill = 0;
                var done = false;
                while failed == 0 && !done {
                    var got = 0 - 1;
                    borrow mut table as &!tw in {
                        got = login_read(tw, b, rb[fill..relay_max()], login_ms());
                    }
                    if got < 0 {
                        failed = 1;
                    } else if got == 0 {
                        failed = 4;
                    } else {
                        fill = fill + got;
                    }
                    var pos = 0;
                    var more = true;
                    var first = true;
                    while more && failed == 0 && !done {
                        if pos + 5 > fill {
                            more = false;
                        } else {
                            let ln = commit.be(rb, pos + 1, 4);
                            if ln < 4 || ln > relay_max() {
                                failed = 1;
                            } else if pos + 1 + ln > fill {
                                more = false;
                            } else {
                                let t = int_of(rb[pos]);
                                if t == 'R' && pos == 0 && commit.be(rb, 5, 4) != 0 {
                                    failed = 2;
                                } else if t == 'E' {
                                    failed = 3;
                                } else if t == 'Z' {
                                    done = true;
                                }
                                pos = pos + 1 + ln;
                            }
                        }
                    }
                    if fill >= relay_max() && !done {
                        failed = 1;
                    }
                }
                if failed == 0 {
                    // pair: the relay goes to the client, and from here both are forwarded
                    let q = stride() * b;
                    st[q] = 3;
                    st[q + 1] = k;
                    st[q + 2] = 0;
                    st[q + 3] = 0;
                    st[q + 4] = 0;
                    st[q + 12] = 0 - 1;
                    st[q + 13] = 0;
                    st[q + 14] = 0;
                    st[q + 15] = 0;
                    st[q + 16] = 0;
                    st[q + 17] = 0;
                    st[q + 18] = 0;
                    st[q + 19] = 0;
                    st[q + 20] = 0;
                    st[q + 21] = 0;
                    st[q + 22] = 0;
                    st[p] = 3;
                    st[p + 1] = b;
                    st[p + 13] = 0;
                    st[p + 14] = 0;
                    st[p + 15] = 0;
                    st[p + 16] = 0;
                    st[p + 17] = 0;
                    st[p + 18] = 0;
                    borrow mut table as &!ct in {
                        if conns.nonblocking(ct, b) != 0 || conns.nodelay(ct, b) != 0 || conns.watch(ct, core.poller, b, b + 1, 1) != 0 {
                            shut(ct, core, b);
                            shut(ct, core, k);
                        } else {
                            st[q + 3] = 1;
                            send(ct, core, k, rb[0..fill]);
                            settle(ct, core, k);
                        }
                    }
                } else {
                    // PostgreSQL did not accept the proxy's own login (or answered with an error): the client is told, and
                    // an error PostgreSQL sent is relayed as it is.
                    detail = b;
                    borrow mut table as &!ct in {
                        conns.close(ct, b);
                        if failed == 3 {
                            if send(ct, core, k, rb[0..fill]) {
                                close_after(ct, core, k);
                            }
                        } else if failed == 2 {
                            refuse(ct, core, k, "FATAL", "28000", "upstream-auth-unsupported", "the database requires a password the proxy does not have");
                        } else if failed == 4 {
                            refuse(ct, core, k, "FATAL", "08006", "upstream-timeout", "the database did not answer in time");
                        } else {
                            refuse(ct, core, k, "FATAL", "08006", "upstream-unavailable", "the database closed the connection during login");
                        }
                    }
                }
            }
        }
        Dialed::Failed(e) => {
            borrow mut table as &!ct in {
                refuse(ct, core, k, "FATAL", "08006", "upstream-unavailable", "cannot reach the database");
            }
        }
    }
    if failed == 1 && st[p] == 5 {
        borrow mut table as &!ct in {
            refuse(ct, core, k, "FATAL", "08006", "upstream-unavailable", "cannot reach the database");
        }
    }
    return table;
}

// Pair every client whose login has been accepted.
fn pair_all[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c Core, net: &n Net(""), host: &n [byte], port: int) -> [heap, net_out(""), conn_read, conn_write, poll] conns.Table {
    var table = tab;
    var k = 0;
    while k < 2 * max_clients() {
        let kind = contents(core.state)[stride() * k];
        if kind == 5 {
            table = pair_one(heap, table, core, net, host, port, k);
        }
        k = k + 1;
    }
    return table;
}

// ------------------------------------------------------------------------------------------------ the guard

// The two questions that make the schema snapshot: every ordinary table's columns in order, then every index and the table it is
// on, in the public schema.
fn snapshot_sql() -> [] &static [byte] {
    return "select c.relname, a.attname from pg_class c join pg_namespace n on n.oid = c.relnamespace join pg_attribute a on a.attrelid = c.oid where n.nspname = 'public' and c.relkind in ('r', 'p') and a.attnum > 0 and not a.attisdropped order by c.relname, a.attnum; select indexname, tablename from pg_indexes where schemaname = 'public' order by indexname";
}

// A name that can be written into the snapshot's text: not empty, and none of the bytes that text uses.
fn plain_name[&d](data: &d [byte]) -> [] bool {
    if len(data) == 0 || len(data) > 63 {
        return false;
    }
    var i = 0;
    while i < len(data) {
        let c = int_of(data[i]);
        if c == ' ' || c == ':' || c == '\n' || c == '.' || c == 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn append[&o, &d](out: &!o [byte], at: int, data: &d [byte]) -> [] int {
    if at < 0 || at + len(data) > len(out) {
        return 0 - 1;
    }
    var i = 0;
    while i < len(data) {
        out[at + i] = data[i];
        i = i + 1;
    }
    return at + len(data);
}

// Turn the catalog's answer (`raw`, `n` bytes: RowDescription, DataRow..., CommandComplete, twice, ReadyForQuery) into the
// snapshot's text in `out` (`lower.cho`'s header). Answers its length, or -1 if the answer is not what was asked for.
fn build_snapshot[&r, &o](raw: &r [byte], n: int, out: &!o [byte]) -> [] int {
    var at = 0;
    var w = 0;
    var phase = 0;
    var cur_at = 0 - 1;
    var cur_len = 0;
    var skip_table = false;
    var pos = 0;
    while pos + 5 <= n && w >= 0 {
        let ty = int_of(raw[pos]);
        let ln = commit.be(raw, pos + 1, 4);
        if ln < 4 || pos + 1 + ln > n {
            return 0 - 1;
        }
        if ty == 'D' {
            if ln < 6 || commit.be(raw, pos + 5, 2) != 2 {
                return 0 - 1;
            }
            let l1 = commit.be(raw, pos + 7, 4);
            if l1 < 0 || pos + 11 + l1 + 4 > pos + 1 + ln {
                return 0 - 1;
            }
            let a1 = pos + 11;
            let l2 = commit.be(raw, a1 + l1, 4);
            let a2 = a1 + l1 + 4;
            if l2 < 0 || a2 + l2 > pos + 1 + ln {
                return 0 - 1;
            }
            let first = raw[a1..a1 + l1];
            let second = raw[a2..a2 + l2];
            if plain_name(first) && plain_name(second) {
                if phase == 0 {
                    // a column of a table: a new line when the table changes
                    var same = false;
                    if cur_at >= 0 && cur_len == l1 {
                        same = true;
                        var i = 0;
                        while i < l1 {
                            if out[cur_at + i] != first[i] {
                                same = false;
                            }
                            i = i + 1;
                        }
                    }
                    if !same {
                        if cur_at >= 0 {
                            w = append(out, w, "\n");
                        }
                        cur_at = w;
                        cur_len = l1;
                        w = append(out, w, first);
                        w = append(out, w, ":");
                    }
                    w = append(out, w, " ");
                    w = append(out, w, second);
                } else {
                    w = append(out, w, "index ");
                    w = append(out, w, first);
                    w = append(out, w, " on ");
                    w = append(out, w, second);
                    w = append(out, w, "\n");
                }
            }
        } else if ty == 'C' {
            if phase == 0 {
                if cur_at >= 0 {
                    w = append(out, w, "\n");
                }
                phase = 1;
            }
        } else if ty == 'E' {
            return 0 - 1;
        }
        pos = pos + 1 + ln;
    }
    if w < 0 || phase != 1 {
        return 0 - 1;
    }
    return w;
}

// Put the proxy's own startup message (the configured role and database, application_name `name`) into `msg`: its length.
fn startup_msg[&m, &c, &s](msg: &!m [byte], cfg: &c [byte], ci: &s [int], name: &static [byte]) -> [] int {
    var at = 8;
    at = put_cstr(msg, at, "user");
    at = put_cstr(msg, at, cfg[32 + ci[2]..32 + ci[2] + ci[3]]);
    at = put_cstr(msg, at, "database");
    at = put_cstr(msg, at, cfg[32 + ci[4]..32 + ci[4] + ci[5]]);
    at = put_cstr(msg, at, "application_name");
    at = put_cstr(msg, at, name);
    msg[at] = byte_of(0);
    at = at + 1;
    msg[0] = byte_of(at / 16777216 % 256);
    msg[1] = byte_of(at / 65536 % 256);
    msg[2] = byte_of(at / 256 % 256);
    msg[3] = byte_of(at % 256);
    msg[4] = byte_of(0);
    msg[5] = byte_of(3);
    msg[6] = byte_of(0);
    msg[7] = byte_of(0);
    return at;
}

// Send all of `data` on connection `slot`, waiting if the kernel is slow: false if it fails. The catalog connection is never
// the busy one, and its messages are small.
fn write_all[&t, &d](tab: &!t conns.Table, slot: int, data: &d [byte]) -> [conn_write] bool {
    var sent = 0;
    var spins = 0;
    while sent < len(data) {
        match conns.write(tab, slot, data[sent..len(data)]) {
            Sent::Wrote(x) => {
                sent = sent + x;
            }
            Sent::Again => {
                spins = spins + 1;
                if spins > 1000000 {
                    return false;
                }
            }
            Sent::Failed(e) => {
                return false;
            }
        }
    }
    return true;
}

// Read from `slot` until a ReadyForQuery has come, into `into`: the bytes read, or -1 (it failed, was silent past `wait_ms`, or
// answered with an error before the first row, or too much).
fn read_until_ready[&t, &b](tab: &!t conns.Table, slot: int, into: &!b [byte], wait_ms: int) -> [conn_read, poll] int {
    var fill = 0;
    while fill < len(into) {
        let got = login_read(tab, slot, into[fill..len(into)], wait_ms);
        if got <= 0 {
            return 0 - 1;
        }
        fill = fill + got;
        // is there a complete ReadyForQuery as the last message?
        var pos = 0;
        var last = 0 - 1;
        var whole = true;
        while whole && pos + 5 <= fill {
            let ln = commit.be(into, pos + 1, 4);
            if ln < 4 {
                return 0 - 1;
            }
            if pos + 1 + ln > fill {
                whole = false;
            } else {
                last = int_of(into[pos]);
                pos = pos + 1 + ln;
            }
        }
        if whole && pos == fill && last == 'Z' {
            return fill;
        }
    }
    return 0 - 1;
}

// ------------------------------------------------------------------------------------------------ transactions

// Run `sql` (one simple query of the proxy's own: BEGIN, COMMIT, ROLLBACK) on upstream connection `b` and wait, bounded, for its
// ReadyForQuery. 0 if it ran, 1 if PostgreSQL answered with an error, -1 if the connection failed or was silent. Used only
// where the upstream is idle and nothing else is owed from it.
fn upstream_exec[&t, &c, &q](tab: &!t conns.Table, core: &!c Core, b: int, sql: &q [byte]) -> [conn_read, conn_write, poll] int {
    var sent = false;
    region r {
        let msg = alloc_slice[r](len(sql) + 8, byte_of(0));
        let ln = len(sql) + 5;
        msg[0] = byte_of('Q');
        msg[1] = byte_of(ln / 16777216 % 256);
        msg[2] = byte_of(ln / 65536 % 256);
        msg[3] = byte_of(ln / 256 % 256);
        msg[4] = byte_of(ln % 256);
        var i = 0;
        while i < len(sql) {
            msg[5 + i] = sql[i];
            i = i + 1;
        }
        msg[5 + len(sql)] = byte_of(0);
        sent = write_all(tab, b, msg[0..len(sql) + 6]);
    }
    if !sent {
        return 0 - 1;
    }
    let si = contents(core.snapin);
    let n = read_until_ready(tab, b, si, login_ms());
    if n < 0 {
        return 0 - 1;
    }
    var pos = 0;
    var errored = 0;
    while pos + 5 <= n {
        if int_of(si[pos]) == 'E' {
            errored = 1;
        }
        pos = pos + 1 + commit.be(si, pos + 1, 4);
    }
    return errored;
}

// The statement of client `client` has finished on upstream connection `k`, which the proxy had wrapped in a transaction of its
// own (the client was in autocommit): make it permanent and tell the client, now. The held `CommandComplete` messages are
// released only if the commit succeeded; a statement that failed is rolled back and the client has the error already.
fn finish_autocommit[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int, client: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let hd = contents(core.hold);
    let q = stride() * k;
    let cp = stride() * client;
    let failed = st[q + 22] == 1;
    st[q + 21] = 0;
    st[q + 22] = 0;
    st[cp + 17] = 0;
    var r = 0;
    if failed {
        r = upstream_exec(tab, core, k, "ROLLBACK");
    } else {
        r = upstream_exec(tab, core, k, "COMMIT");
    }
    if r < 0 {
        finish(tab, core, k);
        return 0;
    }
    if !failed && r == 1 {
        st[cp + 18] = 0;
        answer_error(tab, core, client, 73, "40000", "commit-failed", "the database refused to commit the statement");
        return 0;
    }
    if !failed && st[cp + 18] > 0 {
        send(tab, core, client, hd[client * hold_max()..client * hold_max() + st[cp + 18]]);
    }
    st[cp + 18] = 0;
    region z {
        let rq = alloc_slice[z](8, byte_of(0));
        let n = login.ready_for_query(rq, 'I');
        send(tab, core, client, rq[0..n]);
    }
    return 0;
}

// The upstream side `k` of a pair has sent `got` bytes (in `rbuf`). Messages are relayed to the client as they come, in pieces if
// need be, except the ones the proxy acts on: `CommandComplete` (held while the statement is an autocommit one) and
// `ReadyForQuery` (which ends it, and carries the transaction status the proxy keeps).
fn relay_server[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int, got: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let rb = contents(core.rbuf);
    let sb = contents(core.sbuf);
    let hd = contents(core.hold);
    let q = stride() * k;
    let client = st[q + 1];
    let cp = stride() * client;
    var pos = 0;
    while pos < got && st[q] == 3 && st[cp] == 3 {
        if st[q + 20] > 0 {
            // inside a message that is relayed as it comes
            var n = got - pos;
            if n > st[q + 20] {
                n = st[q + 20];
            }
            if !send(tab, core, client, rb[pos..pos + n]) {
                finish(tab, core, k);
                return 0;
            }
            st[q + 20] = st[q + 20] - n;
            pos = pos + n;
        } else {
            // at a message boundary: collect the five bytes of its header
            while st[q + 19] < 5 && pos < got {
                sb[k * sbuf_max() + st[q + 19]] = rb[pos];
                st[q + 19] = st[q + 19] + 1;
                pos = pos + 1;
            }
            if st[q + 19] >= 5 {
                let ty = int_of(sb[k * sbuf_max()]);
                let ln = commit.be(sb, k * sbuf_max() + 1, 4);
                if ln < 4 {
                    finish(tab, core, k);
                    return 0;
                }
                if ty == 'C' || ty == 'Z' {
                    // small and acted on: collect it whole
                    if ln + 1 > sbuf_max() {
                        finish(tab, core, k);
                        return 0;
                    }
                    while st[q + 19] < ln + 1 && pos < got {
                        sb[k * sbuf_max() + st[q + 19]] = rb[pos];
                        st[q + 19] = st[q + 19] + 1;
                        pos = pos + 1;
                    }
                    if st[q + 19] >= ln + 1 {
                        let whole = sb[k * sbuf_max()..k * sbuf_max() + ln + 1];
                        st[q + 19] = 0;
                        if ty == 'C' && st[q + 21] == 1 {
                            // held: the client is told only when the statement is permanent
                            if st[cp + 18] + len(whole) > hold_max() {
                                finish(tab, core, k);
                                return 0;
                            }
                            var i = 0;
                            while i < len(whole) {
                                hd[client * hold_max() + st[cp + 18] + i] = whole[i];
                                i = i + 1;
                            }
                            st[cp + 18] = st[cp + 18] + len(whole);
                        } else if ty == 'Z' && st[q + 21] == 1 {
                            finish_autocommit(tab, core, k, client);
                        } else {
                            if ty == 'Z' {
                                // the transaction state the server says it is in, which the proxy keeps
                                let status = int_of(whole[5]);
                                st[cp + 17] = 0;
                                if status == 'I' {
                                    st[cp + 16] = 0;
                                } else if status == 'T' {
                                    st[cp + 16] = 1;
                                } else {
                                    st[cp + 16] = 2;
                                }
                            }
                            if !send(tab, core, client, whole) {
                                finish(tab, core, k);
                                return 0;
                            }
                        }
                    }
                } else {
                    if ty == 'E' && st[q + 21] == 1 {
                        st[q + 22] = 1;
                    }
                    if !send(tab, core, client, sb[k * sbuf_max()..k * sbuf_max() + 5]) {
                        finish(tab, core, k);
                        return 0;
                    }
                    st[q + 19] = 0;
                    st[q + 20] = ln - 4;
                }
            }
        }
    }
    return 0;
}

// Upstream connection `k` of a pair can be read.
fn server_read[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [conn_read, conn_write, poll] int {
    let rb = contents(core.rbuf);
    match conns.read(tab, k, rb[0..chunk()]) {
        Received::Data(got) => {
            relay_server(tab, core, k, got);
        }
        Received::End => {
            finish(tab, core, k);
        }
        Received::Again => {
        }
        Received::Failed(e) => {
            finish(tab, core, k);
        }
    }
    return 0;
}

// The poller said connection `k` is ready.
fn step[&t, &c, &k](tab: &!t conns.Table, core: &!c Core, clk: &k Clock, k: int, readiness: int) -> [conn_read, conn_write, poll, clock] int {
    let st = contents(core.state);
    let p = stride() * k;
    if readiness % 4 >= 2 && st[p + 2] > 0 {
        drain(tab, core, k);
    }
    if st[p] != 0 && readiness % 2 == 1 {
        if st[p] == 1 || st[p] == 2 {
            if st[p + 4] == 0 {
                hello_read(tab, core, clk, k);
            } else {
                shut(tab, core, k);
            }
        } else if st[p] == 3 {
            if st[p + 3] % 2 == 1 {
                if st[p + 12] > 0 {
                    client_read(tab, core, k);
                } else {
                    server_read(tab, core, k);
                }
            } else {
                finish(tab, core, k);
            }
        }
    }
    return 0;
}

// Open the proxy's own connection to PostgreSQL for catalog questions: login as the configured role, and wait for ReadyForQuery.
// Answers its slot, or -1.
fn catalog_open[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c Core, net: &n Net(""), host: &n [byte], port: int) -> [heap, net_out(""), conn_read, conn_write, poll] (conns.Table, int) {
    let cfg = contents(core.cfg);
    let ci = contents(core.cfgi);
    let si = contents(core.snapin);
    var table = tab;
    var slot = 0 - 1;
    match tcp_connect(net, host, port) {
        Dialed::Ok(server) => {
            let (t1, b) = conns.put(heap, table, server);
            table = t1;
            if b >= 0 {
                var good = false;
                region r {
                    let msg = alloc_slice[r](1024, byte_of(0));
                    let at = startup_msg(msg, cfg, ci, "cancho-db-catalog");
                    borrow mut table as &!tw in {
                        if write_all(tw, b, msg[0..at]) {
                            let got = read_until_ready(tw, b, si, login_ms());
                            // the first message must be AuthenticationOk (R, 8, 0): a password request is not something to answer here
                            if got >= 9 && int_of(si[0]) == 'R' && commit.be(si, 5, 4) == 0 {
                                good = true;
                            }
                        }
                    }
                }
                if good {
                    slot = b;
                    contents(core.state)[stride() * b] = 6;
                    contents(core.state)[stride() * b + 12] = 0 - 1;
                } else {
                    borrow mut table as &!tw in {
                        conns.close(tw, b);
                    }
                }
            }
        }
        Dialed::Failed(e) => {
        }
    }
    return (table, slot);
}

// The schema snapshot, fresh from the catalog, into `core.snap`: its length, or -1 if the catalog cannot be asked. The one
// connection is kept between questions and opened again if PostgreSQL has closed it.
fn snapshot[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c Core, net: &n Net(""), host: &n [byte], port: int) -> [heap, net_out(""), conn_read, conn_write, poll] (conns.Table, int) {
    let aux = contents(core.aux);
    let si = contents(core.snapin);
    var table = tab;
    var attempt = 0;
    while attempt < 2 {
        if aux[0] < 0 {
            let (t1, slot) = catalog_open(heap, table, core, net, host, port);
            table = t1;
            aux[0] = slot;
        }
        if aux[0] >= 0 {
            let slot = aux[0];
            var answered = 0 - 1;
            region r {
                let sql = snapshot_sql();
                let msg = alloc_slice[r](len(sql) + 8, byte_of(0));
                msg[0] = byte_of('Q');
                let ln = len(sql) + 5;
                msg[1] = byte_of(ln / 16777216 % 256);
                msg[2] = byte_of(ln / 65536 % 256);
                msg[3] = byte_of(ln / 256 % 256);
                msg[4] = byte_of(ln % 256);
                var i = 0;
                while i < len(sql) {
                    msg[5 + i] = sql[i];
                    i = i + 1;
                }
                msg[5 + len(sql)] = byte_of(0);
                borrow mut table as &!tw in {
                    if write_all(tw, slot, msg[0..len(sql) + 6]) {
                        answered = read_until_ready(tw, slot, si, login_ms());
                    }
                }
            }
            if answered > 0 {
                let w = build_snapshot(si, answered, contents(core.snap));
                if w >= 0 {
                    return (table, w);
                }
            }
            // it failed: close it, and try once more with a fresh one
            borrow mut table as &!tw in {
                conns.close(tw, slot);
            }
            contents(core.state)[stride() * slot] = 0;
            aux[0] = 0 - 1;
        }
        attempt = attempt + 1;
    }
    return (table, 0 - 1);
}

// The client's BEGIN, COMMIT or ROLLBACK, which the proxy answers itself from its own record of the client's transaction, after
// doing what it means upstream. (A COMMIT of a failed transaction is a ROLLBACK, as in PostgreSQL.) `BEGIN` inside a transaction is
// an error here where PostgreSQL only warns, and COMMIT or ROLLBACK with none open is answered with no warning: both stated in
// docs/m1-commit-path.md.
fn transaction_control[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int, kind: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let p = stride() * k;
    let b = st[p + 1];
    let ts = st[p + 16];
    if kind == 1 {
        if ts == 0 {
            let r = upstream_exec(tab, core, b, "BEGIN");
            if r != 0 {
                answer_error(tab, core, k, 73, "08006", "upstream-unavailable", "the database could not begin a transaction");
                return 0;
            }
            st[p + 16] = 1;
            answer_tag(tab, core, k, 'T', "BEGIN");
        } else if ts == 1 {
            answer_error(tab, core, k, 'T', "25001", "transaction-in-progress", "there is already a transaction in progress");
        } else {
            answer_error(tab, core, k, 'E', "25P02", "in-failed-transaction", "current transaction is aborted, commands ignored until end of transaction block");
        }
        return 0;
    }
    if ts == 0 {
        if kind == 2 {
            answer_tag(tab, core, k, 'I', "COMMIT");
        } else {
            answer_tag(tab, core, k, 'I', "ROLLBACK");
        }
        return 0;
    }
    var sql = "ROLLBACK";
    if kind == 2 && ts == 1 {
        sql = "COMMIT";
    }
    let r = upstream_exec(tab, core, b, sql);
    st[p + 16] = 0;
    if r < 0 {
        finish(tab, core, k);
    } else if r == 1 {
        answer_error(tab, core, k, 73, "40000", "commit-failed", "the database refused to commit the transaction");
    } else if kind == 2 && ts == 1 {
        answer_tag(tab, core, k, 'I', "COMMIT");
    } else {
        answer_tag(tab, core, k, 'I', "ROLLBACK");
    }
    return 0;
}

// A statement the guard refused. Inside a transaction that aborts it, as an error would in PostgreSQL: the proxy rolls the
// upstream transaction back at once (its locks go with it) and the client is `E` until its own ROLLBACK.
fn refused_query[&t, &c, &v](tab: &!t conns.Table, core: &!c Core, k: int, vd: &v [int]) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let p = stride() * k;
    let ts = st[p + 16];
    if ts == 1 {
        upstream_exec(tab, core, st[p + 1], "ROLLBACK");
        st[p + 16] = 2;
    }
    var status = 'E';
    if ts == 0 {
        status = 'I';
    }
    answer_error(tab, core, k, status, guard.sqlstate(vd), guard.tag(vd), "the statement was not run");
    return 0;
}

// An allowed statement, rendered into `core.rend` (`rl` bytes): sent upstream as it is inside a transaction; in autocommit the
// proxy opens a transaction first, and `finish_autocommit` ends it when the statement has. In a failed transaction nothing is sent.
fn run_query[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int, rl: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let p = stride() * k;
    let b = st[p + 1];
    let ts = st[p + 16];
    if ts == 2 {
        answer_error(tab, core, k, 'E', "25P02", "in-failed-transaction", "current transaction is aborted, commands ignored until end of transaction block");
        return 0;
    }
    if ts == 0 {
        let r = upstream_exec(tab, core, b, "BEGIN");
        if r != 0 {
            answer_error(tab, core, k, 73, "08006", "upstream-unavailable", "the database could not begin a transaction");
            return 0;
        }
        st[stride() * b + 21] = 1;
        st[stride() * b + 22] = 0;
        st[p + 18] = 0;
    }
    let out = contents(core.qout);
    let total = rl + 6;
    out[0] = byte_of('Q');
    out[1] = byte_of((rl + 5) / 16777216 % 256);
    out[2] = byte_of((rl + 5) / 65536 % 256);
    out[3] = byte_of((rl + 5) / 256 % 256);
    out[4] = byte_of((rl + 5) % 256);
    var i = 0;
    while i < rl {
        out[5 + i] = contents(core.rend)[i];
        i = i + 1;
    }
    out[5 + rl] = byte_of(0);
    st[p + 17] = 1;
    send(tab, core, b, out[0..total]);
    return 0;
}

// Client `k` has a whole simple query waiting: ask the catalog, run the guard, and either send PostgreSQL the guard's rendering
// or tell the client it is refused.
fn serve_one[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c Core, net: &n Net(""), host: &n [byte], port: int, k: int) -> [heap, net_out(""), conn_read, conn_write, poll] conns.Table {
    let st = contents(core.state);
    let mb = contents(core.mbuf);
    let p = stride() * k;
    let base = k * msg_max();
    let ln = commit.be(mb, base + 1, 4);
    var table = tab;
    if int_of(mb[base + ln]) != 0 {
        borrow mut table as &!tw in {
            refuse(tw, core, k, "FATAL", "08P01", "protocol-violation", "a query is not terminated");
        }
        return table;
    }
    let sql = mb[base + 5..base + ln];
    let (t1, snap_len) = snapshot(heap, table, core, net, host, port);
    table = t1;
    // the transaction state the client is in decides what is said, and what is sent
    let ts = st[p + 16];
    var status = 'E';
    if ts == 0 {
        status = 'I';
    } else if ts == 1 {
        status = 'T';
    }
    if snap_len < 0 {
        borrow mut table as &!tw in {
            answer_error(tw, core, k, status, "08006", "catalog-unavailable", "the schema could not be read, so the query was not checked");
        }
    } else {
        region r {
            let vd = alloc_slice[r](8, 0);
            let verdict = guard.check(heap, contents(core.tokb)[k * token_max()..k * token_max() + st[p + 12]], contents(core.snap)[0..snap_len], sql, contents(core.rend), vd);
            borrow mut table as &!tw in {
                if verdict != 0 {
                    refused_query(tw, core, k, vd);
                } else if vd[6] > 0 {
                    transaction_control(tw, core, k, vd[6]);
                } else {
                    run_query(tw, core, k, vd[3]);
                }
            }
        }
    }
    if st[p] == 3 {
        consume(core, k, ln + 1);
        st[p + 14] = 0;
        borrow mut table as &!tw in {
            frame_client(tw, core, k);
        }
    }
    return table;
}

// Serve every client that has a whole simple query waiting, until none has.
fn serve_all[&h, &c, &n](heap: &!h Heap, tab: conns.Table, core: &!c Core, net: &n Net(""), host: &n [byte], port: int) -> [heap, net_out(""), conn_read, conn_write, poll] conns.Table {
    var table = tab;
    var again = true;
    while again {
        again = false;
        var k = 0;
        while k < 2 * max_clients() {
            let st = contents(core.state);
            if st[stride() * k] == 3 && st[stride() * k + 14] == 1 && st[stride() * k + 17] == 0 {
                table = serve_one(heap, table, core, net, host, port, k);
                again = true;
            }
            k = k + 1;
        }
    }
    return table;
}

// Close clients that have taken too long over their login.
fn sweep[&t, &c, &k](tab: &!t conns.Table, core: &!c Core, clk: &k Clock) -> [clock] int {
    let st = contents(core.state);
    let now = clock_ms(clk);
    var k = 0;
    while k < 2 * max_clients() {
        let p = stride() * k;
        if (st[p] == 1 || st[p] == 2) && now - st[p + 11] > hello_ms() {
            shut(tab, core, k);
        }
        k = k + 1;
    }
    return 0;
}

fn run[&h, &l, &n, &k](heap: &!h Heap, listener: &!l Listener, net: &n Net(""), clk: &k Clock, host: &n [byte], port: int, cfg: Box[[byte]], cfgi: Box[[int]]) -> [heap, conn_accept, conn_read, conn_write, net_out(""), poll, clock] int {
    match poller_new() {
        Polling::Ok(p) => {
            var poller = p;
            borrow mut poller as &!pw in {
                poller_add_listener(pw, listener, 0);
            }
            let slots = 2 * max_clients();
            var core = Core { poller: poller, events: box_slice(heap, 128, 0), state: box_slice(heap, stride() * slots + 2 * stride(), 0), rbuf: box_slice(heap, chunk(), byte_of(0)), pends: box_slice(heap, slots * queue_size() + queue_size(), byte_of(0)), hbuf: box_slice(heap, slots * hello_size() + hello_size(), byte_of(0)), cfg: cfg, cfgi: cfgi, tokb: box_slice(heap, slots * token_max() + token_max(), byte_of(0)), mbuf: box_slice(heap, slots * msg_max() + msg_max(), byte_of(0)), snap: box_slice(heap, snap_max(), byte_of(0)), snapin: box_slice(heap, snapin_max(), byte_of(0)), rend: box_slice(heap, msg_max(), byte_of(0)), qout: box_slice(heap, msg_max() + 16, byte_of(0)), aux: box_slice(heap, 4, 0 - 1), hold: box_slice(heap, slots * hold_max() + hold_max(), byte_of(0)), sbuf: box_slice(heap, slots * sbuf_max() + sbuf_max(), byte_of(0)) };
            var tab = conns.empty(heap, 64);
            while true {
                var ready = 0 - 1;
                borrow mut core as &!cw in {
                    ready = poller_wait(cw.poller, contents(cw.events), 1000);
                }
                var j = 0;
                while j < ready {
                    var token = 0 - 1;
                    var readiness = 0;
                    borrow core as &cr in {
                        token = contents(cr.events)[2 * j];
                        readiness = contents(cr.events)[2 * j + 1];
                    }
                    if token == 0 {
                        borrow mut core as &!cw in {
                            tab = accept_all(heap, tab, listener, cw, clk);
                        }
                    } else {
                        borrow mut tab as &!tw in {
                            borrow mut core as &!cw in {
                                if contents(cw.state)[stride() * (token - 1)] != 0 {
                                    step(tw, cw, clk, token - 1, readiness);
                                }
                            }
                        }
                    }
                    j = j + 1;
                }
                borrow mut core as &!cw in {
                    tab = pair_all(heap, tab, cw, net, host, port);
                    tab = serve_all(heap, tab, cw, net, host, port);
                    borrow mut tab as &!tw in {
                        sweep(tw, cw, clk);
                    }
                }
            }
            conns.drop(heap, tab);
            let Core { poller, events, state, rbuf, pends, hbuf, cfg, cfgi, tokb, mbuf, snap, snapin, rend, qout, aux, hold, sbuf } = core;
            poller_close(poller);
            unbox_slice(heap, events);
            unbox_slice(heap, state);
            unbox_slice(heap, rbuf);
            unbox_slice(heap, pends);
            unbox_slice(heap, hbuf);
            unbox_slice(heap, cfg);
            unbox_slice(heap, cfgi);
            unbox_slice(heap, tokb);
            unbox_slice(heap, mbuf);
            unbox_slice(heap, snap);
            unbox_slice(heap, snapin);
            unbox_slice(heap, rend);
            unbox_slice(heap, qout);
            unbox_slice(heap, aux);
            unbox_slice(heap, hold);
            unbox_slice(heap, sbuf);
            return 0;
        }
        Polling::Failed(e) => {
            unbox_slice(heap, cfg);
            unbox_slice(heap, cfgi);
            return 4;
        }
    }
}

// ------------------------------------------------------------------------------------------------ the command line

fn number_of[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 || len(text) > 5 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        n = n * 10 + (c - '0');
        i = i + 1;
    }
    return n;
}

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10;
    }
    return 0 - 1;
}

// Copies `text` into `dst` at `at`; answers where it ended.
fn copy_in[&d, &s](dst: &!d [byte], at: int, text: &s [byte]) -> [] int {
    var i = 0;
    while i < len(text) {
        dst[at + i] = text[i];
        i = i + 1;
    }
    return at + len(text);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(fs);
    release(ffi);
    var status = 2;
    var listen_port = 0 - 1;
    var server_port = 0 - 1;
    var good = false;
    borrow args as &g in {
        if arg_count(g) == 8 {
            listen_port = number_of(arg(g, 1));
            server_port = number_of(arg(g, 3));
            good = listen_port > 0 && listen_port < 65536 && server_port > 0 && server_port < 65536 && len(arg(g, 4)) > 0 && len(arg(g, 5)) == 64 && len(arg(g, 6)) > 0 && len(arg(g, 7)) > 0;
            var i = 0;
            while good && i < 64 {
                if hexval(int_of(arg(g, 5)[i])) < 0 {
                    good = false;
                }
                i = i + 1;
            }
        }
    }
    if !good {
        borrow mut io as &!e in {
            io.error_all(e, "usage: proxy <listen port> <upstream host> <upstream port> <branch> <root key, 64 hex digits> <upstream user> <upstream database>\n");
        }
    } else {
        status = 3;
        borrow args as &g in {
            let branch = arg(g, 4);
            let user = arg(g, 6);
            let dbname = arg(g, 7);
            borrow mut heap as &!h in {
                var cfg = box_slice(h, 32 + len(branch) + len(user) + len(dbname), byte_of(0));
                var cfgi = box_slice(h, 6, 0);
                borrow mut cfg as &!cb in {
                    borrow mut cfgi as &!ib in {
                        let c = contents(cb);
                        let ci = contents(ib);
                        var j = 0;
                        while j < 32 {
                            c[j] = byte_of(hexval(int_of(arg(g, 5)[2 * j])) * 16 + hexval(int_of(arg(g, 5)[2 * j + 1])));
                            j = j + 1;
                        }
                        var at = 0;
                        ci[0] = at;
                        ci[1] = len(branch);
                        at = copy_in(c, 32 + at, branch) - 32;
                        ci[2] = at;
                        ci[3] = len(user);
                        at = copy_in(c, 32 + at, user) - 32;
                        ci[4] = at;
                        ci[5] = len(dbname);
                        at = copy_in(c, 32 + at, dbname) - 32;
                    }
                }
                borrow net as &nn in {
                    match tcp_listen(nn, listen_port, 1024, 0) {
                        Listening::Ok(l) => {
                            var listener = l;
                            borrow mut listener as &!lh in {
                                listener_nonblocking(lh);
                                borrow mut io as &!o in {
                                    io.write_all(o, "listening\n");
                                }
                                borrow clock as &ck in {
                                    status = run(h, lh, nn, ck, arg(g, 2), server_port, cfg, cfgi);
                                }
                            }
                            listener_close(listener);
                        }
                        Listening::Failed(e) => {
                            unbox_slice(h, cfg);
                            unbox_slice(h, cfgi);
                            status = 3;
                        }
                    }
                }
            }
        }
    }
    release(net);
    release(clock);
    release(args);
    release(io);
    release(heap);
    return status;
}
