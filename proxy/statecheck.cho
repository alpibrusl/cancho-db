import std.buffer;
import std.io;
import cdb.build;
import cdb.state;

// `statecheck`: reads commands from standard input, one per line, and writes one result line each (docs/spec/state.md section 6):
//     C FACT ...            FACT = kind:table:pk:old:new, hex, `-` for an absent hash          ->  ok HEX | error RULE
//     S P PARENT... CHANGES P parent states then the changes, hex                              ->  ok HEX
// For tests/state_check.py, which compares it with tools/state.py.

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return 0 - 1;
}

fn digit(v: int) -> [] int {
    if v < 10 {
        return '0' + v;
    }
    return 'a' + v - 10;
}

// The hex text `all[a..b]` decoded into `w` at `at`: its length in bytes, or -1 if it is not hex.
fn hexdec[&s, &w](all: &s [byte], a: int, b: int, w: &!w [byte], at: int) -> [] int {
    if (b - a) % 2 != 0 {
        return 0 - 1;
    }
    var j = 0;
    while j < (b - a) / 2 {
        let hi = hexval(int_of(all[a + 2 * j]));
        let lo = hexval(int_of(all[a + 2 * j + 1]));
        if hi < 0 || lo < 0 {
            return 0 - 1;
        }
        w[at + j] = byte_of(hi * 16 + lo);
        j = j + 1;
    }
    return (b - a) / 2;
}

// The end of the token that starts at `a` (a space, the end of the line `le`, or the colon when `colon` is true).
fn token_end[&s](all: &s [byte], a: int, le: int, colon: bool) -> [] int {
    var e = a;
    while e < le && int_of(all[e]) != ' ' && !(colon && int_of(all[e]) == ':') {
        e = e + 1;
    }
    return e;
}

// One command line `all[ls..le]`. Answers 0 and writes the 32-byte result to `digest`; a positive rule number (state.e_*); or -1 for a malformed command.
// `w` is scratch for decoded bytes, `meta` for the offsets of the facts (9 ints each), `enc` for one fact's encoding and the root, `lv` for the leaves.
fn command[&s, &ww, &mm, &ee, &ll, &rr](all: &s [byte], ls: int, le: int, w: &!ww [byte], meta: &!mm [int], enc: &!ee [byte], lv: &!ll [byte], digest: &!rr [byte]) -> [] int {
    if ls >= le {
        return 0 - 1;
    }
    let cmd = int_of(all[ls]);
    var p = token_end(all, ls, le, false);
    if cmd == 'S' {
        // S P PARENT... CHANGES
        p = p + 1;
        let e = token_end(all, p, le, false);
        if e - p != 1 {
            return 0 - 1;
        }
        let np = int_of(all[p]) - '0';
        if np < 0 || np > 2 {
            return 0 - 1;
        }
        var at = 0;
        var k = 0;
        p = e + 1;
        while k < np + 1 {
            if p >= le {
                return 0 - 1;
            }
            let te = token_end(all, p, le, false);
            if hexdec(all, p, te, w, at) != 32 {
                return 0 - 1;
            }
            at = at + 32;
            p = te + 1;
            k = k + 1;
        }
        if p < le {
            return 0 - 1;
        }
        state.state(np, w[0..32 * np], w[32 * np..32 * np + 32], digest);
        return 0;
    }
    if cmd != 'C' {
        return 0 - 1;
    }
    // C FACT ...: decode every fact, then check and hash them in order
    var at = 0;
    var nf = 0;
    p = p + 1;
    while p < le {
        let te = token_end(all, p, le, false);
        // kind:table:pk:old:new
        let ke = token_end(all, p, te, true);
        if ke == te || ke - p != 1 {
            return 0 - 1;
        }
        let base = 9 * nf;
        meta[base] = int_of(all[p]) - '0';
        var q = ke + 1;
        var f = 1;
        while f < 5 {
            let fe = token_end(all, q, te, true);
            if f >= 3 && fe - q == 1 && int_of(all[q]) == '-' {
                meta[base + 2 * f - 1] = at;
                meta[base + 2 * f] = 0;
            } else {
                let got = hexdec(all, q, fe, w, at);
                if got < 0 {
                    return 0 - 1;
                }
                meta[base + 2 * f - 1] = at;
                meta[base + 2 * f] = got;
                at = at + got;
            }
            if f < 4 {
                if fe >= te {
                    return 0 - 1;
                }
                q = fe + 1;
            } else if fe != te {
                return 0 - 1;
            }
            f = f + 1;
        }
        nf = nf + 1;
        p = te + 1;
    }
    var i = 0;
    while i < nf {
        let b = 9 * i;
        let kind = meta[b];
        let n = state.put_fact(enc, 0, kind, w[meta[b + 1]..meta[b + 1] + meta[b + 2]], w[meta[b + 3]..meta[b + 3] + meta[b + 4]], w[meta[b + 5]..meta[b + 5] + meta[b + 6]], w[meta[b + 7]..meta[b + 7] + meta[b + 8]]);
        if n < 0 {
            return 0 - n;
        }
        if i > 0 {
            let pb = 9 * (i - 1);
            if !state.key_less(w[meta[pb + 1]..meta[pb + 1] + meta[pb + 2]], w[meta[pb + 3]..meta[pb + 3] + meta[pb + 4]], w[meta[b + 1]..meta[b + 1] + meta[b + 2]], w[meta[b + 3]..meta[b + 3] + meta[b + 4]]) {
                return state.e_order();
            }
        }
        state.leaf(enc[0..n], lv[32 * i..32 * i + 32]);
        i = i + 1;
    }
    state.merkle(lv[0..32 * nf], nf, enc[0..32]);
    state.changes(nf, enc[0..32], digest);
    return 0;
}

fn put_str[&i, &s](io: &!i Io, text: &s [byte]) -> [io_write] int {
    var j = 0;
    while j < len(text) {
        putchar(io, int_of(text[j]));
        j = j + 1;
    }
    return 0;
}

fn rule_name(n: int) -> [] int {
    return n;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(ffi);
    release(fs);
    release(args);
    borrow mut heap as &!h in {
        var text = buffer.empty(h, 4096);
        borrow mut io as &!i in {
            text = read_stdin(h, i, text);
        }
        var size = 0;
        borrow text as &t0 in {
            size = buffer.size(t0);
        }
        var w = box_slice(h, size + 64, byte_of(0));
        var m = box_slice(h, 9 * (size / 8 + 4), 0);
        var digest = box_slice(h, 32, byte_of(0));
        var enc = box_slice(h, 140000, byte_of(0));
        var lv = box_slice(h, 32 * (size / 8 + 4), byte_of(0));
        borrow text as &t in {
            let all = buffer.bytes(t);
            var ls = 0;
            while ls < len(all) {
                var le = ls;
                while le < len(all) && int_of(all[le]) != '\n' {
                    le = le + 1;
                }
                var code = 0 - 1;
                borrow mut w as &!ww in {
                    borrow mut m as &!mw in {
                        borrow mut enc as &!ew in {
                            borrow mut lv as &!lw in {
                                borrow mut digest as &!rw in {
                                    code = command(all, ls, le, contents(ww), contents(mw), contents(ew), contents(lw), contents(rw));
                                }
                            }
                        }
                    }
                }
                borrow mut io as &!i in {
                    if code == 0 {
                        put_str(i, "ok ");
                        borrow digest as &rr in {
                            var j = 0;
                            while j < 32 {
                                putchar(i, digit(int_of(contents(rr)[j]) / 16));
                                putchar(i, digit(int_of(contents(rr)[j]) % 16));
                                j = j + 1;
                            }
                        }
                    } else if code == state.e_kind() {
                        put_str(i, "error fact-kind");
                    } else if code == state.e_table() {
                        put_str(i, "error fact-table");
                    } else if code == state.e_pk() {
                        put_str(i, "error fact-pk");
                    } else if code == state.e_image() {
                        put_str(i, "error fact-image");
                    } else if code == state.e_order() {
                        put_str(i, "error facts-unordered");
                    } else {
                        put_str(i, "error command");
                    }
                    putchar(i, '\n');
                }
                ls = le + 1;
            }
        }
        unbox_slice(h, w);
        unbox_slice(h, m);
        unbox_slice(h, digest);
        unbox_slice(h, enc);
        unbox_slice(h, lv);
        buffer.drop(h, text);
    }
    release(io);
    release(heap);
    return 0;
}
