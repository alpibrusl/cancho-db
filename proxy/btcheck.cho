edition 9;

import std.buffer;
import std.io;
import cdb.pager;
import cdb.btree;
import cdb.pstore;

// `btcheck PAGEFILE [CRASH TORN]`: the copy-on-write B+tree (src/btree.cho) on its own, for tests/btree_check.py. PAGEFILE is made if it is missing and opened read-write. There are 16 *slots*, each holding a tree
// (a root page number, 0 for empty); a command works on a slot, and a new write leaves the roots of the other slots (and the old root of the same slot) whole. Commands, one a line, keys and values in hex:
//
//     put S KEY VALUE     (`-` for an empty value or key) slot S becomes the tree with KEY set to VALUE         -> `ok ROOT` or `err CODE`
//     del S KEY           slot S without KEY                                   -> `ok ROOT`, `none` if it was not there, or `err CODE`
//     get S KEY                                                                -> `val HEX`, `none` or `err CODE`
//     next S KEY INCL     the first entry after KEY (at it if INCL is 1)       -> `kv KEYHEX VALHEX`, `none` or `err CODE`
//     fork S T            slot T becomes the same tree as slot S               -> `ok ROOT`
//     root S                                                                   -> `root ROOT`
//     flip PAGE OFFSET    flip a bit of a byte of page PAGE in the file, CRC not restamped (flip again to put it back) -> `ok`
//     init                a new database in an empty file (the two superblocks)    -> `ok`
//     load                the roots of the newest valid superblock into the slots  -> `loaded SEQ`, `empty`, or `err CODE`
//     commit              the slots' roots become the state (src/pstore.cho)        -> `seq N` or `err CODE`
//     sweep               zero the pages nothing names and make them free            -> `swept N` or `err CODE`
//     sync                fsync                                                -> `ok` or `err CODE`
//     steps                                                                    -> `steps N`
//
// With CRASH and TORN (decimal) the pager's crash hook is set (src/pager.cho): the CRASH-th write or sync does not happen (a write happens in part, TORN bytes of it) and nothing after it does.

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return 0 - 1;
}

fn digit(v: int) -> [] int {
    if v < 10 {
        return '0' + v;
    }
    return 'a' + v - 10;
}

fn put_hex[&i, &s](io: &!i Io, bytes: &s [byte]) -> [io_write] int {
    var j = 0;
    while j < len(bytes) {
        putchar(io, digit(int_of(bytes[j]) / 16));
        putchar(io, digit(int_of(bytes[j]) % 16));
        j = j + 1;
    }
    return 0;
}

fn put_str[&i, &s](io: &!i Io, text: &s [byte]) -> [io_write] int {
    var j = 0;
    while j < len(text) {
        putchar(io, int_of(text[j]));
        j = j + 1;
    }
    return 0;
}

fn put_int[&i](io: &!i Io, v: int) -> [io_write] int {
    if v < 0 {
        putchar(io, '-');
        return put_int(io, 0 - v);
    }
    var div = 1;
    while v / div >= 10 {
        div = div * 10;
    }
    while div > 0 {
        putchar(io, '0' + v / div % 10);
        div = div / 10;
    }
    return 0;
}

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

// The start and end of the n-th word of the line `all[ls..le]` (words are separated by one or more spaces): end < start if there is none.
fn word[&a](all: &a [byte], ls: int, le: int, n: int) -> [] (int, int) {
    var at = ls;
    var k = 0;
    while at < le {
        while at < le && int_of(all[at]) == ' ' {
            at = at + 1;
        }
        let st = at;
        while at < le && int_of(all[at]) != ' ' {
            at = at + 1;
        }
        if at > st {
            if k == n {
                return (st, at);
            }
            k = k + 1;
        }
    }
    return (1, 0);
}

fn decimal[&a](all: &a [byte], st: int, en: int) -> [] int {
    var v = 0;
    var i = st;
    while i < en {
        let d = int_of(all[i]) - '0';
        if d < 0 || d > 9 {
            return 0 - 1;
        }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

// Hex text `all[st..en]` decoded into `out`: the length (`-` is the empty string), or -1 if it is not hex.
fn unhex[&a, &o](all: &a [byte], st: int, en: int, out: &!o [byte]) -> [] int {
    if en - st == 1 && int_of(all[st]) == '-' {
        return 0;
    }
    if (en - st) % 2 != 0 || (en - st) / 2 > len(out) {
        return 0 - 1;
    }
    var n = 0;
    var i = st;
    while i < en {
        let h = hexval(int_of(all[i]));
        let l = hexval(int_of(all[i + 1]));
        if h < 0 || l < 0 {
            return 0 - 1;
        }
        out[n] = byte_of(h * 16 + l);
        n = n + 1;
        i = i + 2;
    }
    return n;
}

fn run[&h, &i, &p, &r](heap: &!h Heap, io: &!i Io, pg: &!p pager.Pager, roots: &!r [int]) -> [heap, io_read, io_write, file_read, file_write] int {
    var sc = box_slice(heap, btree.scratch_size(), byte_of(0));
    var kb = box_slice(heap, 512, byte_of(0));
    var vb = box_slice(heap, 2048, byte_of(0));
    var ko = box_slice(heap, 512, byte_of(0));
    var vo = box_slice(heap, 2048, byte_of(0));
    var seq = 0;
    var text = buffer.empty(heap, 4096);
    text = read_stdin(heap, io, text);
    borrow text as &t in {
        let all = buffer.bytes(t);
        var ls = 0;
        while ls < len(all) {
            var le = ls;
            while le < len(all) && int_of(all[le]) != '\n' {
                le = le + 1;
            }
            let (cs, ce) = word(all, ls, le, 0);
            let (ss, se) = word(all, ls, le, 1);
            var slot = 0 - 1;
            if se >= ss {
                slot = decimal(all, ss, se);
            }
            if ce < cs {
                putchar(io, '\n');
            } else if ce - cs == 3 && int_of(all[cs]) == 'p' && int_of(all[cs + 1]) == 'u' && int_of(all[cs + 2]) == 't' {
                let (ks, ke) = word(all, ls, le, 2);
                let (vs, ve) = word(all, ls, le, 3);
                var klen = 0 - 1;
                var vlen = 0 - 1;
                borrow mut kb as &!kw in {
                    klen = unhex(all, ks, ke, contents(kw));
                }
                borrow mut vb as &!vw in {
                    vlen = unhex(all, vs, ve, contents(vw));
                }
                if slot < 0 || slot > 15 || klen < 0 || vlen < 0 {
                    put_str(io, "err args\n");
                } else {
                    var r = 0;
                    borrow mut sc as &!sw in {
                        borrow kb as &kr in {
                            borrow vb as &vr in {
                                r = btree.put(pg, contents(sw), roots[slot], contents(kr)[0..klen], contents(vr)[0..vlen]);
                            }
                        }
                    }
                    if r < 0 {
                        put_str(io, "err ");
                        put_int(io, 0 - r);
                        putchar(io, '\n');
                    } else {
                        roots[slot] = r;
                        put_str(io, "ok ");
                        put_int(io, r);
                        putchar(io, '\n');
                    }
                }
            } else if ce - cs == 3 && int_of(all[cs]) == 'd' && int_of(all[cs + 1]) == 'e' && int_of(all[cs + 2]) == 'l' {
                let (ks, ke) = word(all, ls, le, 2);
                var klen = 0 - 1;
                borrow mut kb as &!kw in {
                    klen = unhex(all, ks, ke, contents(kw));
                }
                if slot < 0 || slot > 15 || klen < 0 {
                    put_str(io, "err args\n");
                } else {
                    var r = 0;
                    borrow mut sc as &!sw in {
                        borrow kb as &kr in {
                            r = btree.del(pg, contents(sw), roots[slot], contents(kr)[0..klen]);
                        }
                    }
                    if r == btree.not_found() {
                        put_str(io, "none\n");
                    } else if r < 0 {
                        put_str(io, "err ");
                        put_int(io, 0 - r);
                        putchar(io, '\n');
                    } else {
                        roots[slot] = r;
                        put_str(io, "ok ");
                        put_int(io, r);
                        putchar(io, '\n');
                    }
                }
            } else if ce - cs == 3 && int_of(all[cs]) == 'g' && int_of(all[cs + 1]) == 'e' && int_of(all[cs + 2]) == 't' {
                let (ks, ke) = word(all, ls, le, 2);
                var klen = 0 - 1;
                borrow mut kb as &!kw in {
                    klen = unhex(all, ks, ke, contents(kw));
                }
                if slot < 0 || slot > 15 || klen < 0 {
                    put_str(io, "err args\n");
                } else {
                    var r = 0;
                    borrow mut sc as &!sw in {
                        borrow kb as &kr in {
                            borrow mut vo as &!ow in {
                                r = btree.get(pg, contents(sw), roots[slot], contents(kr)[0..klen], contents(ow));
                            }
                        }
                    }
                    if r == btree.not_found() {
                        put_str(io, "none\n");
                    } else if r < 0 {
                        put_str(io, "err ");
                        put_int(io, 0 - r);
                        putchar(io, '\n');
                    } else {
                        put_str(io, "val ");
                        borrow vo as &or in {
                            put_hex(io, contents(or)[0..r]);
                        }
                        putchar(io, '\n');
                    }
                }
            } else if ce - cs == 4 && int_of(all[cs]) == 'n' {
                let (ks, ke) = word(all, ls, le, 2);
                let (is, ie) = word(all, ls, le, 3);
                var klen = 0 - 1;
                borrow mut kb as &!kw in {
                    klen = unhex(all, ks, ke, contents(kw));
                }
                if ke < ks {
                    klen = 0;
                }
                if slot < 0 || slot > 15 || klen < 0 {
                    put_str(io, "err args\n");
                } else {
                    var r = 0;
                    var incl = ie > is && int_of(all[is]) == '1';
                    borrow mut sc as &!sw in {
                        borrow kb as &kr in {
                            borrow mut ko as &!xw in {
                                borrow mut vo as &!ow in {
                                    r = btree.next_after(pg, contents(sw), roots[slot], contents(kr)[0..klen], incl, contents(xw), contents(ow));
                                }
                            }
                        }
                    }
                    if r == btree.not_found() {
                        put_str(io, "none\n");
                    } else if r < 0 {
                        put_str(io, "err ");
                        put_int(io, 0 - r);
                        putchar(io, '\n');
                    } else {
                        put_str(io, "kv ");
                        borrow ko as &xr in {
                            put_hex(io, contents(xr)[0..r / 1024]);
                        }
                        putchar(io, ' ');
                        borrow vo as &or in {
                            put_hex(io, contents(or)[0..r % 1024]);
                        }
                        putchar(io, '\n');
                    }
                }
            } else if ce - cs == 4 && int_of(all[cs]) == 'f' && int_of(all[cs + 1]) == 'o' {
                let (ts, te) = word(all, ls, le, 2);
                var to = 0 - 1;
                if te >= ts {
                    to = decimal(all, ts, te);
                }
                if slot < 0 || slot > 15 || to < 0 || to > 15 {
                    put_str(io, "err args\n");
                } else {
                    roots[to] = roots[slot];
                    put_str(io, "ok ");
                    put_int(io, roots[to]);
                    putchar(io, '\n');
                }
            } else if ce - cs == 4 && int_of(all[cs]) == 'f' && int_of(all[cs + 1]) == 'l' {
                let (os, oe) = word(all, ls, le, 2);
                var off = 0 - 1;
                if oe >= os {
                    off = decimal(all, os, oe);
                }
                if slot < 1 || off < 0 || off > 4095 {
                    put_str(io, "err args\n");
                } else {
                    let r = pager.flip(pg, slot, off);
                    if r < 0 {
                        put_str(io, "err 101\n");
                    } else {
                        put_str(io, "ok\n");
                    }
                }
            } else if ce - cs == 4 && int_of(all[cs]) == 'i' {
                // init: a new database in an empty file
                var r = 0;
                borrow mut sc as &!sw in {
                    r = pstore.init(pg, contents(sw));
                }
                if r < 0 {
                    put_str(io, "err ");
                    put_int(io, 0 - r);
                    putchar(io, '\n');
                } else {
                    put_str(io, "ok\n");
                }
            } else if ce - cs == 4 && int_of(all[cs]) == 'l' {
                // load: the roots of the newest valid superblock, into the slots
                var r = 0;
                borrow mut sc as &!sw in {
                    r = pstore.load(pg, contents(sw), roots);
                }
                if r == pstore.no_database() {
                    put_str(io, "empty\n");
                } else if r < 0 {
                    put_str(io, "err ");
                    put_int(io, 0 - r);
                    putchar(io, '\n');
                } else {
                    seq = r;
                    put_str(io, "loaded ");
                    put_int(io, r);
                    putchar(io, '\n');
                }
            } else if ce - cs == 5 && int_of(all[cs]) == 's' && int_of(all[cs + 1]) == 'w' {
                // sweep: zero the pages nothing names and make them free
                var r = 0;
                borrow mut sc as &!sw in {
                    r = pstore.sweep(heap, pg, contents(sw), roots);
                }
                if r < 0 {
                    put_str(io, "err ");
                    put_int(io, 0 - r);
                    putchar(io, '\n');
                } else {
                    put_str(io, "swept ");
                    put_int(io, r);
                    putchar(io, '\n');
                }
            } else if ce - cs == 6 && int_of(all[cs]) == 'c' {
                // commit: the slots' roots become the state
                var r = 0;
                borrow mut sc as &!sw in {
                    r = pstore.commit(pg, contents(sw), roots, seq);
                }
                if r < 0 {
                    put_str(io, "err ");
                    put_int(io, 0 - r);
                    putchar(io, '\n');
                } else {
                    seq = r;
                    put_str(io, "seq ");
                    put_int(io, r);
                    putchar(io, '\n');
                }
            } else if ce - cs == 4 && int_of(all[cs]) == 'r' {
                if slot < 0 || slot > 15 {
                    put_str(io, "err args\n");
                } else {
                    put_str(io, "root ");
                    put_int(io, roots[slot]);
                    putchar(io, '\n');
                }
            } else if ce - cs == 4 && int_of(all[cs]) == 's' && int_of(all[cs + 1]) == 'y' {
                let r = pager.sync(pg);
                if r < 0 {
                    put_str(io, "err ");
                    put_int(io, 0 - r);
                    putchar(io, '\n');
                } else {
                    put_str(io, "ok\n");
                }
            } else {
                put_str(io, "steps ");
                put_int(io, pager.steps(pg));
                putchar(io, '\n');
            }
            ls = le + 1;
        }
    }
    buffer.drop(heap, text);
    unbox_slice(heap, sc);
    unbox_slice(heap, kb);
    unbox_slice(heap, vb);
    unbox_slice(heap, ko);
    unbox_slice(heap, vo);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(tty);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    var status = 2;
    borrow fs as &fsr in {
        borrow args as &g in {
            if arg_count(g) == 2 || arg_count(g) == 4 {
                status = 3;
                match open_new(fsr, arg(g, 1)) {
                    Opened::Ok(nf) => {
                        file_close(nf);
                    }
                    Opened::Failed(e) => {
                    }
                }
                match open_rw(fsr, arg(g, 1)) {
                    Opened::Failed(e) => {
                        status = 4;
                    }
                    Opened::Ok(rf) => {
                        var f = rf;
                        var size = 0;
                        borrow mut f as &!w in {
                            match file_size(w) {
                                Done::Ok(n) => {
                                    size = n;
                                }
                                Done::Failed(e) => {
                                }
                            }
                        }
                        borrow mut heap as &!hh in {
                            var pg = pager.new_pager(hh, f, size);
                            if arg_count(g) == 4 {
                                var crash = 0;
                                var torn = 0;
                                var i = 0;
                                while i < len(arg(g, 2)) {
                                    crash = crash * 10 + int_of(arg(g, 2)[i]) - '0';
                                    i = i + 1;
                                }
                                i = 0;
                                while i < len(arg(g, 3)) {
                                    torn = torn * 10 + int_of(arg(g, 3)[i]) - '0';
                                    i = i + 1;
                                }
                                borrow mut pg as &!cq in {
                                    pager.set_crash(cq, crash, torn);
                                }
                            }
                            var roots = box_slice(hh, 16, 0);
                            borrow mut io as &!oo in {
                                borrow mut pg as &!pp in {
                                    borrow mut roots as &!rw in {
                                        status = run(hh, oo, pp, contents(rw));
                                    }
                                }
                            }
                            unbox_slice(hh, roots);
                            pager.drop_pager(hh, pg);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(args);
    release(io);
    release(heap);
    return status;
}
