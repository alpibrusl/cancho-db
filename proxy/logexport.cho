import std.io;
import cdb.commit;
import cdb.pager;
import cdb.btree;
import cdb.pstore;
import cdb.exec;
import cdb.facts;
import cdb.tables;
import cdb.build;
import cdb.row;

// The log out of a page file, for someone else to keep (docs/m3-engine.md 6av):
//
//     logexport PAGEFILE WHAT [UPTO [FROM]]
//
// writes one thing to the standard output, in the form the verifiers read, and nothing anywhere else:
//
//     anchor   `anchor N ID`: the number of commits in the log and the id of the last, in hex (`anchor 0 -`: none yet)
//     log      `CHODBLG1`, the key, each record (the first UPTO, if given; with FROM, the records of commits FROM to UPTO and no header: what to append to a
//              copy that has FROM)
//     facts    a version-2 delta store, the hashes only, of every commit (of the first UPTO; with FROM, as for `log`)
//     tokens   `CHODBTK1` and each token kept with the log
//     stmts    `CHODBST3` and each statement's record kept with the log
//     sweeps   `sweeps N`: how many times the server has said a sweep was coming (docs/m3-engine.md 6az); a reader that sees it change was raced
//     live     a version-2 dump of every row of every table (with UPTO: only if the log has exactly that many commits)
//
// It opens PAGEFILE to read and never writes to it. A server may be writing the file meanwhile: commits do not disturb a reader, a sweep may (it frees pages for
// the commits after it to write again), and the server says in the tree when one is coming. If that happened while this program read, what it wrote is not to be believed, and it
// says so (`refused export-raced`, status 1). Status 0: the output is whole. Status 2: usage. Every other refusal is status 1 with its tag on the error stream.

fn digit(v: int) -> [] int {
    if v < 10 {
        return '0' + v;
    }
    return 'a' + v - 10;
}

fn put_str[&i, &s](io: &!i Io, text: &s [byte]) -> [io_write] int {
    var j = 0;
    while j < len(text) {
        putchar(io, int_of(text[j]));
        j = j + 1;
    }
    return 0;
}

fn put_int[&i](io: &!i Io, v: int) -> [io_write] int {
    var div = 1;
    while v / div >= 10 {
        div = div * 10;
    }
    while div > 0 {
        putchar(io, '0' + v / div % 10);
        div = div / 10;
    }
    return 0;
}

fn put_hex[&i, &s](io: &!i Io, bytes: &s [byte], a: int, b: int) -> [io_write] int {
    var k = a;
    while k < b {
        putchar(io, digit(int_of(bytes[k]) / 16));
        putchar(io, digit(int_of(bytes[k]) % 16));
        k = k + 1;
    }
    return 0;
}

fn put_raw[&i, &s](io: &!i Io, bytes: &s [byte], a: int, b: int) -> [io_write] int {
    var k = a;
    while k < b {
        putchar(io, int_of(bytes[k]));
        k = k + 1;
    }
    return 0;
}

fn put_u32[&i](io: &!i Io, v: int) -> [io_write] int {
    putchar(io, v / 16777216 % 256);
    putchar(io, v / 65536 % 256);
    putchar(io, v / 256 % 256);
    putchar(io, v % 256);
    return 0;
}

fn same[&a](text: &a [byte], word: &static [byte]) -> [] bool {
    if len(text) != len(word) {
        return false;
    }
    var i = 0;
    while i < len(word) {
        if int_of(text[i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// What can go wrong, each with its tag (`rule`).
fn usage() -> [] int {
    return 2;
}

fn no_file() -> [] int {
    return 3;
}

fn no_database() -> [] int {
    return 4;
}

fn no_log() -> [] int {
    return 5;
}

fn damaged() -> [] int {
    return 6;
}

fn behind() -> [] int {
    return 7;
}

fn raced() -> [] int {
    return 8;
}

fn rule(code: int) -> [] &static [byte] {
    if code == usage() {
        return "export-usage";
    }
    if code == no_file() {
        return "export-no-file";
    }
    if code == no_database() {
        return "export-no-database";
    }
    if code == no_log() {
        return "export-no-log";
    }
    if code == behind() {
        return "export-behind";
    }
    if code == raced() {
        return "export-raced";
    }
    return "export-damaged";
}

// A count of commits in decimal: its value, or -1 (not a number, or one too long to be a count).
fn number[&a](text: &a [byte]) -> [] int {
    if len(text) < 1 || len(text) > 12 {
        return 0 - 1;
    }
    var v = 0;
    var i = 0;
    while i < len(text) {
        let d = int_of(text[i]) - '0';
        if d < 0 || d > 9 {
            return 0 - 1;
        }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

// How many commits the log in the tree `root` has, and the id of the last into `ident`: what the head of the log says (one key of the tree); or minus a refusal's code.
fn count[&q, &z, &d](pg: &!z pager.Pager, w: &!q exec.Work, root: int, ident: &!d [byte]) -> [file_read] int {
    let hk = tables.head_key(contents(w.key));
    let hr = btree.get(pg, contents(w.sc), root, contents(w.key)[0..hk], contents(w.cur));
    if hr == btree.not_found() {
        return 0;
    }
    if hr != 72 {
        return 0 - damaged();
    }
    exec.copy(contents(w.cur), 8, 32, ident, 0);
    return commit.be(contents(w.cur), 0, 8) + 1;
}

// The log: the header (if `from` is 0) and the records of the commits `from` to `upto` (not included).
fn put_log[&i, &q, &z, &r](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, root: int, from: int, upto: int, rec: &!r [byte]) -> [io_write, file_read] int {
    var n = facts.header(pg, w, root, rec);
    if n <= 0 {
        return damaged();
    }
    if from == 0 {
        put_raw(io, rec, 0, n);
    }
    var seq = from;
    while seq < upto {
        n = facts.record(pg, w, root, seq, rec);
        if n <= 0 {
            return damaged();
        }
        put_raw(io, rec, 0, n);
        seq = seq + 1;
    }
    return 0;
}

// The facts of the first `upto` commits, as lines of a version-2 delta store that hold the hashes and nothing else (docs/spec/l3a.md section 9: the form of an erased line).
fn put_facts[&i, &q, &z, &r](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, root: int, from: int, upto: int, rec: &!r [byte]) -> [io_write, file_read] int {
    if from == 0 {
        put_str(io, "CHODBDL2\n");
    }
    var status = 0;
    region g {
        let fk = alloc_slice[g](256, byte_of(0));
        let fv = alloc_slice[g](66, byte_of(0));
        let ident = alloc_slice[g](32, byte_of(0));
        var of = 0 - 1;
        var an = 0;
        var line = 0;
        if from > 0 {
            // the first fact of commit `from` or after: the key that is the commit's number alone is before them all
            build.put_be(fk, 0, from, 8);
            an = 8;
        }
        var n = facts.next_fact(pg, w, root, fk, an, fv);
        while n > 0 && status == 0 {
            an = n;
            let seq = commit.be(fk, 0, 8);
            if seq >= upto {
                n = 0;
            } else {
                if seq != of {
                    // the id of the commit these facts are of
                    let rn = facts.record(pg, w, root, seq, rec);
                    if rn <= 0 {
                        status = damaged();
                    } else {
                        build.id(rec[4..rn - 64], ident);
                        of = seq;
                        line = 0;
                    }
                }
                if status == 0 && line >= line_space() {
                    status = damaged();
                }
                if status == 0 {
                    // a line's number is its commit's and its place in the commit: the same whatever part of the store is written
                    put_int(io, seq * line_space() + line);
                    putchar(io, '\t');
                    put_hex(io, ident, 0, 32);
                    put_str(io, "\tpublic\t");
                    var k = 8;
                    while k < n && int_of(fk[k]) != 0 {
                        k = k + 1;
                    }
                    put_hex(io, fk, 8, k);
                    putchar(io, '\t');
                    put_hex(io, fk, k + 1, n);
                    var side = 0;
                    while side < 2 {
                        putchar(io, '\t');
                        if int_of(fv[33 * side]) == 1 {
                            put_hex(io, fv, 33 * side + 1, 33 * side + 33);
                        }
                        side = side + 1;
                    }
                    put_str(io, "\t\t\t\t\t\t\n");
                    line = line + 1;
                    n = facts.next_fact(pg, w, root, fk, an, fv);
                }
            }
        }
        if n < 0 {
            status = damaged();
        }
    }
    return status;
}

// A line of the store is numbered by its commit and its place among the commit's lines; a commit has fewer lines than this.
fn line_space() -> [] int {
    return 10000000;
}

// What is kept with the log under an id: the tokens (kind 7), the statements' records (kind 8).
fn put_kept[&i, &q, &z](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, root: int, kind: int) -> [io_write, file_read] int {
    if kind == 7 {
        put_str(io, "CHODBTK1");
    } else {
        put_str(io, "CHODBST3");
    }
    var status = 0;
    region g {
        let ident = alloc_slice[g](32, byte_of(0));
        let item = alloc_slice[g](60000, byte_of(0));
        var an = 0;
        var n = facts.next_kept(pg, w, root, kind, ident, an, item);
        while n > 0 {
            an = 32;
            put_u32(io, n);
            put_raw(io, item, 0, n);
            n = facts.next_kept(pg, w, root, kind, ident, an, item);
        }
        if n < 0 {
            status = damaged();
        }
    }
    return status;
}

// Every row of the table `name` as lines of a version-2 dump: the schema, the table, the key, its salt, the image, its salt.
fn put_table[&i, &z, &q, &n](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, root: int, name: &n [byte]) -> [io_write, file_read] int {
    let el = tables.find(pg, contents(w.sc), root, name, contents(w.key), contents(w.nrow));
    if el < 0 {
        return damaged();
    }
    let id = tables.id_of(contents(w.nrow));
    let dl = tables.def_len(contents(w.nrow));
    var kl = build.put_be(contents(w.key), 0, id, 4);
    var status = 0;
    var more = true;
    region g {
        let text = alloc_slice[g](16384, byte_of(0));
        while more {
            let r = btree.next_after(pg, contents(w.sc), root, contents(w.key)[0..kl], false, contents(w.key2), contents(w.cur));
            if r < 0 || r / 1024 < 4 || commit.be(contents(w.key2), 0, 4) != id {
                more = false;
                if r < 0 && r != btree.not_found() {
                    status = damaged();
                }
            } else {
                let nv = r % 1024;
                var pl = 0 - 1;
                var il = 0 - 1;
                if nv >= 32 {
                    pl = row.plain_key(contents(w.nrow)[6..6 + dl], contents(w.cur)[32..nv], text[0..8192]);
                    il = row.image(contents(w.nrow)[6..6 + dl], contents(w.cur)[32..nv], text[8192..16384]);
                }
                if pl < 0 || il < 0 {
                    more = false;
                    status = damaged();
                } else {
                    put_str(io, "public\t");
                    put_hex(io, name, 0, len(name));
                    putchar(io, '\t');
                    if pl == 0 {
                        putchar(io, '.');
                    }
                    put_hex(io, text, 0, pl);
                    putchar(io, '\t');
                    put_hex(io, contents(w.cur), 0, 16);
                    putchar(io, '\t');
                    put_hex(io, text, 8192, 8192 + il);
                    putchar(io, '\t');
                    put_hex(io, contents(w.cur), 16, 32);
                    putchar(io, '\n');
                    kl = exec.copy(contents(w.key2), 0, r / 1024, contents(w.key), 0);
                }
            }
        }
    }
    return status;
}

// Every row of every table the catalog of the tree `root` names.
fn put_live[&i, &z, &q](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, root: int) -> [io_write, file_read] int {
    put_str(io, "CHODBLV2\n");
    var status = 0;
    region g {
        let at = alloc_slice[g](80, byte_of(0));
        let next = alloc_slice[g](1024, byte_of(0));
        let ent = alloc_slice[g](1024, byte_of(0));
        var al = 4;
        var more = root != 0;
        while more && status == 0 {
            let r = btree.next_after(pg, contents(w.sc), root, at[0..al], false, next, ent);
            if r == btree.not_found() {
                more = false;
            } else if r < 0 {
                status = damaged();
            } else {
                let nk = r / 1024;
                if nk < 5 || commit.be(next, 0, 4) != 0 {
                    // past the catalog
                    more = false;
                } else if nk > len(at) {
                    status = damaged();
                } else {
                    al = exec.copy(next, 0, nk, at, 0);
                    if int_of(at[4]) > 4 {
                        // a table (an index, a counter, a sequence and the head of the log are under 1 to 4, `src/tables.cho`)
                        status = put_table(io, pg, w, root, at[4..al]);
                    }
                }
            }
        }
    }
    return status;
}

// The thing asked for, from the tree `root`: 0, or a refusal's code.
fn export[&i, &z, &q, &a](io: &!i Io, pg: &!z pager.Pager, w: &!q exec.Work, root: int, what: &a [byte], upto: int, from: int, swept: int) -> [io_write, file_read] int {
    var status = 0;
    region g {
        let rec = alloc_slice[g](facts.max_record(), byte_of(0));
        let ident = alloc_slice[g](32, byte_of(0));
        let logged = facts.header(pg, w, root, rec);
        var n = 0;
        if logged < 0 {
            status = damaged();
        } else if logged > 0 {
            n = count(pg, w, root, ident);
            if n < 0 {
                status = 0 - n;
            }
        }
        if status == 0 && upto > n {
            status = behind();
        }
        var stop = n;
        if upto >= 0 {
            stop = upto;
        }
        if status == 0 && from > stop {
            status = behind();
        }
        if status != 0 {
        } else if same(what, "sweeps") {
            put_str(io, "sweeps ");
            put_int(io, swept);
            putchar(io, '\n');
        } else if same(what, "live") {
            if upto >= 0 && upto != n {
                // the rows are the rows now: they are of the log asked for only if nothing was committed since
                status = behind();
            } else {
                status = put_live(io, pg, w, root);
            }
        } else if logged == 0 {
            status = no_log();
        } else if same(what, "anchor") {
            put_str(io, "anchor ");
            put_int(io, n);
            putchar(io, ' ');
            if n == 0 {
                putchar(io, '-');
            } else {
                put_hex(io, ident, 0, 32);
            }
            putchar(io, '\n');
        } else if same(what, "log") {
            status = put_log(io, pg, w, root, from, stop, rec);
        } else if same(what, "facts") {
            status = put_facts(io, pg, w, root, from, stop, rec);
        } else if same(what, "tokens") {
            status = put_kept(io, pg, w, root, 7);
        } else if same(what, "stmts") {
            status = put_kept(io, pg, w, root, 8);
        } else {
            status = usage();
        }
    }
    return status;
}

// How many sweeps the tree `root` says were announced (`tables.sweeps`), or a negative number.
fn sweeps_of[&z, &q](pg: &!z pager.Pager, w: &!q exec.Work, root: int) -> [file_read] int {
    var n = 0 - 1;
    region g {
        let key = alloc_slice[g](8, byte_of(0));
        let num = alloc_slice[g](1024, byte_of(0));
        n = tables.sweeps(pg, exec.scratch(w), root, key, num);
    }
    return n;
}

// The same number as a pager that has read nothing of the file sees it now, in the state the file is in now; or a negative number.
fn sweeps_now[&h, &f, &p, &r](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], roots: &!r [int]) -> [heap, fs_read(""), file_read] int {
    var n = 0 - 1;
    match open_read(fs, path) {
        Opened::Failed(e) => {
        }
        Opened::Ok(rf) => {
            var f = rf;
            var size = 0;
            borrow mut f as &!fw in {
                match file_size(fw) {
                    Done::Ok(sz) => {
                        size = sz;
                    }
                    Done::Failed(e) => {
                    }
                }
            }
            var pg = pager.new_pager(heap, f, size);
            var wk = exec.new_work(heap);
            borrow mut pg as &!pp in {
                borrow mut wk as &!ww in {
                    if pstore.load(pp, exec.scratch(ww), roots) >= 0 {
                        n = sweeps_of(pp, ww, roots[0]);
                    }
                }
            }
            exec.drop_work(heap, wk);
            pager.drop_pager(heap, pg);
        }
    }
    return n;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(tty);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    var status = usage();
    borrow fs as &fsr in {
        borrow args as &g in {
            var upto = 0 - 1;
            var from = 0;
            var good = arg_count(g) >= 3 && arg_count(g) <= 5;
            if good && arg_count(g) >= 4 {
                upto = number(arg(g, 3));
                good = upto >= 0;
            }
            if good && arg_count(g) == 5 {
                from = number(arg(g, 4));
                good = from >= 0 && (same(arg(g, 2), "log") || same(arg(g, 2), "facts"));
            }
            if good {
                good = (same(arg(g, 2), "anchor") || same(arg(g, 2), "sweeps")) && arg_count(g) == 3 || same(arg(g, 2), "log") || same(arg(g, 2), "facts") || same(arg(g, 2), "live") || (same(arg(g, 2), "tokens") || same(arg(g, 2), "stmts")) && arg_count(g) == 3;
            }
            if good {
                status = no_file();
                match open_read(fsr, arg(g, 1)) {
                    Opened::Failed(e) => {
                    }
                    Opened::Ok(rf) => {
                        var f = rf;
                        var size = 0;
                        borrow mut f as &!fw in {
                            match file_size(fw) {
                                Done::Ok(n) => {
                                    size = n;
                                }
                                Done::Failed(e) => {
                                }
                            }
                        }
                        borrow mut heap as &!hh in {
                            var pg = pager.new_pager(hh, f, size);
                            var wk = exec.new_work(hh);
                            var roots = box_slice(hh, 16, 0);
                            var seq = 0 - 1;
                            var swept = 0 - 1;
                            borrow mut roots as &!rw in {
                                borrow mut pg as &!pp in {
                                    borrow mut wk as &!ww in {
                                        seq = pstore.load(pp, exec.scratch(ww), contents(rw));
                                        if seq == pstore.no_database() {
                                            status = no_database();
                                        } else if seq < 0 {
                                            status = damaged();
                                        } else {
                                            swept = sweeps_of(pp, ww, contents(rw)[0]);
                                            if swept < 0 {
                                                status = damaged();
                                            } else {
                                                borrow mut io as &!oo in {
                                                    status = export(oo, pp, ww, contents(rw)[0], arg(g, 2), upto, from, swept);
                                                }
                                            }
                                        }
                                    }
                                }
                                if swept >= 0 && status != usage() {
                                    // pages are written again only after a sweep has freed them, and the commit before a sweep raises a number in the tree
                                    // (docs/m3-engine.md 6az): if it is not what it was when this program began, a page it read may have been another's
                                    if sweeps_now(hh, fsr, arg(g, 1), contents(rw)) != swept {
                                        status = raced();
                                    }
                                }
                            }
                            unbox_slice(hh, roots);
                            exec.drop_work(hh, wk);
                            pager.drop_pager(hh, pg);
                        }
                    }
                }
            }
        }
    }
    borrow mut io as &!oo in {
        if status == usage() {
            io.error_all(oo, "usage: logexport PAGEFILE anchor|log|facts|tokens|stmts|live|sweeps [UPTO [FROM]]\n");
        }
        if status != 0 {
            io.error_all(oo, "refused ");
            io.error_all(oo, rule(status));
            io.error_all(oo, "\n");
            if status != usage() {
                status = 1;
            }
        }
    }
    release(fs);
    release(args);
    release(io);
    release(heap);
    return status;
}
