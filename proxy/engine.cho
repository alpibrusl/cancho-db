edition 9;

import std.io;
import cdb.pager;
import cdb.pstore;
import cdb.exec;
import cdb.drive;
import cdb.wire;
import cdb.serve;
import cdb.tlsio;
import cdb.tlsid;
import tls;

// The engine's server (docs/m3-engine.md 6al): PostgreSQL's protocol in front of the engine, with no PostgreSQL behind it.
//
//     engine PAGEFILE PORT [KEYFILE [ROOTFILE [IDLE_MS WRITE_MS [REVOKEDFILE]]]] [tls=DIRECTORY] [places=N] [check-purge]
//
// `tls=DIRECTORY` (docs/m3-engine.md 6bq): the directory holds `chain.pem` and `key.pem` (ECDSA P-256), and a client that asks for TLS is given it. A directory whose
// files cannot be read or are refused is a refusal to start (status 2), with the reason on standard error.
//
// `check-purge` as the last word (docs/m3-engine.md 6bh): the garbage an erase finds is held to the sweep's walk before it is zeroed, and the server stops if they differ. For the tests.
//
// REVOKEDFILE: the root's list of revoked tokens (docs/spec/token.md section 3), read again whenever it has grown (docs/m3-engine.md 6bd); a token on it, or made from one
// on it, is not let in and runs nothing more.
// `places=N` (6bt): how many connections at once, 1 to 128 (16 without it); an address that is not this machine's holds at most a quarter of them.
// Up to that many connections: from this machine, and with both `tls=` and ROOTFILE from any other too, through TLS only (docs/m3-engine.md 6br). ROOTFILE: 64 hexadecimal digits, the public key of the root that signs capability tokens; with it a client logs in with a
// token as its password (docs/m3-engine.md 6at); `-` or nothing: no login. KEYFILE: 64 hexadecimal digits, the seed of the key that signs the log; with it every commit that changed rows is
// recorded in the page file with what it wrote (docs/m3-engine.md 6as), without it nothing is recorded. IDLE_MS: how long a transaction may idle while another connection waits for it (default 30000); WRITE_MS:
// how long a client may take none of its answer, or not finish its startup (default 10000). It writes `listening` to standard error when it is, and ends when the listener fails or the page
// file cannot be committed. Status 2: usage; 3: the file or the port cannot be opened; 5: the page file is not a database; 7: a commit of the page file failed.

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return 0 - 1;
}

// The 32 bytes a file holds as 64 hexadecimal digits (and at most a newline): whether it does.
fn hex_file[&f, &p, &o](fs: &f Fs(""), path: &p [byte], out: &!o [byte]) -> [fs_read(""), file_read] bool {
    var ok = false;
    region r {
        let kb = alloc_slice[r](80, byte_of(0));
        match open_read(fs, path) {
            Opened::Ok(kf) => {
                var kfile = kf;
                borrow mut kfile as &!kw in {
                    match file_read(kw, kb) {
                        Read::Got(n) => {
                            ok = n >= 64 && n <= 66;
                            var i = 0;
                            while i < 32 && ok {
                                let hi = hexval(int_of(kb[2 * i]));
                                let lo = hexval(int_of(kb[2 * i + 1]));
                                ok = hi >= 0 && lo >= 0;
                                out[i] = byte_of((hi * 16 + lo) % 256);
                                i = i + 1;
                            }
                        }
                        Read::End => {
                        }
                        Read::Failed(e) => {
                        }
                    }
                }
                file_close(kfile);
            }
            Opened::Failed(e) => {
            }
        }
    }
    return ok;
}

fn number_of[&t](text: &t [byte]) -> [] int {
    var v = 0;
    var i = 0;
    if len(text) == 0 || len(text) > 5 {
        return 0 - 1;
    }
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + c - '0';
        i = i + 1;
    }
    return v;
}

fn listen_on[&h, &n, &o, &k, &z, &q, &b, &y, &j, &f, &e, &d, &s](heap: &!h Heap, io: &!o Io, net: &n Net(""), clk: &k Clock, port: int, idle_ms: int, write_ms: int, checks: int, key: &y [byte], rootkey: &j [byte], pg: &!z pager.Pager, w: &!q exec.Work, sub: &!b drive.Sub, revoked: &!f File, eng: &!e tls.Engine, secure: bool, nplaces: int, dir: &d Dir, seen: &!s [byte]) -> [heap, err_write, dir_read, net_in(""), conn_accept, conn_read, conn_write, poll, clock, file_read, file_write] int {
    var roots = box_slice(heap, 16, 0);
    var globals = box_slice(heap, serve.globals(), 0);
    var states = box_slice(heap, serve.stride() * nplaces, 0);
    var inb = box_slice(heap, serve.in_size() * nplaces, byte_of(0));
    var outb = box_slice(heap, 1048576, byte_of(0));
    var arena = box_slice(heap, serve.arena_size() * nplaces, byte_of(0));
    var index = box_slice(heap, serve.index_size() * nplaces, 0);
    var raws = box_slice(heap, tlsio.raw_size() * nplaces, byte_of(0));
    var draws = box_slice(heap, exec.seq_room() * nplaces, 0);
    var status = 0;
    borrow mut roots as &!rw in {
        borrow mut globals as &!gw in {
            let rs = contents(rw);
            let gs = contents(gw);
            var seq = pstore.load(pg, exec.scratch(w), rs);
            if seq == pstore.no_database() {
                seq = pstore.init(pg, exec.scratch(w));
            }
            // before anyone is served, the pages the last run left behind are taken back (docs/m3-engine.md 6ay): a server stopped by a full disk starts again with
            // the room there is in its own file
            if seq >= 0 && serve.reclaim(heap, gs, pg, w, rs, true) < 0 {
                seq = 0 - 1;
            }
            if seq < 0 {
                status = 5;
            } else {
                gs[serve.g_seq()] = seq;
                gs[serve.g_idle_ms()] = idle_ms;
                gs[serve.g_write_ms()] = write_ms;
                gs[serve.g_check()] = checks;
                gs[serve.g_places()] = nplaces;
                if secure {
                    gs[serve.g_tls()] = 1;
                }
                if len(rootkey) == 32 {
                    gs[serve.g_login()] = 1;
                    var rk = 0;
                    while rk < 32 {
                        gs[serve.g_root() + rk] = int_of(rootkey[rk]);
                        rk = rk + 1;
                    }
                }
                if len(key) == 32 {
                    gs[serve.g_logs()] = 1;
                    var kk = 0;
                    while kk < 32 {
                        gs[serve.g_key() + kk] = int_of(key[kk]);
                        kk = kk + 1;
                    }
                }
                match tcp_listen(net, port, 64, 0) {
                    Listening::Ok(l) => {
                        var listener = l;
                        borrow mut listener as &!lh in {
                            listener_nonblocking(lh);
                            io.error_all(io, "listening\n");
                            if len(key) != 32 {
                                io.error_all(io, "engine: no key file was named: commits are not recorded in the log\n");
                            }
                            if len(rootkey) != 32 {
                                io.error_all(io, "engine: no root key was named: there is no login, and any client on this machine is served\n");
                            }
                            borrow mut states as &!sw in {
                                borrow mut inb as &!ib in {
                                    borrow mut outb as &!ob in {
                                        borrow mut arena as &!ab in {
                                            borrow mut index as &!xb in {
                                                borrow mut raws as &!wb in {
                                                    borrow mut draws as &!qb in {
                                                        status = serve.run(heap, lh, clk, revoked, pg, w, sub, contents(ib), contents(ob), rs, gs, contents(sw), contents(ab), contents(xb), eng, contents(wb), io, dir, seen, contents(qb));
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        listener_close(listener);
                    }
                    Listening::Failed(e) => {
                        status = 3;
                    }
                }
            }
        }
    }
    unbox_slice(heap, roots);
    unbox_slice(heap, globals);
    unbox_slice(heap, states);
    unbox_slice(heap, inb);
    unbox_slice(heap, outb);
    unbox_slice(heap, arena);
    unbox_slice(heap, index);
    unbox_slice(heap, raws);
    unbox_slice(heap, draws);
    return status;
}

// Whether the command line ends with the word `check-purge` (6bh): every erase's garbage is then held to the sweep's walk before it is zeroed. For the tests: it costs the walk.
fn checking[&a](args: &a Args) -> [args] bool {
    let n = arg_count(args);
    if n < 4 {
        return false;
    }
    let last = arg(args, n - 1);
    let want = "check-purge";
    if len(last) != len(want) {
        return false;
    }
    var i = 0;
    while i < len(want) {
        if int_of(last[i]) != int_of(want[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn begins[&w](word: &w [byte], lit: &static [byte]) -> [] bool {
    if len(word) < len(lit) {
        return false;
    }
    var i = 0;
    while i < len(lit) {
        if int_of(word[i]) != int_of(lit[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Whether a word is one of the options that come after the words that have a place: `tls=DIRECTORY` (6bq), `places=N` (6bt).
fn is_option[&w](word: &w [byte]) -> [] bool {
    return begins(word, "tls=") || begins(word, "places=");
}

// Where the option that begins `lit` is on the command line: among its last words, before `check-purge`, in any order. -1 if there is none.
fn option_at[&a](args: &a Args, lit: &static [byte]) -> [args] int {
    var at = arg_count(args) - 1;
    if checking(args) {
        at = at - 1;
    }
    while at >= 3 && is_option(arg(args, at)) {
        if begins(arg(args, at), lit) {
            return at;
        }
        at = at - 1;
    }
    return 0 - 1;
}

fn tls_word[&a](args: &a Args) -> [args] int {
    return option_at(args, "tls=");
}

// How many places the command line asks for (6bt): 16 with no `places=N`, N from 1 to `serve.max_places()`, or -1 for anything else.
fn places[&a](args: &a Args) -> [args] int {
    let at = option_at(args, "places=");
    if at < 0 {
        return 16;
    }
    let n = number_of(arg(args, at)[7..len(arg(args, at))]);
    if n < 1 || n > serve.max_places() {
        return 0 - 1;
    }
    return n;
}

// How many words the command line has, without the options and `check-purge`.
fn words[&a](args: &a Args) -> [args] int {
    var n = arg_count(args);
    if checking(args) {
        n = n - 1;
    }
    while n - 1 >= 3 && is_option(arg(args, n - 1)) {
        n = n - 1;
    }
    return n;
}

// 32 bytes from the system into `out`: whether there were.
fn random[&f, &o](fs: &f Fs(""), out: &!o [byte]) -> [fs_read(""), file_read] bool {
    var ok = false;
    match open_read(fs, "/dev/urandom") {
        Opened::Ok(uf) => {
            var u = uf;
            borrow mut u as &!uw in {
                match file_read(uw, out) {
                    Read::Got(n) => {
                        ok = n == len(out);
                    }
                    Read::End => {
                    }
                    Read::Failed(e) => {
                    }
                }
            }
            file_close(u);
        }
        Opened::Failed(e) => {
        }
    }
    return ok;
}

// The directory of the certificate (6bq), opened once: the server reads beneath it and holds no path (6bu). With no `tls=` it is the directory the server was
// started in, and is never read.
fn cert_dir[&f, &a](fs: &f Fs(""), args: &a Args) -> [fs_read(""), args] DirOpened {
    let tw = tls_word(args);
    if tw >= 0 {
        return open_dir(fs, arg(args, tw)[4..len(arg(args, tw))]);
    }
    return open_dir(fs, ".");
}

// The server's certificate and key given to the package when it starts (6bq): whether it took them. What it refuses is said on standard error, with the package's tag.
fn identity[&h, &o, &f, &d, &e, &s](heap: &!h Heap, io: &!o Io, fs: &f Fs(""), dir: &d Dir, eng: &!e tls.Engine, now_ms: int, seen: &!s [byte]) -> [heap, err_write, fs_read(""), dir_read, file_read] bool {
    var ok = false;
    region r {
        let seed = alloc_slice[r](32, byte_of(0));
        if !random(fs, seed) || tls.seed(eng, seed) != 0 {
            io.error_all(io, "engine: tls: no random bytes\n");
        } else {
            let code = tlsid.load(heap, dir, eng, true, now_ms, seen);
            if code == tlsid.no_chain() || code == tlsid.no_key() {
                io.error_all(io, "engine: tls: ");
                io.error_all(io, tlsid.reason(code));
                io.error_all(io, "\n");
            } else if code != 0 {
                io.error_all(io, "engine: tls: refused ");
                io.error_all(io, tlsid.reason(code));
                io.error_all(io, "\n");
            } else {
                ok = true;
            }
        }
    }
    return ok;
}

// The file of revoked tokens the command line names (its eighth word), or one that is always empty.
fn revoked_file[&f, &a](fs: &f Fs(""), args: &a Args) -> [fs_read(""), args] Opened {
    if words(args) == 8 {
        return open_read(fs, arg(args, 7));
    }
    return open_read(fs, "/dev/null");
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(tty);
    release(ffi);
    release(signals);
    release(exec);
    var status = 2;
    borrow fs as &fsr in {
        borrow args as &g in {
            var idle_ms = 30000;
            var write_ms = 10000;
            var checks = 0;
            if checking(g) {
                checks = 1;
            }
            if words(g) == 7 || words(g) == 8 {
                idle_ms = number_of(arg(g, 5));
                write_ms = number_of(arg(g, 6));
            }
            // the seed of the signing key: 64 hexadecimal digits in a file (6as); a file named that is not that is a refusal to start, not a server that does not log
            var keyed = 0;
            var rooted = 0;
            region kr {
                let keyseed = alloc_slice[kr](32, byte_of(0));
                let rootkey = alloc_slice[kr](32, byte_of(0));
                if words(g) >= 4 {
                    keyed = 0 - 1;
                    if hex_file(fsr, arg(g, 3), keyseed) {
                        keyed = 1;
                    }
                }
                // the root's public key (6at): with it a client must log in with a token the root signed; `-` in its place means no login
                if words(g) >= 5 && !(len(arg(g, 4)) == 1 && int_of(arg(g, 4)[0]) == '-') {
                    rooted = 0 - 1;
                    if hex_file(fsr, arg(g, 4), rootkey) {
                        rooted = 1;
                    }
                }
                if (words(g) == 3 || words(g) == 4 || words(g) == 5 || words(g) == 7 || words(g) == 8 && rooted == 1) && number_of(arg(g, 2)) > 0 && number_of(arg(g, 2)) < 65536 && idle_ms > 0 && write_ms > 0 && keyed >= 0 && rooted >= 0 && places(g) > 0 {
                    status = 3;
                    match open_new(fsr, arg(g, 1)) {
                        Opened::Ok(nf) => {
                            file_close(nf);
                        }
                        Opened::Failed(e) => {
                        }
                    }
                    match open_rw(fsr, arg(g, 1)) {
                        Opened::Failed(e) => {
                        }
                        Opened::Ok(rf) => {
                            var f = rf;
                            var size = 0;
                            borrow mut f as &!fw in {
                                match file_size(fw) {
                                    Done::Ok(n) => {
                                        size = n;
                                    }
                                    Done::Failed(e) => {
                                    }
                                }
                            }
                            borrow mut heap as &!hh in {
                                var pg = pager.new_pager(hh, f, size);
                                var wk = exec.new_work(hh);
                                var subs = drive.new(hh);
                                var seeded = false;
                                borrow mut wk as &!ww in {
                                    // the seed of the salts (docs/m3-engine.md 6ag): 32 bytes from the system, kept nowhere. With none there is no server
                                    region sr {
                                        let sd = alloc_slice[sr](32, byte_of(0));
                                        match open_read(fsr, "/dev/urandom") {
                                            Opened::Ok(uf) => {
                                                var u = uf;
                                                borrow mut u as &!uw in {
                                                    match file_read(uw, sd) {
                                                        Read::Got(n) => {
                                                            seeded = n == 32 && exec.seed(ww, sd);
                                                        }
                                                        Read::End => {
                                                        }
                                                        Read::Failed(e) => {
                                                        }
                                                    }
                                                }
                                                file_close(u);
                                            }
                                            Opened::Failed(e) => {
                                            }
                                        }
                                    }
                                    if seeded {
                                        borrow mut io as &!oo in {
                                            borrow mut pg as &!pp in {
                                                borrow mut subs as &!sb in {
                                                    borrow net as &nn in {
                                                        borrow clock as &kk in {
                                                            // the list of revoked tokens (6bd): the file named, or one that is always empty
                                                            match revoked_file(fsr, g) {
                                                                Opened::Ok(rf) => {
                                                                    var rv = rf;
                                                                    borrow mut rv as &!rw in {
                                                                        // the certificate (6bq): one named and not taken is no server
                                                                        var engine = tls.open_server(hh, places(g));
                                                                        borrow mut engine as &!ee in {
                                                                            match cert_dir(fsr, g) {
                                                                                DirOpened::Ok(dh) => {
                                                                                    let cdir = dh;
                                                                                    region cr {
                                                                                        let seen = alloc_slice[cr](64, byte_of(0));
                                                                                        var secure = false;
                                                                                        var refused = false;
                                                                                        borrow cdir as &dd in {
                                                                                            if tls_word(g) >= 0 {
                                                                                                secure = identity(hh, oo, fsr, dd, ee, clock_unix_ms(kk), seen);
                                                                                                refused = !secure;
                                                                                            }
                                                                                            if refused {
                                                                                                status = 2;
                                                                                            } else {
                                                                                                status = listen_on(hh, oo, nn, kk, number_of(arg(g, 2)), idle_ms, write_ms, checks, keyseed[0..32 * keyed], rootkey[0..32 * rooted], pp, ww, sb, rw, ee, secure, places(g), dd, seen);
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                    dir_close(cdir);
                                                                                }
                                                                                DirOpened::Failed(e) => {
                                                                                    io.error_all(oo, "engine: tls: the directory cannot be opened\n");
                                                                                    status = 2;
                                                                                }
                                                                            }
                                                                        }
                                                                        tls.close(hh, engine);
                                                                    }
                                                                    file_close(rv);
                                                                }
                                                                Opened::Failed(e) => {
                                                                    status = 3;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                drive.free(hh, subs);
                                exec.drop_work(hh, wk);
                                pager.drop_pager(hh, pg);
                            }
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(args);
    release(io);
    release(heap);
    release(net);
    release(clock);
    return status;
}
