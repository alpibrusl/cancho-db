edition 9;

import std.io;
import cdb.pager;
import cdb.pstore;
import cdb.exec;
import cdb.drive;
import cdb.wire;
import cdb.serve;
import cdb.tlsio;
import tls;

// The engine's server (docs/m3-engine.md 6al): PostgreSQL's protocol in front of the engine, with no PostgreSQL behind it.
//
//     engine PAGEFILE PORT [KEYFILE [ROOTFILE [IDLE_MS WRITE_MS [REVOKEDFILE]]]] [tls=DIRECTORY] [check-purge]
//
// `tls=DIRECTORY` (docs/m3-engine.md 6bq): the directory holds `chain.pem` and `key.pem` (ECDSA P-256), and a client that asks for TLS is given it. A directory whose
// files cannot be read or are refused is a refusal to start (status 2), with the reason on standard error.
//
// `check-purge` as the last word (docs/m3-engine.md 6bh): the garbage an erase finds is held to the sweep's walk before it is zeroed, and the server stops if they differ. For the tests.
//
// REVOKEDFILE: the root's list of revoked tokens (docs/spec/token.md section 3), read again whenever it has grown (docs/m3-engine.md 6bd); a token on it, or made from one
// on it, is not let in and runs nothing more.
// Up to 16 connections, from this machine only. ROOTFILE: 64 hexadecimal digits, the public key of the root that signs capability tokens; with it a client logs in with a
// token as its password (docs/m3-engine.md 6at); `-` or nothing: no login. KEYFILE: 64 hexadecimal digits, the seed of the key that signs the log; with it every commit that changed rows is
// recorded in the page file with what it wrote (docs/m3-engine.md 6as), without it nothing is recorded. IDLE_MS: how long a transaction may idle while another connection waits for it (default 30000); WRITE_MS:
// how long a client may take none of its answer (default 10000). It writes `listening` to standard error when it is, and ends when the listener fails or the page
// file cannot be committed. Status 2: usage; 3: the file or the port cannot be opened; 5: the page file is not a database; 7: a commit of the page file failed.

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return 0 - 1;
}

// The 32 bytes a file holds as 64 hexadecimal digits (and at most a newline): whether it does.
fn hex_file[&f, &p, &o](fs: &f Fs(""), path: &p [byte], out: &!o [byte]) -> [fs_read(""), file_read] bool {
    var ok = false;
    region r {
        let kb = alloc_slice[r](80, byte_of(0));
        match open_read(fs, path) {
            Opened::Ok(kf) => {
                var kfile = kf;
                borrow mut kfile as &!kw in {
                    match file_read(kw, kb) {
                        Read::Got(n) => {
                            ok = n >= 64 && n <= 66;
                            var i = 0;
                            while i < 32 && ok {
                                let hi = hexval(int_of(kb[2 * i]));
                                let lo = hexval(int_of(kb[2 * i + 1]));
                                ok = hi >= 0 && lo >= 0;
                                out[i] = byte_of((hi * 16 + lo) % 256);
                                i = i + 1;
                            }
                        }
                        Read::End => {
                        }
                        Read::Failed(e) => {
                        }
                    }
                }
                file_close(kfile);
            }
            Opened::Failed(e) => {
            }
        }
    }
    return ok;
}

fn number_of[&t](text: &t [byte]) -> [] int {
    var v = 0;
    var i = 0;
    if len(text) == 0 || len(text) > 5 {
        return 0 - 1;
    }
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + c - '0';
        i = i + 1;
    }
    return v;
}

fn listen_on[&h, &n, &o, &k, &z, &q, &b, &y, &j, &f, &e](heap: &!h Heap, io: &!o Io, net: &n Net(""), clk: &k Clock, port: int, idle_ms: int, write_ms: int, checks: int, key: &y [byte], rootkey: &j [byte], pg: &!z pager.Pager, w: &!q exec.Work, sub: &!b drive.Sub, revoked: &!f File, eng: &!e tls.Engine, secure: bool) -> [heap, err_write, net_in(""), conn_accept, conn_read, conn_write, poll, clock, file_read, file_write] int {
    var roots = box_slice(heap, 16, 0);
    var globals = box_slice(heap, serve.globals(), 0);
    var states = box_slice(heap, serve.stride() * serve.max_clients(), 0);
    var inb = box_slice(heap, serve.in_size() * serve.max_clients(), byte_of(0));
    var outb = box_slice(heap, 1048576, byte_of(0));
    var arena = box_slice(heap, serve.arena_size() * serve.max_clients(), byte_of(0));
    var index = box_slice(heap, serve.index_size() * serve.max_clients(), 0);
    var raws = box_slice(heap, tlsio.raw_size() * serve.max_clients(), byte_of(0));
    var status = 0;
    borrow mut roots as &!rw in {
        borrow mut globals as &!gw in {
            let rs = contents(rw);
            let gs = contents(gw);
            var seq = pstore.load(pg, exec.scratch(w), rs);
            if seq == pstore.no_database() {
                seq = pstore.init(pg, exec.scratch(w));
            }
            // before anyone is served, the pages the last run left behind are taken back (docs/m3-engine.md 6ay): a server stopped by a full disk starts again with
            // the room there is in its own file
            if seq >= 0 && serve.reclaim(heap, gs, pg, w, rs, true) < 0 {
                seq = 0 - 1;
            }
            if seq < 0 {
                status = 5;
            } else {
                gs[serve.g_seq()] = seq;
                gs[serve.g_idle_ms()] = idle_ms;
                gs[serve.g_write_ms()] = write_ms;
                gs[serve.g_check()] = checks;
                if secure {
                    gs[serve.g_tls()] = 1;
                }
                if len(rootkey) == 32 {
                    gs[serve.g_login()] = 1;
                    var rk = 0;
                    while rk < 32 {
                        gs[serve.g_root() + rk] = int_of(rootkey[rk]);
                        rk = rk + 1;
                    }
                }
                if len(key) == 32 {
                    gs[serve.g_logs()] = 1;
                    var kk = 0;
                    while kk < 32 {
                        gs[serve.g_key() + kk] = int_of(key[kk]);
                        kk = kk + 1;
                    }
                }
                match tcp_listen(net, port, 64, 0) {
                    Listening::Ok(l) => {
                        var listener = l;
                        borrow mut listener as &!lh in {
                            listener_nonblocking(lh);
                            io.error_all(io, "listening\n");
                            if len(key) != 32 {
                                io.error_all(io, "engine: no key file was named: commits are not recorded in the log\n");
                            }
                            if len(rootkey) != 32 {
                                io.error_all(io, "engine: no root key was named: there is no login, and any client on this machine is served\n");
                            }
                            borrow mut states as &!sw in {
                                borrow mut inb as &!ib in {
                                    borrow mut outb as &!ob in {
                                        borrow mut arena as &!ab in {
                                            borrow mut index as &!xb in {
                                                borrow mut raws as &!wb in {
                                                    status = serve.run(heap, lh, clk, revoked, pg, w, sub, contents(ib), contents(ob), rs, gs, contents(sw), contents(ab), contents(xb), eng, contents(wb));
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        listener_close(listener);
                    }
                    Listening::Failed(e) => {
                        status = 3;
                    }
                }
            }
        }
    }
    unbox_slice(heap, roots);
    unbox_slice(heap, globals);
    unbox_slice(heap, states);
    unbox_slice(heap, inb);
    unbox_slice(heap, outb);
    unbox_slice(heap, arena);
    unbox_slice(heap, index);
    unbox_slice(heap, raws);
    return status;
}

// Whether the command line ends with the word `check-purge` (6bh): every erase's garbage is then held to the sweep's walk before it is zeroed. For the tests: it costs the walk.
fn checking[&a](args: &a Args) -> [args] bool {
    let n = arg_count(args);
    if n < 4 {
        return false;
    }
    let last = arg(args, n - 1);
    let want = "check-purge";
    if len(last) != len(want) {
        return false;
    }
    var i = 0;
    while i < len(want) {
        if int_of(last[i]) != int_of(want[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Where the command line's `tls=DIRECTORY` is (6bq): its last word, or the one before `check-purge`. -1 if there is none.
fn tls_word[&a](args: &a Args) -> [args] int {
    var at = arg_count(args) - 1;
    if checking(args) {
        at = at - 1;
    }
    if at < 3 {
        return 0 - 1;
    }
    let word = arg(args, at);
    if len(word) > 4 && int_of(word[0]) == 't' && int_of(word[1]) == 'l' && int_of(word[2]) == 's' && int_of(word[3]) == '=' {
        return at;
    }
    return 0 - 1;
}

// How many words the command line has, without those two.
fn words[&a](args: &a Args) -> [args] int {
    var n = arg_count(args);
    if checking(args) {
        n = n - 1;
    }
    if tls_word(args) >= 0 {
        n = n - 1;
    }
    return n;
}

// The file `leaf` of the directory `dir`, read whole into `into`: how many bytes, or -1 if it cannot be read or does not fit.
fn read_whole[&f, &d, &l, &o](fs: &f Fs(""), dir: &d [byte], leaf: &l [byte], into: &!o [byte]) -> [fs_read(""), file_read] int {
    var at = 0 - 1;
    region r {
        let path = alloc_slice[r](len(dir) + 1 + len(leaf), byte_of(0));
        var i = 0;
        while i < len(dir) {
            path[i] = dir[i];
            i = i + 1;
        }
        path[i] = byte_of('/');
        var j = 0;
        while j < len(leaf) {
            path[i + 1 + j] = leaf[j];
            j = j + 1;
        }
        match open_read(fs, path) {
            Opened::Ok(of) => {
                var file = of;
                at = 0;
                var going = true;
                borrow mut file as &!fw in {
                    while going {
                        if at == len(into) {
                            at = 0 - 1;
                            going = false;
                        } else {
                            match file_read(fw, into[at..len(into)]) {
                                Read::Got(n) => {
                                    at = at + n;
                                }
                                Read::End => {
                                    going = false;
                                }
                                Read::Failed(e) => {
                                    at = 0 - 1;
                                    going = false;
                                }
                            }
                        }
                    }
                }
                file_close(file);
            }
            Opened::Failed(e) => {
            }
        }
    }
    return at;
}

// 32 bytes from the system into `out`: whether there were.
fn random[&f, &o](fs: &f Fs(""), out: &!o [byte]) -> [fs_read(""), file_read] bool {
    var ok = false;
    match open_read(fs, "/dev/urandom") {
        Opened::Ok(uf) => {
            var u = uf;
            borrow mut u as &!uw in {
                match file_read(uw, out) {
                    Read::Got(n) => {
                        ok = n == len(out);
                    }
                    Read::End => {
                    }
                    Read::Failed(e) => {
                    }
                }
            }
            file_close(u);
        }
        Opened::Failed(e) => {
        }
    }
    return ok;
}

// The server's certificate and key given to the package (6bq): whether it took them. What it refuses is said on standard error, with the package's tag.
fn identity[&h, &o, &f, &d, &e](heap: &!h Heap, io: &!o Io, fs: &f Fs(""), dir: &d [byte], eng: &!e tls.Engine, now_ms: int) -> [heap, err_write, fs_read(""), file_read] bool {
    var ok = false;
    let chain = box_slice(heap, 65536, byte_of(0));
    let key = box_slice(heap, 8192, byte_of(0));
    borrow mut chain as &!cw in {
        borrow mut key as &!kw in {
            region r {
                let seed = alloc_slice[r](32, byte_of(0));
                let cn = read_whole(fs, dir, "chain.pem", contents(cw));
                let kn = read_whole(fs, dir, "key.pem", contents(kw));
                if cn < 0 {
                    io.error_all(io, "engine: tls: chain.pem cannot be read\n");
                } else if kn < 0 {
                    io.error_all(io, "engine: tls: key.pem cannot be read\n");
                } else if !random(fs, seed) || tls.seed(eng, seed) != 0 {
                    io.error_all(io, "engine: tls: no random bytes\n");
                } else {
                    let code = tls.add_identity(eng, contents(cw)[0..cn], contents(kw)[0..kn], "localhost", now_ms);
                    if code < 0 {
                        io.error_all(io, "engine: tls: refused ");
                        io.error_all(io, tls.refusal_tag(code));
                        io.error_all(io, "\n");
                    } else {
                        ok = true;
                    }
                }
            }
            // the key's copy is overwritten
            var z = 0;
            while z < len(contents(kw)) {
                contents(kw)[z] = byte_of(0);
                z = z + 1;
            }
        }
    }
    unbox_slice(heap, chain);
    unbox_slice(heap, key);
    return ok;
}

// The file of revoked tokens the command line names (its eighth word), or one that is always empty.
fn revoked_file[&f, &a](fs: &f Fs(""), args: &a Args) -> [fs_read(""), args] Opened {
    if words(args) == 8 {
        return open_read(fs, arg(args, 7));
    }
    return open_read(fs, "/dev/null");
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(tty);
    release(ffi);
    release(signals);
    release(exec);
    var status = 2;
    borrow fs as &fsr in {
        borrow args as &g in {
            var idle_ms = 30000;
            var write_ms = 10000;
            var checks = 0;
            if checking(g) {
                checks = 1;
            }
            if words(g) == 7 || words(g) == 8 {
                idle_ms = number_of(arg(g, 5));
                write_ms = number_of(arg(g, 6));
            }
            // the seed of the signing key: 64 hexadecimal digits in a file (6as); a file named that is not that is a refusal to start, not a server that does not log
            var keyed = 0;
            var rooted = 0;
            region kr {
                let keyseed = alloc_slice[kr](32, byte_of(0));
                let rootkey = alloc_slice[kr](32, byte_of(0));
                if words(g) >= 4 {
                    keyed = 0 - 1;
                    if hex_file(fsr, arg(g, 3), keyseed) {
                        keyed = 1;
                    }
                }
                // the root's public key (6at): with it a client must log in with a token the root signed; `-` in its place means no login
                if words(g) >= 5 && !(len(arg(g, 4)) == 1 && int_of(arg(g, 4)[0]) == '-') {
                    rooted = 0 - 1;
                    if hex_file(fsr, arg(g, 4), rootkey) {
                        rooted = 1;
                    }
                }
                if (words(g) == 3 || words(g) == 4 || words(g) == 5 || words(g) == 7 || words(g) == 8 && rooted == 1) && number_of(arg(g, 2)) > 0 && number_of(arg(g, 2)) < 65536 && idle_ms > 0 && write_ms > 0 && keyed >= 0 && rooted >= 0 {
                    status = 3;
                    match open_new(fsr, arg(g, 1)) {
                        Opened::Ok(nf) => {
                            file_close(nf);
                        }
                        Opened::Failed(e) => {
                        }
                    }
                    match open_rw(fsr, arg(g, 1)) {
                        Opened::Failed(e) => {
                        }
                        Opened::Ok(rf) => {
                            var f = rf;
                            var size = 0;
                            borrow mut f as &!fw in {
                                match file_size(fw) {
                                    Done::Ok(n) => {
                                        size = n;
                                    }
                                    Done::Failed(e) => {
                                    }
                                }
                            }
                            borrow mut heap as &!hh in {
                                var pg = pager.new_pager(hh, f, size);
                                var wk = exec.new_work(hh);
                                var subs = drive.new(hh);
                                var seeded = false;
                                borrow mut wk as &!ww in {
                                    // the seed of the salts (docs/m3-engine.md 6ag): 32 bytes from the system, kept nowhere. With none there is no server
                                    region sr {
                                        let sd = alloc_slice[sr](32, byte_of(0));
                                        match open_read(fsr, "/dev/urandom") {
                                            Opened::Ok(uf) => {
                                                var u = uf;
                                                borrow mut u as &!uw in {
                                                    match file_read(uw, sd) {
                                                        Read::Got(n) => {
                                                            seeded = n == 32 && exec.seed(ww, sd);
                                                        }
                                                        Read::End => {
                                                        }
                                                        Read::Failed(e) => {
                                                        }
                                                    }
                                                }
                                                file_close(u);
                                            }
                                            Opened::Failed(e) => {
                                            }
                                        }
                                    }
                                    if seeded {
                                        borrow mut io as &!oo in {
                                            borrow mut pg as &!pp in {
                                                borrow mut subs as &!sb in {
                                                    borrow net as &nn in {
                                                        borrow clock as &kk in {
                                                            // the list of revoked tokens (6bd): the file named, or one that is always empty
                                                            match revoked_file(fsr, g) {
                                                                Opened::Ok(rf) => {
                                                                    var rv = rf;
                                                                    borrow mut rv as &!rw in {
                                                                        // the certificate (6bq): one named and not taken is no server
                                                                        var engine = tls.open_server(hh, serve.max_clients());
                                                                        var secure = false;
                                                                        var refused = false;
                                                                        borrow mut engine as &!ee in {
                                                                            let tw = tls_word(g);
                                                                            if tw >= 0 {
                                                                                secure = identity(hh, oo, fsr, arg(g, tw)[4..len(arg(g, tw))], ee, clock_unix_ms(kk));
                                                                                refused = !secure;
                                                                            }
                                                                            if refused {
                                                                                status = 2;
                                                                            } else {
                                                                                status = listen_on(hh, oo, nn, kk, number_of(arg(g, 2)), idle_ms, write_ms, checks, keyseed[0..32 * keyed], rootkey[0..32 * rooted], pp, ww, sb, rw, ee, secure);
                                                                            }
                                                                        }
                                                                        tls.close(hh, engine);
                                                                    }
                                                                    file_close(rv);
                                                                }
                                                                Opened::Failed(e) => {
                                                                    status = 3;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                drive.free(hh, subs);
                                exec.drop_work(hh, wk);
                                pager.drop_pager(hh, pg);
                            }
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(args);
    release(io);
    release(heap);
    release(net);
    release(clock);
    return status;
}
