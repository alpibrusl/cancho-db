import std.test;
import std.bytes;
import cdb.lex;
import cdb.parse;
import cdb.parse_cases;

// src/parse.cho from bytes, with no server: the cases are tests/parse_cases.cho, which tools/gen_parse.py writes, with every
// answer written by hand there. An accepted expression must render exactly as expected AND render again, from its own
// rendering, to the same text (the fixed point that the proxy's forwarding relies on); a refused one must carry exactly its tag.

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return 0 - 1;
}

fn unhex[&t, &o](text: &t [byte], out: &!o [byte]) -> [] int {
    if len(text) % 2 != 0 {
        return 0 - 1;
    }
    var i = 0;
    while i < len(text) / 2 {
        let hi = hexval(int_of(text[2 * i]));
        let lo = hexval(int_of(text[2 * i + 1]));
        if hi < 0 || lo < 0 {
            return 0 - 1;
        }
        out[i] = byte_of(hi * 16 + lo);
        i = i + 1;
    }
    return len(text) / 2;
}

// Lexes, parses and renders `sql` with the given limits, into `out`. Answers the length rendered, or `0 - code` of a parser
// refusal (a lexer refusal would be a bug in a case: every case lexes).
fn run[&s, &t, &n, &k, &v, &o, &x, &r, &w](sql: &s [byte], toks: &!t [int], nodes: &!n [int], kids: &!k [int], vs: &!v [int], os: &!o [int], st: &!x [int], rs: &!r [int], out: &!w [byte]) -> [] int {
    let n = lex.tokenize(sql, toks);
    test.assert(n >= 0);
    parse.reset(st);
    let q = parse.expr(sql, toks, 0, n, nodes, kids, vs, os, st);
    if q < 0 {
        return q;
    }
    if q != n {
        return 0 - parse.e_syntax();
    }
    return parse.render(sql, toks, nodes, kids, st[2], rs, out);
}

fn test_every_case() -> [] int {
    var i = 0;
    while i < parse_cases.n_parse() {
        region r {
            let hex = parse_cases.parse_input(i);
            let sql = alloc_slice[r](len(hex) / 2 + 1, byte_of(0));
            let m = unhex(hex, sql);
            test.assert(m >= 0);
            let toks = alloc_slice[r](4 * (m + 4), 0);
            let nodes = alloc_slice[r](6 * parse_cases.parse_ncap(i), 0);
            let kids = alloc_slice[r](parse_cases.parse_kcap(i), 0);
            let vs = alloc_slice[r](parse_cases.parse_vcap(i), 0);
            let os = alloc_slice[r](4 * parse_cases.parse_oscap(i), 0);
            let st = alloc_slice[r](16, 0);
            let rs = alloc_slice[r](2 * parse_cases.parse_rcap(i), 0);
            let out = alloc_slice[r](parse_cases.parse_ocap(i), byte_of(0));
            let got = run(sql[0..m], toks, nodes, kids, vs, os, st, rs, out);
            if parse_cases.parse_ok(i) == 1 {
                test.assert(got >= 0);
                let want_hex = parse_cases.parse_want(i);
                let want = alloc_slice[r](len(want_hex) / 2 + 1, byte_of(0));
                let wn = unhex(want_hex, want);
                test.assert_eq(got, wn);
                test.assert(bytes.equal(out[0..got], want[0..wn]));
                // the fixed point: the rendering, parsed and rendered again, is itself
                let toks2 = alloc_slice[r](4 * (wn + 4), 0);
                let nodes2 = alloc_slice[r](6 * 200, 0);
                let kids2 = alloc_slice[r](200, 0);
                let vs2 = alloc_slice[r](64, 0);
                let os2 = alloc_slice[r](256, 0);
                let st2 = alloc_slice[r](16, 0);
                let rs2 = alloc_slice[r](128, 0);
                let out2 = alloc_slice[r](1024, byte_of(0));
                let again = run(want[0..wn], toks2, nodes2, kids2, vs2, os2, st2, rs2, out2);
                test.assert_eq(again, wn);
                test.assert(bytes.equal(out2[0..again], want[0..wn]));
            } else {
                test.assert(got < 0);
                test.assert(bytes.equal(parse.error_name(0 - got), parse_cases.parse_tag(i)));
            }
        }
        i = i + 1;
    }
    return 0;
}

// Every refusal has a tag.
fn test_every_refusal_has_a_tag() -> [] int {
    var code = 1;
    while code <= 8 {
        test.assert(len(parse.error_name(code)) > 3);
        code = code + 1;
    }
    return 0;
}
